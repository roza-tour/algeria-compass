# ---- Algeria Compass — unified site on cPanel/Apache (LiteSpeed) ----
Options -Indexes -MultiViews
DirectoryIndex index.html
# build.format=directory emits 404.html (Astro special-case), not 404/index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Canonical host — force HTTPS + non-www in a SINGLE 301 hop
  #    (prevents redirect chains http→https→non-www that GSC flags as "Page with redirect")
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # 2) Legacy asset path: old /images/* → current /assets/img/* (before the slash rule)
  RewriteRule ^images/(.+)$ /assets/img/$1 [R=301,L]

  # 3) Force a trailing slash on directory-style URLs in one hop
  #    (skip real files and any URL ending in a file extension)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,6}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # 4) Legacy URL 301 map — ADD specific old slugs here from the GSC
  #    "Not found (404)" + "Page with redirect" exports. Each must 301 to a URL
  #    that itself returns 200 (do NOT add the old URL to the sitemap). Example:
  #    RewriteRule ^old-tour-slug/?$ /tours/new-tour-slug/ [R=301,L]
</IfModule>

# Compression (Brotli where available, gzip fallback)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

# Caching: immutable for fingerprinted assets + images, short for HTML
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Mark hashed build assets as immutable (they never change content)
<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|woff2|webp|avif|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # ---- Security headers (Best Practices / future-proofing) ----
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # CSP: allows our inline styles/scripts + Google Analytics + Google Fonts.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com; frame-src 'self' https://www.openstreetmap.org https://maps.google.com https://www.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>
