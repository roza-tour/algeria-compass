# ---- Algeria Compass — unified site on cPanel/Apache (LiteSpeed) ----
Options -Indexes -MultiViews
DirectoryIndex index.html
# build.format=directory emits 404.html (Astro special-case), not 404/index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 0) SECURITY — the git repo root IS the live docroot, so explicitly block
  #    anything that must never be web-served: VCS metadata, source, build
  #    scripts, and the Astro cache. Returns 403 before any redirect fires.
  RewriteRule (^|/)\.git                                - [F,L]
  RewriteRule ^(?:src|scripts|node_modules|\.astro)(?:/|$) - [F,L]
  #    Internal design-handoff reference material (HTML/JSX mock-ups) also sits
  #    in the repo and would otherwise be crawlable at the docroot.
  RewriteRule ^design_handoff_algeria_compass(?:/|$)     - [F,L]

  # 1) Canonical host — force HTTPS + non-www in a SINGLE 301 hop
  #    (prevents redirect chains http→https→non-www that GSC flags as "Page with redirect")
  #
  #    The host is written out literally rather than captured with %1. mod_rewrite
  #    resolves %N against the LAST MATCHED RewriteCond, not the first one — and the
  #    two conditions that actually decide this rule (HTTPS off / ^www\.) contain no
  #    capture groups. A leading capturing condition therefore does not reliably
  #    survive to the substitution, so the previous version could emit a target
  #    built from an empty %1. That is a strong candidate for GSC's "couldn't
  #    fetch" on https://www.algeriacompass.com/sitemap.xml, though it was not
  #    reproduced against the live server. Naming the host removes the question.
  #
  #    This site has exactly one canonical origin (astro.config.mjs `site`).
  #
  #    Reads as: (host is www) OR (not HTTPS AND not proxied-HTTPS). mod_rewrite
  #    binds AND tighter than OR, so the two protocol conditions form one branch.
  #    The X-Forwarded-Proto check matters if TLS is ever terminated upstream
  #    (CDN/proxy): there %{HTTPS} reads "off" on a perfectly good HTTPS request,
  #    and without the guard this rule would redirect to itself forever.
  RewriteCond %{HTTP_HOST} ^www\. [NC,OR]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://algeriacompass.com%{REQUEST_URI} [R=301,L]

  # 2) Legacy asset path: old /images/* → current /assets/img/* (before the slash rule)
  RewriteRule ^images/(.+)$ /assets/img/$1 [R=301,L]

  # 2b) Removed /clusters/ scaffolding (orphaned duplicate hubs) → 301 to the real page.
  #     Placed BEFORE the trailing-slash rule so both /x and /x/ resolve in ONE hop.
  RewriteRule ^clusters/algeria-travel-planning/?$   /travel-guides/ [R=301,L]
  RewriteRule ^clusters/algeria-sahara/?$            /regions/sahara/ [R=301,L]
  RewriteRule ^clusters/algeria-history/?$           /history/ [R=301,L]
  RewriteRule ^clusters/algeria-culture/?$           /culture/ [R=301,L]
  RewriteRule ^clusters/algeria-food/?$              /food/ [R=301,L]
  RewriteRule ^clusters/algeria-unesco/?$            /unesco/ [R=301,L]
  RewriteRule ^clusters/algeria-photography/?$       /regions/ [R=301,L]
  RewriteRule ^clusters/algeria-road-trips/?$        /blog/algeria-transportation-guide/ [R=301,L]
  RewriteRule ^clusters/algeria-luxury/?$            /luxury/ [R=301,L]
  RewriteRule ^clusters/algeria-family/?$            /tours/ [R=301,L]
  RewriteRule ^clusters/algeria-safety/?$            /blog/algeria-safety-guide/ [R=301,L]
  RewriteRule ^clusters/algeria-transportation/?$    /blog/algeria-transportation-guide/ [R=301,L]
  RewriteRule ^clusters/algeria-architecture/?$      /destinations/ [R=301,L]
  RewriteRule ^clusters/algeria-festivals/?$         /culture/ [R=301,L]
  RewriteRule ^clusters/algeria-beaches/?$           /regions/ [R=301,L]
  RewriteRule ^clusters/algeria-mountains/?$         /regions/ [R=301,L]
  #     Index, graph.json and any other unmapped /clusters/* → home (catch-all, keep last).
  RewriteRule ^clusters(/.*)?$                       / [R=301,L]

  # 2bb) Retired /knowledge/ hubs (noindex scaffolding inherited from the old site)
  #      → 301 to the real, indexable page that now owns each subject. Placed
  #      BEFORE the trailing-slash rule so /x and /x/ both resolve in ONE hop.
  RewriteRule ^knowledge/provinces/?$        /provinces/ [R=301,L]
  RewriteRule ^knowledge/sahara/?$           /regions/sahara/ [R=301,L]
  RewriteRule ^knowledge/coast/?$            /regions/ [R=301,L]
  RewriteRule ^knowledge/mountains/?$        /regions/ [R=301,L]
  RewriteRule ^knowledge/photography/?$      /regions/ [R=301,L]
  RewriteRule ^knowledge/roman-heritage/?$   /regions/roman/ [R=301,L]
  RewriteRule ^knowledge/history/?$          /history/ [R=301,L]
  RewriteRule ^knowledge/culture/?$          /culture/ [R=301,L]
  RewriteRule ^knowledge/architecture/?$     /destinations/ [R=301,L]
  RewriteRule ^knowledge/unesco/?$           /unesco/ [R=301,L]
  RewriteRule ^knowledge/cuisine/?$          /food/ [R=301,L]
  RewriteRule ^knowledge/luxury/?$           /luxury/ [R=301,L]
  RewriteRule ^knowledge/family/?$           /tours/ [R=301,L]
  RewriteRule ^knowledge/adventure/?$        /experiences/ [R=301,L]
  RewriteRule ^knowledge/travel-planning/?$  /travel-guides/ [R=301,L]
  RewriteRule ^knowledge/road-trips/?$       /blog/algeria-transportation-guide/ [R=301,L]
  #      Index, /knowledge/graph/, graph.json and anything unmapped → destinations.
  RewriteRule ^knowledge(/.*)?$              /destinations/ [R=301,L]

  # 2c) /fr/, /it/, /es/ and /de/ are all REAL translated sections now, so the old
  #     catch-all that 301'd /de/ and /es/ to the home page has been removed —
  #     leaving it in place would silently redirect the German and Spanish sites
  #     to the English home page. Do not reintroduce it.

  # 3) Force a trailing slash on directory-style URLs in one hop
  #    (skip real files and any URL ending in a file extension)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,6}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # 4) Legacy URL 301 map — ADD specific old slugs here from the GSC
  #    "Not found (404)" + "Page with redirect" exports. Each must 301 to a URL
  #    that itself returns 200 (do NOT add the old URL to the sitemap). Example:
  #    RewriteRule ^old-tour-slug/?$ /tours/new-tour-slug/ [R=301,L]
</IfModule>

# Compression (Brotli where available, gzip fallback)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

# Caching: immutable for fingerprinted assets + images, short for HTML
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Mark hashed build assets as immutable (they never change content)
<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|woff2|webp|avif|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # ---- Security headers (Best Practices / future-proofing) ----
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # CSP: allows our inline styles/scripts + Google Analytics + Google Fonts.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com; frame-src 'self' https://www.openstreetmap.org https://maps.google.com https://www.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# ---- Deny web access to source, config, build scripts & internal docs ----
#      (the repo root is the docroot; none of these should be fetchable).
#      robots.txt / sitemap*.xml / search-index.json / llms.txt stay public.
<FilesMatch "\.(?:md|mjs|sh|py|bak|lock|map)$">
  <IfModule mod_authz_core.c>Require all denied</IfModule>
  <IfModule !mod_authz_core.c>Order allow,deny
Deny from all</IfModule>
</FilesMatch>
<FilesMatch "^(?:package\.json|package-lock\.json|tsconfig\.json|IDENTITY\.txt|DEPLOY-README\.txt|INVENTORY\.txt|CLIENTS-INVENTORY\.txt)$">
  <IfModule mod_authz_core.c>Require all denied</IfModule>
  <IfModule !mod_authz_core.c>Order allow,deny
Deny from all</IfModule>
</FilesMatch>
