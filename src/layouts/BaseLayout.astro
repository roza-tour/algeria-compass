---
import '../styles/global.css';
import { ANALYTICS } from '../config';
import '../styles/civ-skins.css';
import '../styles/occasions.css';
import '../styles/season-themes.css';
import '../styles/motion.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SchemaGraph from '../components/SchemaGraph.astro';
import Analytics from '../components/Analytics.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { asLang, t as tr } from '../i18n';
import SeasonAmbience from '../components/SeasonAmbience.astro';
import SeasonBanner from '../components/SeasonBanner.astro';
import { seasonForDate } from '../lib/season';
import StickyContact from '../components/StickyContact.astro';
import AskWidget from '../components/AskWidget.astro';
export interface Props {
  title: string; description: string; image?: string; imageAlt?: string; type?: string;
  region?: string; civ?: string; rgn?: string; schema?: any[]; speakable?: string[]; sticky?: boolean; keywords?: string | string[]; bodyClass?: string; noindex?: boolean;
  lang?: string; alternates?: { hreflang: string; href: string }[];
  /** Seasonal/topic skin: 'ramadan' | 'christmas' | 'winter' | 'sahara' */
  occasion?: string;
}
const { title, description, image, imageAlt, type, region, civ, rgn, schema = [], speakable, sticky = false, keywords, bodyClass, noindex = false, lang = 'en', alternates = [], occasion } = Astro.props;

// Occasion display faces are loaded only on the pages that use them.
const OCCASION_FONT: Record<string, string> = {
  ramadan: 'https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&display=swap',
  christmas: 'https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&display=swap',
};
const occasionFont = occasion ? OCCASION_FONT[occasion] : undefined;

// Site-wide seasonal theme, resolved from the calendar (SEASON_PREVIEW forces it).
const siteSeason = (import.meta.env.SEASON_PREVIEW as string) || seasonForDate(new Date());
// Speakable: tells voice assistants and AI answer engines which parts of the
// page are the spoken answer (CSS selectors that exist on that page).
const speakUrl = new URL(Astro.url.pathname, (Astro.site?.toString() || 'https://algeriacompass.com')).toString();
const speakableNode = speakable?.length ? {
  '@type': 'WebPage', '@id': speakUrl + '#webpage', url: speakUrl, name: title, inLanguage: lang,
  speakable: { '@type': 'SpeakableSpecification', cssSelector: speakable },
} : null;
---
<!doctype html>
<html lang={lang} data-region={region} data-civ={civ} data-rgn={rgn} data-occasion={occasion} data-season={siteSeason}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  {/* Page-supplied head content comes FIRST, because this is where pages put
      their LCP image preload. It used to sit at the end of <head>, behind four
      favicons and three Google Fonts requests, and the measurement was blunt:
      Lighthouse recorded an lcpLoadDelay of 1051 ms on the live homepage — the
      hero was not even discovered until the browser had opened cross-origin
      connections for fonts. Preloads are honoured in document order, so
      hoisting this slot is the whole fix. */}
  <slot name="head" />

  <link rel="icon" href="/assets/img/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/assets/img/favicon-512.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/favicon-180.png" />
  {ANALYTICS.adsense && (
    <>
      {/* Google AdSense. The site is tied to the account by this meta tag
          (Google's "meta tag" verification method) and by /ads.txt; the ad
          script itself loads only once the visitor accepts cookies.
          It used to load on every visit with pauseAdRequests=1, but that
          did not hold: measured in October 2026, a fresh visitor with no
          consent still triggered a full ad request (pagead/ads, the
          doubleclick test_cookie, the sodar traffic-quality scripts) --
          the notice promises nothing is set before a choice. Loading on
          consent keeps that promise and spares everyone else ~250 KB of
          script, the largest share of the tour pages' blocking time.
          CookieConsent.astro calls __loadAds() on Accept; a stored
          acceptance loads it here on later visits. */}
      <meta name="google-adsense-account" content={ANALYTICS.adsense} />
      <script is:inline define:vars={{ adClient: ANALYTICS.adsense }}>
        window.__loadAds = function () {
          if (window.__adsLoaded) return; window.__adsLoaded = 1;
          var s = document.createElement('script'); s.async = true; s.crossOrigin = 'anonymous';
          s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + adClient;
          document.head.appendChild(s);
        };
        try { if (localStorage.getItem('ac-consent') === 'granted') window.__loadAds(); } catch (e) {}
      </script>
    </>
  )}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  {/* Load font CSS asynchronously so it never blocks first render (Lighthouse) */}
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Jost:wght@400;500;600;700&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Jost:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Jost:wght@400;500;600;700&display=swap" /></noscript>
  {occasionFont && (
    <>
      <link rel="stylesheet" href={occasionFont} media="print" onload="this.media='all'" />
      <noscript><link rel="stylesheet" href={occasionFont} /></noscript>
    </>
  )}
  <Seo title={title} description={description} image={image} imageAlt={imageAlt} type={type} keywords={keywords} noindex={noindex} lang={lang} />
  {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
  <SchemaGraph nodes={speakableNode ? [...schema, speakableNode] : schema} />
  <Analytics />
</head>
<body class={bodyClass}>
  <SeasonAmbience />
  <a href="#main" class="skip-link">{tr(asLang(lang), 'skip')}</a>
  <Header lang={lang} />
  <SeasonBanner lang={lang} />
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} />
  {sticky && <StickyContact lang={lang} />}
  <AskWidget lang={asLang(lang)} />
  <CookieConsent lang={lang} />
  <script is:inline>
    // Spam filter support (spamguard.php): on submit, every form posting to
    // contact.php / reviews.php / itinerary.php carries _el = seconds since the page loaded.
    // Capture phase, so it is set before the forms' own fetch() handlers run.
    (function(){var t0=Date.now();document.addEventListener('submit',function(e){var f=e.target;if(!f||!/(contact|reviews|itinerary)\.php$/.test(f.getAttribute('action')||''))return;var i=f.querySelector('input[name="_el"]');if(!i){i=document.createElement('input');i.type='hidden';i.name='_el';f.appendChild(i);}i.value=String(Math.round((Date.now()-t0)/1000));},true);})();
  </script>
  <script is:inline>
    /* Numbers count up the first time they come into view: [data-count].
       The final figure is in the HTML -- for search engines, no-JS and
       reduced motion -- and the script only replays the climb to it. It keeps
       whatever surrounds the number ("€1,615", "24") and skips text with no
       number in it ("All-in"). */
    (function(){
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (document.visibilityState === 'hidden' || !('IntersectionObserver' in window)) return;
      var els = document.querySelectorAll('[data-count]');
      if (!els.length) return;
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if (!e.isIntersecting) return;
          io.unobserve(e.target);
          var el = e.target, text = el.textContent, m = text.match(/\d[\d,]*/);
          if (!m) return;
          var target = parseInt(m[0].replace(/,/g, ''), 10), comma = m[0].indexOf(',') > -1;
          var pre = text.slice(0, m.index), post = text.slice(m.index + m[0].length);
          var t0 = performance.now(), dur = Math.min(1600, 700 + target * 2);
          /* starts on the first real frame (never writes a 0 up front), and a
             timer restores the final text even if frames stop, e.g. a tab sent
             to the background mid-count -- so a figure can never sit at 0 */
          function step(now){
            var k = Math.min(1, (now - t0) / dur), eased = 1 - Math.pow(1 - k, 3);
            var n = Math.round(target * eased);
            el.textContent = pre + (comma ? n.toLocaleString('en-US') : n) + post;
            if (k < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(function(now){ t0 = now; step(now); });
          setTimeout(function(){ el.textContent = text; }, dur + 900);
        });
      }, { threshold: .6 });
      els.forEach(function(el){ io.observe(el); });
    })();
  </script>
  <script is:inline>
    /* Header glass + reading progress (styles in motion.css). One passive
       scroll listener, painted on the next frame. */
    (function(){
      var root = document.documentElement, bar = null, raf = 0;
      var prose = document.querySelector('.prose');
      if (prose && document.documentElement.scrollHeight > window.innerHeight * 2.5) {
        bar = document.createElement('div');
        bar.className = 'read-progress'; bar.setAttribute('aria-hidden', 'true');
        document.body.appendChild(bar);
      }
      function paint(){
        raf = 0;
        var y = window.pageYOffset || 0;
        root.classList.toggle('is-scrolled', y > 12);
        if (bar) {
          var max = document.documentElement.scrollHeight - window.innerHeight;
          bar.style.transform = 'scaleX(' + (max > 0 ? Math.min(1, y / max) : 0).toFixed(4) + ')';
        }
      }
      window.addEventListener('scroll', function(){ if (!raf) raf = requestAnimationFrame(paint); }, { passive:true });
      paint();
    })();
  </script>
  <script is:inline>
    /* Floating actions appear once the hero has scrolled away (see global.css,
       html.fab-wait). A page with no hero shows them at once. */
    (function(){
      var hero = document.querySelector('.home-hero, .rg-hero, .hero');
      if (!hero) return;
      var root = document.documentElement;
      root.classList.add('fab-wait');
      function check(){
        /* past the point where the hero's own buttons leave the screen */
        var on = hero.getBoundingClientRect().bottom < window.innerHeight * 0.35;
        root.classList.toggle('fab-on', on);
      }
      check();
      var fr = 0;   /* once per frame: getBoundingClientRect per scroll event forced layout */
      function onScroll(){ if (!fr) fr = requestAnimationFrame(function(){ fr = 0; check(); }); }
      window.addEventListener('scroll', onScroll, { passive:true });
      window.addEventListener('resize', onScroll, { passive:true });
    })();
  </script>
  <script is:inline>
    /* Homepage hero parallax. .home-hero-bg is laid out with inset:-6% and an
       img at height:108% -- overscan that exists for exactly this effect but
       was never wired up, leaving a will-change hint paying for a compositor
       layer that nothing animated.

       The travel is clamped in pixels, not just scaled by a rate: a rate alone
       would exceed the available slack on a tall viewport and expose a bare
       edge under the photograph. Only the background moves -- the copy sits at
       the bottom of an overflow:hidden hero, so shifting it down would clip
       the h1, and it is a candidate LCP element besides. */
    (function(){
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var bg = document.querySelector('.home-hero-bg');
      if(!bg) return;
      var raf = 0;
      function paint(){
        raf = 0;
        var y = window.pageYOffset || 0;
        if (y > 1200) return;                      /* hero is long gone */
        var d = Math.min(y * 0.09, 56);            /* stays inside the overscan */
        bg.style.transform = 'translate3d(0,' + d.toFixed(1) + 'px,0)';
      }
      window.addEventListener('scroll', function(){ if(!raf) raf = requestAnimationFrame(paint); }, { passive:true });
    })();
  </script>
  <script is:inline>
    /* Shared scroll-reveal. Content is visible by default; the hidden state is
       only applied when motion is allowed AND the tab is visible, so print,
       no-JS, reduced-motion and background tabs always show everything. */
    (function(){
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (document.visibilityState === 'hidden') return;

      /* Two ways to opt in:
           [data-reveal]        this element reveals itself
           [data-reveal-group]  each child reveals, cascading left to right
         A group saves marking every card in a grid, and keeps the stagger in
         one place instead of a copy in every page's own script. */
      var els = [];
      document.querySelectorAll('[data-reveal]').forEach(function(el){ els.push(el); });
      document.querySelectorAll('[data-reveal-group]').forEach(function(g){
        for(var i = 0; i < g.children.length; i++){
          /* The CSS contract is `[data-reveal].reveal-init` -- the attribute is
             half of it, so a child given only the class gets no hidden state
             and never animates. Set the attribute here rather than loosening
             the selector: the 428 pages already using it keep one
             authoritative rule, and because this attribute is now also applied
             only by JS, no-JS, print and reduced-motion still show everything.*/
          g.children[i].setAttribute('data-reveal', '');
          els.push(g.children[i]);
        }
      });
      if(!els.length) return;
      els.forEach(function(el){ el.classList.add('reveal-init'); });

      if('IntersectionObserver' in window){
        var io = new IntersectionObserver(function(entries){
          /* Everything that crossed the line in the same frame arrives in one
             callback, so the batch itself gives us the cascade order -- no
             index bookkeeping, and a long grid cascades per screenful instead
             of firing its last row while it is still far below the fold. */
          var n = 0;
          entries.forEach(function(e){
            if(!e.isIntersecting) return;
            if(n) e.target.style.transitionDelay = Math.min(n, 6) * 80 + 'ms';
            n++;
            e.target.classList.add('reveal-in');
            io.unobserve(e.target);
          });
        }, { rootMargin:'0px 0px -8% 0px', threshold:.06 });
        els.forEach(function(el){ io.observe(el); });
      } else {
        els.forEach(function(el){ el.classList.add('reveal-in'); });
      }
    })();
  </script>
</body>
</html>
