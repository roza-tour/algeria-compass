---
import '../styles/global.css';
import '../styles/civ-skins.css';
import '../styles/occasions.css';
import '../styles/season-themes.css';
import '../styles/contrast-overrides.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SchemaGraph from '../components/SchemaGraph.astro';
import Analytics from '../components/Analytics.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { asLang, t as tr } from '../i18n';
import SeasonAmbience from '../components/SeasonAmbience.astro';
import SeasonBanner from '../components/SeasonBanner.astro';
import { seasonForDate } from '../lib/season';
import StickyContact from '../components/StickyContact.astro';
export interface Props {
  title: string; description: string; image?: string; imageAlt?: string; type?: string;
  region?: string; civ?: string; schema?: any[]; sticky?: boolean; keywords?: string | string[]; bodyClass?: string; noindex?: boolean;
  lang?: string; alternates?: { hreflang: string; href: string }[];
  /** Seasonal/topic skin: 'ramadan' | 'christmas' | 'winter' | 'sahara' */
  occasion?: string;
}
const { title, description, image, imageAlt, type, region, civ, schema = [], sticky = false, keywords, bodyClass, noindex = false, lang = 'en', alternates = [], occasion } = Astro.props;

// Occasion display faces are loaded only on the pages that use them.
const OCCASION_FONT: Record<string, string> = {
  ramadan: 'https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&display=swap',
  christmas: 'https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&display=swap',
};
const occasionFont = occasion ? OCCASION_FONT[occasion] : undefined;

// Site-wide seasonal theme, resolved from the calendar (SEASON_PREVIEW forces it).
const siteSeason = (import.meta.env.SEASON_PREVIEW as string) || seasonForDate(new Date());
---
<!doctype html>
<html lang={lang} data-region={region} data-civ={civ} data-occasion={occasion} data-season={siteSeason}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  {/* Page-supplied head content comes FIRST, because this is where pages put
      their LCP image preload. It used to sit at the end of <head>, behind four
      favicons and three Google Fonts requests, and the measurement was blunt:
      Lighthouse recorded an lcpLoadDelay of 1051 ms on the live homepage — the
      hero was not even discovered until the browser had opened cross-origin
      connections for fonts. Preloads are honoured in document order, so
      hoisting this slot is the whole fix. */}
  <slot name="head" />

  <link rel="icon" href="/assets/img/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/assets/img/favicon-512.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/favicon-180.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  {/* Load font CSS asynchronously so it never blocks first render (Lighthouse) */}
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=Nunito:wght@300;400;500;600;700;800&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=Nunito:wght@300;400;500;600;700;800&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=Nunito:wght@300;400;500;600;700;800&display=swap" /></noscript>
  {occasionFont && (
    <>
      <link rel="stylesheet" href={occasionFont} media="print" onload="this.media='all'" />
      <noscript><link rel="stylesheet" href={occasionFont} /></noscript>
    </>
  )}
  <Seo title={title} description={description} image={image} imageAlt={imageAlt} type={type} keywords={keywords} noindex={noindex} lang={lang} />
  {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
  <SchemaGraph nodes={schema} />
  <Analytics />
</head>
<body class={bodyClass}>
  <SeasonAmbience />
  <a href="#main" class="skip-link">{tr(asLang(lang), 'skip')}</a>
  <Header lang={lang} />
  <SeasonBanner lang={lang} />
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} />
  {sticky && <StickyContact lang={lang} />}
  <CookieConsent lang={lang} />
  <script is:inline>
    /* Shared scroll-reveal. Content is visible by default; the hidden state is
       only applied when motion is allowed AND the tab is visible, so print,
       no-JS, reduced-motion and background tabs always show everything. */
    (function(){
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (document.visibilityState === 'hidden') return;
      var els = document.querySelectorAll('[data-reveal]');
      if(!els.length) return;
      els.forEach(function(el){ el.classList.add('reveal-init'); });
      if('IntersectionObserver' in window){
        var io = new IntersectionObserver(function(entries){
          entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('reveal-in'); io.unobserve(e.target); } });
        }, { rootMargin:'0px 0px -8% 0px', threshold:.06 });
        els.forEach(function(el){ io.observe(el); });
      } else {
        els.forEach(function(el){ el.classList.add('reveal-in'); });
      }
    })();
  </script>
</body>
</html>
