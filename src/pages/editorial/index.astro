---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
const policies=(await getCollection('editorial')).sort((a,b)=>a.data.order-b.data.order);
const site=(Astro.site?.toString()||'https://algeriacompass.com').replace(/\/$/,'');
const schema=[{"@type":"AboutPage","@id":site+"/editorial/#page","name":"Editorial Standards","about":{"@id":site+"/#organization"},"isPartOf":{"@id":site+"/#website"},"mainEntity":{"@id":site+"/#organization"}}];
---
<BaseLayout title="Editorial Standards & Transparency — Algeria Compass" description="How Algeria Compass researches, verifies, reviews, updates and corrects its Algeria travel content. Our editorial policies, team and review function." schema={schema}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Editorial'}]} />
  <section class="section"><div class="wrap" style="max-width:820px">
    <div class="eyebrow">Trust &amp; transparency</div>
    <h1>Editorial standards</h1>
    <p style="color:var(--text-m)">Algeria Compass is a travel publication about Algeria. Our value rests entirely on being accurate and trustworthy, so we are open about who creates our content, how it is researched and verified, and how we handle updates and corrections. Below are the people behind the work and the policies that govern it.</p>
    <h2>The people</h2>
    <div class="policy-list">
      <a href="/team/"><div class="pt">Editorial team</div><div class="ps">Who researches and writes our guides.</div></a>
      <a href="/reviewers/"><div class="pt">Review &amp; fact-checking</div><div class="ps">Who verifies information before and after publication.</div></a>
    </div>
    <h2 style="margin-top:1.6rem">Our policies</h2>
    <div class="policy-list">
      {policies.map(p => (<a href={`/editorial/${p.slug}/`}><div class="pt">{p.data.title}</div><div class="ps">{p.data.summary}</div></a>))}
    </div>
    <p style="margin-top:1.6rem;font-size:.9rem;color:var(--text-l)">Spotted an error? Our <a href="/editorial/corrections-policy/">Corrections Policy</a> explains how to tell us. Email <strong>editorial@algeriacompass.com</strong>.</p>
  </div></section>
</BaseLayout>
