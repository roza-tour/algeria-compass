---
// One page per eclipse journey (data: src/data/eclipseTours.ts). Each has its
// own URL so eclipse-tour directories can link straight to it. Night-sky
// theme (src/styles/eclipse.css), animated eclipse hero with a countdown,
// clear included / not-included panels and photos of our own guests.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EclipseSky from '../../components/EclipseSky.astro';
import GuestMoments from '../../components/GuestMoments.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import FaqSection from '../../components/FaqSection.astro';
import CtaSection from '../../components/CtaSection.astro';
import { ECLIPSE_TOURS, ECLIPSE_DATE, type EclipseTour } from '../../data/eclipseTours';
import { PHOTO_ALT } from '../../data/tour-photos';
import { BOOKING } from '../../config';
import '../../styles/eclipse.css';

export function getStaticPaths() {
  return ECLIPSE_TOURS.map(t => ({ params: { slug: t.slug }, props: { tour: t } }));
}
const { tour } = Astro.props as { tour: EclipseTour };
const site = (Astro.site?.toString() || 'https://algeriacompass.com').replace(/\/$/, '');
const url = `${site}/eclipse-2027-algeria/${tour.slug}/`;
const img = (f: string) => `/assets/img/tours/${f}`;
const others = ECLIPSE_TOURS.filter(t => t.slug !== tour.slug);
const contact = `/contact/?i=${encodeURIComponent('Eclipse 2027 – ' + tour.short)}`;
const eclipseDay = tour.itinerary.findIndex(d => /2 August/.test(d.date));

const facts = [
  { label: 'Dates', value: tour.dates },
  { label: 'Length', value: `${tour.days} days, private for your party` },
  { label: 'Totality', value: `${tour.watch.duration}, from ${tour.watch.time}` },
  { label: 'Price', value: `From €${tour.price} per person, sharing` },
  { label: 'Starts / ends', value: `${tour.start} / ${tour.end}` },
  { label: 'Visa', value: 'Consulate visa; we send the invitation letter' },
];

const faqs = [
  { q: 'Is this a group tour?', a: 'No. Like all our trips it is private, for your own party only: your guide, your driver and your pace. Tell us how many you are and we tailor the details.' },
  { q: 'What if it is cloudy on the morning?', a: 'Long-term satellite records give this eclipse some of the lowest cloud the specialists have measured, and morning cloud in Algeria is usually light. Still, we never leave it to chance: the evening before, we look at the forecast together and choose the spot, with a second one ready a short drive away.' },
  { q: 'How do we get the visa?', a: 'You apply at an Algerian consulate with the invitation letter and confirmed programme we send you. Apply early: summer 2027 will be busy, and we confirm your booking once the visa is accepted.' },
  { q: 'Can we change the dates or add days?', a: 'Yes. The eclipse morning is fixed, everything around it can move: arrive earlier, stay longer, add the Sahara or another region. We rebuild the programme and the price around you.' },
  { q: 'Do you provide eclipse glasses?', a: 'Please bring proper eclipse glasses (ISO 12312-2) for the partial phases; take them off only during totality.' },
];

const trip = {
  '@type': 'TouristTrip', '@id': `${url}#trip`, name: `${tour.title} (total solar eclipse, 2 August 2027)`,
  description: tour.hook, url, touristType: 'Eclipse travellers',
  itinerary: { '@type': 'ItemList', numberOfItems: tour.itinerary.length, itemListElement: tour.itinerary.map((d, i) => ({ '@type': 'ListItem', position: i + 1, name: `Day ${i + 1}: ${d.title}` })) },
  offers: { '@type': 'Offer', price: tour.price, priceCurrency: 'EUR', url, availability: 'https://schema.org/InStock', validThrough: ECLIPSE_DATE },
  provider: { '@id': `${site}/#organization` },
};
const breadcrumb = { '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
  { '@type': 'ListItem', position: 2, name: 'Eclipse 2027 in Algeria', item: `${site}/eclipse-2027-algeria/` },
  { '@type': 'ListItem', position: 3, name: tour.short, item: url },
] };
const gallery = tour.photos.map(p => ({ src: img(`${p}.jpg`), alt: PHOTO_ALT[p] || tour.title }));
const place = tour.watch.duration.split(' in ').pop()?.split(',')[0] || tour.short;
---
<BaseLayout title={tour.seoTitle} description={tour.seoDesc} image={img(tour.hero)}
  keywords={['eclipse tour Algeria 2027', `${tour.short} eclipse`, 'total solar eclipse August 2 2027', 'private eclipse tour']}
  schema={[trip, breadcrumb]}>
<div class="ecx">
  <EclipseSky eyebrow={`Private eclipse journey · ${tour.dates}`} title={tour.title} text={tour.hook}
    target={tour.totalityStart} place={place}
    cta={{ href: contact, label: 'Hold my place →' }} cta2={{ href: '#included', label: 'What is included' }} />
  <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Eclipse 2027', href: '/eclipse-2027-algeria/' }, { name: tour.short }]} />

  <section class="ec-sec ec-reveal" style="padding-top:1rem"><div class="wrap ec-narrow">
    <dl class="ec-facts">{facts.map(f => <div class="ec-fact"><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>
  </div></section>

  <section class="ec-sec ec-reveal" style="padding-top:0"><div class="wrap ec-narrow">
    <div class="ec-panel ec-quick">
      <b>Where we watch the eclipse</b>
      <p><strong style="color:var(--ec-head)">{tour.watch.place}.</strong> Totality lasts {tour.watch.duration} and begins at {tour.watch.time}. {tour.watch.why}</p>
    </div>
  </div></section>

  <div class="ec-orn" aria-hidden="true"></div>

  <section class="ec-sec ec-reveal"><div class="wrap ec-narrow">
    <span class="ec-eyebrow">The programme</span>
    <h2>Day by day</h2>
    <ol class="ec-tl">
      {tour.itinerary.map((d, i) => (
        <li class={i === eclipseDay ? 'is-eclipse' : ''}>
          <span class="ec-day">Day {i + 1} · {d.date}{i === eclipseDay ? ' · Eclipse day' : ''}</span>
          <b>{d.title}</b>
          <p>{d.body}</p>
        </li>
      ))}
    </ol>
  </div></section>

  <section class="ec-sec ec-reveal" id="included" style="padding-top:0"><div class="wrap ec-narrow">
    <span class="ec-eyebrow">Clear and simple</span>
    <h2>What the price includes</h2>
    <div class="ec-ie">
      <div class="ec-panel ec-yes">
        <h3><span class="ec-ico" aria-hidden="true">✓</span>Included</h3>
        <ul>{tour.includes.map(x => <li><span class="ec-ico" aria-hidden="true">✓</span><span>{x}</span></li>)}</ul>
      </div>
      <div class="ec-panel ec-no">
        <h3><span class="ec-ico" aria-hidden="true">✕</span>Not included</h3>
        <ul>{tour.excludes.map(x => <li><span class="ec-ico" aria-hidden="true">✕</span><span>{x}</span></li>)}</ul>
      </div>
    </div>
    <div class="ec-price">
      <div>
        <div class="ec-price-n">€{tour.price}<small>per person, sharing a double room</small></div>
        <p>We hold your dates for {BOOKING.holdHours} hours at no cost while we confirm, and confirm the booking once your visa is accepted. No payment to hold your place.</p>
      </div>
      <a class="ec-btn" href={contact} data-evt="cta_plan">Hold my place →</a>
    </div>
  </div></section>

  <GuestMoments prefer={tour.guestPhotos} heading="Travel with the people in these photos" lead="Our own guests and guides, on trips we ran. Not stock images: this is how a journey with us looks." />

  <div class="ec-orn" aria-hidden="true"></div>
  <section class="ec-sec ec-reveal" style="padding-bottom:0"><div class="wrap">
    <span class="ec-eyebrow">The places</span>
    <h2>{tour.short} in pictures</h2>
  </div></section>
</div>
  <PhotoGallery images={gallery} />
<div class="ecx">
  <section class="ec-sec ec-reveal"><div class="wrap">
    <div class="ec-orn-c"><span></span></div>
    <h2 style="text-align:center">Our other eclipse journeys</h2>
    <div class="ec-cards">
      {others.map(o => (
        <a class="ec-card" href={`/eclipse-2027-algeria/${o.slug}/`}>
          <span class="ec-badge">{o.days} days</span>
          <img src={img(o.hero)} alt="" width="640" height="400" loading="lazy" decoding="async" />
          <span class="ec-card-b"><b>{o.title}</b><span>{o.dates}</span><span class="ec-card-t">Totality: {o.watch.duration}</span><span class="ec-card-p">From €{o.price} per person →</span></span>
        </a>
      ))}
    </div>
    <p style="text-align:center"><a href="/eclipse-2027-algeria/">Where to see the 2027 eclipse in Algeria →</a></p>
  </div></section>
  <FaqSection faqs={faqs} />
</div>
  <CtaSection heading="Hold your place under the eclipse" interest={`Eclipse 2027 – ${tour.short}`} />
</BaseLayout>
