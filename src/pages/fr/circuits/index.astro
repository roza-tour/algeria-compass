---
// French tours index. Cards are fully translated for every tour; a tour links to
// its French detail page when one exists, otherwise to the English page, which
// is honest rather than shipping a half-translated page.
import AlgeriaMap from '../../../components/AlgeriaMap.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TourFilters from '../../../components/TourFilters.astro';
import RecentTours from '../../../components/RecentTours.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import data from '../../../data/tours.json';
import { TOUR_VISUALS } from '../../../data/tour-visuals';
import { TOURS_FR } from '../../../data/tours-fr';
import { alternatesFor } from '../../../i18n';

const site = (Astro.site?.toString() || 'https://algeriacompass.com').replace(/\/$/, '');
const tours = (((data as any).tours || data) as any[]);
const currency = (data as any).currency || 'EUR';

const rows = tours.map(t => {
  const fr = TOURS_FR[t.id];
  const v = TOUR_VISUALS[t.id] || { hero: `${t.image_slugs[0]}-1.jpg`, accent: '#0B3D2E' };
  return {
    tour: t,
    id: t.id,
    href: fr?.full ? `/fr/circuits/${t.id}/` : `/tours/${t.id}/`,
    frenchPage: !!fr?.full,
    title: fr?.title || t.title,
    duration: fr?.duration || t.duration,
    hook: fr?.hook || t.summary,
    price: t.price_eur,
    hero: v.hero,
    accent: v.accent,
  };
});

const title = "Circuits privés en Algérie — voyages sur mesure | Algeria Compass";
const description = "Nos circuits privés en Algérie : Sahara et Tadrart, vallée du M'Zab, cités romaines, Alger et la côte. Voyagiste algérien agréé, guides francophones.";
const alternates = alternatesFor(site, { en: '/tours/', fr: '/fr/circuits/', it: '/it/circuiti/', es: '/es/circuitos/', de: '/de/reisen/' });
const itemList = {
  '@type': 'ItemList',
  '@id': `${site}/fr/circuits/#circuits`,
  name: 'Circuits privés en Algérie',
  numberOfItems: rows.length,
  itemListElement: rows.map((r, i) => ({
    '@type': 'ListItem', position: i + 1, name: r.title, url: site + r.href,
  })),
};
const collection = {
  '@type': 'CollectionPage',
  '@id': `${site}/fr/circuits/#collection`,
  name: 'Circuits privés en Algérie',
  description,
  inLanguage: 'fr',
  url: `${site}/fr/circuits/`,
  isPartOf: { '@id': `${site}/#website` },
  about: { '@id': `${site}/#algeria` },
  mainEntity: { '@id': `${site}/fr/circuits/#circuits` },
};
---
<BaseLayout title={title} description={description} lang="fr" alternates={alternates}
  image="/assets/img/tours/djanet-1.jpg" schema={[collection, itemList]}
  keywords={["circuit Algérie","voyage Algérie","circuit Sahara Algérie","voyage organisé Algérie","agence de voyage Algérie"]}>
  <section class="hero" style="min-height:42vh">
    <img src="/assets/img/tours/djanet-1.jpg" alt="Dunes du Sahara algérien près de Djanet" width="1600" height="900" fetchpriority="high" />
    <div class="hero-in wrap">
      <div class="eyebrow">{rows.length} circuits privés</div>
      <h1>Circuits privés en Algérie</h1>
      <p>Des voyages privés et guidés à travers toute l'Algérie — du Sahara profond aux cités romaines du nord et à la côte méditerranéenne.</p>
    </div>
  </section>

  <AlgeriaMap lang="fr" />

  <Breadcrumbs items={[{name:'Accueil',href:'/fr/'},{name:'Circuits'}]} />

  <section class="section"><div class="wrap">
    <p class="fr-intro">
      Algeria Compass est un <strong>voyagiste algérien agréé</strong> basé à Alger. Tous nos circuits sont
      <strong>privés</strong> : votre guide, votre véhicule, votre rythme — rien n'est mutualisé avec d'autres groupes.
      Nous fournissons l'invitation et le programme confirmé que les consulats demandent pour le
      <a href="/fr/visa-algerie/">visa algérien</a>, et nos guides parlent français.
      Pour choisir la période, voyez <a href="/fr/quand-partir-algerie/">quand partir en Algérie</a>.
    </p>

    <RecentTours lang="fr" inline />
    <TourFilters lang="fr" rows={rows.map((r) => ({ tour: r.tour, href: r.href, title: r.title, hook: r.hook, duration: r.duration, englishOnly: !r.frenchPage }))} />

    <p class="fr-note">
      Les circuits sans page française détaillée sont décrits en anglais, mais se réservent et
      s'accompagnent en français comme les autres. Écrivez-nous en français :
      <a href="/fr/contact/">formulaire de contact</a> ou WhatsApp.
    </p>
  </div></section>
</BaseLayout>

<style>
  .fr-intro{max-width:780px;color:var(--text-m);margin-bottom:1.6rem}
  .fr-intro a,.fr-note a{text-decoration:underline;text-underline-offset:2px}
  .fr-note{max-width:780px;color:var(--text-l);font-size:.88rem;margin-top:2rem;padding-top:1.2rem;border-top:1px solid var(--border)}
</style>
