---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import { clusters } from '../../data/clusters';
import { clusterStats } from '../../lib/clusters';
import { intentById } from '../../data/intents';
const site = (Astro.site?.toString() || 'https://algeriacompass.com').replace(/\/$/, '');
const stats = clusterStats();
const rowById = Object.fromEntries(stats.rows.map(r => [r.id, r]));
const quick = `Algeria Compass organises every page into ${clusters.length} content clusters — each a topical authority center linking a pillar guide, supporting articles, FAQs, a knowledge hub and the entities behind it. ${stats.entitiesConnected} of ${stats.entitiesTotal} knowledge-graph entities are connected to clusters.`;
const url = '/clusters/';
const collection = {
  '@type':'CollectionPage', '@id':`${site}${url}#collection`, name:'Algeria Compass Content Clusters',
  description:'The topical cluster architecture of Algeria Compass.', url:`${site}${url}`,
  isPartOf:{'@id':`${site}/#website`}, about:{'@id':`${site}/#algeria`},
  mainEntity:{ '@type':'ItemList', numberOfItems:clusters.length,
    itemListElement: clusters.map((c,i)=>({'@type':'ListItem',position:i+1,name:c.name,url:`${site}/clusters/${c.id}/`})) },
};
const breadcrumb = { '@type':'BreadcrumbList', itemListElement:[
  {'@type':'ListItem',position:1,name:'Home',item:`${site}/`},
  {'@type':'ListItem',position:2,name:'Clusters',item:`${site}${url}`}]};
---
<BaseLayout title="Content Clusters" description="The 16 topical content clusters that structure Algeria Compass — each a pillar, supporting articles, FAQs, entities and a knowledge hub." schema={[collection, breadcrumb]} noindex>
  <Hero title="Content Clusters" eyebrow="Architecture" text="Every page belongs to a cluster — a topical authority center connecting content, FAQs, entities and knowledge hubs." image="/assets/img/sahara-dunes-tadrart.jpg" alt="Algeria" />
  <section class="section"><div class="wrap" style="max-width:820px"><QuickAnswer text={quick} /></div></section>
  <section class="section"><div class="wrap">
    <div class="cluster-grid">
      {clusters.map(c => (
        <a class="cluster-tile" href={`/clusters/${c.id}/`}>
          <span class="ct-intent">{intentById(c.primaryIntent as any)?.name ?? c.primaryIntent}</span>
          <strong>{c.name}</strong>
          <span class="ct-desc">{c.description}</span>
          <span class="ct-meta">{rowById[c.id]?.entities ?? 0} entities · {rowById[c.id]?.related ?? 0} linked clusters</span>
        </a>
      ))}
    </div>
    <p style="margin-top:1.2rem"><a class="btn btn-outline" href="/clusters/graph.json">Cluster graph JSON →</a> <a class="btn btn-outline" href="/knowledge/">Knowledge graph →</a></p>
  </div></section>
</BaseLayout>
<style>
.cluster-grid{display:grid;gap:.9rem;grid-template-columns:repeat(auto-fill,minmax(260px,1fr))}
.cluster-tile{display:flex;flex-direction:column;gap:.3rem;padding:1.1rem;border:1px solid var(--border);border-radius:12px;background:var(--wash);color:var(--text);transition:.15s}
.cluster-tile:hover{border-color:var(--brand);transform:translateY(-2px)}
.cluster-tile strong{font-size:1.05rem}
.ct-intent{font-size:.66rem;text-transform:uppercase;letter-spacing:.07em;color:var(--brand);font-weight:700}
.ct-desc{font-size:.85rem;color:var(--text-m)}
.ct-meta{font-size:.76rem;color:var(--text-l);margin-top:.2rem}
</style>
