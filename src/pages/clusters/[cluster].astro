---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import Card from '../../components/Card.astro';
import EntitySnapshot from '../../components/EntitySnapshot.astro';
import EntityLinks from '../../components/EntityLinks.astro';
import TravelStats from '../../components/TravelStats.astro';
import { getCollection } from 'astro:content';
import { clusters, clusterById } from '../../data/clusters';
import { clusterEntities, clusterRelations } from '../../lib/clusters';
import { intentById } from '../../data/intents';
import { entityUrl, collectionPageNode } from '../../lib/entitySchema';

export async function getStaticPaths() {
  return clusters.map(c => ({ params: { cluster: c.id }, props: { cluster: c } }));
}
const { cluster } = Astro.props;
const site = (Astro.site?.toString() || 'https://algeriacompass.com').replace(/\/$/, '');
const ents = clusterEntities(cluster.id);
const rels = clusterRelations(cluster.id);
const snapshots = ents.slice(0, 6).map(x => x.entity);

const TYPE_LABEL = {
  unesco:'UNESCO sites','roman-site':'Roman sites','islamic-site':'Islamic heritage','ottoman-site':'Ottoman heritage',
  'french-site':'Colonial heritage','historical-building':'Monuments',museum:'Museums',city:'Towns','national-park':'National parks',
  'sahara-area':'Desert regions','mountain-area':'Mountains','coast-area':'Coast','historical-period':'Historical periods',
  tradition:'Traditions',food:'Food',architecture:'Architecture',festival:'Festivals',season:'Seasons',transport:'Transport',
  accommodation:'Where to stay','travel-style':'Travel styles',province:'Provinces',
};
const groups = {};
for (const x of ents) { (groups[x.entity.type] ||= []).push({ name:x.entity.name, href:entityUrl(site, x.entity) }); }
const entityGroups = Object.entries(groups).map(([t, items]) => ({ label: TYPE_LABEL[t] || t, items }));

const belongs = (e) => { const d=e.data; return d.cluster===cluster.id || d.primaryCluster===cluster.id || (d.secondaryClusters||[]).includes(cluster.id); };
const [provs, dests, exps, arts, qs] = await Promise.all(['province','destination','experience','article','question'].map(c => getCollection(c)));
const provC = provs.filter(belongs), destC = dests.filter(belongs), expC = exps.filter(belongs), artC = arts.filter(belongs), qC = qs.filter(belongs);
const contentCount = provC.length+destC.length+expC.length+artC.length+qC.length;

const intent = intentById(cluster.primaryIntent);
const quick = `${cluster.name} is one of Algeria Compass's ${clusters.length} content clusters: ${cluster.description} It connects ${ents.length} knowledge-graph entities with ${contentCount} page(s) and links to ${rels.length} related clusters.`;
const stats = [
  { value:String(ents.length), label:'entities' },
  { value:String(contentCount), label:'pages' },
  { value:String(rels.length), label:'linked clusters' },
  { value:intent?.name ?? cluster.primaryIntent, label:'primary intent' },
];
const url = `/clusters/${cluster.id}/`;
const collection = collectionPageNode(site, url, cluster.name, cluster.description, ents.map(x=>x.entity));
const defined = { '@type':'DefinedTerm','@id':`${site}${url}#cluster`, name:cluster.name, description:cluster.purpose,
  inDefinedTermSet:{'@type':'DefinedTermSet','@id':`${site}/clusters/#set`, name:'Algeria Compass content clusters'} };
const breadcrumb = { '@type':'BreadcrumbList', itemListElement:[
  {'@type':'ListItem',position:1,name:'Home',item:`${site}/`},
  {'@type':'ListItem',position:2,name:'Clusters',item:`${site}/clusters/`},
  {'@type':'ListItem',position:3,name:cluster.name,item:`${site}${url}`}]};
---
<BaseLayout title={`${cluster.name} — Cluster`} description={cluster.description} schema={[collection, defined, breadcrumb]}>
  <Hero title={cluster.name} eyebrow="Content cluster" text={cluster.purpose} image="/images/sahara-dunes-tadrart.jpg" alt={cluster.name} />
  <section class="section"><div class="wrap" style="max-width:860px">
    <QuickAnswer text={quick} />
    <TravelStats stats={stats} />
    <dl class="cluster-facts">
      <dt>Audience</dt><dd>{cluster.audience}</dd>
      <dt>Authority goal</dt><dd>{cluster.authorityGoal}</dd>
      <dt>Conversion goal</dt><dd>{cluster.conversionGoal}</dd>
      <dt>Intents</dt><dd>{cluster.intents.join(', ')}</dd>
      <dt>Supporting types</dt><dd>{cluster.supportingTypes.join(', ')}</dd>
      {cluster.knowledgeHub && <><dt>Knowledge hub</dt><dd><a href={`/knowledge/${cluster.knowledgeHub}/`}>/knowledge/{cluster.knowledgeHub}/</a></dd></>}
    </dl>
  </div></section>

  {snapshots.length > 0 && (
    <section class="section"><div class="wrap">
      <h2>Anchor entities</h2>
      <div class="snapshot-grid">{snapshots.map(e => <EntitySnapshot entity={e} href={entityUrl(site, e)} />)}</div>
    </div></section>
  )}

  <EntityLinks groups={entityGroups} heading="Entities in this cluster" />

  {contentCount > 0 && (
    <section class="section"><div class="wrap">
      <h2>Pages in this cluster</h2>
      {provC.length>0 && <><h3 class="grp">Provinces</h3><div class="grid grid-3">{provC.map(p => <Card href={`/provinces/${p.slug}/`} title={p.data.name} image={p.data.image} alt={p.data.imageAlt} tag={p.data.region} text={p.data.quickAnswer} />)}</div></>}
      {destC.length>0 && <><h3 class="grp">Destinations</h3><div class="grid grid-3">{destC.map(d => <Card href={`/destinations/${d.slug}/`} title={d.data.name} image={d.data.image} alt={d.data.imageAlt} tag={d.data.region} text={d.data.quickAnswer} />)}</div></>}
      {expC.length>0 && <><h3 class="grp">Journeys</h3><div class="grid grid-3">{expC.map(e => <Card href={`/experiences/${e.slug}/`} title={e.data.name} image={e.data.image} alt={e.data.imageAlt} tag={`${e.data.durationDays} days`} text={e.data.tagline} />)}</div></>}
      {artC.length>0 && <><h3 class="grp">Guides</h3><div class="grid grid-3">{artC.map(a => <Card href={`/blog/${a.slug}/`} title={a.data.title} image={a.data.image} alt={a.data.imageAlt} tag={a.data.category} text={a.data.excerpt} />)}</div></>}
      {qC.length>0 && <><h3 class="grp">Questions</h3><ul class="q-list">{qC.map(q => <li><a href={`/questions/${q.slug}/`}>{q.data.question}</a></li>)}</ul></>}
    </div></section>
  )}

  {rels.length > 0 && (
    <section class="section"><div class="wrap">
      <h2>Related clusters</h2>
      <div class="rel-clusters">{rels.map(r => (
        <a class="rc-pill" href={`/clusters/${r.cluster.id}/`}>{r.cluster.name}{r.shared>0 && <span> · {r.shared} shared</span>}</a>
      ))}</div>
    </div></section>
  )}

  <section class="section"><div class="wrap" style="text-align:center"><a class="btn" href="/clusters/">← All clusters</a></div></section>
</BaseLayout>
<style>
.cluster-facts{display:grid;grid-template-columns:auto 1fr;gap:.3rem 1rem;margin:1.2rem 0 0;font-size:.9rem}
.cluster-facts dt{color:var(--text-l)} .cluster-facts dd{margin:0}
.snapshot-grid{display:grid;gap:1rem;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));margin-top:1rem}
.grp{margin:1.4rem 0 .4rem;font-size:.8rem;text-transform:uppercase;letter-spacing:.06em;color:var(--text-l)}
.q-list{margin:0;padding-left:1.1rem}.q-list li{margin:.3rem 0}
.rel-clusters{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1rem}
.rc-pill{padding:.34rem .8rem;border:1px solid var(--border);border-radius:999px;font-size:.85rem;background:var(--wash);color:var(--text)}
.rc-pill:hover{border-color:var(--brand)} .rc-pill span{color:var(--text-l)}
</style>
