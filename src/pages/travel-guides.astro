---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import CtaSection from '../components/CtaSection.astro';
---
<BaseLayout title="Algeria Travel Guides | Algeria Compass" description="Practical, in-depth guides to planning a trip to Algeria — visas, safety, when to go, regions and routes." image="/assets/img/mzab-ghardaia-panorama.jpg" keywords={["Algeria travel guide","Algeria visa","best time to visit Algeria","Algeria travel tips","Algeria itineraries"]} region="highlands">
  <Hero title="Algeria Travel Guides" eyebrow="Knowledge hub" text="Practical, in-depth guides to planning a trip to Algeria — visas, safety, when to go, regions and routes." image="/assets/img/mzab-ghardaia-panorama.jpg" alt="Panorama of a Saharan oasis town" />
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Algeria Travel Guides'}]} />
  <section class="section"><div class="wrap" style="max-width:820px">
    <QuickAnswer text="Planning a trip to Algeria is easier than its reputation suggests. These guides cover the practical essentials — visas, safety, the best time to visit by region, money, transport and suggested routes — so you can travel the country with confidence." />
    <div class="prose">
      <p>This is the practical, reference side of the site: step-by-step planning for visas and entry, current safety guidance, when to go by region, budgeting, transport and ready-made routes. For the stories, history and food behind the country, read <a href="/blog/">The Algeria Journal</a>.</p>
      <h2>Explore further</h2>
      <ul><li><a href="/questions/is-algeria-safe/">Is Algeria safe?</a></li><li><a href="/questions/do-i-need-a-visa-for-algeria/">Do I need a visa?</a></li><li><a href="/blog/best-time-to-visit-algeria/">Best time to visit</a></li></ul>
    </div>
  </div></section>
  <CtaSection />
</BaseLayout>
