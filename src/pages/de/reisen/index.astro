---
// French tours index. Cards are fully translated for every tour; a tour links to
// its French detail page when one exists, otherwise to the English page, which
// is honest rather than shipping a half-translated page.
import AlgeriaMap from '../../../components/AlgeriaMap.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TourFilters from '../../../components/TourFilters.astro';
import RecentTours from '../../../components/RecentTours.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import data from '../../../data/tours.json';
import { TOUR_VISUALS } from '../../../data/tour-visuals';
import { TOURS_DE } from '../../../data/tours-de';
import { alternatesFor } from '../../../i18n';

const site = (Astro.site?.toString() || 'https://algeriacompass.com').replace(/\/$/, '');
const tours = (((data as any).tours || data) as any[]);
const currency = (data as any).currency || 'EUR';

const rows = tours.map(t => {
  const fr = TOURS_DE[t.id];
  const v = TOUR_VISUALS[t.id] || { hero: `${t.image_slugs[0]}-1.jpg`, accent: '#0B3D2E' };
  return {
    tour: t,
    id: t.id,
    href: fr?.full ? `/de/reisen/${t.id}/` : `/tours/${t.id}/`,
    germanPage: !!fr?.full,
    title: fr?.title || t.title,
    duration: fr?.duration || t.duration,
    hook: fr?.hook || t.summary,
    price: t.price_eur,
    hero: v.hero,
    accent: v.accent,
  };
});

const title = "Private Algerien-Reisen — Rundreisen nach Maß";
const description = "Unsere privaten Algerien-Reisen: Sahara und Tadrart, M'Zab-Tal, römische Städte, Algier und die Küste. Lizenzierter algerischer Veranstalter.";
const alternates = alternatesFor(site, { en: '/tours/', fr: '/fr/circuits/', it: '/it/circuiti/', es: '/es/circuitos/', de: '/de/reisen/' });
const itemList = {
  '@type': 'ItemList',
  '@id': `${site}/de/reisen/#reisen`,
  name: 'Private Algerien-Reisen',
  numberOfItems: rows.length,
  itemListElement: rows.map((r, i) => ({
    '@type': 'ListItem', position: i + 1, name: r.title, url: site + r.href,
  })),
};
const collection = {
  '@type': 'CollectionPage',
  '@id': `${site}/de/reisen/#collection`,
  name: 'Private Algerien-Reisen',
  description,
  inLanguage: 'de',
  url: `${site}/de/reisen/`,
  isPartOf: { '@id': `${site}/#website` },
  about: { '@id': `${site}/#algeria` },
  mainEntity: { '@id': `${site}/de/reisen/#reisen` },
};
---
<BaseLayout title={title} description={description} lang="de" alternates={alternates}
  image="/assets/img/tours/djanet-1.jpg" schema={[collection, itemList]}
  keywords={["Algerien Reise","Algerien Rundreise","Sahara Reise Algerien","Algerien Studienreise","Reiseveranstalter Algerien"]}>
  <section class="hero" style="min-height:42vh">
    <img src="/assets/img/tours/djanet-1.jpg" alt="Dünen der algerischen Sahara bei Djanet" width="1600" height="900" fetchpriority="high" />
    <div class="hero-in wrap">
      <div class="eyebrow">{rows.length} private Reisen</div>
      <h1>Private Algerien-Reisen</h1>
      <p>Private, geführte Reisen durch ganz Algerien — von der tiefen Sahara zu den römischen Städten des Nordens und an die Mittelmeerküste.</p>
    </div>
  </section>

  <AlgeriaMap lang="de" />

  <Breadcrumbs items={[{name:'Start',href:'/de/'},{name:'Reisen'}]} />

  <section class="section"><div class="wrap">
    <p class="fr-intro">
      Algeria Compass ist ein <strong>lizenzierter algerischer Reiseveranstalter</strong> mit Sitz in Algier.
      Alle unsere Reisen sind <strong>privat</strong>: Ihr Guide, Ihr Fahrzeug, Ihr Tempo — nichts wird mit
      anderen Gruppen geteilt. Wir stellen die Einladung und das bestätigte Programm, die die Konsulate für
      das <a href="/de/visum-algerien/">algerische Visum</a> verlangen, und unsere Guides sprechen Deutsch.
      Zur Wahl des Zeitraums siehe <a href="/de/beste-reisezeit-algerien/">beste Reisezeit für Algerien</a>.
    </p>

    <RecentTours lang="de" inline />
    <TourFilters lang="de" rows={rows.map((r) => ({ tour: r.tour, href: r.href, title: r.title, hook: r.hook, duration: r.duration, englishOnly: !r.germanPage }))} />

    <p class="fr-note">
      Reisen ohne ausführliche deutsche Seite sind auf Englisch beschrieben, werden aber wie alle anderen
      gebucht und organisiert. Schreiben Sie uns auf Deutsch:
      <a href="/de/kontakt/">Kontaktformular</a> oder WhatsApp.
    </p>
  </div></section>
</BaseLayout>

<style>
  .fr-intro{max-width:780px;color:var(--text-m);margin-bottom:1.6rem}
  .fr-intro a,.fr-note a{text-decoration:underline;text-underline-offset:2px}
  .fr-note{max-width:780px;color:var(--text-l);font-size:.88rem;margin-top:2rem;padding-top:1.2rem;border-top:1px solid var(--border)}
</style>
