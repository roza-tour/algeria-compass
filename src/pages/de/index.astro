---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { alternatesFor } from '../../i18n';
const site = Astro.site?.toString().replace(/\/$/, '') || 'https://algeriacompass.com';
const alternates = alternatesFor(site, { en: '/', fr: '/fr/', it: '/it/', es: '/es/', de: '/de/' });
const title = "Algerien-Reisen — private Rundreisen mit lokalen Guides";
const description = "Algeria Compass, lizenzierter algerischer Reiseveranstalter: private Kultur- und Sahara-Reisen nach Maß, Unterstützung beim Visum und lokale Guides.";
const schema = [{
  '@type': 'WebPage', '@id': `${site}/de/#webpage`,
  name: title, description, inLanguage: 'de', url: `${site}/de/`,
  isPartOf: { '@id': `${site}/#website` }, about: { '@id': `${site}/#algeria` },
}];
---
<BaseLayout title={title} description={description} lang="de" alternates={alternates} type="website" sticky={true} schema={schema}
  keywords={["Algerien Reise","Algerien Rundreise","Algerien Studienreise","algerische Sahara","Visum Algerien"]}>
  <section class="section">
    <div class="wrap" style="max-width:820px">
      <span class="eyebrow">Lizenzierter algerischer Reiseveranstalter</span>
      <h1 style="font-size:clamp(1.9rem,4.5vw,3rem);margin:.4rem 0 .8rem">Algerien mit denen bereisen, die es wirklich kennen</h1>
      <p style="font-size:1.1rem;color:var(--text-l);line-height:1.7">
        Von der Mittelmeerküste zu den römischen Städten des Ostens, von den Tälern des M'Zab zu den Hochebenen
        des Tassili n'Ajjer: Algeria Compass plant und begleitet private Reisen durch das größte Land Afrikas —
        mit algerischen Guides vor Ort, Unterstützung beim Visum und echter Geländekenntnis.
      </p>
      <p style="margin-top:1.4rem">
        <a class="btn btn-gold" href="/contact/">Angebot anfordern</a>
        <a class="btn" href="/de/reisen/" style="margin-inline-start:.5rem">Reisen ansehen</a>
      </p>
    </div>
  </section>

  <section class="section" style="background:var(--wash)">
    <div class="wrap">
      <span class="eyebrow">Unsere Reisen</span>
      <h2>Wie Sie Algerien entdecken</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.1rem;margin-top:1rem">
        <div class="card" style="padding:1.1rem">
          <h3 style="margin:.2rem 0">Kultur- und Geschichtsreisen</h3>
          <p style="color:var(--text-l)">Algier und die Kasbah, die römischen Städte Timgad und Djémila, Constantine, das andalusische Tlemcen.</p>
          <a href="/de/reisen/">Reisen entdecken →</a>
        </div>
        <div class="card" style="padding:1.1rem">
          <h3 style="margin:.2rem 0">Sahara-Expeditionen</h3>
          <p style="color:var(--text-l)">Djanet und das Tassili n'Ajjer, das Hoggar, Timimoun und die Oasen — geführte 4×4-Expeditionen im Winter.</p>
          <a href="/de/sahara-algerien/">Sahara-Ratgeber →</a>
        </div>
        <div class="card" style="padding:1.1rem">
          <h3 style="margin:.2rem 0">Maßgeschneiderte Luxusreisen</h3>
          <p style="color:var(--text-l)">Private Programme der gehobenen Klasse, entworfen rund um Ihre Termine und Interessen.</p>
          <a href="/luxury/">Luxusreisen →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap" style="max-width:820px">
      <span class="eyebrow">Die Reise vorbereiten</span>
      <h2>Praktische Ratgeber auf Deutsch</h2>
      <p style="color:var(--text-l)">Beginnen Sie mit dem kompletten Reiseführer und vertiefen Sie dann Visum, Sicherheit, Jahreszeiten und Sahara.</p>
      <ul class="prose" style="line-height:2">
        <li><a href="/de/algerien-reisefuehrer/"><strong>Kompletter Algerien-Reiseführer</strong></a></li>
        <li><a href="/de/visum-algerien/">Visum für Algerien</a></li>
        <li><a href="/de/sicherheit-algerien/">Ist Algerien sicher?</a></li>
        <li><a href="/de/beste-reisezeit-algerien/">Beste Reisezeit für Algerien</a></li>
        <li><a href="/de/sahara-algerien/">Die algerische Sahara</a></li>
      </ul>
      <p style="margin-top:1rem;color:var(--text-l)">
        Sehen Sie auch die <a href="/de/reiseziele/">Reiseziele</a> — die sieben UNESCO-Stätten und die Städte,
        die einer Reise als Basis dienen.
      </p>
    </div>
  </section>

  <section class="section" style="background:var(--wash)">
    <div class="wrap" style="max-width:820px">
      <span class="eyebrow">Warum wir</span>
      <h2>Ein lokaler Veranstalter, kein Vermittler</h2>
      <p style="color:var(--text-l);line-height:1.75">
        Wir sind eine lizenzierte algerische Agentur mit Sitz in Algier. Das bedeutet drei konkrete Dinge:
        Wir stellen <strong>Einladung und bestätigtes Programm</strong>, die die Konsulate für das Visum verlangen;
        die Genehmigungen für den tiefen Süden laufen über uns und nicht über eine Kette von Subunternehmern;
        und Guides, Fahrer und Wüstenteams sind Menschen, mit denen wir arbeiten, keine anonymen Zulieferer.
      </p>
      <p style="margin-top:1.2rem">
        <a class="btn btn-gold" href="/contact/">Erzählen Sie uns von Ihrer Reise</a>
      </p>
    </div>
  </section>
</BaseLayout>
