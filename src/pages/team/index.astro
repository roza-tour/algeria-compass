---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
const team = (await getCollection('team')).sort((a,b)=>a.data.order-b.data.order);
const site=(Astro.site?.toString()||'https://algeriacompass.com').replace(/\/$/,'');
const schema=[{"@type":"CollectionPage","@id":site+"/team/#page","name":"Editorial Team","about":{"@id":site+"/#organization"},"isPartOf":{"@id":site+"/#website"}}];
---
<BaseLayout title="Editorial Team — Who Writes Algeria Compass" description="Meet the Algeria Compass editorial team that researches, writes and maintains our Algeria travel guides." schema={schema}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Editorial',href:'/editorial/'},{name:'Team'}]} />
  <section class="section"><div class="wrap" style="max-width:820px">
    <div class="eyebrow">Editorial</div>
    <h1>Our editorial team</h1>
    <p style="color:var(--text-m)">The people who research, write and maintain Algeria Compass. Every guide on this site is produced and verified through our <a href="/editorial/content-review-process/">editorial process</a>.</p>
    <div class="policy-list">
      {team.map(t => (<a href={`/team/${t.slug}/`}><div class="pt">{t.data.name}</div><div class="ps">{t.data.role} — {t.data.shortBio}</div></a>))}
    </div>
    <p style="margin-top:1.4rem;font-size:.9rem;color:var(--text-l)">As our team grows, individual writers will be credited by name on the work they produce. See also <a href="/reviewers/">our review function</a>.</p>
  </div></section>
</BaseLayout>
