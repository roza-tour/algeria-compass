---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { authorNode } from '../../lib/authorship';
export async function getStaticPaths(){
  const team = await getCollection('team');
  return team.map(item=>({ params:{slug:item.slug}, props:{item} }));
}
const { item } = Astro.props; const d=item.data; const { Content } = await item.render();
const site=(Astro.site?.toString()||'https://algeriacompass.com').replace(/\/$/,'');
const entity = authorNode(site, item);
const schema=[{"@type":"ProfilePage","@id":site+`/team/${item.slug}/#profilepage`,"name":d.name,"about":{"@id":site+"/#organization"},"isPartOf":{"@id":site+"/#website"},"mainEntity":entity}];
const def=[["Role",d.role],["Research focus",d.researchFocus],["Languages",(d.languages||[]).join(', ')],["Regions",(d.regions||[]).join(', ')]].filter(x=>x[1]);
---
<BaseLayout title={(d.seo?.title)||`${d.name} — Algeria Compass`} description={d.seo?.description||d.shortBio} schema={schema}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Editorial',href:'/editorial/'},{name:'Team',href:'/team/'},{name:d.name}]} />
  <section class="section"><div class="wrap" style="max-width:820px">
    <div class="profile-head">
      {d.image && <img src={d.image} alt={d.name} width="96" height="96" />}
      <div><div class="eyebrow">{d.kind==='team'?'Editorial team':'Author'}</div><h1 style="margin:.2rem 0">{d.name}</h1><p style="color:var(--text-m);margin:0">{d.role}</p></div>
    </div>
    <p style="margin-top:1rem;color:var(--text-m)">{d.shortBio}</p>
    {def.length>0 && <div class="def-grid">{def.map(([k,v])=> <div><div class="k">{k}</div><div class="v">{v}</div></div>)}</div>}
    {d.expertise?.length>0 && (<><h2>Areas of expertise</h2><div class="chips-list">{d.expertise.map((e:string)=> <span>{e}</span>)}</div></>)}
    {d.specializations?.length>0 && (<><h2>Specialisations</h2><div class="chips-list">{d.specializations.map((e:string)=> <span>{e}</span>)}</div></>)}
    {d.methodology && (<><h2>Methodology</h2><p style="color:var(--text-m)">{d.methodology}</p></>)}
    {d.researchStandards && (<><h2>Research standards</h2><p style="color:var(--text-m)">{d.researchStandards}</p></>)}
    {d.credentials?.length>0 && (<><h2>Credentials</h2><ul class="prose">{d.credentials.map((c:string)=> <li>{c}</li>)}</ul></>)}
    <article class="prose"><Content /></article>
    <p style="margin-top:1.2rem;font-size:.9rem;color:var(--text-l)">Contact: {d.email||'editorial@algeriacompass.com'} · Standards: <a href="/editorial/">Editorial standards</a></p>
  </div></section>
</BaseLayout>
