---
// Spanish destinations index — the seven UNESCO sites plus the cities that
// anchor a trip. Photography is read from the English collection so both
// language versions show the same place.
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { DESTINATIONS_ES } from '../../../data/destinations-es';
import { alternatesFor } from '../../../i18n';

const site = (Astro.site?.toString() || 'https://algeriacompass.com').replace(/\/$/, '');
const en = await getCollection('destination');
const rows = DESTINATIONS_ES.map(d => ({
  ...d,
  image: en.find(e => e.slug === d.en)?.data?.image || '/assets/img/brand-algeria.jpg',
}));

const title = "Destinos en Argelia: sitios UNESCO e imprescindibles";
const description = "Los destinos que ver en Argelia: los siete sitios UNESCO — Timgad, Djémila, Tipaza, el valle del M'Zab, la Casbah, el Tassili, Beni Hammad — y más.";
const alternates = alternatesFor(site, { en: '/destinations/', fr: '/fr/destinations/', it: '/it/destinazioni/', es: '/es/destinos/', de: '/de/reiseziele/' });
const itemList = {
  '@type': 'ItemList',
  '@id': `${site}/es/destinos/#lista`,
  name: 'Destinos en Argelia',
  numberOfItems: rows.length,
  itemListElement: rows.map((r, i) => ({
    '@type': 'ListItem', position: i + 1, name: r.name,
    url: `${site}/es/destinos/${r.slug}/`,
  })),
};
const collection = {
  '@type': 'CollectionPage',
  '@id': `${site}/es/destinos/#collection`,
  name: 'Destinos en Argelia', description, inLanguage: 'es',
  url: `${site}/es/destinos/`,
  isPartOf: { '@id': `${site}/#website` },
  about: { '@id': `${site}/#algeria` },
  mainEntity: { '@id': `${site}/es/destinos/#lista` },
};
---
<BaseLayout title={title} description={description} lang="es" alternates={alternates}
  image="/assets/img/timgad-trajan-arch.jpg" schema={[collection, itemList]}
  keywords={["destinos Argelia","qué ver en Argelia","sitios UNESCO Argelia","Timgad","valle del M'Zab","Tassili n'Ajjer"]}>

  <section class="hero" style="min-height:42vh">
    <img src="/assets/img/timgad-trajan-arch.jpg" alt="El arco de Trajano en Timgad, ciudad romana Patrimonio de la UNESCO en Argelia" width="1600" height="900" fetchpriority="high" />
    <div class="hero-in wrap">
      <div class="eyebrow">7 sitios UNESCO · {rows.length} destinos</div>
      <h1>Qué ver en Argelia</h1>
      <p>Ciudades romanas entre las mejor conservadas del mundo, cinco ksour saharianos del siglo XI, una medina otomana y uno de los mayores conjuntos de arte rupestre del planeta.</p>
    </div>
  </section>

  <Breadcrumbs items={[{name:'Inicio',href:'/es/'},{name:'Destinos'}]} />

  <section class="section"><div class="wrap">
    <p class="fr-intro">
      Argelia cuenta con <strong>siete sitios inscritos en el Patrimonio Mundial de la UNESCO</strong> y
      casi ningún turismo de masas: es normal recorrer Timgad o Djémila cruzándose con un puñado de
      visitantes. Cada destino de abajo se visita dentro de un
      <a href="/es/circuitos/">circuito privado</a>, con guía autorizado.
    </p>

    <div class="fr-grid">
      {rows.map((r, i) => (
        <a class="dcard" href={`/es/destinos/${r.slug}/`}>
          <div class="dcard-img">
            <img src={r.image} alt={r.name} width="400" height="250" loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
          </div>
          <div class="dcard-body">
            <span class="dcard-eyebrow">{r.eyebrow}</span>
            <h2>{r.name}</h2>
            <p>{r.intro}</p>
          </div>
        </a>
      ))}
    </div>
  </div></section>
</BaseLayout>

<style>
  .fr-intro{max-width:780px;color:var(--text-m);margin-bottom:1.6rem}
  .fr-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.4rem}
  .dcard{display:flex;flex-direction:column;background:var(--card);border:1px solid var(--border);border-radius:14px;overflow:hidden;color:var(--text);box-shadow:0 2px 14px rgba(7,38,28,.06)}
  .dcard:hover{transform:translateY(-3px);transition:.18s;border-color:var(--gold);text-decoration:none}
  .dcard-img{aspect-ratio:16/10;background:var(--wash)}
  .dcard-img img{width:100%;height:100%;object-fit:cover;display:block}
  .dcard-body{display:flex;flex-direction:column;gap:.35rem;padding:1rem 1.1rem 1.2rem}
  .dcard-eyebrow{font-size:.7rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--accent,var(--brand-green))}
  .dcard-body h2{font-size:1.08rem;margin:0}
  .dcard-body p{font-size:.88rem;line-height:1.55;color:var(--text-m);margin:0}
</style>
