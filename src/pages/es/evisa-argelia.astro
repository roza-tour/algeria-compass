---
// Versión española de la página « e-Visa & Entry » (/evisa/). Mismo contenido:
// no existe un e-Visa turístico general; dos vías — visado consular o el
// e-Visa sahariano (visado a la llegada) para programas saharianos organizados.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaSection from '../../components/CtaSection.astro';
import { CONTACT } from '../../config';
import { alternatesFor } from '../../i18n';

const site = (Astro.site?.toString() || 'https://algeriacompass.com').replace(/\/$/, '');
const url = `${site}/es/evisa-argelia/`;
const alternates = alternatesFor(site, {
  en: '/evisa/',
  fr: '/fr/evisa-algerie/',
  it: '/it/evisa-algeria/',
  es: '/es/evisa-argelia/',
  de: '/de/evisa-algerien/',
});

const title = "e-Visa y entrada a Argelia: cómo funciona | Algeria Compass";
const description = "La verdad sobre la entrada a Argelia: no hay e-Visa turístico general. Las vías: visado consular o visado a la llegada para circuitos organizados del Sáhara.";

const breadcrumb = { '@type':'BreadcrumbList', itemListElement:[
  {'@type':'ListItem',position:1,name:'Inicio',item:`${site}/es/`},
  {'@type':'ListItem',position:2,name:'e-Visa y entrada',item:url}]};
const faqs = [
  { q: '¿Qué es el e-Visa sahariano?', a: 'Es el documento de autorización de visado que preparamos para los viajeros de un programa sahariano organizado. Como turoperador argelino autorizado, emitimos una autorización con un código QR verificable en el portal del Ministerio del Interior argelino. El visado en sí lo conceden las autoridades argelinas — su etiqueta/sello se emite a la llegada; nosotros gestionamos cada expediente con antelación.' },
  { q: '¿Cuánto cuesta el e-Visa sahariano?', a: 'El documento de autorización de visado cuesta 40 €. La preparación de todos los expedientes requeridos es completamente gratuita por nuestra parte. A la llegada se paga a las autoridades una tasa aparte por la etiqueta/sello del visado — el importe depende de su nacionalidad, y le comunicamos la cifra antes de viajar.' },
  { q: '¿Puedo visitar también el norte, o solo el desierto?', a: 'Ambos. Con nuestro apoyo, un solo viaje puede combinar el norte y el sur, siempre que aproximadamente la mitad del recorrido transcurra en una provincia sahariana (wilaya). Diseñamos el itinerario para que cumpla ese requisito.' },
  { q: '¿El documento de autorización es oficial y verificable?', a: 'Sí. Lleva un código QR que puede comprobarse en el portal del Ministerio del Interior argelino. La emisión sigue los canales oficiales — nosotros somos su socio documental; las autoridades argelinas emiten el visado.' },
  { q: '¿Necesito reservar un circuito completo para obtenerlo?', a: 'Sí. La autorización del e-Visa sahariano está disponible cuando reserva un programa completo con nosotros — forma parte de la organización de su viaje organizado, no es un servicio independiente.' },
  { q: '¿Tiene Argelia un e-Visa para turistas?', a: 'No existe un e-Visa turístico general en línea para viajar de forma ordinaria a Argelia. Las dos vías prácticas son un visado turístico en su consulado argelino local, o — para circuitos organizados por el Sáhara que entran por el sur — la autorización de visado sahariana que preparamos, con la etiqueta emitida a la llegada. En ambos casos nos ocupamos del papeleo.' },
  { q: '¿Cómo se entra realmente en Argelia?', a: 'La mayoría de los visitantes vuela a Argel (u otro aeropuerto del norte) con un visado turístico consular, respaldado por nuestra carta de invitación. Los viajeros de un programa sahariano organizado pueden usar en su lugar nuestra vía de autorización de visado, con la etiqueta emitida a la llegada en los aeropuertos de entrada del sur. Nosotros le confirmamos cuál se aplica en su caso.' },
];
const faqSchema = { '@type':'FAQPage', '@id':`${url}#faq`, inLanguage:'es',
  mainEntity: faqs.map(f => ({ '@type':'Question', name:f.q, acceptedAnswer:{ '@type':'Answer', text:f.a } })) };
---
<BaseLayout
  title={title}
  description={description}
  lang="es"
  alternates={alternates}
  image="/assets/img/algiers-great-mosque.jpg"
  keywords={["e-Visa Argelia","visado a la llegada Argelia","entrada a Argelia","visado turístico Argelia","visado Argelia online"]}
  schema={[breadcrumb, faqSchema]}>
  <Breadcrumbs items={[{name:'Inicio',href:'/es/'},{name:'e-Visa y entrada'}]} />
  <section class="section"><div class="wrap" style="max-width:780px">
    <div class="eyebrow">Entrada a Argelia</div>
    <h1>e-Visa y entrada a Argelia</h1>
    <div class="prose" style="margin-top:1rem">
      <p>Los viajeros suelen buscar un "e-Visa para Argelia". Esta es la imagen honesta, para que planifique sobre hechos y no sobre esperanzas.</p>

      <h2>¿Existe un e-Visa para Argelia?</h2>
      <p>Para el turismo ordinario, <strong>no existe un e-Visa general en línea</strong> que se pueda simplemente solicitar e imprimir. La entrada turística a Argelia funciona a través de dos vías establecidas — y nosotros le apoyamos en ambas, gratis, con cada reserva.</p>

      <h2>Vía 1 — Visado turístico consular (el norte y la mayoría de los viajes)</h2>
      <p>Usted solicita un visado turístico en el <strong>consulado argelino</strong> que corresponde a su país, normalmente en persona. Los consulados exigen una <strong>carta de invitación / bono turístico</strong> de una agencia argelina autorizada — que nosotros le emitimos, junto con su confirmación de hotel y circuito y una lista de requisitos para su nacionalidad. Calcule aproximadamente <strong>de dos a cuatro semanas</strong>.</p>

      <h2>Vía 2 — El e-Visa sahariano (programas organizados en el desierto)</h2>
      <p>Es lo más parecido a una vía "en línea". Para un <strong>programa sahariano organizado</strong>, preparamos con antelación un <strong>documento de autorización de visado</strong> — sin necesidad de acudir al consulado — y su etiqueta de visado se emite a la llegada en los aeropuertos de entrada del sur. Está <strong>abierto a viajeros de cualquier nacionalidad</strong>, pero únicamente en viajes saharianos organizados. <a href="#saharan-evisa">Vea exactamente cómo funciona el e-Visa sahariano ↓</a></p>

      <h2>Cómo encaja nuestra asistencia de visado</h2>
      <p>Sea cual sea la vía que le corresponda, preparamos la documentación que los consulados y las autoridades esperan, gratis con su reserva — consulte <a href="/es/asistencia-visado-argelia/">Asistencia de visado</a> para el detalle completo y los documentos requeridos, y los <a href="/es/visado-llegada-argelia/">requisitos de visado para Argelia</a> para una comparación lado a lado de las dos vías. Somos su socio documental; el visado lo emite el consulado o el gobierno.</p>

      <h2>Verifique antes de viajar</h2>
      <p>Las normas de entrada a Argelia <strong>varían según la nacionalidad y cambian con el tiempo</strong>. Confirme siempre los requisitos vigentes con su consulado argelino oficial, e indíquenos su nacionalidad para que podamos decirle exactamente qué vía — visado consular o visado a la llegada por el sur — encaja con su viaje.</p>

      <p style="color:var(--text-l);font-size:.9rem">¿No está seguro de cuál es su vía? <a href="/es/contacto/">Pregúntenos</a> o escríbanos por <a href={`https://wa.me/${CONTACT.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a> — se lo confirmamos y le enviamos su lista de requisitos.</p>
      <!-- OWNER: si Argelia introduce un portal oficial de e-Visa turístico, enlácelo aquí y actualice el planteamiento de las vías. -->
    </div>
  </div></section>

  <!-- ===== Explicación del e-Visa sahariano (P7) ===== -->
  <section class="section sev" id="saharan-evisa" data-region="sahara"><div class="wrap">
    <div class="sev-head">
      <span class="eyebrow">Para programas saharianos organizados</span>
      <h2>El e-Visa sahariano — cómo funciona</h2>
      <p class="sev-lede">Como <strong>turoperador argelino autorizado</strong>, podemos preparar su documento de autorización de visado para que pueda viajar por el sur de Argelia. La emisión sigue los canales oficiales: nosotros gestionamos cada expediente y las autoridades argelinas emiten el visado. Esto es exactamente lo que significa — y lo que cuesta.</p>
    </div>

    <ol class="sev-steps">
      <li>
        <span class="sev-n">1</span>
        <div><strong>Reserve un programa completo</strong>
        <p>La autorización del e-Visa sahariano está disponible cuando reserva un circuito completo con nosotros. Diseñamos su itinerario de modo que <strong>aproximadamente la mitad del viaje transcurra en una provincia sahariana (wilaya)</strong> — lo que le permite combinar el <strong>norte y el sur</strong> en un solo viaje.</p></div>
      </li>
      <li>
        <span class="sev-n">2</span>
        <div><strong>Preparamos todos los expedientes — gratis</strong>
        <p>Reunir todos los documentos requeridos es <strong>completamente gratuito por nuestra parte</strong>. Le indicamos con precisión qué enviar según su nacionalidad y montamos la solicitud por usted.</p></div>
      </li>
      <li>
        <span class="sev-n">3</span>
        <div><strong>Emitimos su autorización — 40 €</strong>
        <p>Usted recibe un <strong>documento de autorización de visado con un código QR</strong> que es <strong>verificable en el portal del Ministerio del Interior argelino</strong>. El documento cuesta <strong>40 €</strong>.</p></div>
      </li>
      <li>
        <span class="sev-n">4</span>
        <div><strong>Pague la tasa de la etiqueta a la llegada</strong>
        <p>A la llegada se paga una <strong>tasa por la etiqueta/sello del visado</strong> a las autoridades argelinas, que son quienes emiten el visado. El importe depende de su nacionalidad — le confirmamos la cifra antes de viajar.</p></div>
      </li>
    </ol>

    <div class="sev-facts">
      <div class="sev-fact"><span class="sev-fig">40 €</span><span class="sev-lab">Documento de autorización</span></div>
      <div class="sev-fact"><span class="sev-fig">Gratis</span><span class="sev-lab">Preparamos cada expediente</span></div>
      <div class="sev-fact"><span class="sev-fig">Verificado por QR</span><span class="sev-lab">En el portal del Ministerio del Interior</span></div>
      <div class="sev-fact"><span class="sev-fig">Norte + Sur</span><span class="sev-lab">≈ la mitad del viaje en una provincia sahariana</span></div>
    </div>

    <div class="sev-note">
      <p><strong>Una nota honesta:</strong> la tasa de la etiqueta del visado a la llegada es un cargo gubernamental, independiente de nuestra tarifa de 40 € por el documento, y las normas de entrada varían según la nacionalidad. Díganos su nacionalidad y le confirmaremos tanto su elegibilidad como la tasa exacta a la llegada antes de que se comprometa.</p>
    </div>

    <div class="sev-cta">
      <a class="btn btn-gold" href="/es/circuitos/">Ver circuitos saharianos →</a>
      <a class="btn btn-ghost" href={`https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent('Hola Algeria Compass, tengo una pregunta sobre el e-Visa sahariano.')}`} target="_blank" rel="noopener">💬 Pregunte por el e-Visa sahariano</a>
    </div>

    <div class="sev-faq">
      <h3>e-Visa sahariano — respuestas rápidas</h3>
      <div class="faq">
        {faqs.slice(0,5).map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </div>
  </div></section>

  <CtaSection lang="es" heading="Nosotros gestionamos el visado — usted disfruta del viaje" />
</BaseLayout>

<style>
  /* ===== Saharan e-Visa explainer (P7) ===== */
  .sev{
    background-color:#F3E7CF;
    background-image:url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'48'%20height%3D'48'%3E%3Cg%20fill%3D'none'%20stroke%3D'%23C2842B'%20stroke-width%3D'1'%20opacity%3D'.12'%3E%3Cpath%20d%3D'M24%203L45%2024L24%2045L3%2024Z'/%3E%3Ccircle%20cx%3D'24'%20cy%3D'24'%20r%3D'6'/%3E%3C/g%3E%3C/svg%3E"),
      linear-gradient(180deg,#FAF1DE,#F0E1C2);
    scroll-margin-top:80px;
  }
  .sev .eyebrow{color:#8A5314}
  .sev-head{max-width:780px}
  .sev h2{color:#7a4513;font-size:clamp(1.5rem,3vw,2.1rem);margin:.2rem 0 .5rem}
  .sev-lede{color:#574226;font-size:1.06rem;line-height:1.7;margin:0}
  .sev-steps{list-style:none;padding:0;margin:1.8rem 0 0;display:grid;grid-template-columns:1fr 1fr;gap:1rem}
  .sev-steps li{display:flex;gap:.85rem;background:#fffaf0;border:1px solid #e6cfa3;border-radius:14px;
    padding:1.05rem 1.15rem;box-shadow:0 6px 18px rgba(122,69,19,.07)}
  .sev-n{flex:0 0 auto;width:2rem;height:2rem;border-radius:50%;background:#8A5410;color:#fff;font-weight:800;
    display:flex;align-items:center;justify-content:center;font-size:.95rem}
  .sev-steps strong{display:block;color:#7a4513;font-size:1.04rem;margin-bottom:.2rem}
  .sev-steps p{margin:0;color:#534233;font-size:.9rem;line-height:1.55}
  .sev-facts{display:grid;grid-template-columns:repeat(4,1fr);gap:.9rem;margin:1.4rem 0 0}
  .sev-fact{background:#7a4513;color:#fff;border-radius:13px;padding:1rem .9rem;text-align:center}
  .sev-fig{display:block;font-family:var(--serif);font-size:1.5rem;font-weight:800;color:#F4D58A;line-height:1.1}
  .sev-lab{display:block;font-size:.78rem;color:rgba(255,255,255,.85);margin-top:.3rem;line-height:1.35}
  .sev-note{margin:1.3rem 0 0;background:#fff6e6;border:1px solid #e6cfa3;border-left:4px solid #8A5410;
    border-radius:10px;padding:.9rem 1.1rem}
  .sev-note p{margin:0;color:#534233;font-size:.92rem;line-height:1.6}
  .sev-cta{margin:1.5rem 0 0;display:flex;flex-wrap:wrap;gap:.7rem}
  .sev-cta .btn-gold{background:#8A5410;color:#fff}
  .sev-cta .btn-gold:hover{filter:brightness(1.08)}
  .sev-cta .btn-ghost{border-color:#8A5410;color:#7a4513}
  .sev-faq{margin:2rem 0 0;max-width:820px}
  .sev-faq h3{color:#7a4513;font-size:1.2rem;margin:0 0 .6rem}
  @media(max-width:760px){
    .sev-steps{grid-template-columns:1fr}
    .sev-facts{grid-template-columns:1fr 1fr}
  }
</style>
