---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Card from '../../components/Card.astro';
import CtaSection from '../../components/CtaSection.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import { entitiesByType } from '../../lib/graph';
import { entityUrl, itemListNode, entityNode } from '../../lib/entitySchema';

const items = await getCollection('province');
const site = (Astro.site?.toString() || 'https://algeriacompass.com').replace(/\/$/, '');

// Full 58-state directory (previously a separate noindex hub). It now lives on
// the state index itself: one indexable URL carrying both the guides and the
// complete, anchored inventory that entityUrl() links states to.
const provinces = entitiesByType('province').sort((a, b) => (a.wilayaNumber || 0) - (b.wilayaNumber || 0));
const regions = entitiesByType('region');
const byRegion = regions
  .map(r => ({ region: r, items: provinces.filter(p => p.region === r.id) }))
  .filter(g => g.items.length > 0);

const url = '/provinces/';
const quick = `Algeria is divided into 58 states (wilayas). This page lists all 58 with their capital, state number and region; ${items.length} currently have a full travel guide on this site, with more in progress.`;
const list = itemListNode(site, `${url}#all-states`, 'States of Algeria', provinces);
const schema = [list, ...provinces.map(p => entityNode(site, p))];
---
<BaseLayout title="Algeria States & Provinces — Travel Guides" description="Authoritative travel guides to the states of Algeria — history, culture, food, attractions and how to visit, plus a directory of all 58 states." image="/assets/img/constantine-sidi-mcid-bridge.jpg" keywords={["Algeria states","Algeria provinces","Algeria regions","Algeria wilayas","Algeria travel guide","58 states of Algeria"]} schema={schema}>
  <Hero title="Algeria States" eyebrow="Algeria" text="Authoritative travel guides to the states of Algeria — history, culture, food, attractions and how to visit." image="/assets/img/brand-algeria.jpg" alt="Algeria" />
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Algeria States'}]} />
  <section class="section"><div class="wrap" style="max-width:820px"><QuickAnswer text={quick} /></div></section>
  <section class="section"><div class="wrap">
    <h2>State travel guides</h2>
    <div class="grid" style="margin-top:1.2rem">
      {items.map(it => (
        <Card href={`/provinces/${it.slug}/`}
          title={it.data.name}
          image={it.data.image ?? '/assets/img/brand-algeria.jpg'}
          alt={it.data.imageAlt ?? it.data.name}
          tag={it.data.region}
          text={it.data.quickAnswer} />
      ))}
    </div>
  </div></section>

  <section class="section" style="background:var(--wash)"><div class="wrap">
    <div class="eyebrow">Directory</div>
    <h2 id="all-states">All 58 states of Algeria</h2>
    <p style="color:var(--text-m);max-width:720px">Every state, grouped by region, with its capital and official state number. States with a full guide are outlined in gold.</p>
    {byRegion.map(g => (
      <div class="prov-region">
        <h3>{g.region.name} <span class="rcount">{g.items.length} states</span></h3>
        <p style="color:var(--text-m);max-width:720px">{g.region.description}</p>
        <div class="prov-grid">
          {g.items.map(p => p.contentSlug ? (
            <a class="prov-tile" id={p.slug} href={entityUrl(site, p)} data-has-guide="yes">
              <span class="pnum">{p.wilayaNumber}</span>
              <strong>{p.name}</strong>
              <span class="pcap">Capital: {p.capital}</span>
              <span class="pguide">Guide &#8599;</span>
            </a>
          ) : (
            <div class="prov-tile" id={p.slug} data-has-guide="no">
              <span class="pnum">{p.wilayaNumber}</span>
              <strong>{p.name}</strong>
              <span class="pcap">Capital: {p.capital}</span>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div></section>

  <CtaSection />
</BaseLayout>
<style>
.prov-region{margin-top:2rem}
.rcount{font-size:.7rem;font-weight:700;color:var(--brand);text-transform:uppercase;letter-spacing:.06em;margin-left:.4rem}
.prov-grid{display:grid;gap:.6rem;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));margin-top:1rem}
.prov-tile{position:relative;display:flex;flex-direction:column;gap:.15rem;padding:.7rem .85rem;border:1px solid var(--border);border-radius:10px;background:var(--bg);color:var(--text);scroll-margin-top:90px}
.prov-tile[data-has-guide=yes]{border-color:var(--gold)}
.prov-tile:hover{transform:translateY(-2px);transition:.15s}
.prov-tile strong{font-size:.98rem}
.pnum{position:absolute;top:.5rem;right:.6rem;font-size:.7rem;color:var(--text-l)}
.pcap{font-size:.78rem;color:var(--text-m)}
.pguide{font-size:.72rem;color:var(--gold-d,var(--brand));font-weight:700;margin-top:.15rem}
</style>
