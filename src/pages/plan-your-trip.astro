---
// /plan-your-trip/ — the conversion landing page, built for paid ads and
// organic traffic alike.
//
// Everything a visitor needs to decide is on one page, in this order:
//   1. a five-question planner that names the right tour and the price for
//      THEIR group, with the early-booking discount applied when it applies;
//   2. a no-risk next step — hold the dates free for 72 hours, or WhatsApp;
//   3. the guarantees that remove the usual fears about Algeria;
//   4. proof (rating, licence, real travellers) and an honest season note.
// A visitor about to leave is offered the early-booking discount in exchange
// for an email or WhatsApp number.
//
// Prices are read from tours.json and luxury.mjs; every promise from BOOKING
// in config.ts — the same sources as the tour pages and /booking-terms/.
// Nothing here invents a price, a deadline or a scarcity claim.
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT, REVIEWS, BOOKING, LANGUAGES } from '../config';
import toursData from '../data/tours.json';
import { LUX_PRICING } from '../data/luxury.mjs';

const site = (Astro.site?.toString() || 'https://algeriacompass.com').replace(/\/$/, '');
const DESERT = ['djanet', 'ghardaia', 'timimoun', 'bousaada'];
const tours = (toursData as any).tours.map((t: any) => ({
  id: t.id, title: t.title, hook: t.hook, price: t.price_eur, theme: t.theme,
  days: parseInt(t.duration, 10) || 1, dur: t.duration.split(' · ')[0],
  desert: t.theme === 'sahara' || t.theme === 'mzab' || (t.wilayas || []).some((w: string) => DESERT.includes(w)),
  north: !(t.theme === 'sahara' || t.theme === 'mzab') || (t.wilayas || []).some((w: string) => !DESERT.includes(w) && w !== 'illizi'),
  img: `/assets/img/thumbs/tours/${(t.image_slugs || ['algiers'])[0]}-1.jpg`,
}));
const lux = { tiers: [[2, 9, 2290], [10, 15, 1870], [16, 22, 1700], [23, 999, 1615]], from: LUX_PRICING.fromValue };
const cfg = { hold: BOOKING.holdHours, earlyDays: BOOKING.earlyDays, earlyPct: BOOKING.earlyPct, wa: CONTACT.whatsapp };

const moments = ['client-641', 'client-223', 'client-547', 'client-189', 'client-4', 'client-500'];

const faqs = [
  { q: 'Is it safe to travel to Algeria?', a: 'The north, the M\'Zab Valley and the organised Sahara routes are calm and very welcoming. We travel the deep desert only with permits and licensed guides. Our evidence-based safety guide is at /blog/algeria-safety-guide/.' },
  { q: 'Do I need a visa?', a: `Most nationalities do. We prepare the invitation letter free with every booking; for organised Sahara trips the visa can be issued on arrival through our €40 authorisation. And if your visa is refused, we refund everything you paid us.` },
  { q: 'Do I have to pay to hold my dates?', a: `No. Your dates are held free for ${BOOKING.holdHours} hours while we confirm availability, permits and flights. A deposit — by bank transfer, card or PayPal — secures the trip only once you are happy.` },
  { q: 'Are the tours private?', a: `Yes, every tour is private, on your own dates, with a licensed local guide. Our guides work in ${LANGUAGES.names.join(', ')}.` },
  { q: 'Can the price change after I book?', a: 'No. The price we confirm in writing is locked — it does not rise for season, demand or exchange rate.' },
];
const schema = [{
  '@type': 'FAQPage', '@id': `${site}/plan-your-trip/#faq`,
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}];
const hero = '/assets/img/tours/djanet-13.jpg';
---
<BaseLayout
  title="Plan Your Private Algeria Trip — Instant Price | Algeria Compass"
  description="Answer five questions and see the right private tour and your price instantly. Dates held free 72h, full refund if your visa is refused, price locked."
  image={hero}
  imageAlt="A natural sandstone arch rising above smooth orange sand in the desert around Djanet"
  keywords={['Algeria tour price', 'plan a trip to Algeria', 'private tour Algeria', 'Algeria Sahara tour', 'book Algeria tour']}
  schema={schema}
  region="sahara">

  <section class="lp-hero" style={`background-image:linear-gradient(180deg,rgba(10,20,15,.35),rgba(10,20,15,.78)),url(${hero})`}>
    <div class="wrap">
      <p class="eyebrow" style="color:var(--gold-l)">Private tours · licensed Algerian operator</p>
      <h1>Your Algeria trip, priced in 60 seconds</h1>
      <p class="lp-sub">Sahara, Roman cities, the Casbah — tell us what you want and see the right private tour and your price, now.</p>
      <a class="btn btn-gold lp-go" href="#planner" data-evt="lp_start">Plan my trip</a>
      <ul class="lp-chips">
        <li>✓ Dates held free {BOOKING.holdHours}h</li>
        <li>✓ Visa refused = full refund</li>
        <li>✓ Price locked</li>
        <li>★ {REVIEWS.ratingValue.toFixed(1)} on Google</li>
      </ul>
    </div>
  </section>

  <section class="section" id="planner"><div class="wrap" style="max-width:860px">
    <div class="lp-card">
      <div class="lp-prog" aria-hidden="true"><span id="lpBar"></span></div>
      <form id="lpQuiz" novalidate>
        <fieldset class="lp-step" data-step="0">
          <legend>What would you love to see?</legend>
          <div class="lp-opts">
            <button type="button" data-k="want" data-v="sahara">🏜️ The Sahara</button>
            <button type="button" data-k="want" data-v="history">🏛️ Roman cities & history</button>
            <button type="button" data-k="want" data-v="both">✨ A bit of both</button>
            <button type="button" data-k="want" data-v="city">🕌 Algiers & the coast</button>
          </div>
        </fieldset>
        <fieldset class="lp-step" data-step="1" hidden>
          <legend>How many days do you have?</legend>
          <div class="lp-opts">
            <button type="button" data-k="days" data-v="2">1–3 days</button>
            <button type="button" data-k="days" data-v="5">4–6 days</button>
            <button type="button" data-k="days" data-v="8">7–9 days</button>
            <button type="button" data-k="days" data-v="12">10 days or more</button>
          </div>
        </fieldset>
        <fieldset class="lp-step" data-step="2" hidden>
          <legend>How many travellers?</legend>
          <div class="lp-num">
            <button type="button" id="lpMinus" aria-label="One fewer traveller">−</button>
            <output id="lpPax" aria-live="polite">2</output>
            <button type="button" id="lpPlus" aria-label="One more traveller">+</button>
          </div>
          <button type="button" class="btn btn-gold lp-next" data-next>Next</button>
        </fieldset>
        <fieldset class="lp-step" data-step="3" hidden>
          <legend>When would you like to travel?</legend>
          <div class="lp-opts lp-months" id="lpMonths"></div>
          <p class="lp-hint">The deep Sahara is travelled from October to April.</p>
        </fieldset>
        <fieldset class="lp-step" data-step="4" hidden>
          <legend>Which style suits you?</legend>
          <div class="lp-opts">
            <button type="button" data-k="style" data-v="comfort">Comfortable — guesthouses, camps, good hotels</button>
            <button type="button" data-k="style" data-v="luxury">Luxury — five-star, all-inclusive</button>
          </div>
        </fieldset>
      </form>

      <div id="lpResult" hidden>
        <h2 id="lpResH">Your best matches</h2>
        <p id="lpEarly" class="lp-early" hidden></p>
        <div id="lpList" class="lp-list"></div>

        <div class="lp-hold" id="hold">
          <h3>Hold these dates — free for {BOOKING.holdHours} hours</h3>
          <p>No payment, no card. We confirm availability, permits and flights and send your final, locked price.</p>
          <form method="POST" action="/contact.php" id="lpHoldForm">
            <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
            <input type="hidden" name="context" id="lpCtx" value="Plan-your-trip: hold dates" />
            <input type="hidden" name="interests" id="lpInt" value="" />
            <input type="hidden" name="people" id="lpPeople" value="" />
            <input type="hidden" name="when" id="lpWhen" value="" />
            <input type="hidden" name="days" id="lpDays" value="" />
            <div class="lp-row">
              <label>Your name<input name="name" required maxlength="80" autocomplete="name" /></label>
              <label>Email<input name="email" type="email" required maxlength="120" autocomplete="email" /></label>
            </div>
            <label>Anything we should know? (optional)<textarea name="message" id="lpMsg" rows="3" maxlength="4000"></textarea></label>
            <div class="lp-actions">
              <button type="submit" class="btn btn-gold" data-evt="lp_hold">Hold my dates free</button>
              <a class="btn btn-wa-2" id="lpWa" href={`https://wa.me/${CONTACT.whatsapp}`} target="_blank" rel="noopener" data-evt="lp_whatsapp">💬 Or book on WhatsApp</a>
            </div>
            <p class="lp-fine">Then a deposit by bank transfer, card or PayPal secures the trip; the balance is due before departure. Free cancellation up to {BOOKING.cancelDays} days before. <a href="/booking-terms/#guarantees">Full terms</a></p>
          </form>
        </div>
        <button type="button" class="lp-restart" id="lpRestart">↺ Start again</button>
      </div>
      <noscript><p>The planner needs JavaScript. <a href="/contact/">Tell us about your trip here</a> or WhatsApp {CONTACT.phoneDisplay}.</p></noscript>
    </div>
  </div></section>

  <section class="section" style="background:var(--wash)"><div class="wrap">
    <p class="eyebrow">Book without the worry</p>
    <h2>Our guarantees</h2>
    <div class="lp-guar">
      <div><b>Dates held free {BOOKING.holdHours}h</b><span>Request now, pay nothing until we have confirmed everything.</span></div>
      <div><b>Visa refused? Full refund</b><span>Everything you paid us comes back. The biggest worry about Algeria, removed.</span></div>
      <div><b>Your price is locked</b><span>The price we confirm never goes up — not for season, demand or exchange rate.</span></div>
      <div><b>Free date changes</b><span>Plans move. Change your dates at no cost, subject to availability.</span></div>
      <div><b>Free cancellation</b><span>Up to {BOOKING.cancelDays} days before departure, with a full refund.</span></div>
      <div><b>−{BOOKING.earlyPct}% booking early</b><span>Book {BOOKING.earlyDays}+ days before departure and {BOOKING.earlyPct}% comes off the tour price.</span></div>
    </div>
  </div></section>

  <section class="section"><div class="wrap">
    <div class="lp-proof">
      <div><b>★ {REVIEWS.ratingValue.toFixed(1)}</b><span>on <a href={CONTACT.googleProfile} target="_blank" rel="noopener">Google</a></span></div>
      <div><b>7+ years</b><span>guiding in Algeria</span></div>
      <div><b>Licensed</b><span>Algerian operator, based in Algiers</span></div>
      <div><b>{LANGUAGES.names.length} languages</b><span>spoken by our guides</span></div>
    </div>
    <h2 style="margin-top:2rem">Our travellers, not stock photos</h2>
    <div class="lp-moments">
      {moments.map((m) => (<img src={`/assets/img/clients/${m}.jpg`} alt="A moment from one of our private trips in Algeria" loading="lazy" width="300" height="300" />))}
    </div>
    <p><a href="/moments/">See more moments from our trips →</a></p>
  </div></section>

  <section class="section" style="background:var(--wash)"><div class="wrap" style="max-width:820px">
    <h2>A note on timing</h2>
    <p>The deep Sahara is travelled from <strong>October to April</strong>, and the Christmas and New Year weeks are the first to book up — domestic flights to the south are limited. If you have dates in mind, holding them costs nothing.</p>
    <h2 style="margin-top:2rem">Questions</h2>
    {faqs.map((f) => (<details class="lp-faq"><summary>{f.q}</summary><p>{f.a}</p></details>))}
  </div></section>

  <div class="lp-exit" id="lpExit" role="dialog" aria-modal="true" aria-labelledby="lpExitH" hidden>
    <div class="lp-exit-box">
      <button type="button" class="lp-x" id="lpExitX" aria-label="Close">×</button>
      <p class="eyebrow">Before you go</p>
      <h2 id="lpExitH">{BOOKING.earlyPct}% off when you book early</h2>
      <p>Book at least {BOOKING.earlyDays} days before departure and {BOOKING.earlyPct}% comes off any tour. Leave your email or WhatsApp and we'll send you the trip that fits, with the discount applied.</p>
      <form method="POST" action="/contact.php">
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
        <input type="hidden" name="context" value="Plan-your-trip: early-booking offer (exit)" />
        <input type="hidden" name="interests" value={`Early booking -${BOOKING.earlyPct}%`} />
        <label>Your name<input name="name" required maxlength="80" autocomplete="name" /></label>
        <label>Email<input name="email" type="email" required maxlength="120" autocomplete="email" /></label>
        <label>WhatsApp (optional)<input name="whatsapp" maxlength="30" inputmode="tel" autocomplete="tel" placeholder="+…" /></label>
        <input type="hidden" name="message" value="Please send me a trip suggestion with the early-booking discount." />
        <button type="submit" class="btn btn-gold" data-evt="lp_exit_offer">Send me my offer</button>
      </form>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ tours, lux, cfg }}>
(function(){
  var st={want:null,days:null,pax:2,month:null,monthDate:null,style:null}, step=0, steps=document.querySelectorAll('.lp-step');
  var bar=document.getElementById('lpBar');
  var ev=function(n){ try{ window.trackEvent && window.trackEvent(n) }catch(e){} };
  function show(i){ step=i; steps.forEach(function(s,j){ s.hidden = j!==i; }); bar.style.width=((i)/steps.length*100)+'%'; }
  // months: the next 12
  var mWrap=document.getElementById('lpMonths'), now=new Date();
  for(var i=0;i<12;i++){ var d=new Date(now.getFullYear(), now.getMonth()+i, 1);
    var b=document.createElement('button'); b.type='button'; b.dataset.k='month'; b.dataset.v=d.toISOString();
    b.textContent=d.toLocaleDateString('en-GB',{month:'short',year:'numeric'}); mWrap.appendChild(b); }
  document.getElementById('lpQuiz').addEventListener('click',function(e){
    var b=e.target.closest('button[data-k]'); if(b){
      var k=b.dataset.k, v=b.dataset.v;
      if(k==='month'){ st.monthDate=new Date(v); st.month=b.textContent; } else st[k]=v;
      if(step===0) ev('lp_q1');
      if(step<steps.length-1) show(step+1); else result();
      return; }
    if(e.target.closest('[data-next]')) show(step+1);
  });
  var paxEl=document.getElementById('lpPax');
  document.getElementById('lpMinus').onclick=function(){ st.pax=Math.max(1,st.pax-1); paxEl.textContent=st.pax; };
  document.getElementById('lpPlus').onclick=function(){ st.pax=Math.min(40,st.pax+1); paxEl.textContent=st.pax; };
  function eur(n){ return '€'+Math.round(n).toLocaleString('en-GB'); }
  function score(t){
    var s=0, want=st.want, d=+st.days;
    if(want==='sahara') s+= t.desert ? (t.north?6:10) : -20;
    if(want==='history') s+= t.north ? (t.desert?6:10) : -20;
    if(want==='both') s+= (t.desert && t.north) ? 10 : 2;
    if(want==='city') s+= (t.theme==='city'||t.theme==='coast'||t.theme==='roman') ? 10 : (t.north?2:-20);
    s -= Math.abs(t.days-d)*1.6;
    return s;
  }
  function luxPrice(n){ for(var i=0;i<lux.tiers.length;i++){ var r=lux.tiers[i]; if(n>=r[0]&&n<=r[1]) return r[2]; } return null; }
  function result(){
    ev('lp_result');
    document.getElementById('lpQuiz').hidden=true; bar.style.width='100%';
    var R=document.getElementById('lpResult'); R.hidden=false;
    var days=Math.round((st.monthDate - new Date())/864e5);
    var early = days >= cfg.earlyDays;
    var earlyEl=document.getElementById('lpEarly');
    if(early){ earlyEl.hidden=false; earlyEl.textContent='Travelling in '+st.month+' qualifies for the early-booking discount: '+cfg.earlyPct+'% off, shown below.'; }
    else { earlyEl.hidden=false; earlyEl.textContent='Travelling soon? Holding your dates now is the best way to secure guides and flights.'; }
    var list=document.getElementById('lpList'); list.innerHTML='';
    var picks=[];
    if(st.style==='luxury'){
      var lp=luxPrice(st.pax);
      picks.push({lux:true,title:'The 5-Star Collection — 8 days all-inclusive',hook:'Internal flights, five-star hotels, all meals, a private 4WD fleet, guides and entry fees.',dur:'8 days',price:lp,url:'/luxury/',img:'/assets/img/tours/djemila-2.jpg'});
    }
    tours.slice().sort(function(a,b){return score(b)-score(a)}).slice(0, st.style==='luxury'?2:3).forEach(function(t){ picks.push({title:t.title,hook:t.hook,dur:t.dur,price:t.price,url:'/tours/'+t.id+'/',img:t.img}); });
    picks.forEach(function(p,i){
      var per=p.price, tot=per? per*st.pax : null, disc= early&&tot ? tot*cfg.earlyPct/100 : 0;
      var el=document.createElement('div'); el.className='lp-pick'+(i===0?' lp-top':'');
      el.innerHTML='<img src="'+p.img+'" alt="" width="120" height="120" loading="lazy">'+
        '<div><span class="lp-badge">'+(i===0?'Best match':'Also great')+' · '+p.dur+'</span>'+
        '<h3><a href="'+p.url+'" target="_blank" rel="noopener">'+p.title.replace(/</g,'&lt;')+'</a></h3>'+
        '<p>'+String(p.hook||'').replace(/</g,'&lt;')+'</p>'+
        (per ? '<p class="lp-price">From <b>'+eur(per)+'</b> per person · '+st.pax+' traveller'+(st.pax>1?'s':'')+': <b>'+eur(tot-disc)+'</b>'+(disc?' <s>'+eur(tot)+'</s> <em>−'+cfg.earlyPct+'%</em>':'')+'</p>'
             : '<p class="lp-price">Price on request for this group size</p>')+
        '<button type="button" class="btn btn-gold lp-pickbtn" data-title="'+p.title.replace(/"/g,'&quot;')+'">Hold my dates</button></div>';
      list.appendChild(el);
    });
    fill(picks[0].title);
    list.querySelectorAll('.lp-pickbtn').forEach(function(b){ b.onclick=function(){ fill(b.dataset.title); document.getElementById('hold').scrollIntoView({behavior:'smooth'}); }; });
    R.scrollIntoView({behavior:'smooth'});
  }
  function fill(title){
    var label={sahara:'Sahara',history:'Roman & history',both:'Sahara + history',city:'Algiers & coast'}[st.want];
    document.getElementById('lpCtx').value='Plan-your-trip: hold dates — '+title;
    document.getElementById('lpInt').value=label+' · '+st.style;
    document.getElementById('lpPeople').value=st.pax;
    document.getElementById('lpWhen').value=st.month;
    document.getElementById('lpDays').value={2:'1–3',5:'4–6',8:'7–9',12:'10+'}[st.days];
    var msg=document.getElementById('lpMsg'); if(!msg.dataset.touched) msg.value='I would like to hold dates for: '+title+'.';
    var wa='Hello! I would like to book: '+title+' — '+st.pax+' traveller(s), '+st.month+', '+label+' ('+st.style+').';
    document.getElementById('lpWa').href='https://wa.me/'+cfg.wa+'?text='+encodeURIComponent(wa);
  }
  document.getElementById('lpMsg').addEventListener('input',function(){ this.dataset.touched='1'; });
  document.getElementById('lpRestart').onclick=function(){ document.getElementById('lpResult').hidden=true; document.getElementById('lpQuiz').hidden=false; show(0); };
  show(0);

  // Exit offer: once per session; desktop on exit intent, mobile after 45 s.
  var X=document.getElementById('lpExit'), shown=false;
  function seen(){ try{ return sessionStorage.getItem('lpExit') }catch(e){ return null } }
  function open(){ if(shown||seen()) return; if(!document.getElementById('lpResult').hidden) return; shown=true; try{sessionStorage.setItem('lpExit','1')}catch(e){} X.hidden=false; ev('lp_exit_shown'); X.querySelector('input[name=name]').focus(); }
  function close(){ X.hidden=true; }
  document.getElementById('lpExitX').onclick=close;
  X.addEventListener('click',function(e){ if(e.target===X) close(); });
  document.addEventListener('keydown',function(e){ if(e.key==='Escape') close(); });
  if(matchMedia('(pointer:fine)').matches) document.addEventListener('mouseout',function(e){ if(!e.relatedTarget && e.clientY<10) open(); });
  else setTimeout(open,45000);
})();
</script>

<style is:global>
  .lp-hero{background-size:cover;background-position:center;color:#fff;padding:5.5rem 0 4rem}
  .lp-hero h1{color:#fff;font-size:clamp(2rem,5vw,3.2rem);max-width:16ch;margin:.3rem 0 .8rem}
  .lp-sub{font-size:1.15rem;max-width:44ch;color:rgba(255,255,255,.92)}
  .lp-go{margin-top:1.2rem;font-size:1.1rem;padding:.9rem 1.8rem}
  .lp-chips{list-style:none;display:flex;flex-wrap:wrap;gap:.5rem;padding:0;margin:1.4rem 0 0}
  .lp-chips li{background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.25);padding:.35rem .75rem;border-radius:999px;font-size:.9rem}
  .lp-card{background:var(--card,#fff);border-radius:18px;box-shadow:0 10px 40px rgba(0,0,0,.08);padding:1.6rem;position:relative;overflow:hidden}
  .lp-prog{height:5px;background:rgba(0,0,0,.06);border-radius:5px;margin-bottom:1.2rem}
  .lp-prog span{display:block;height:100%;width:0;background:var(--gold,#b8862e);border-radius:5px;transition:width .3s}
  .lp-step{border:0;padding:0;margin:0}
  .lp-step legend{font-size:1.45rem;font-weight:800;margin-bottom:1rem;font-family:inherit}
  .lp-opts{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:.7rem}
  .lp-opts button{font:inherit;font-size:1.02rem;text-align:left;padding:1rem 1.1rem;border-radius:12px;border:1.5px solid rgba(0,0,0,.14);background:#fff;cursor:pointer;min-height:56px}
  .lp-opts button:hover,.lp-opts button:focus-visible{border-color:var(--gold,#b8862e);background:#fffaf0}
  .lp-months{grid-template-columns:repeat(auto-fit,minmax(110px,1fr))}
  .lp-months button{text-align:center}
  .lp-hint{color:var(--text-m);font-size:.92rem;margin-top:.8rem}
  .lp-num{display:flex;align-items:center;gap:1.2rem;margin:.4rem 0 1.2rem}
  .lp-num button{width:52px;height:52px;border-radius:50%;border:1.5px solid rgba(0,0,0,.2);background:#fff;font-size:1.6rem;cursor:pointer}
  .lp-num output{font-size:2rem;font-weight:800;min-width:2ch;text-align:center}
  .lp-early{background:#fff6e0;border-left:4px solid var(--gold,#b8862e);padding:.7rem .9rem;border-radius:8px}
  .lp-list{display:grid;gap:.9rem;margin:1rem 0 1.6rem}
  .lp-pick{display:grid;grid-template-columns:120px 1fr;gap:1rem;border:1px solid rgba(0,0,0,.1);border-radius:14px;padding:.9rem}
  .lp-pick.lp-top{border:2px solid var(--gold,#b8862e)}
  .lp-pick img{width:120px;height:120px;object-fit:cover;border-radius:10px}
