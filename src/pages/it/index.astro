---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { alternatesFor } from '../../i18n';
const site = Astro.site?.toString().replace(/\/$/, '') || 'https://algeriacompass.com';
const alternates = alternatesFor(site, { en: '/', fr: '/fr/', it: '/it/', es: '/es/', de: '/de/' });
const title = "Viaggio in Algeria — tour privati e guide esperte";
const description = "Algeria Compass, tour operator algerino autorizzato: viaggi privati culturali e sahariani su misura, assistenza visto e guide locali italiane.";
const schema = [{
  '@type': 'WebPage',
  '@id': `${site}/it/#webpage`,
  name: title, description, inLanguage: 'it',
  url: `${site}/it/`,
  isPartOf: { '@id': `${site}/#website` },
  about: { '@id': `${site}/#algeria` },
}];
---
<BaseLayout title={title} description={description} lang="it" alternates={alternates} type="website" sticky={true} schema={schema}
  keywords={["viaggio Algeria","tour Algeria","viaggi organizzati Algeria","Sahara algerino","visto Algeria"]}>
  <section class="section">
    <div class="wrap" style="max-width:820px">
      <span class="eyebrow">Tour operator algerino autorizzato</span>
      <h1 style="font-size:clamp(1.9rem,4.5vw,3rem);margin:.4rem 0 .8rem">Viaggiate in Algeria con chi la conosce davvero</h1>
      <p style="font-size:1.1rem;color:var(--text-l);line-height:1.7">
        Dalla costa mediterranea alle città romane dell'est, dalle valli del M'Zab agli altopiani del Tassili n'Ajjer,
        Algeria Compass progetta e guida viaggi privati attraverso il paese più grande d'Africa — con guide
        algerine locali, assistenza per il visto e una conoscenza reale del terreno.
      </p>
      <p style="margin-top:1.4rem">
        <a class="btn btn-gold" href="/it/contatto/">Richiedi un preventivo</a>
        <a class="btn" href="/it/circuiti/" style="margin-inline-start:.5rem">Vedi i viaggi</a>
      </p>
    </div>
  </section>

  <section class="section" style="background:var(--wash)">
    <div class="wrap">
      <span class="eyebrow">I nostri viaggi</span>
      <h2>Come scoprire l'Algeria</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.1rem;margin-top:1rem">
        <div class="card" style="padding:1.1rem">
          <h3 style="margin:.2rem 0">Viaggi culturali e storici</h3>
          <p style="color:var(--text-l)">Algeri e la Casbah, le città romane di Timgad e Djémila, Costantina, Tlemcen l'andalusa.</p>
          <a href="/it/circuiti/">Scopri i viaggi →</a>
        </div>
        <div class="card" style="padding:1.1rem">
          <h3 style="margin:.2rem 0">Spedizioni nel Sahara</h3>
          <p style="color:var(--text-l)">Djanet e il Tassili n'Ajjer, l'Hoggar, Timimoun e le oasi — spedizioni guidate in 4×4, d'inverno.</p>
          <a href="/it/sahara-algeria/">Guida al Sahara →</a>
        </div>
        <div class="card" style="padding:1.1rem">
          <h3 style="margin:.2rem 0">Viaggi di lusso su misura</h3>
          <p style="color:var(--text-l)">Programmi privati di alta gamma, costruiti attorno alle vostre date e ai vostri desideri.</p>
          <a href="/it/lusso/">Viaggi di lusso →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap" style="max-width:820px">
      <span class="eyebrow">Preparare il viaggio</span>
      <h2>Guide pratiche in italiano</h2>
      <p style="color:var(--text-l)">Iniziate dalla guida completa, poi approfondite visto, sicurezza, stagioni e Sahara.</p>
      <ul class="prose" style="line-height:2">
        <li><a href="/it/guida-viaggio-algeria/"><strong>Guida di viaggio completa all'Algeria</strong></a></li>
        <li><a href="/it/visto-algeria/">Visto per l'Algeria</a></li>
        <li><a href="/it/sicurezza-algeria/">L'Algeria è sicura?</a></li>
        <li><a href="/it/quando-andare-algeria/">Quando andare in Algeria</a></li>
        <li><a href="/it/sahara-algeria/">Il Sahara algerino</a></li>
      </ul>
      <p style="margin-top:1rem;color:var(--text-l)">
        Vedete anche le <a href="/it/destinazioni/">destinazioni</a> — i sette siti UNESCO e le città che
        fanno da base a un viaggio.
      </p>
    </div>
  </section>

  <section class="section" style="background:var(--wash)">
    <div class="wrap" style="max-width:820px">
      <span class="eyebrow">Perché noi</span>
      <h2>Un operatore locale, non un intermediario</h2>
      <p style="color:var(--text-l);line-height:1.75">
        Siamo un'agenzia algerina con licenza, con sede ad Algeri. Questo significa tre cose concrete:
        forniamo <strong>l'invito e il programma confermato</strong> che i consolati richiedono per il visto;
        i permessi per il grande sud passano da noi e non da una catena di subappalti; e le guide, gli autisti
        e le squadre del deserto sono persone con cui lavoriamo, non fornitori anonimi.
      </p>
      <p style="margin-top:1.2rem">
        <a class="btn btn-gold" href="/it/contatto/">Parlaci del tuo viaggio</a>
      </p>
    </div>
  </section>
</BaseLayout>
