---
// Italian destinations index — the seven UNESCO sites plus the cities that
// anchor a trip. Photography is read from the English collection so both
// language versions show the same place.
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { DESTINATIONS_IT } from '../../../data/destinations-it';
import { alternatesFor } from '../../../i18n';

const site = (Astro.site?.toString() || 'https://algeriacompass.com').replace(/\/$/, '');
const en = await getCollection('destination');
const rows = DESTINATIONS_IT.map(d => ({
  ...d,
  image: en.find(e => e.slug === d.en)?.data?.image || '/assets/img/brand-algeria.jpg',
}));

const title = "Destinazioni in Algeria: siti UNESCO e imperdibili";
const description = "Le destinazioni da vedere in Algeria: i sette siti UNESCO — Timgad, Djémila, Tipaza, la valle del M'Zab, la Casbah, il Tassili, Beni Hammad — e altro.";
const alternates = alternatesFor(site, { en: '/destinations/', fr: '/fr/destinations/', it: '/it/destinazioni/' });
const itemList = {
  '@type': 'ItemList',
  '@id': `${site}/it/destinazioni/#elenco`,
  name: 'Destinazioni in Algeria',
  numberOfItems: rows.length,
  itemListElement: rows.map((r, i) => ({
    '@type': 'ListItem', position: i + 1, name: r.name,
    url: `${site}/it/destinazioni/${r.slug}/`,
  })),
};
const collection = {
  '@type': 'CollectionPage',
  '@id': `${site}/it/destinazioni/#collection`,
  name: 'Destinazioni in Algeria', description, inLanguage: 'it',
  url: `${site}/it/destinazioni/`,
  isPartOf: { '@id': `${site}/#website` },
  about: { '@id': `${site}/#algeria` },
  mainEntity: { '@id': `${site}/it/destinazioni/#elenco` },
};
---
<BaseLayout title={title} description={description} lang="it" alternates={alternates}
  image="/assets/img/timgad-trajan-arch.jpg" schema={[collection, itemList]}
  keywords={["destinazioni Algeria","cosa vedere in Algeria","siti UNESCO Algeria","Timgad","valle del M'Zab","Tassili n'Ajjer"]}>

  <section class="hero" style="min-height:42vh">
    <img src="/assets/img/timgad-trajan-arch.jpg" alt="L'arco di Traiano a Timgad, città romana patrimonio UNESCO in Algeria" width="1600" height="900" fetchpriority="high" />
    <div class="hero-in wrap">
      <div class="eyebrow">7 siti UNESCO · {rows.length} destinazioni</div>
      <h1>Cosa vedere in Algeria</h1>
      <p>Città romane tra le meglio conservate al mondo, cinque ksour sahariani dell'XI secolo, una medina ottomana e uno dei più grandi complessi di arte rupestre del pianeta.</p>
    </div>
  </section>

  <Breadcrumbs items={[{name:'Home',href:'/it/'},{name:'Destinazioni'}]} />

  <section class="section"><div class="wrap">
    <p class="fr-intro">
      L'Algérie compte <strong>sept sites inscrits au patrimoine mondial de l'UNESCO</strong> et
      presque aucun tourisme de masse : il est courant de parcourir Timgad ou Djémila en ne croisant
      qu'une poignée de visiteurs. Chaque destination ci-dessous se visite dans le cadre d'un
      <a href="/fr/circuits/">circuit privé</a>, avec un guide francophone.
    </p>

    <div class="fr-grid">
      {rows.map((r, i) => (
        <a class="dcard" href={`/it/destinazioni/${r.slug}/`}>
          <div class="dcard-img">
            <img src={r.image} alt={r.name} width="400" height="250" loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
          </div>
          <div class="dcard-body">
            <span class="dcard-eyebrow">{r.eyebrow}</span>
            <h2>{r.name}</h2>
            <p>{r.intro}</p>
          </div>
        </a>
      ))}
    </div>
  </div></section>
</BaseLayout>

<style>
  .fr-intro{max-width:780px;color:var(--text-m);margin-bottom:1.6rem}
  .fr-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.4rem}
  .dcard{display:flex;flex-direction:column;background:var(--card);border:1px solid var(--border);border-radius:14px;overflow:hidden;color:var(--text);box-shadow:0 2px 14px rgba(7,38,28,.06)}
  .dcard:hover{transform:translateY(-3px);transition:.18s;border-color:var(--gold);text-decoration:none}
  .dcard-img{aspect-ratio:16/10;background:var(--wash)}
  .dcard-img img{width:100%;height:100%;object-fit:cover;display:block}
  .dcard-body{display:flex;flex-direction:column;gap:.35rem;padding:1rem 1.1rem 1.2rem}
  .dcard-eyebrow{font-size:.7rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--accent,var(--brand-green))}
  .dcard-body h2{font-size:1.08rem;margin:0}
  .dcard-body p{font-size:.88rem;line-height:1.55;color:var(--text-m);margin:0}
</style>
