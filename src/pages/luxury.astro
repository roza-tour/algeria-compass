---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LuxuryProgram from '../components/LuxuryProgram.astro';
import InquiryForm from '../components/InquiryForm.astro';
import Motif from '../components/Motif.astro';
import { PROGRAMMES, LUX_PRICING } from '../data/luxury.mjs';
import { CONTACT } from '../config';

const site = (Astro.site?.toString() || 'https://algeriacompass.com').replace(/\/$/, '');
const wa = `https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent("Hello Algeria Compass, I'd like to enquire about your 5-Star Collection luxury tours.")}`;

const breadcrumb = { '@type':'BreadcrumbList', '@id':`${site}/luxury/#breadcrumb`, itemListElement:[
  {'@type':'ListItem',position:1,name:'Home',item:`${site}/`},
  {'@type':'ListItem',position:2,name:'Luxury 5-Star Collection',item:`${site}/luxury/`}]};

// Travel-focused schema only: one TouristTrip per programme with an AggregateOffer
// (price band, EUR). No Product/GTIN/brand/shipping — this is a travel service.
const tripNodes = PROGRAMMES.map((p) => ({
  '@type': 'TouristTrip',
  '@id': `${site}/luxury/#${p.id}`,
  name: `${p.name} — ${p.subtitle}`,
  description: p.tagline,
  url: `${site}/luxury/#${p.id}`,
  image: site + p.hero,
  touristType: ['Luxury travellers', 'Private groups'],
  duration: 'P8D',
  provider: { '@id': site + '/#organization' },
  itinerary: {
    '@type': 'ItemList',
    numberOfItems: p.days.length,
    itemListElement: p.days.map((d) => ({ '@type':'ListItem', position:d.n, name:`Day ${d.n}: ${d.title}` })),
  },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'EUR',
    lowPrice: LUX_PRICING.fromValue,
    highPrice: 2290,
    offerCount: LUX_PRICING.tiers.length,
    availability: 'https://schema.org/InStock',
    url: `${site}/luxury/#${p.id}`,
    seller: { '@id': site + '/#organization' },
  },
}));

const pillars = [
  { icon: '🇩🇿', t: 'Licensed Algerian operator', d: 'Run on the ground by Algerians — every permit, road and door handled in-country.' },
  { icon: '◆', t: 'Truly all-inclusive', d: 'Internal flights, all meals, 5-star hotels, a private 4WD fleet, guides and UNESCO fees — one price, no surprises.' },
  { icon: '🗣️', t: 'Multilingual private guides', d: 'A dedicated tour leader who never leaves your group, plus expert local guides at each site.' },
  { icon: '🛂', t: 'Visa support included', d: 'We prepare your visa documentation as part of the booking — see our e-Visa & visa support.' },
  { icon: '🗓️', t: 'Free cancellation', d: 'Free cancellation up to 5 days before your tour departure date.' },
  { icon: '★', t: 'Private, not packaged', d: 'Your own group only. Request-to-book, confirmed in writing before you pay — no instant-checkout, no crowds.' },
];
---
<BaseLayout
  title="Luxury Algeria Tours — The 5-Star Collection | Algeria Compass"
  description="Three signature private, all-inclusive 8-day luxury tours of Algeria: Roman ruins, UNESCO cities, the Sahara and the Andalusian west. Internal flights, 5-star hotels, private 4WD and multilingual guides. From €1,615 per person."
  image="/assets/img/tours/djemila-1.jpg"
  imageAlt="Djemila's UNESCO Roman ruins — Algeria Compass luxury tours"
  keywords={["Algeria luxury tours","5-star Algeria","private Algeria tours","luxury Sahara Algeria","luxury Algeria travel","Algeria UNESCO tours","all-inclusive Algeria tour"]}
  schema={[breadcrumb, ...tripNodes]}
  sticky={true}>

  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Luxury 5-Star Collection'}]} />

  <!-- ===== page hero ===== -->
  <section class="lux-hero">
    <div class="lux-hero-bg" aria-hidden="true"></div>
    <Motif name="zellige" size={120} class="lux-hero-motif" />
    <div class="wrap lux-hero-in">
      <span class="eyebrow lux-eyebrow">Algeria Revealed · The 5-Star Collection</span>
      <h1>Luxury Algeria, <span class="lux-gold">privately yours</span></h1>
      <p class="lux-sub">Three signature private journeys — eight unhurried days each, fully all-inclusive, across Roman ruins, UNESCO cities, the living Sahara and the Andalusian west. Internal flights, 5-star hotels, a private 4WD fleet and a tour leader who never leaves your side.</p>
      <div class="lux-stats">
        <div><strong>3</strong><span>signature journeys</span></div>
        <div><strong>8</strong><span>days · 7 nights</span></div>
        <div><strong>All-in</strong><span>flights · hotels · meals</span></div>
        <div><strong>€{LUX_PRICING.fromValue.toLocaleString('en-US')}</strong><span>from / person</span></div>
      </div>
      <p class="lux-hero-cta">
        <a class="btn btn-gold" href="#programmes">Explore the journeys ↓</a>
        <a class="btn btn-ghost lux-ghost" href={wa} target="_blank" rel="noopener">💬 Talk to a specialist</a>
      </p>
    </div>
  </section>

  <!-- ===== what makes it 5-star ===== -->
  <section class="section lux-pillars"><div class="wrap">
    <div class="lux-h"><span class="eyebrow">What makes it 5-star</span><h2>The Algeria Compass standard</h2>
      <p class="lux-h-sub">Every claim below is simply how we operate — a licensed Algerian house running private, all-inclusive travel. No metrics we can’t stand behind.</p>
    </div>
    <div class="lux-pillar-grid">
      {pillars.map(p => (
        <div class="lux-pillar">
          <span class="lux-pillar-i" aria-hidden="true">{p.icon}</span>
          <h3>{p.t}</h3>
          <p>{p.d}</p>
        </div>
      ))}
    </div>
  </div></section>

  <!-- ===== programmes ===== -->
  <div id="programmes">
    {PROGRAMMES.map(p => <LuxuryProgram prog={p} />)}
  </div>

  <!-- ===== reserve ===== -->
  <section class="section lux-reserve" id="reserve"><div class="wrap">
    <div class="lux-reserve-grid">
      <div class="lux-reserve-copy">
        <span class="eyebrow">Reserve your journey</span>
        <h2>Begin your 5-Star Collection trip</h2>
        <p>Tell us which programme draws you — <strong>Classical Algeria</strong>, <strong>Sahara Heart</strong> or <strong>Four Seasons</strong> — your dates and group size. We confirm availability, internal flights and your final per-person price in writing, usually within a few hours.</p>
        <ul class="lux-reserve-pts">
          <li>Private, request-to-book — no payment to enquire</li>
          <li>From <strong>{LUX_PRICING.fromLabel}</strong> per person, all-inclusive</li>
          <li>Free cancellation up to 5 days before departure</li>
          <li>Prefer to talk? <a href={wa} target="_blank" rel="noopener">Message us on WhatsApp</a> or email <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
        </ul>
      </div>
      <div class="lux-reserve-form">
        <h3>Request your private journey</h3>
        <InquiryForm context="Luxury 5-Star Collection enquiry" defaultInterest="Luxury" />
      </div>
    </div>
  </div></section>
</BaseLayout>

<style>
  /* ===== page hero — cinematic near-black emerald + champagne gold ===== */
  .lux-hero{position:relative;overflow:hidden;background:#04140F;color:#fff;
    border-bottom:1px solid rgba(224,190,115,.28)}
  .lux-hero::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;z-index:3;
    background:linear-gradient(90deg,transparent,#E7C66B 30%,#F4E3AE 50%,#E7C66B 70%,transparent)}
  .lux-hero-bg{position:absolute;inset:0;background:
    radial-gradient(130% 100% at 82% -15%, rgba(231,198,107,.26), transparent 52%),
    radial-gradient(95% 85% at -5% 115%, rgba(30,111,92,.5), transparent 55%),
    linear-gradient(165deg,#0B3D2E 0%,#072019 60%,#04140F 100%)}
  .lux-hero-bg::after{content:"";position:absolute;inset:0;
    background:radial-gradient(120% 120% at 50% 40%,transparent 55%,rgba(0,0,0,.45) 100%)}
  .lux-hero-motif{position:absolute;right:-20px;top:30px;color:#C9A24B;opacity:.12}
  .lux-hero-in{position:relative;padding:4.4rem 0 4rem;max-width:860px}
  .lux-eyebrow{display:inline-flex;align-items:center;gap:.7rem;color:#E7C66B;
    font-size:.74rem;letter-spacing:.22em;text-transform:uppercase;font-weight:700}
  .lux-eyebrow::before{content:"";width:34px;height:1px;background:linear-gradient(90deg,transparent,#E7C66B)}
  .lux-hero-in h1{font-family:'Cinzel',serif;color:#fff;font-size:clamp(2.3rem,6.2vw,4rem);line-height:1.03;
    margin:.9rem 0 .7rem;font-weight:700;text-shadow:0 2px 30px rgba(0,0,0,.4)}
  .lux-gold{background:linear-gradient(90deg,#E7C66B,#F4E3AE 60%,#D7A94B);
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:#E7C66B}
  .lux-sub{font-size:clamp(1.04rem,2vw,1.2rem);line-height:1.7;color:rgba(255,255,255,.88);max-width:720px;font-weight:300}
  .lux-stats{display:flex;flex-wrap:wrap;gap:0;margin:2rem 0;
    border-top:1px solid rgba(224,190,115,.22);border-bottom:1px solid rgba(224,190,115,.22)}
  .lux-stats div{display:flex;flex-direction:column;padding:1rem 1.7rem 1rem 0;margin-right:1.7rem;
    border-right:1px solid rgba(224,190,115,.16)}
  .lux-stats div:last-child{border-right:0;margin-right:0}
  .lux-stats strong{font-family:'Cinzel',serif;font-size:1.85rem;color:#E7C66B;line-height:1;font-weight:700}
  .lux-stats span{font-size:.78rem;letter-spacing:.04em;color:rgba(255,255,255,.66);margin-top:.35rem;text-transform:uppercase}
  .lux-hero-cta{display:flex;flex-wrap:wrap;gap:.7rem;margin:0}
  .lux-hero-cta .btn-gold{background:linear-gradient(135deg,#E7C66B,#C9A24B);color:#05130D;font-weight:700;
    box-shadow:0 10px 28px rgba(201,162,75,.3)}
  .lux-hero-cta .btn-gold:hover{filter:brightness(1.07)}
  .lux-ghost{color:#fff;border-color:rgba(231,198,107,.55)}
  .lux-ghost:hover{background:rgba(231,198,107,.14);border-color:#E7C66B}
  /* ===== pillars ===== */
  .lux-pillars{background:
    radial-gradient(120% 80% at 50% -20%, rgba(201,162,75,.07), transparent 60%),
    var(--wash,#f7f5ef)}
  .lux-h{text-align:center;max-width:680px;margin:0 auto 2.2rem}
  .lux-h .eyebrow{display:inline-flex;align-items:center;gap:.6rem;color:var(--gold-d,#8B6A22);
    letter-spacing:.2em;text-transform:uppercase;font-size:.74rem;font-weight:700}
  .lux-h .eyebrow::before,.lux-h .eyebrow::after{content:"";width:26px;height:1px;background:currentColor;opacity:.5}
  .lux-h h2{font-family:'Cinzel',serif;color:#0B3D2E;font-size:clamp(1.7rem,3vw,2.35rem);margin:.45rem 0 .4rem}
  .lux-h-sub{color:#4a5a52;margin:0;line-height:1.6}
  .lux-pillar-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.1rem}
  .lux-pillar{position:relative;background:#fff;border:1px solid var(--border,#e4ddd0);border-radius:16px;
    padding:1.7rem 1.5rem 1.4rem;box-shadow:0 4px 16px rgba(11,61,46,.05);
    transition:transform .3s ease,box-shadow .3s ease,border-color .3s ease}
  .lux-pillar::before{content:"";position:absolute;top:0;left:1.5rem;right:1.5rem;height:2px;
    background:linear-gradient(90deg,#E7C66B,#C9A24B);border-radius:2px}
  .lux-pillar:hover{transform:translateY(-4px);box-shadow:0 16px 36px rgba(11,61,46,.13);border-color:rgba(201,162,75,.5)}
  .lux-pillar-i{display:inline-flex;align-items:center;justify-content:center;width:2.7rem;height:2.7rem;
    font-size:1.3rem;margin-bottom:.7rem;border-radius:50%;color:#0B3D2E;
    background:radial-gradient(circle at 30% 25%,#F4E3AE,#E7C66B 60%,#C9A24B);
    box-shadow:0 4px 12px rgba(201,162,75,.32)}
  .lux-pillar h3{font-family:'Cinzel',serif;color:#0B3D2E;font-size:1.1rem;margin:0 0 .35rem}
  .lux-pillar p{color:#42524a;font-size:.92rem;line-height:1.55;margin:0}
  /* ===== reserve ===== */
  .lux-reserve{background:#0B3D2E;color:#fff}
  .lux-reserve-grid{display:grid;grid-template-columns:1fr 1.05fr;gap:2.2rem;align-items:start}
  .lux-reserve-copy .eyebrow{color:#E0BE73}
  .lux-reserve-copy h2{font-family:'Cinzel',serif;color:#fff;font-size:clamp(1.5rem,3vw,2rem);margin:.1rem 0 .6rem}
  .lux-reserve-copy p{color:rgba(255,255,255,.9);line-height:1.7}
  .lux-reserve-pts{list-style:none;padding:0;margin:1.1rem 0 0;display:grid;gap:.55rem}
  .lux-reserve-pts li{position:relative;padding-left:1.6rem;color:rgba(255,255,255,.92);font-size:.95rem;line-height:1.5}
  .lux-reserve-pts li::before{content:"✦";position:absolute;left:0;color:#E0BE73}
  .lux-reserve-pts a{color:#E0BE73;font-weight:600}
  .lux-reserve-form{background:#fff;border-radius:16px;border-top:4px solid var(--gold,#C19333);padding:1.5rem}
  .lux-reserve-form h3{font-family:'Cinzel',serif;color:#0B3D2E;font-size:1.2rem;margin:0 0 .8rem}
  @media(max-width:860px){
    .lux-pillar-grid{grid-template-columns:1fr 1fr}
    .lux-reserve-grid{grid-template-columns:1fr;gap:1.4rem}
  }
  @media(max-width:560px){ .lux-pillar-grid{grid-template-columns:1fr} .lux-stats{gap:1.1rem} }
</style>
