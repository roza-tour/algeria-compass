---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { REGIONS } from '../../data/regions';
import '../../styles/regions.css';
import '../../styles/region-art.css';
import { readFileSync } from 'node:fs';

export function getStaticPaths() {
  return REGIONS.map(r => ({ params: { slug: r.id }, props: { r } }));
}
const { r } = Astro.props;
const site = (Astro.site?.toString() || 'https://algeriacompass.com').replace(/\/$/, '');
const url = `${site}/regions/${r.id}/`;
const schema = [
  {
    '@type': 'TouristDestination',
    '@id': url + '#region',
    name: r.name + ', Algeria',
    description: r.sub,
    url,
    image: site + r.hero,
    containedInPlace: { '@id': site + '/#algeria' },
    isPartOf: { '@id': site + '/#website' },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site + '/' },
      { '@type': 'ListItem', position: 2, name: 'Regions', item: site + '/regions/' },
      { '@type': 'ListItem', position: 3, name: r.name, item: url },
    ],
  },
];
// The hero edge is inlined as a data URI (about 2 KB): as a separate file the
// photograph stayed fully masked -- invisible -- until that file arrived.
const edge = (o: string) => `url("data:image/svg+xml,${encodeURIComponent(readFileSync(`public/assets/regions/edge-${r.id}-${o}.svg`, 'utf8'))}")`;
const vars = `--rc:${r.rc};--rc-d:${r.rcD};--rc-l:${r.rcL};--rc-paper:${r.paper};--pat:${r.pat};--edge-v:${edge('v')};--edge-h:${edge('h')}`;
// The emblem is inlined (not an <img>) so it takes the page's colour and can
// draw itself in: every shape in it carries pathLength="1".
const emblemSvg = readFileSync(`public${r.emblem}`, 'utf8')
  .replace(/stroke="#[0-9A-Fa-f]{6}"/, 'stroke="currentColor"')
  .replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
// the ring of text around the medallion: the name and kicker, repeated to fill it
// The ring holds about 66 characters at its 10.5px size; repeat what fits,
// and textLength spreads it evenly round the circle.
const ringBase = (`${r.name} · ${r.kicker} · `).toUpperCase();
const ringText = ringBase.length > 66 ? (`${r.name} · `).toUpperCase().repeat(Math.max(1, Math.floor(66 / (r.name.length + 3))))
  : ringBase.repeat(Math.max(1, Math.floor(66 / ringBase.length)));
const waText = encodeURIComponent(`Hello Algeria Compass, I'd like to plan a journey through ${r.name}.`);
---
<BaseLayout
  title={r.seoTitle}
  description={r.seoDesc}
  image={r.hero}
  imageAlt={`${r.name}, Algeria`}
  region={r.id === 'roman' ? 'roman' : undefined}
  schema={schema}
  sticky={true}>

  <div class="rg rg-page" data-region={r.id} style={vars}>
    <nav class="rg-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> › <a href="/regions/">Regions</a> › {r.name}
    </nav>

    <!-- Split hero. The photograph used to be a full-bleed background stretched
         to 112% of the viewport: every region hero source is about 700px wide
         (the library has only 11 images at 1400px or more, and those are the
         luxury-camp photographs that must not stand for the circuits), so at
         desktop width each one was being blown up roughly 2.2x and arrived as a
         soft wash. A panel narrower than the source downscales instead, which
         is sharp at every viewport, and the region's colour now owns the text
         column outright rather than being painted over the picture. -->
    <header class="rg-hero">
      <div class="rg-hero__in">
        <span class="rg-hero__em rg-draw" set:html={emblemSvg} />
        <span class="rg-hero__kick">{r.kicker}</span>
        <span class="rg-hero__ar" lang="ar">{r.ar}</span>
        <h1 class="rg-hero__title">{r.heading || r.name}</h1>
        <p class="rg-hero__sub">{r.sub}</p>
        <div class="rg-hero__cue" aria-hidden="true">Scroll to explore</div>
      </div>
      <div class="rg-hero__media">
        <img class="rg-hero__img" src={r.hero} alt={`${r.name} — Algeria`} width="736" height="920" fetchpriority="high" decoding="async" />
        <div class="rg-hero__pat" aria-hidden="true"></div>
        <div class="rg-hero__scrim" aria-hidden="true"></div>
      </div>
    </header>

    <!-- Intro -->
    <section class="rg-section rg-wrap">
      <div class="rg-intro">
        <div>
          <span class="rg-eyebrow">The dossier</span>
          <h2 class="rg-h2">{r.name}</h2>
          <p class="rg-lead" style="margin-top:1.2rem">{r.intro[0]}</p>
          <p class="rg-p" style="margin-top:1rem">{r.intro[1]}</p>
        </div>
        <div class="rg-medallion">
          <svg class="rg-ring" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
            <defs><path id="rg-ring-path" d="M100,100 m-84,0 a84,84 0 1,1 168,0 a84,84 0 1,1 -168,0" /></defs>
            <text><textPath href="#rg-ring-path" textLength="527" lengthAdjust="spacing">{ringText}</textPath></text>
          </svg>
          <span class="rg-medallion__em rg-draw" set:html={emblemSvg} />
        </div>
      </div>
    </section>

    <div class="rg-band rg-wrap" aria-hidden="true"><span></span></div>

    <!-- 3D monuments -->
    <section class="rg-monu rg-section">
      <div class="rg-wrap">
        <div class="rg-monu__head">
          <span class="rg-eyebrow">Archaeological &amp; cultural sites</span>
          <h2 class="rg-h2">What to see</h2>
        </div>
        <div class="rg-monu__grid" data-reveal-group>
          {r.monuments.map(m => (
            <div class="rg-mcard">
              <div class="rg-mcard__in">
                <img class="rg-mcard__img" src={m.img} alt={m.t} width="600" height="400" loading="lazy" decoding="async" />
                <div class="rg-mcard__shine" aria-hidden="true"></div>
                <div class="rg-mcard__plate">
                  <div class="rg-mcard__n">{m.n}</div>
                  <div class="rg-mcard__t">{m.t}</div>
                  <div class="rg-mcard__d">{m.d}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Facets -->
    <section class="rg-section rg-wrap">
      <span class="rg-eyebrow">The character of the region</span>
      <h2 class="rg-h2" style="margin-bottom:2.2rem">What defines it</h2>
      <div class="rg-facets">
        {r.facets.map(f => (
          <div class="rg-facet">
            <div class="rg-facet__n">{f[0]}</div>
            <div><h3>{f[1]}</h3><p>{f[2]}</p></div>
          </div>
        ))}
      </div>
    </section>

    <div class="rg-band rg-wrap" aria-hidden="true"><span></span></div>

    <!-- Ledger + gallery -->
    <section class="rg-section rg-wrap" style="padding-top:0">
      <div class="rg-two">
        <div>
          <span class="rg-eyebrow">Travel notes</span>
          <h2 class="rg-h2" style="margin-bottom:1rem">At a glance</h2>
          <div class="rg-ledger">
            {r.facts.map(f => (
              <div class="rg-ledger__row">
                <span class="rg-ledger__k">{f[0]}</span>
                <span class="rg-ledger__dots" aria-hidden="true"></span>
                <span class="rg-ledger__v">{f[1]}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="rg-gal">
          {r.gallery.map(g => (
            <figure><img src={g} alt="" width="400" height="300" loading="lazy" decoding="async" /></figure>
          ))}
        </div>
      </div>
    </section>

    <!-- Explore real pages + CTA -->
    <section class="rg-section rg-wrap" style="padding-top:0">
      <div class="rg-cta">
        <div class="rg-cta__in">
          <span class="rg-cta__em rg-draw" set:html={emblemSvg} />
          <h2 class="rg-h2">Travel {r.name} with us</h2>
          <p>Algeria Compass is a licensed Algerian tour operator. When you’re ready, we’ll craft a private, guided journey through this region with local Algerian guides.</p>
          <div class="rg-links">
            {r.links.map(l => <a href={l.href}>{l.label} →</a>)}
          </div>
          <div class="rg-actions">
            <a class="rg-btn" href={`/contact/?i=${encodeURIComponent(r.name)}`}>Plan a journey →</a>
            <a class="rg-btn rg-btn--ghost" href="/regions/">All regions</a>
          </div>
        </div>
      </div>
      <p style="margin-top:1.6rem"><a class="rg-back" href="/regions/">← Back to all regions</a></p>
    </section>
  </div>

  <script is:inline>
    /* Region page: parallax hero + 3D monument tilt. Pointer-only and
       motion-gated; all content is static HTML and fully readable without JS. */
    (function(){
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      /* Emblems draw themselves in, line by line. Hidden only once this runs,
         so without JS (or with reduced motion) they are simply there. */
      var draws = document.querySelectorAll('.rg-draw');
      document.documentElement.classList.add('rg-anim');
      if ('IntersectionObserver' in window){
        var io = new IntersectionObserver(function(es){
          es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('is-drawn'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -12% 0px' });
        draws.forEach(function(d){ io.observe(d); });
      } else draws.forEach(function(d){ d.classList.add('is-drawn'); });
      var noHover = matchMedia('(hover: none)').matches;
      var hero = document.querySelector('.rg-hero');
      var img = document.querySelector('.rg-hero__img');
      var pat = document.querySelector('.rg-hero__pat');
      var inr = document.querySelector('.rg-hero__in');

      if(hero && img){
        /* Mouse offset and scroll offset are composed into ONE transform per
           element. They used to be written separately to the same style
           property, so whichever fired last erased the other: moving the mouse
           snapped the hero back to the top of its parallax, and scrolling threw
           away the pointer offset. */
        var mx = 0, my = 0, sy = 0, raf = 0;
        /* Split hero: only the photograph moves, inside its own clipped panel,
           and its travel is clamped to the slack its 1.08 scale leaves (about 4%
           of the panel each way) so no edge is ever exposed. The copy column no
           longer drifts: in the full-bleed hero the hero clipped it, but the
           split hero grows with its text and is not clipped, so a scroll-driven
           shift carried the title down over the next section. */
        var clamp = function(v, m){ return Math.max(-m, Math.min(m, v)); };
        function paint(){
          raf = 0;
          var slack = (img.offsetHeight || 600) * 0.035;
          img.style.transform = 'translate(' + clamp(mx*-14, slack).toFixed(1) + 'px,' + clamp(my*-14 + sy*0.06, slack).toFixed(1) + 'px) scale(1.08)';
          if(pat) pat.style.transform = 'translate(' + (mx*20).toFixed(1) + 'px,' + (my*20).toFixed(1) + 'px)';
        }
        function schedule(){ if(!raf) raf = requestAnimationFrame(paint); }

        if(!noHover){
          hero.addEventListener('mousemove', function(e){
            var r = hero.getBoundingClientRect();
            mx = (e.clientX - r.left) / r.width - 0.5;
            my = (e.clientY - r.top) / r.height - 0.5;
            schedule();
          });
          hero.addEventListener('mouseleave', function(){ mx = 0; my = 0; schedule(); });
        }
        window.addEventListener('scroll', function(){
          var y = window.pageYOffset || 0;
          if(y < 900){ sy = y; schedule(); }
        }, { passive:true });
      }

      /* Monument cards.
         The tilt and the cursor-tracking shine were behind `!noHover`, so on a
         phone — where most of this site is read — the cards did nothing at all.
         Touch now gets its own treatment instead of the desktop one: the cards
         rise into place as they scroll in, staggered, and press down when
         tapped. Pointer devices keep the tilt. */
      var cards = Array.prototype.slice.call(document.querySelectorAll('.rg-mcard'));

      if(!noHover){
        cards.forEach(function(card){
          var inner = card.querySelector('.rg-mcard__in');
          if(!inner) return;
          card.addEventListener('mousemove', function(e){
            var r = card.getBoundingClientRect();
            var px = (e.clientX - r.left) / r.width - 0.5;
            var py = (e.clientY - r.top) / r.height - 0.5;
            inner.style.transition = 'transform .1s linear';
            inner.style.transform = 'perspective(1000px) rotateY(' + (px*14).toFixed(2) + 'deg) rotateX(' + (-py*14).toFixed(2) + 'deg)';
            inner.style.setProperty('--gx', ((px+0.5)*100).toFixed(1) + '%');
            inner.style.setProperty('--gy', ((py+0.5)*100).toFixed(1) + '%');
          });
          card.addEventListener('mouseleave', function(){
            inner.style.transition = 'transform .6s cubic-bezier(.2,.7,.2,1)';
            inner.style.transform = 'perspective(1000px) rotateY(0) rotateX(0)';
          });
        });
      }

      /* The cards' entrance and its stagger are the site-wide reveal system in
         BaseLayout, opted into with data-reveal-group on the grid in the markup
         above -- not a second mechanism here. */
    })();
  </script>
    <section class="section"><div class="wrap">
      <p style="color:var(--text-l);max-width:62ch">Curious about the civilisations behind this region — Amazigh, Roman, Andalusian, Ottoman and Saharan? Read the full <a href="/culture/" style="text-decoration:underline">Algerian culture guide</a>.</p>
    </div></section>
</BaseLayout>
