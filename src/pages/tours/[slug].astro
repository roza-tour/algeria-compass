---
import Icon from '../../components/Icon.astro';
import { nobr } from '../../lib/nobr';
import fs from 'node:fs';
import sharp from 'sharp';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import data from '../../data/tours.json';
import { TOUR_VISUALS } from '../../data/tour-visuals';
import { tourGallery } from '../../data/tour-photos';
import RegionSeal from '../../components/RegionSeal.astro';
import TourCard from '../../components/TourCard.astro';
import TourReviews from '../../components/TourReviews.astro';
import RouteMap from '../../components/RouteMap.astro';
import JourneyHero from '../../components/JourneyHero.astro';
import HeroReel from '../../components/HeroReel.astro';
import { dayPhotos } from '../../lib/journeyPhotos';
import { tourStory } from '../../lib/tourStory.mjs';
import { journeyOf } from '../../lib/journey.mjs';
import { REGIONS } from '../../data/regions';
import BestMonths from '../../components/BestMonths.astro';
import { TOUR_VISUALS } from '../../data/tour-visuals';
import { regionForTour } from '../../data/tourRegions.mjs';
import '../../styles/tour-regions.css';
import ItineraryOffer from '../../components/ItineraryOffer.astro';
import GuideBadge from '../../components/GuideBadge.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import { CONTACT, BOOKING } from '../../config';
import { TOURS_FR } from '../../data/tours-fr';
import { TOURS_IT } from '../../data/tours-it';
import { TOURS_ES } from '../../data/tours-es';
import { TOURS_DE } from '../../data/tours-de';
import { alternatesFor } from '../../i18n';

const tours = (data as any).tours || (data as any);

// theme -> accent region (reuses the [data-region] system in global.css)
const REGION: Record<string,string> = {
  culture: '', sahara: 'sahara', mzab: 'mzab', west: 'andalusian',
  city: 'coast', east: 'roman', coast: 'coast', roman: 'roman'
};

export async function getStaticPaths() {
  const list = ((data as any).tours || (data as any)) as any[];
  return list.map(t => ({ params: { slug: t.id }, props: { tour: t } }));
}

const { tour } = Astro.props as { tour: any };

// Bidirectional hreflang: only tours that actually have a French detail page are
// paired, so no hreflang ever points at a URL that is not built.
const siteUrl = (Astro.site?.toString() || 'https://algeriacompass.com').replace(/\/$/, '');
const frAlternates = (TOURS_FR[tour.id]?.full || TOURS_IT[tour.id]?.full || TOURS_ES[tour.id]?.full || TOURS_DE[tour.id]?.full)
  ? alternatesFor(siteUrl, {
      en: `/tours/${tour.id}/`,
      fr: TOURS_FR[tour.id]?.full ? `/fr/circuits/${tour.id}/` : undefined,
      it: TOURS_IT[tour.id]?.full ? `/it/circuiti/${tour.id}/` : undefined,
      es: TOURS_ES[tour.id]?.full ? `/es/circuitos/${tour.id}/` : undefined,
      de: TOURS_DE[tour.id]?.full ? `/de/reisen/${tour.id}/` : undefined,
    })
  : [];

// Internal-linking: connect this tour to the State pages it actually visits, and to
// similar tours — so tour pages are no longer crawl dead-ends. Provinces are filtered
// to ones that exist as pages; similar tours share the same theme.
const provinceSlugs = new Set((await getCollection('province')).map(p => p.slug));
const coveredProvinces = (tour.wilayas || []).filter((w: string) => provinceSlugs.has(w));
// Similar tours, shown as cards: the same region first (closest in feel and
// geography), then the same theme, then nearest in price.
const myRegion = regionForTour(tour);
const relatedTours = tours.filter((t: any) => t.id !== tour.id)
  .map((t: any) => ({ t, score: (regionForTour(t) === myRegion ? 2 : 0) + (t.theme === tour.theme ? 1 : 0) - Math.abs(t.price_eur - tour.price_eur) / 10000 }))
  .sort((a: any, b: any) => b.score - a.score).slice(0, 3).map((x: any) => x.t);
const favImg = (() => { const h = (TOUR_VISUALS as any)[tour.id]?.hero || `${tour.image_slugs[0]}-1.jpg`; return `/assets/img/thumbs/tours/${h}`; })();

// Build the gallery from real files on disk: assets/img/tours/<slug>-N.jpg,
// best photos first and alternating between the tour's places (see tour-photos.ts).
let gallery: { file: string; alt?: string }[] = [];
try {
  gallery = tourGallery(tour.image_slugs, fs.readdirSync('public/assets/img/tours'));
} catch (e) { gallery = []; }

const site = (Astro.site?.toString() || 'https://algeriacompass.com').replace(/\/$/, '');
const url = `${site}/tours/${tour.id}/`;
const region = REGION[tour.theme] ?? '';
// Per-tour visual identity: distinct correct hero + accent token (see tour-visuals.ts)
const visual = TOUR_VISUALS[tour.id] || { hero: `${tour.image_slugs[0]}-1.jpg`, accent: '#0B3D2E' };
const needsImage = !!visual.needsImage || !visual.hero;
const hero = needsImage ? '' : `/assets/img/tours/${visual.hero}`;
// Display-sized WebP sibling (scripts/gen-webp.mjs) with JPG fallback for the LCP hero.
// The .sm variant is 460px wide, which is right on a phone and soft on a
// desktop hero — every tour was serving it to every device. Where a .lg
// sibling exists it is offered above 640px; tours without one are unaffected.
const heroWebp = hero && /\.jpe?g$/i.test(hero) ? hero.replace(/\.jpe?g$/i, '.sm.webp') : '';
const heroWebpLg = hero && /\.jpe?g$/i.test(hero) ? hero.replace(/\.jpe?g$/i, '.lg.webp') : '';
const hasHeroLg = !!heroWebpLg && fs.existsSync('public' + heroWebpLg);
const accent = visual.accent;
const ogImage = hero || '/assets/img/og-image.png';
// Real dimensions of the primary image — honest ImageObject schema + correct
// intrinsic ratio (these portrait hero photos are NOT the old hardcoded 1600×900).
let imgW = 1200, imgH = 630;
try {
  const meta = await sharp('public' + ogImage).metadata();
  if (meta.width && meta.height) { imgW = meta.width; imgH = meta.height; }
} catch (e) { /* fall back to og-image dimensions */ }
// Human-readable touristType (was emitting the internal theme code, e.g. "sahara").
const TTYPE: Record<string,string> = {
  culture: 'Cultural & heritage travel', sahara: 'Sahara & desert adventure',
  mzab: 'Desert & cultural heritage', west: 'Cultural & heritage travel',
  city: 'City & cultural sightseeing', east: 'Roman & ancient-history travel',
  coast: 'Coastal & cultural travel', roman: 'Roman & ancient-history travel'
};
// "Where you'll be" map — uses the tour's real coordinates (tour.map)
const m = tour.map || { lat: 36.7538, lng: 3.0588 };
const bbox = `${(m.lng - 0.9).toFixed(4)},${(m.lat - 0.55).toFixed(4)},${(m.lng + 0.9).toFixed(4)},${(m.lat + 0.55).toFixed(4)}`;
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${m.lat}%2C${m.lng}`;
const mapLink = `https://www.openstreetmap.org/?mlat=${m.lat}&mlon=${m.lng}#map=7/${m.lat}/${m.lng}`;
const wilayaNames = (tour.wilayas || []).map((w: string) => w.replace(/-/g, ' '));
const priceLabel = `${tour.price_from ? 'From ' : ''}€${tour.price_eur} / ${tour.per}`;
const waText = encodeURIComponent(`Hello Algeria Compass, I'd like to book the "${tour.title}".`);
const days = (tour.itinerary || []).length;
// Long tours that cross regions get their own design: the journey's regions in
// the hero, each day in its region's colour, a divider when the route enters a
// new region (src/lib/journey.mjs reads the places from the itinerary itself).
const journey = journeyOf(tour);
const isJourney = days >= 3 && journey.regions.length >= 2;
const RG: Record<string, any> = Object.fromEntries(REGIONS.map(r => [r.id, r]));
let lastRegion = '';
const dayView = (tour.itinerary || []).map((d: any, i: number) => {
  const jd = journey.days[i] || { regions: [] };
  const region = jd.regions[jd.regions.length - 1] || lastRegion;
  const enters = isJourney && region && region !== lastRegion ? RG[region] : null;
  lastRegion = region || lastRegion;
  return { d, r: isJourney && region ? RG[region] : null, enters, names: jd.regions.map((x: string) => RG[x]?.name).filter(Boolean) };
});
// Tours of three days or more are told as a story: a photograph for every day
// (from the place that day is about, never repeated), the hero as a reel of
// those days, and the itinerary as chapters.
const story = days >= 3;
const photos = story ? dayPhotos(journey.days, [visual.hero]) : [];
dayView.forEach((v: any, i: number) => { v.photo = photos[i] || null; });
// the reel and its captions: the same logic as the translated pages (lib/tourStory.mjs)
const st = tourStory(tour, tour.itinerary || [], 'en', visual.hero);
const reel = st.reel;
const schema = [
  {
    '@type': 'TouristTrip',
    '@id': url + '#trip',
    name: tour.title,
    description: tour.summary,
    url,
    image: site + ogImage,
    touristType: TTYPE[tour.theme] || 'Guided travel',
    ...(days ? { duration: `P${days}D` } : {}),
    provider: { '@id': site + '/#organization' },
    offers: {
      '@type': 'Offer',
      price: tour.price_eur,
      priceCurrency: 'EUR',
      availability: 'https://schema.org/InStock',
      url
    },
    // Each day is a TouristDestination and its named stops are the attractions
    // it includes. That is the vocabulary search and answer engines can
    // actually read a per-day answer out of ("what do I see on day 3?"), which
    // a flat list of day summaries cannot support.
    itinerary: {
      '@type': 'ItemList',
      numberOfItems: days,
      itemListElement: (tour.itinerary || []).map((d: any) => ({
        '@type': 'ListItem',
        position: d.day,
        name: `Day ${d.day}: ${d.title}`,
        item: {
          '@type': 'TouristDestination',
          name: `Day ${d.day}: ${d.title}`,
          description: d.body,
          ...(d.stops?.length ? {
            includesAttraction: d.stops.map((s: any) => ({
              '@type': 'TouristAttraction', name: s.place, description: s.text
            }))
          } : {})
        }
      }))
    }
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site + '/' },
      { '@type': 'ListItem', position: 2, name: 'Tours', item: site + '/tours/' },
      { '@type': 'ListItem', position: 3, name: tour.title, item: url }
    ]
  },
  {
    '@type': 'ImageObject',
    '@id': url + '#primaryimage',
    url: site + ogImage,
    contentUrl: site + ogImage,
    width: imgW,
    height: imgH,
    caption: `${tour.title} — Algeria`
  }
];
if (tour.faqs && tour.faqs.length) schema.push({
  '@type': 'FAQPage', '@id': url + '#faq',
  mainEntity: tour.faqs.map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
});
---
<BaseLayout speakable={['h1', '.tour-hook', '.tour-lead']}
  title={tour.title}
  description={tour.summary}
  image={ogImage}
  region={region}
  rgn={regionForTour(tour)}
  keywords={[tour.title.split(' — ')[0], 'Algeria tour', ...((tour.wilayas||[]).map((w: string)=>w.replace(/-/g,' ')+' tour')), 'Algeria travel']}
  schema={schema}
  alternates={frAlternates}
  sticky={false}>
  <link slot="head" rel="alternate" type="text/plain" href={`/tours/${tour.id}.txt`} title="Text version for AI assistants" />

  <div class="tour" style={`--accent:${accent}`}>
  <section class={`hero${needsImage ? ' hero-gradient' : ''}`} data-region={region}>
    {!needsImage && (
      <picture>
        {hasHeroLg && <source srcset={heroWebpLg} type="image/webp" media="(min-width: 641px)" />}
        {heroWebp && <source srcset={heroWebp} type="image/webp" />}
        <img src={hero} alt={`${tour.title} — Algeria`} width={imgW} height={imgH} fetchpriority="high" decoding="async" />
      </picture>
    )}
    {story && <HeroReel slides={reel} first={st.heroCaption} />}
    <div class="hero-in wrap">
      {isJourney ? <JourneyHero regions={journey.regions} /> : <RegionSeal region={regionForTour(tour)} />}
      <div class="eyebrow">Private guided tour · {tour.duration}</div>
      <h1>{nobr(tour.title)}</h1>
      <p class="tour-hook">{tour.hook ?? tour.summary}</p>
      <GuideBadge lang="en" tourTitle={tour.title} url={`${site}/tours/${tour.id}/`} />
      <p style="margin-top:1rem">
        <a class="btn btn-gold" href="#book" data-evt="book_intent">Request to book →</a>
        <a class="btn btn-ghost" href={`https://wa.me/213784193176?text=${waText}`} target="_blank" rel="noopener" style="color:#fff;border-color:rgba(255,255,255,.5)"><Icon name="whatsapp" /> Book on WhatsApp</a>
      </p>
    </div>
  </section>

  <nav class="crumbs wrap" aria-label="Breadcrumb"><a href="/">Home</a> › <a href="/tours/">Tours</a> › {tour.title}</nav>

  <section class="section"><div class="wrap" style="display:grid;grid-template-columns:1fr 320px;gap:2rem;align-items:start">
    <div>
      {tour.overview && <><h2>Overview</h2><p class="tour-lead">{tour.overview}</p></>}

      <h2 style={tour.overview ? 'margin-top:2rem' : undefined}>Highlights</h2>
      <ul class="tour-highlights">
        {tour.highlights.map((h: string) => <li>{h}</li>)}
      </ul>

      {tour.whyDifferent && tour.whyDifferent.length > 0 &&
        <><h2 style="margin-top:2rem">Why this trip is different</h2>
        <ul class="why-grid">
          {tour.whyDifferent.map((w: any) => <li><strong>{w.t}</strong><span>{w.d}</span></li>)}
        </ul></>}

      <h2 style="margin-top:2rem">Day-by-day itinerary</h2>
      {story ? (
      <ol class="chapters">
        {dayView.map(({ d, r, enters, names, photo }: any, i: number) => (<>
          {enters && (
            <li class="chap-enter" style={`--rc:${enters.rc};--pat:${enters.pat}`}>
              <span class="iday-enter-em"><img src={enters.emblem} alt="" width="38" height="38" loading="lazy" /></span>
              <span class="iday-enter-t"><small>On to</small> <a href={`/regions/${enters.id}/`}>{enters.heading || enters.name}</a></span>
            </li>
          )}
          <li class={`chap${photo ? '' : ' chap--text'}${i % 2 ? ' chap--flip' : ''}`} style={r ? `--accent:${r.rc}` : undefined} data-reveal>
            {photo && (
              <figure class="chap-fig">
                <img src={`/assets/img/tours/${photo.file}`} alt={photo.alt || d.title} width="736" height="552" loading="lazy" decoding="async" />
                <span class="chap-no" aria-hidden="true">{String(d.day).padStart(2, '0')}</span>
              </figure>
            )}
            <div class="chap-body">
              <span class="iday-num">Day {d.day}{r && names.length > 0 && <span class="iday-tag"> · {names.join(' → ')}</span>}</span>
              <h3 class="chap-t">{d.title}</h3>
              <p>{d.body}</p>
              {d.stops && d.stops.length > 0 &&
                <ul class="iday-stops">
                  {d.stops.map((st: any) => <li><strong>{st.place}</strong> — {st.text}</li>)}
                </ul>}
              {d.note && <p class="iday-note">{d.note}</p>}
            </div>
          </li>
        </>))}
      </ol>
      ) : (
      <ol class="itinerary" data-reveal-group>
        {dayView.map(({ d, r, enters, names }: any) => (<>
          {enters && (
            <li class="iday-enter" style={`--rc:${enters.rc};--pat:${enters.pat}`}>
              <span class="iday-enter-em"><img src={enters.emblem} alt="" width="34" height="34" loading="lazy" /></span>
              <span class="iday-enter-t"><small>On to</small> <a href={`/regions/${enters.id}/`}>{enters.heading || enters.name}</a></span>
            </li>
          )}
          <li class={r ? 'iday-r' : undefined} style={r ? `--accent:${r.rc}` : undefined}>
            <span class="iday-num">Day {d.day}{r && names.length > 0 && <span class="iday-tag"> · {names.join(' → ')}</span>}</span>
            <strong>{d.title}</strong>
            <p>{d.body}</p>
            {d.stops && d.stops.length > 0 &&
              <ul class="iday-stops">
                {d.stops.map((s: any) => <li><strong>{s.place}</strong> — {s.text}</li>)}
              </ul>}
            {d.note && <p class="iday-note">{d.note}</p>}
          </li>
        </>))}
      </ol>
      )}

      <ItineraryOffer tourId={tour.id} tourTitle={tour.title} printHref={`/tours/${tour.id}/print/`} />

      <div class="incl-grid">
        <div class="facts"><h3>What's included</h3><ul>{tour.includes.map((i: string) => <li>{i}</li>)}</ul></div>
        {tour.excludes && tour.excludes.length > 0 &&
          <div class="facts"><h3>Not included</h3><ul>{tour.excludes.map((i: string) => <li>{i}</li>)}</ul></div>}
      </div>

      {tour.goodToKnow && tour.goodToKnow.length > 0 &&
        <><h2 style="margin-top:2rem">Good to know</h2>
        <BestMonths season={((tour.goodToKnow || []).find((g: any) => g.label === 'Best season') || {}).value} />
        <dl class="gtk">
          {tour.goodToKnow.map((g: any) => <><dt>{g.label}</dt><dd>{g.value}</dd></>)}
        </dl></>}

      <aside class="visa-note">
        <strong><Icon name="passport" /> Visa &amp; entry</strong>
        {(tour.theme === 'sahara' || tour.theme === 'mzab')
          ? <p>This trip heads into the Sahara, so the <a href="/evisa/#saharan-evisa">Saharan e-Visa</a> applies: as your licensed operator we prepare every file free and issue your QR-verified authorisation document ($45); the visa sticker tax is paid on arrival. <a href="/evisa/#saharan-evisa">See how it works →</a></p>
          : <p>We prepare your invitation letter ($25) for any programme of 3+ days with airport transfers — and if your trip includes the desert you may qualify for the <a href="/evisa/#saharan-evisa">Saharan e-Visa</a>. <a href="/evisa/">How entry to Algeria works →</a></p>}
      </aside>
    </div>

    <aside class="book-widget">
      <div class="bw-price">{tour.price_from ? 'From ' : ''}<span data-eur={tour.price_eur}>€{tour.price_eur}</span></div>
      <div class="bw-per">per person · {tour.duration}
        <select class="bw-cur" data-cur-select aria-label="Show prices in">
          <option value="EUR">EUR</option><option value="USD">USD</option><option value="GBP">GBP</option>
        </select>
      </div>
      <a class="bw-rating" href="https://share.google/rEAjf9e2qvCwefa2X" target="_blank" rel="noopener"><span aria-hidden="true">★★★★★</span> 5.0 on Google · 9 reviews</a>
      <div class="bw-meta">Starts: {tour.start}</div>
      <div class="bw-meta">🇩🇿 Licensed Algerian operator</div>
      {tour.includes && tour.includes.length > 0 &&
        <ul class="bw-incl">
          {tour.includes.slice(0, 4).map((i: string) => <li>{i}</li>)}
          {tour.includes.length > 4 && <li class="bw-more">+ more — see what’s included below</li>}
        </ul>}
      <a class="btn btn-gold bw-cta" href="#book" data-evt="book_intent">Request to book</a>
      <a class="btn btn-wa-2 bw-cta" href={`https://wa.me/213784193176?text=${waText}`} target="_blank" rel="noopener"><Icon name="whatsapp" /> Book on WhatsApp</a>
      <button type="button" class="bw-save" data-fav={tour.id} data-title={tour.title} data-price={tour.price_eur} data-img={favImg} aria-pressed="false">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 20.3l-1.3-1.2C6 14.9 3 12.2 3 8.9 3 6.2 5.1 4.2 7.7 4.2c1.5 0 3 .7 3.9 1.9l.4.5.4-.5c.9-1.2 2.4-1.9 3.9-1.9 2.6 0 4.7 2 4.7 4.7 0 3.3-3 6-7.7 10.2z"/></svg>
        <span class="bw-save-off">Save to my shortlist</span><span class="bw-save-on">Saved to your shortlist</span>
      </button>
      <ul class="bw-guar">
        <li>Dates held free for {BOOKING.holdHours} hours — no payment</li>
        <li>Visa refused? Full refund</li>
        <li>Confirmed price locked — never goes up</li>
        <li>Free cancellation up to {BOOKING.cancelDays} days before</li>
        <li>−{BOOKING.earlyPct}% when you book {BOOKING.earlyDays}+ days ahead</li>
      </ul>
      <p class="bw-terms">No payment to request. Once we confirm, a {BOOKING.depositPct}% deposit by bank transfer, card or PayPal secures your trip; the balance is paid on arrival in Algeria. <a href="/booking-terms/#guarantees">Our guarantees</a></p>
    </aside>
  </div></section>

  {!needsImage && gallery.length > 0 &&
    <section class="section" style="background:var(--wash)"><div class="wrap photo-gallery">
      <h2>Gallery</h2>
      <div class="pgrid" data-reveal-group data-lightbox>
        {gallery.map((g) => (
          <figure><img src={`/assets/img/thumbs/tours/${g.file}`} alt={g.alt || tour.title} width="400" height="400" loading="lazy" /></figure>
        ))}
      </div>
    </div></section>}

  <TourReviews tourTitle={tour.title} />

  <section class="section"><div class="wrap">
    <h2>Where you'll be</h2>
    <p class="map-route">Starts in <strong>{tour.start}</strong>. This itinerary covers <span class="caps">{wilayaNames.join(', ')}</span>.</p>
    <RouteMap wilayas={tour.wilayas || []} sequence={journey.sequence} accent={accent} label={`Route of ${tour.title}`} />
    <p style="margin-top:.5rem;font-size:.85rem"><a href={mapLink} target="_blank" rel="noopener">Open in Google Maps →</a></p>
  </div></section>

  <section class="section"><div class="wrap">
    <h2>Continue exploring</h2>
    {coveredProvinces.length > 0 &&
      <p class="explore-row">States on this route: {coveredProvinces.map((w: string, i: number) => (<>{i > 0 && <span aria-hidden="true"> · </span>}<a class="caps" href={`/provinces/${w}/`}>{w.replace(/-/g, ' ')}</a></>))}</p>}
    {relatedTours.length > 0 && <>
      <h3 class="rel-h">You may also like</h3>
      <div class="grid rel-grid" data-reveal-group>
        {relatedTours.map((t: any, i: number) => <TourCard tour={t} index={i} />)}
      </div>
    </>}
    <p class="explore-row">Browse all <a href="/tours/">tours</a>, <a href="/destinations/">destinations</a>, <a href="/regions/">regions</a> and <a href="/experiences/">experiences</a>.</p>
  </div></section>

  {tour.faqs && tour.faqs.length > 0 &&
    <section class="section" style="background:var(--wash)"><div class="wrap" style="max-width:820px">
      <h2>Tour FAQ</h2>
      <div class="faq">
        {tour.faqs.map((f: any) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </div></section>}

  <!-- Booking promises and payment methods come from BOOKING in src/config.ts.
       The secure card/PayPal link is sent once dates are confirmed. -->
  <section id="book" class="section book-sec"><div class="wrap">
    <div class="book-head">
      <span class="eyebrow">Request to book</span>
      <h2>Book this trip</h2>
