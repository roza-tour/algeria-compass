---
import fs from 'node:fs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import data from '../../data/tours.json';
import { TOUR_VISUALS } from '../../data/tour-visuals';
import { skinForTour } from '../../data/civSkins.mjs';

const tours = (data as any).tours || (data as any);

// theme -> accent region (reuses the [data-region] system in global.css)
const REGION: Record<string,string> = {
  culture: '', sahara: 'sahara', mzab: 'mzab', west: 'andalusian',
  city: 'coast', east: 'roman', coast: 'coast', roman: 'roman'
};

export async function getStaticPaths() {
  const list = ((data as any).tours || (data as any)) as any[];
  return list.map(t => ({ params: { slug: t.id }, props: { tour: t } }));
}

const { tour } = Astro.props as { tour: any };

// Build the gallery from real files on disk: assets/img/tours/<slug>-N.jpg
let gallery: string[] = [];
try {
  const files = fs.readdirSync('public/assets/img/tours');
  for (const s of tour.image_slugs) {
    const matches = files
      .filter((f: string) => /^.+-\d+\.jpg$/i.test(f) && f.toLowerCase().startsWith(s.toLowerCase() + '-'))
      .sort((a: string, b: string) => (parseInt(a.match(/-(\d+)\./)![1]) - parseInt(b.match(/-(\d+)\./)![1])));
    gallery.push(...matches.map((f: string) => f));
  }
} catch (e) { gallery = []; }

const site = (Astro.site?.toString() || 'https://algeriacompass.com').replace(/\/$/, '');
const url = `${site}/tours/${tour.id}/`;
const region = REGION[tour.theme] ?? '';
// Per-tour visual identity: distinct correct hero + accent token (see tour-visuals.ts)
const visual = TOUR_VISUALS[tour.id] || { hero: `${tour.image_slugs[0]}-1.jpg`, accent: '#0B3D2E' };
const needsImage = !!visual.needsImage || !visual.hero;
const hero = needsImage ? '' : `/assets/img/tours/${visual.hero}`;
const accent = visual.accent;
const ogImage = hero || '/assets/img/og-image.png';
// "Where you'll be" map — uses the tour's real coordinates (tour.map)
const m = tour.map || { lat: 36.7538, lng: 3.0588 };
const bbox = `${(m.lng - 0.9).toFixed(4)},${(m.lat - 0.55).toFixed(4)},${(m.lng + 0.9).toFixed(4)},${(m.lat + 0.55).toFixed(4)}`;
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${m.lat}%2C${m.lng}`;
const mapLink = `https://www.openstreetmap.org/?mlat=${m.lat}&mlon=${m.lng}#map=7/${m.lat}/${m.lng}`;
const wilayaNames = (tour.wilayas || []).map((w: string) => w.replace(/-/g, ' '));
const priceLabel = `${tour.price_from ? 'From ' : ''}€${tour.price_eur} / ${tour.per}`;
const waText = encodeURIComponent(`Hello Algeria Compass, I'd like to book the "${tour.title}".`);
const days = (tour.itinerary || []).length;
const schema = [
  {
    '@type': 'TouristTrip',
    '@id': url + '#trip',
    name: tour.title,
    description: tour.summary,
    url,
    image: site + ogImage,
    touristType: tour.theme,
    ...(days ? { duration: `P${days}D` } : {}),
    provider: { '@id': site + '/#organization' },
    offers: {
      '@type': 'Offer',
      price: tour.price_eur,
      priceCurrency: 'EUR',
      availability: 'https://schema.org/InStock',
      url
    },
    itinerary: {
      '@type': 'ItemList',
      numberOfItems: days,
      itemListElement: (tour.itinerary || []).map((d: any) => ({
        '@type': 'ListItem', position: d.day, name: `Day ${d.day}: ${d.title}`, description: d.body
      }))
    }
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site + '/' },
      { '@type': 'ListItem', position: 2, name: 'Tours', item: site + '/tours/' },
      { '@type': 'ListItem', position: 3, name: tour.title, item: url }
    ]
  }
];
if (tour.faqs && tour.faqs.length) schema.push({
  '@type': 'FAQPage', '@id': url + '#faq',
  mainEntity: tour.faqs.map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
});
---
<BaseLayout
  title={`${tour.title} | Algeria Compass`}
  description={tour.summary}
  image={ogImage}
  region={region}
  civ={skinForTour(tour)}
  schema={schema}
  sticky={true}>

  <div class="tour" style={`--accent:${accent}`}>
  <section class={`hero${needsImage ? ' hero-gradient' : ''}`} data-region={region}>
    {!needsImage && <img src={hero} alt={`${tour.title} — Algeria`} width="1600" height="900" />}
    <div class="hero-in wrap">
      <div class="eyebrow">Private guided tour · {tour.duration}</div>
      <h1>{tour.title}</h1>
      <p>{tour.hook ?? tour.summary}</p>
      <p style="margin-top:1rem">
        <a class="btn btn-gold" href={`https://wa.me/213784193176?text=${waText}`} target="_blank" rel="noopener">Book on WhatsApp</a>
        <a class="btn btn-ghost" href="/contact/" style="color:#fff;border-color:rgba(255,255,255,.5)">Request a quote</a>
      </p>
    </div>
  </section>

  <nav class="crumbs wrap" aria-label="Breadcrumb"><a href="/">Home</a> › <a href="/tours/">Tours</a> › {tour.title}</nav>

  <section class="section"><div class="wrap" style="display:grid;grid-template-columns:1fr 320px;gap:2rem;align-items:start">
    <div>
      {tour.overview && <><h2>Overview</h2><p class="tour-lead">{tour.overview}</p></>}

      <h2 style={tour.overview ? 'margin-top:2rem' : undefined}>Highlights</h2>
      <ul class="tour-highlights">
        {tour.highlights.map((h: string) => <li>{h}</li>)}
      </ul>

      {tour.whyDifferent && tour.whyDifferent.length > 0 &&
        <><h2 style="margin-top:2rem">Why this trip is different</h2>
        <ul class="why-grid">
          {tour.whyDifferent.map((w: any) => <li><strong>{w.t}</strong><span>{w.d}</span></li>)}
        </ul></>}

      <h2 style="margin-top:2rem">Day-by-day itinerary</h2>
      <ol class="itinerary">
        {tour.itinerary.map((d: any) => (
          <li>
            <span class="iday-num">Day {d.day}</span>
            <strong>{d.title}</strong>
            <p>{d.body}</p>
          </li>
        ))}
      </ol>

      <div class="incl-grid">
        <div class="facts"><h3>What's included</h3><ul>{tour.includes.map((i: string) => <li>{i}</li>)}</ul></div>
        {tour.excludes && tour.excludes.length > 0 &&
          <div class="facts"><h3>Not included</h3><ul>{tour.excludes.map((i: string) => <li>{i}</li>)}</ul></div>}
      </div>

      {tour.goodToKnow && tour.goodToKnow.length > 0 &&
        <><h2 style="margin-top:2rem">Good to know</h2>
        <dl class="gtk">
          {tour.goodToKnow.map((g: any) => <><dt>{g.label}</dt><dd>{g.value}</dd></>)}
        </dl></>}
    </div>

    <aside class="book-widget">
      <div class="bw-price">{priceLabel}</div>
      <div class="bw-meta">{tour.duration}</div>
      <div class="bw-meta">Starts: {tour.start}</div>
      <div class="bw-meta">🇩🇿 Licensed Algerian operator</div>
      <a class="btn btn-gold" style="width:100%;text-align:center;margin-top:.8rem" href={`https://wa.me/213784193176?text=${waText}`} target="_blank" rel="noopener">Book on WhatsApp</a>
      <a class="btn" style="width:100%;text-align:center;margin-top:.5rem" href="/contact/">Request a custom quote</a>
    </aside>
  </div></section>

  {!needsImage && gallery.length > 0 &&
    <section class="section" style="background:var(--wash)"><div class="wrap photo-gallery">
      <h2>Gallery</h2>
      <div class="pgrid">
        {gallery.slice(0, 18).map((f: string) => (
          <figure><img src={`/assets/img/thumbs/tours/${f}`} alt={tour.title} width="400" height="400" loading="lazy" /></figure>
        ))}
      </div>
    </div></section>}

  <section class="section"><div class="wrap">
    <h2>Where you'll be</h2>
    <p class="map-route">Starts in <strong>{tour.start}</strong>. This itinerary covers <span class="caps">{wilayaNames.join(', ')}</span>.</p>
    <iframe class="tour-map" title={`Map of ${tour.title}`} src={mapSrc} loading="lazy" width="100%" height="320"></iframe>
    <p style="margin-top:.5rem;font-size:.85rem"><a href={mapLink} target="_blank" rel="noopener">View larger map →</a></p>
  </div></section>

  {tour.faqs && tour.faqs.length > 0 &&
    <section class="section" style="background:var(--wash)"><div class="wrap" style="max-width:820px">
      <h2>Tour FAQ</h2>
      <div class="faq">
        {tour.faqs.map((f: any) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </div></section>}

  <section class="section"><div class="wrap" style="text-align:center">
    <div class="cta">
      <h2>Ready to go?</h2>
      <p style="margin-top:.5rem">{priceLabel} · {tour.duration} · Licensed Algerian operator.</p>
      <p style="margin-top:1rem">
        <a class="btn btn-gold" href={`https://wa.me/213784193176?text=${waText}`} target="_blank" rel="noopener">Book on WhatsApp</a>
        <a class="btn" href="/contact/">Request a custom quote</a>
      </p>
    </div>
  </div></section>
  </div>

</BaseLayout>

<style>
.tour-highlights{list-style:none;padding:0;margin:1rem 0;display:grid;gap:.5rem}
.tour-highlights li{padding-left:1.6rem;position:relative;color:var(--text-m)}
.tour-highlights li::before{content:"✦";position:absolute;left:0;color:var(--accent)}
.itinerary{list-style:none;padding:0;margin:1rem 0;border-left:2px solid var(--border)}
.itinerary li{position:relative;padding:0 0 1.4rem 1.3rem}
.itinerary li::before{content:"";position:absolute;left:-7px;top:.3rem;width:12px;height:12px;border-radius:50%;background:var(--accent)}
.iday-num{display:block;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--accent)}
.itinerary strong{display:block;margin:.1rem 0 .2rem;color:var(--green-d)}
.itinerary p{color:var(--text-m);margin:0}
.incl-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1.5rem}
.facts ul{list-style:none;padding:0;margin:0}
.facts li{padding:.25rem 0 .25rem 1.3rem;position:relative;font-size:.9rem;color:var(--text-m)}
.facts li::before{content:"✓";position:absolute;left:0;color:var(--green)}
.book-widget{position:sticky;top:90px;background:var(--green-d);color:#fff;border:1px solid rgba(201,162,75,.3);border-radius:14px;padding:1.3rem}
.bw-price{font-family:var(--serif);font-size:1.6rem;font-weight:800;color:var(--gold-l)}
.bw-meta{font-size:.85rem;color:rgba(255,255,255,.75);margin-top:.3rem}
/* ===== per-tour accent identity ===== */
.tour h2{color:var(--accent)}
.tour .crumbs a{color:var(--accent)}
.tour .btn-gold{background:var(--accent);color:#fff}
.tour .btn-gold:hover{background:var(--accent);filter:brightness(1.1)}
.tour .book-widget{border-top:4px solid var(--accent)}
.tour .bw-price{color:#fff}
.hero-gradient{background:linear-gradient(135deg,var(--accent),var(--green-d))}
.hero-gradient::after{background:linear-gradient(90deg,rgba(7,38,28,.5),rgba(7,38,28,.12) 70%)}
.tour-map{border:1px solid var(--border);border-radius:12px;width:100%;display:block}
.map-route{color:var(--text-m);margin:.3rem 0 1rem}
.tour-lead{font-size:1.06rem;line-height:1.65;color:var(--text-d,#2b2b2b)}
.why-grid{list-style:none;padding:0;margin:1rem 0;display:grid;gap:.8rem}
.why-grid li{padding-left:1.6rem;position:relative}
.why-grid li::before{content:"✦";position:absolute;left:0;color:var(--accent)}
.why-grid strong{display:block;color:var(--green-d)}
.why-grid span{color:var(--text-m);font-size:.93rem}
.gtk{display:grid;grid-template-columns:auto 1fr;gap:.4rem 1rem;margin:1rem 0}
.gtk dt{font-weight:700;color:var(--accent);font-size:.85rem;text-transform:uppercase;letter-spacing:.04em}
.gtk dd{margin:0;color:var(--text-m)}
.caps{text-transform:capitalize}
@media(max-width:820px){
  .section .wrap[style]{grid-template-columns:1fr !important}
  .book-widget{position:static}
  .incl-grid{grid-template-columns:1fr}
}
</style>
