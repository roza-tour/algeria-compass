---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const site = (Astro.site?.toString() || 'https://algeriacompass.com').replace(/\/$/, '');
const breadcrumb = { '@type':'BreadcrumbList', '@id':`${site}/search/#breadcrumb`, itemListElement:[
  {'@type':'ListItem',position:1,name:'Home',item:`${site}/`},
  {'@type':'ListItem',position:2,name:'Search',item:`${site}/search/`}]};
---
<BaseLayout
  title="Search Algeria Compass"
  description="Search tours, states, destinations, guides and answers across Algeria Compass."
  schema={[breadcrumb]} noindex>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Search'}]} />
  <section class="section"><div class="wrap" style="max-width:820px">
    <div class="eyebrow">Search</div>
    <h1>Search Algeria Compass</h1>
    <p style="color:var(--text-m);margin-top:.4rem">Find tours, states, destinations, guides and answers.</p>

    <form class="srch-form" role="search" onsubmit="return false">
      <input id="srch" type="search" name="q" placeholder="Try “Sahara”, “Constantine”, “visa”…"
        aria-label="Search Algeria Compass" autocomplete="off" />
    </form>

    <p id="srch-status" class="srch-status" aria-live="polite"></p>
    <ul id="srch-results" class="srch-results"></ul>
  </div></section>
</BaseLayout>

<script is:inline>
  (function () {
    var input = document.getElementById('srch');
    var list = document.getElementById('srch-results');
    var status = document.getElementById('srch-status');
    var data = [];

    function esc(s){ return (s||'').replace(/[&<>"]/g, function(c){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'})[c]; }); }

    function render(q) {
      var term = q.trim().toLowerCase();
      list.innerHTML = '';
      if (!term) { status.textContent = data.length ? (data.length + ' pages indexed — start typing.') : ''; return; }
      var hits = data.filter(function (r) {
        return (r.t + ' ' + r.d + ' ' + r.k).toLowerCase().indexOf(term) !== -1;
      }).slice(0, 40);
      status.textContent = hits.length ? (hits.length + ' result' + (hits.length>1?'s':'') + ' for “' + q + '”') : 'No results for “' + q + '”.';
      hits.forEach(function (r) {
        var li = document.createElement('li');
        li.className = 'srch-item';
        li.innerHTML = '<a href="' + r.u + '"><span class="srch-kind">' + esc(r.k) + '</span>'
          + '<span class="srch-title">' + esc(r.t) + '</span>'
          + (r.d ? '<span class="srch-blurb">' + esc(r.d) + '</span>' : '') + '</a>';
        list.appendChild(li);
      });
    }

    function paramQ() {
      try { return new URLSearchParams(location.search).get('q') || ''; } catch (e) { return ''; }
    }

    fetch('/search-index.json').then(function (r) { return r.json(); }).then(function (j) {
      data = j;
      var q = paramQ();
      if (q) { input.value = q; }
      render(input.value);
    }).catch(function () { status.textContent = 'Search is temporarily unavailable.'; });

    input.addEventListener('input', function () { render(input.value); });
  })();
</script>

<style>
  .srch-form{margin:1.4rem 0 .6rem}
  #srch{width:100%;font-size:1.05rem;padding:.85rem 1.1rem;border:2px solid var(--border);border-radius:12px;
    background:#fff;transition:border-color .15s ease}
  #srch:focus{outline:none;border-color:var(--green)}
  .srch-status{color:var(--text-l);font-size:.88rem;margin:.4rem 0 1rem}
  .srch-results{list-style:none;padding:0;margin:0;display:grid;gap:.7rem}
  .srch-item a{display:block;background:var(--wash);border:1px solid var(--border);border-left:4px solid var(--green);
    border-radius:10px;padding:.8rem 1rem;text-decoration:none;transition:transform .12s ease,box-shadow .12s ease}
  .srch-item a:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.08)}
  .srch-kind{display:inline-block;font-size:.66rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;
    color:var(--green-d);background:rgba(11,61,46,.08);border-radius:999px;padding:.12rem .55rem;margin-bottom:.35rem}
  .srch-title{display:block;font-family:var(--serif);font-weight:700;color:var(--green-d);font-size:1.05rem}
  .srch-blurb{display:block;color:var(--text-m);font-size:.9rem;line-height:1.5;margin-top:.2rem}
</style>
