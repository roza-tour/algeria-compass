---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaSection from '../../components/CtaSection.astro';
const items = await getCollection('question');
---
<BaseLayout title="Algeria Travel Questions & Answers" description="Direct answers to the most common questions about traveling to Algeria — safety, visas, costs, best time to visit and more.">
  <Hero title="Questions & Answers" eyebrow="Knowledge base" text="Direct, sourced answers to the most common questions about visiting Algeria." image="/assets/img/brand-algeria.jpg" alt="Algeria" />
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Questions'}]} />
  <section class="section"><div class="wrap" style="max-width:820px">
    <div class="faq">
      {items.map(it => (
        <details>
          <summary><a href={`/questions/${it.slug}/`}>{it.data.question}</a></summary>
          <p>{it.data.shortAnswer}</p>
        </details>
      ))}
    </div>
  </div></section>
  <CtaSection />
</BaseLayout>
