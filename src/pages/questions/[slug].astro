---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import CtaSection from '../../components/CtaSection.astro';
import Byline from '../../components/Byline.astro';
import SourceList from '../../components/SourceList.astro';
import EditorialMeta from '../../components/EditorialMeta.astro';
import { resolveAuthor, resolveReviewer, authorNode, reviewerNode, citationNodes } from '../../lib/authorship';
export async function getStaticPaths() {
  const items = await getCollection('question');
  return items.map(item => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props;
const d = item.data;
const { Content } = await item.render();
const site = Astro.site?.toString().replace(/\/$/, '') || 'https://algeriacompass.com';
const qUrl = `${site}/questions/${item.slug}/`;
const speak = { "@type":"WebPage", "speakable": { "@type":"SpeakableSpecification", "cssSelector": [".qbox",".prose"] } };
const author = await resolveAuthor(d.author);
const reviewer = await resolveReviewer(d.reviewedBy);
const authorEntity = authorNode(site, author.entry);
const reviewerEntity = reviewerNode(site, reviewer.entry);
const authorRef = { "@id": (authorEntity as any)["@id"] };
const stamp = d.updated.toISOString();
// Question/Answer nodes carry the fields Google requires and recommends for
// QAPage. `answerCount` is REQUIRED — without it the whole item is invalid and
// cannot produce a rich result. We publish exactly one editorially-written,
// reviewed answer, so the count is 1 and `upvoteCount` is a truthful 0: this
// site has no voting, and inventing engagement numbers would be a lie to
// Google and to readers. `datePublished` uses the content's `updated` date —
// the only date the collection tracks — which is also its dateModified.
const qa = {
  "@type": "QAPage",
  "@id": `${qUrl}#qa`,
  "mainEntity": {
    "@type": "Question",
    "name": d.question,
    "text": d.question,
    "answerCount": 1,
    "author": authorRef,
    "datePublished": stamp,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": d.shortAnswer,
      "url": `${qUrl}#answer`,
      "author": authorRef,
      "datePublished": stamp,
      "upvoteCount": 0
    }
  }
};
(qa as any).author = authorRef;
(qa as any).reviewedBy = { "@id": (reviewerEntity as any)["@id"] };
(qa as any).dateModified = stamp;
const cites = citationNodes(d.sources);
if (cites.length) (qa as any).citation = cites;
const breadcrumb = { "@type":"BreadcrumbList", "@id":`${site}/questions/${item.slug}/#breadcrumb`, itemListElement:[
  { "@type":"ListItem", position:1, name:"Home", item:`${site}/` },
  { "@type":"ListItem", position:2, name:"Questions", item:`${site}/questions/` },
  { "@type":"ListItem", position:3, name:d.question, item:`${site}/questions/${item.slug}/` } ] };
---
<BaseLayout title={d.seo.title} description={d.seo.description} keywords={d.seo.keywords} schema={[qa, speak, authorEntity, reviewerEntity, breadcrumb]}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Questions',href:'/questions/'},{name:d.category}]} />
  <article class="section"><div class="wrap" style="max-width:760px">
    <span class="eyebrow">{d.category}</span>
    <h1 style="margin:.4rem 0">{d.question}</h1>
    <Byline authorName={author.name} authorHref={author.href} reviewerName={reviewer.name} reviewerHref={reviewer.href} updated={d.updated} lastReviewed={d.lastReviewed} />
    <div class="qbox" id="answer"><b>Quick answer</b><p>{d.shortAnswer}</p></div>
    <div class="prose"><Content /></div>
    <KeyFacts facts={d.keyFacts} />
    <SourceList sources={d.sources} />
    <EditorialMeta sourceCount={d.sources.length} reviewerName={reviewer.name} reviewerHref={reviewer.href} lastReviewed={d.lastReviewed} />
  </div></article>
  <CtaSection />
</BaseLayout>
