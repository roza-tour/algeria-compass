---
import QuestionPhoto from '../../components/QuestionPhoto.astro';
import { getCollection } from 'astro:content';
import InlineTours from '../../components/InlineTours.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ogFallback } from '../../lib/og-image';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import CtaSection from '../../components/CtaSection.astro';
import Byline from '../../components/Byline.astro';
import SourceList from '../../components/SourceList.astro';
import EditorialMeta from '../../components/EditorialMeta.astro';
import { resolveAuthor, resolveReviewer, authorNode, reviewerNode, citationNodes } from '../../lib/authorship';
import { qAlternates } from '../../data/questionI18n.mjs';
export async function getStaticPaths() {
  const items = await getCollection('question');
  return items.map(item => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props;
const d = item.data;
const { Content } = await item.render();
const site = Astro.site?.toString().replace(/\/$/, '') || 'https://algeriacompass.com';
const qUrl = `${site}/questions/${item.slug}/`;
const author = await resolveAuthor(d.author);
const reviewer = await resolveReviewer(d.reviewedBy);
const authorEntity = authorNode(site, author.entry);
const reviewerEntity = reviewerNode(site, reviewer.entry);
const authorRef = { "@id": (authorEntity as any)["@id"] };
const stamp = d.updated.toISOString();
// One WebPage node whose main entity is the question and its reviewed answer.
// This used to be a QAPage. Google reserves QAPage for pages where users
// submit answers (forums, support boards): a single answer written by the
// publisher is outside it, so 220 pages carried markup of the wrong type. The
// question, the answer, the author, the reviewer, the dates and the sources
// are all still here for search and answer engines to read; only the type and
// the forum-only counters (answerCount, upvoteCount) are gone.
const qa = {
  "@type": "WebPage",
  "@id": `${qUrl}#webpage`,
  "url": qUrl,
  "name": d.question,
  "inLanguage": "en",
  "isPartOf": { "@id": `${site}/#website` },
  "datePublished": stamp,
  "speakable": { "@type": "SpeakableSpecification", "cssSelector": [".qbox", ".prose"] },
  "mainEntity": {
    "@type": "Question",
    "@id": `${qUrl}#question`,
    "name": d.question,
    "text": d.question,
    "author": authorRef,
    "datePublished": stamp,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": d.shortAnswer,
      "url": `${qUrl}#answer`,
      "author": authorRef,
      "datePublished": stamp
    }
  }
};
(qa as any).author = authorRef;
(qa as any).reviewedBy = { "@id": (reviewerEntity as any)["@id"] };
(qa as any).dateModified = stamp;
const cites = citationNodes(d.sources);
if (cites.length) (qa as any).citation = cites;
const breadcrumb = { "@type":"BreadcrumbList", "@id":`${site}/questions/${item.slug}/#breadcrumb`, itemListElement:[
  { "@type":"ListItem", position:1, name:"Home", item:`${site}/` },
  { "@type":"ListItem", position:2, name:"Questions", item:`${site}/questions/` },
  { "@type":"ListItem", position:3, name:d.question, item:`${site}/questions/${item.slug}/` } ] };
---
<BaseLayout title={d.seo.title} description={d.seo.description} keywords={d.seo.keywords} image={ogFallback(Astro.url.pathname, d.question, d.category)} schema={[qa, authorEntity, reviewerEntity]} alternates={qAlternates(site, item.slug)}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Questions',href:'/questions/'},{name:d.category}]} />
  <article class="section"><div class="wrap" style="max-width:760px">
    <span class="eyebrow">{d.category}</span>
    <h1 style="margin:.4rem 0">{d.question}</h1>
    <Byline authorName={author.name} authorHref={author.href} reviewerName={reviewer.name} reviewerHref={reviewer.href} updated={d.updated} lastReviewed={d.lastReviewed} />
    <div class="qbox" id="answer"><b>Quick answer</b><p>{d.shortAnswer}</p></div>
    <QuestionPhoto slug={item.slug} />
    <div class="prose"><Content /></div>
    <KeyFacts facts={d.keyFacts} />
    <InlineTours text={item.body} fallback={['the-soul-of-algeria', 'djanet-sahara-safari', 'algeria-through-time-and-tradition']} />
    <SourceList sources={d.sources} />
    <EditorialMeta sourceCount={d.sources.length} reviewerName={reviewer.name} reviewerHref={reviewer.href} lastReviewed={d.lastReviewed} />
  </div></article>
  <CtaSection />
</BaseLayout>
