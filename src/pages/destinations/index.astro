---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Card from '../../components/Card.astro';
import CtaSection from '../../components/CtaSection.astro';
const items = await getCollection('destination');
---
<BaseLayout title="Algeria Destinations" description="Iconic Algerian places — desert, Roman ruins, oasis cities and the Mediterranean coast.">
  <Hero title="Algeria Destinations" eyebrow="Algeria" text="Iconic Algerian places — desert, Roman ruins, oasis cities and the Mediterranean coast." image="/images/brand-algeria.jpg" alt="Algeria" />
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Algeria Destinations'}]} />
  <section class="section"><div class="wrap">
    <div class="grid">
      {items.map(it => (
        <Card href={`/destinations/${it.slug}/`}
          title={it.data.name}
          image={it.data.image ?? '/images/brand-algeria.jpg'}
          alt={it.data.imageAlt ?? it.data.name}
          tag={it.data.region}
          text={it.data.quickAnswer} />
      ))}
    </div>
  </div></section>
  <CtaSection />
</BaseLayout>
