---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import FaqSection from '../../components/FaqSection.astro';
import CtaSection from '../../components/CtaSection.astro';
import RelatedGrid from '../../components/RelatedGrid.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import EntityLinks from '../../components/EntityLinks.astro';
import Byline from '../../components/Byline.astro';
import SourceList from '../../components/SourceList.astro';
import EditorialMeta from '../../components/EditorialMeta.astro';
import { DEST_SKIN } from '../../data/civSkins.mjs';
import { related, toCard } from '../../lib/related';
import { resolveAuthor, resolveReviewer, authorNode, reviewerNode, citationNodes } from '../../lib/authorship';
import { entityForContent } from '../../lib/graph';
import { discoveryGroups } from '../../lib/entitySchema';
export async function getStaticPaths() {
  const items = await getCollection('destination');
  return items.map(item => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props;
const d = item.data;
const { Content } = await item.render();
const site = (Astro.site?.toString() || 'https://algeriacompass.com').replace(/\/$/, '');
const experiences = await related('experience', { region: d.region, limit: 3 });
const dests = await related('destination', { region: d.region, exclude: item.slug, limit: 3 });
const articles = await related('article', { region: d.region, limit: 3 });
const _ent = entityForContent('destination', item.slug);
const _groups = _ent ? discoveryGroups(site, _ent.id) : [];
const author = await resolveAuthor(d.author);
const reviewer = await resolveReviewer(d.reviewedBy);
const authorEntity = authorNode(site, author.entry);
const reviewerEntity = reviewerNode(site, reviewer.entry);
const attr: any = {
  "@type": "TouristAttraction",
  "@id": `${site}/destinations/${item.slug}/#attraction`,
  "name": d.name,
  "description": d.quickAnswer,
  "url": `${site}/destinations/${item.slug}/`,
  "image": site + d.image,
  "containedInPlace": { "@id": site + "/#algeria" },
  "isPartOf": { "@id": site + "/#website" }
};
if (d.coordinates) attr.geo = { "@type": "GeoCoordinates", "latitude": d.coordinates.lat, "longitude": d.coordinates.lng };
if (d.sameAs?.length) attr.sameAs = d.sameAs;
attr.author = { "@id": (authorEntity as any)["@id"] };
attr.reviewedBy = { "@id": (reviewerEntity as any)["@id"] };
attr.dateModified = d.updated.toISOString();
const cites = citationNodes(d.sources);
if (cites.length) attr.citation = cites;
const schemaNodes = [attr, authorEntity, reviewerEntity];
---
<BaseLayout title={d.seo.title} description={d.seo.description} image={d.image} imageAlt={d.imageAlt} keywords={d.seo.keywords} region={d.region} civ={DEST_SKIN[item.slug]} schema={schemaNodes} sticky={true}>
  <Hero title={d.name} eyebrow={d.province ? d.province + ' · Algeria' : 'Algeria'} text={d.quickAnswer} image={d.image} alt={d.imageAlt}>
    <a class="btn btn-gold" href={`/contact/?i=${encodeURIComponent(d.name)}`} data-evt="cta_plan">Visit {d.name} →</a>
  </Hero>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Destinations',href:'/destinations/'},{name:d.name}]} />
  <section class="section"><div class="wrap" style="max-width:820px">
    <Byline authorName={author.name} authorHref={author.href} reviewerName={reviewer.name} reviewerHref={reviewer.href} updated={d.updated} lastReviewed={d.lastReviewed} />
    <QuickAnswer text={d.quickAnswer} />
    <KeyFacts facts={d.keyFacts} />
    <article class="prose"><Content /></article>
    <SourceList sources={d.sources} />
    <EditorialMeta sourceCount={d.sources.length} reviewerName={reviewer.name} reviewerHref={reviewer.href} lastReviewed={d.lastReviewed} />
  </div></section>
  <PhotoGallery images={d.gallery} heading={`${d.name} in pictures`} />
  <RelatedGrid heading="Experiences that include this region" items={experiences.map(e => toCard(e,'/experiences/'))} />
  <RelatedGrid heading="More to explore" items={dests.map(e => toCard(e,'/destinations/'))} />
  <RelatedGrid heading="Related reading" items={articles.map(e => toCard(e,'/blog/'))} />
  <FaqSection faqs={d.faqs} />
  <CtaSection interest={d.name} />
  <EntityLinks groups={_groups} heading="Explore across Algeria" />
</BaseLayout>
