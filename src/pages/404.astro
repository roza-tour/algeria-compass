---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Algeria Compass" description="The page you were looking for could not be found." noindex>
  <!-- Flags this render as a not-found page so the hit tracker reports the
       broken URL as a 404 instead of a normal view — that is how the stats
       page surfaces dead links visitors are actually hitting. -->
  <script is:inline>window.__AC_NF = 1;</script>
  <section class="section"><div class="wrap" style="text-align:center;padding:4rem 0">
    <h1>404 — Page not found</h1>
    <p style="margin:1rem 0">The trail went cold. Let's get you back on the map.</p>
    <a class="btn" href="/">Return home</a>
  </div></section>
</BaseLayout>
