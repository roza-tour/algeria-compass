---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Card from '../../components/Card.astro';
import CtaSection from '../../components/CtaSection.astro';
const items = await getCollection('experience');
---
<BaseLayout title="Algeria Experiences" description="Immersive, private journeys across Algeria — from the Sahara to the Roman north.">
  <Hero title="Algeria Experiences" eyebrow="Algeria" text="Immersive, private journeys across Algeria — from the Sahara to the Roman north." image="/assets/img/brand-algeria.jpg" alt="Algeria" />
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Algeria Experiences'}]} />
  <section class="section"><div class="wrap">
    <div class="grid">
      {items.map(it => (
        <Card href={`/experiences/${it.slug}/`}
          title={it.data.name}
          image={it.data.image ?? '/assets/img/brand-algeria.jpg'}
          alt={it.data.imageAlt ?? it.data.name}
          tag={it.data.region}
          text={it.data.quickAnswer} />
      ))}
    </div>
  </div></section>
  <CtaSection />
</BaseLayout>
