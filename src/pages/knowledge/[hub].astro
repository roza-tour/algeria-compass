---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import FaqSection from '../../components/FaqSection.astro';
import Card from '../../components/Card.astro';
import EntitySnapshot from '../../components/EntitySnapshot.astro';
import EntityLinks from '../../components/EntityLinks.astro';
import { getCollection } from 'astro:content';
import { hubs, hubBySlug } from '../../data/hubs';
import { getEntity, entitiesForTheme, effectiveThemes } from '../../lib/graph';
import { entityUrl, collectionPageNode, entityNode } from '../../lib/entitySchema';

export async function getStaticPaths() {
  return hubs.map(h => ({ params: { hub: h.slug }, props: { hub: h } }));
}
const { hub } = Astro.props;
const site = (Astro.site?.toString() || 'https://algeriacompass.com').replace(/\/$/, '');
const themeEntity = getEntity(hub.theme)!;

// --- entities in this hub (from the graph) ---
const featured = entitiesForTheme(hub.theme, hub.featureTypes);
const snapshots = featured.slice(0, 9);
const TYPE_LABEL: Record<string,string> = {
  unesco:'UNESCO sites', 'roman-site':'Roman sites', 'islamic-site':'Islamic heritage',
  'ottoman-site':'Ottoman heritage', 'french-site':'Colonial heritage', 'historical-building':'Monuments',
  museum:'Museums', city:'Towns', 'national-park':'National parks', 'sahara-area':'Desert regions',
  'mountain-area':'Mountains', 'coast-area':'Coast', 'historical-period':'Historical periods',
  tradition:'Traditions', food:'Food', architecture:'Architecture', festival:'Festivals',
  season:'Seasons', transport:'Transport', accommodation:'Where to stay', 'travel-style':'Travel styles',
  province:'States',
};
const groupsMap = new Map<string, {name:string; href:string}[]>();
for (const e of featured) {
  if (!groupsMap.has(e.type)) groupsMap.set(e.type, []);
  groupsMap.get(e.type)!.push({ name: e.name, href: entityUrl(site, e) });
}
const entityGroups = [...groupsMap.entries()].map(([t, items]) => ({ label: TYPE_LABEL[t] || t, items }));

// --- bridge site (thematic) regions -> graph themes, so content aggregates correctly ---
const SITE_REGION_THEMES: Record<string,string[]> = {
  sahara: ['theme:sahara','theme:adventure','theme:photography'],
  roman: ['theme:roman-heritage','theme:history','theme:cultural'],
  andalusian: ['theme:islamic-heritage','theme:architecture','theme:cultural'],
  mzab: ['theme:architecture','theme:sahara','theme:cultural'],
  coast: ['theme:coast','theme:family','theme:photography'],
  kabylie: ['theme:mountains','theme:coast','theme:amazigh'],
  highlands: ['theme:roman-heritage','theme:history','theme:mountains'],
};
import { entityForContent } from '../../lib/graph';
const themesFor = (collection: string, entry: any): string[] => {
  const ent = entityForContent(collection, entry.slug);
  const base = ent ? effectiveThemes(ent.id) : [];
  const rmap = SITE_REGION_THEMES[entry.data.region] || [];
  return [...new Set([...base, ...rmap])];
};
const inHub = (collection: string) => (entry: any) => themesFor(collection, entry).includes(hub.theme);

const [provs, dests, exps, arts] = await Promise.all([
  getCollection('province'), getCollection('destination'), getCollection('experience'), getCollection('article'),
]);
const provC = provs.filter(inHub('province')).slice(0, 6);
const destC = dests.filter(inHub('destination')).slice(0, 6);
const expC  = exps.filter(inHub('experience')).slice(0, 6);
const artC  = arts.filter(inHub('article')).slice(0, 6);

const quick = `${hub.title} on Algeria Compass brings together ${featured.length} mapped entities — ${entityGroups.map(g=>g.label.toLowerCase()).slice(0,3).join(', ')} and more — with the destinations, experiences and guides that connect to them.`;

// --- schema ---
const url = `/knowledge/${hub.slug}/`;
const collection = collectionPageNode(site, url, hub.title, hub.description, featured);
const themeNode = entityNode(site, themeEntity);
const faqNode = {
  '@type': 'FAQPage',
  '@id': `${site}${url}#faq`,
  mainEntity: hub.faqs.map(f => ({ '@type':'Question', name:f.q, acceptedAnswer:{ '@type':'Answer', text:f.a } })),
};
const breadcrumb = {
  '@type':'BreadcrumbList',
  itemListElement: [
    { '@type':'ListItem', position:1, name:'Home', item:`${site}/` },
    { '@type':'ListItem', position:2, name:'Knowledge', item:`${site}/knowledge/` },
    { '@type':'ListItem', position:3, name:hub.title, item:`${site}${url}` },
  ],
};
const schema = [collection, themeNode, faqNode, breadcrumb];
---
<BaseLayout title={`${hub.title} — Knowledge Hub`} description={hub.description} schema={schema}>
  <Hero title={hub.title} eyebrow="Knowledge hub" text={hub.intro} image="/assets/img/sahara-dunes-tadrart.jpg" alt="Algeria" />

  <section class="section"><div class="wrap" style="max-width:820px">
    <QuickAnswer text={quick} />
    <p style="color:var(--text-m)">{hub.intro}</p>
  </div></section>

  {snapshots.length > 0 && (
    <section class="section"><div class="wrap">
      <h2>Key entities in this hub</h2>
      <div class="snapshot-grid">
        {snapshots.map(e => <EntitySnapshot entity={e} href={entityUrl(site, e)} />)}
      </div>
    </div></section>
  )}

  <EntityLinks groups={entityGroups} heading="Everything in this hub" />

  {(destC.length + expC.length + provC.length + artC.length) > 0 && (
    <section class="section"><div class="wrap">
      <h2>Plan around this topic</h2>
      {provC.length > 0 && <><h3 class="grp">States</h3><div class="grid grid-3">{provC.map(p => <Card href={`/provinces/${p.slug}/`} title={p.data.name} image={p.data.image} alt={p.data.imageAlt} tag={p.data.region} text={p.data.quickAnswer} />)}</div></>}
      {destC.length > 0 && <><h3 class="grp">Destinations</h3><div class="grid grid-3">{destC.map(d => <Card href={`/destinations/${d.slug}/`} title={d.data.name} image={d.data.image} alt={d.data.imageAlt} tag={d.data.region} text={d.data.quickAnswer} />)}</div></>}
      {expC.length > 0 && <><h3 class="grp">Tour programs</h3><div class="grid grid-3">{expC.map(e => <Card href={`/experiences/${e.slug}/`} title={e.data.name} image={e.data.image} alt={e.data.imageAlt} tag={`${e.data.durationDays} days`} text={e.data.tagline} />)}</div></>}
      {artC.length > 0 && <><h3 class="grp">Guides</h3><div class="grid grid-3">{artC.map(a => <Card href={`/blog/${a.slug}/`} title={a.data.title} image={a.data.image} alt={a.data.imageAlt} tag={a.data.category} text={a.data.excerpt} />)}</div></>}
    </div></section>
  )}

  <FaqSection faqs={hub.faqs} />

  <section class="section"><div class="wrap" style="text-align:center">
    <a class="btn" href="/knowledge/">← All knowledge hubs</a>
  </div></section>
</BaseLayout>

<style>
.snapshot-grid{display:grid;gap:1rem;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));margin-top:1rem}
.grp{margin:1.4rem 0 .4rem;font-size:.8rem;text-transform:uppercase;letter-spacing:.06em;color:var(--text-l)}
</style>
