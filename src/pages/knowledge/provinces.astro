---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import { entitiesByType, getEntity, contentForEntity } from '../../lib/graph';
import { entityUrl, itemListNode, entityNode } from '../../lib/entitySchema';
const site = (Astro.site?.toString() || 'https://algeriacompass.com').replace(/\/$/, '');
const provinces = entitiesByType('province').sort((a,b)=>(a.wilayaNumber||0)-(b.wilayaNumber||0));
const regions = entitiesByType('region');
const byRegion = regions.map(r => ({ region: r, items: provinces.filter(p => p.region === r.id) }))
  .filter(g => g.items.length > 0);
const quick = `Algeria is divided into 58 states. This directory lists all 58 with their capital, state number and region, as a machine-readable inventory; ${provinces.filter(p=>p.contentSlug).length} currently have a full guide on this site, with more in progress.`;
const url = '/knowledge/provinces/';
const list = itemListNode(site, `${url}#all`, 'States of Algeria', provinces);
const provinceNodes = provinces.map(p => entityNode(site, p));
const collection = {
  '@type':'CollectionPage', '@id':`${site}${url}#collection`, name:'The 58 States of Algeria',
  description:'Directory of all 58 Algerian states with capitals, numbers and regions.',
  url:`${site}${url}`, isPartOf:{'@id':`${site}/#website`}, about:{'@id':`${site}/#algeria`},
  mainEntity:{'@id':`${site}${url}#all`},
};
const breadcrumb = { '@type':'BreadcrumbList', itemListElement:[
  {'@type':'ListItem',position:1,name:'Home',item:`${site}/`},
  {'@type':'ListItem',position:2,name:'Knowledge',item:`${site}/knowledge/`},
  {'@type':'ListItem',position:3,name:'States',item:`${site}${url}`}]};
const schema = [collection, list, breadcrumb, ...provinceNodes];
---
<BaseLayout title="The 58 States of Algeria" description="A complete directory of all 58 Algerian states with their capitals, state numbers and regions." schema={schema}>
  <Hero title="The 58 States of Algeria" eyebrow="Knowledge · Directory" text="Every state of Algeria, grouped by region — a complete, machine-readable inventory." image="/assets/img/sahara-dunes-tadrart.jpg" alt="Algeria" />
  <section class="section"><div class="wrap" style="max-width:820px"><QuickAnswer text={quick} /></div></section>

  {byRegion.map(g => (
    <section class="section"><div class="wrap">
      <h2>{g.region.name} <span class="rcount">{g.items.length} states</span></h2>
      <p style="color:var(--text-m);max-width:720px">{g.region.description}</p>
      <div class="prov-grid">
        {g.items.map(p => (
          <a class="prov-tile" id={p.slug} href={entityUrl(site, p)} data-has-guide={p.contentSlug ? 'yes' : 'no'}>
            <span class="pnum">{p.wilayaNumber}</span>
            <strong>{p.name}</strong>
            <span class="pcap">Capital: {p.capital}</span>
            {p.contentSlug && <span class="pguide">Guide ↗</span>}
          </a>
        ))}
      </div>
    </div></section>
  ))}
</BaseLayout>
<style>
.rcount{font-size:.7rem;font-weight:700;color:var(--brand);text-transform:uppercase;letter-spacing:.06em;margin-left:.4rem}
.prov-grid{display:grid;gap:.6rem;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));margin-top:1rem}
.prov-tile{position:relative;display:flex;flex-direction:column;gap:.15rem;padding:.7rem .85rem;border:1px solid var(--border);border-radius:10px;background:var(--wash);color:var(--text)}
.prov-tile[data-has-guide=yes]{border-color:var(--brand)}
.prov-tile:hover{transform:translateY(-2px);transition:.15s}
.prov-tile strong{font-size:.98rem}
.pnum{position:absolute;top:.5rem;right:.6rem;font-size:.7rem;color:var(--text-l)}
.pcap{font-size:.78rem;color:var(--text-m)}
.pguide{font-size:.72rem;color:var(--brand);font-weight:700;margin-top:.15rem}
</style>
