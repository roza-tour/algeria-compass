---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import { hubs } from '../../data/hubs';
import { entitiesForTheme, graphStats, entitiesByType } from '../../lib/graph';
const site = (Astro.site?.toString() || 'https://algeriacompass.com').replace(/\/$/, '');
const stats = graphStats();
const hubCounts = hubs.map(h => ({ ...h, count: entitiesForTheme(h.theme, h.featureTypes).length }));
const CAT: [any, string][] = [
  ['province','States'],['unesco','UNESCO sites'],['roman-site','Roman sites'],
  ['islamic-site','Islamic heritage'],['ottoman-site','Ottoman heritage'],['museum','Museums'],
  ['national-park','National parks'],['sahara-area','Desert regions'],['mountain-area','Mountains'],
  ['coast-area','Coast'],['food','Foods'],['tradition','Traditions'],['architecture','Architecture'],
  ['festival','Festivals'],['historical-period','Historical periods'],['language','Languages'],
];
const quick = `The Algeria Compass knowledge graph maps ${stats.total} entities across Algeria — all 58 states, the 7 UNESCO World Heritage Sites, Roman and Islamic heritage, deserts, mountains, coast, food and culture — connected by ${stats.relationEdges} relationships and organised into ${hubs.length} authority hubs.`;
const url = '/knowledge/';
const collection = {
  '@type':'CollectionPage', '@id':`${site}${url}#collection`, name:'Algeria Knowledge Hubs',
  description:'The Algeria knowledge graph: entities, relationships and authority hubs.',
  url:`${site}${url}`, isPartOf:{'@id':`${site}/#website`}, about:{'@id':`${site}/#algeria`},
  mainEntity:{ '@type':'ItemList', numberOfItems:hubs.length,
    itemListElement: hubs.map((h,i)=>({'@type':'ListItem',position:i+1,name:h.title,url:`${site}/knowledge/${h.slug}/`})) },
};
const breadcrumb = { '@type':'BreadcrumbList', itemListElement:[
  {'@type':'ListItem',position:1,name:'Home',item:`${site}/`},
  {'@type':'ListItem',position:2,name:'Knowledge',item:`${site}${url}`}]};
const schema=[collection, breadcrumb];
---
<BaseLayout title="Algeria Knowledge Graph & Hubs" description="A machine-readable map of Algeria: 58 states, UNESCO sites, heritage, deserts, coast, food and culture, organised into authority hubs." schema={schema} noindex>
  <Hero title="The Algeria Knowledge Graph" eyebrow="Knowledge" text="A connected, machine-readable understanding of Algeria — entities, relationships and authority hubs, not just pages." image="/assets/img/sahara-dunes-tadrart.jpg" alt="Algeria" />
  <section class="section"><div class="wrap" style="max-width:820px"><QuickAnswer text={quick} /></div></section>

  <section class="section"><div class="wrap">
    <h2>Authority hubs</h2>
    <div class="hub-grid">
      {hubCounts.map(h => (
        <a class="hub-tile" href={`/knowledge/${h.slug}/`}>
          <span class="hub-count">{h.count} entities</span>
          <strong>{h.title}</strong>
          <span class="hub-desc">{h.description}</span>
        </a>
      ))}
    </div>
  </div></section>

  <section class="section alt"><div class="wrap">
    <h2>Browse the graph</h2>
    <p style="color:var(--text-m);max-width:700px">Explore Algeria by entity category, open the full directory of all 58 states, or view the knowledge-graph map.</p>
    <div class="cat-grid">
      {CAT.map(([t,label]) => <div class="cat-cell"><span class="cat-n">{entitiesByType(t).length}</span><span>{label}</span></div>)}
    </div>
    <p style="margin-top:1.2rem;display:flex;gap:.8rem;flex-wrap:wrap">
      <a class="btn" href="/knowledge/provinces/">All 58 states →</a>
      <a class="btn btn-outline" href="/knowledge/graph/">Knowledge-graph map →</a>
    </p>
  </div></section>
</BaseLayout>
<style>
.hub-grid{display:grid;gap:.9rem;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));margin-top:1rem}
.hub-tile{display:flex;flex-direction:column;gap:.3rem;padding:1.1rem;border:1px solid var(--border);border-radius:12px;background:var(--wash);color:var(--text);transition:.15s}
.hub-tile:hover{border-color:var(--brand);transform:translateY(-2px)}
.hub-tile strong{font-size:1.05rem}
.hub-count{font-size:.68rem;text-transform:uppercase;letter-spacing:.07em;color:var(--brand);font-weight:700}
.hub-desc{font-size:.85rem;color:var(--text-m)}
.cat-grid{display:grid;gap:.7rem;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));margin-top:1rem}
.cat-cell{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:.9rem;border:1px solid var(--border);border-radius:10px;background:var(--bg);text-align:center;font-size:.82rem;color:var(--text-m)}
.cat-n{font-size:1.4rem;font-weight:800;color:var(--text)}
</style>
