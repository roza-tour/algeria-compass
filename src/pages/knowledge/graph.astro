---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import { graphStats, entitiesByType } from '../../lib/graph';
import { hubs } from '../../data/hubs';
import { entitiesForTheme } from '../../lib/graph';
const site = (Astro.site?.toString() || 'https://algeriacompass.com').replace(/\/$/, '');
const stats = graphStats();

const SUPER: Record<string,{cat:string;color:string}> = {
  province:{cat:'Places',color:'#45A3AB'}, city:{cat:'Places',color:'#45A3AB'}, region:{cat:'Places',color:'#2E7D87'},
  unesco:{cat:'Heritage',color:'#B8860B'}, 'roman-site':{cat:'Heritage',color:'#A9740F'}, 'islamic-site':{cat:'Heritage',color:'#C89B2C'},
  'ottoman-site':{cat:'Heritage',color:'#9C6B12'}, 'french-site':{cat:'Heritage',color:'#8A6308'}, 'historical-building':{cat:'Heritage',color:'#D4A537'},
  museum:{cat:'Heritage',color:'#7A5C1E'},
  'national-park':{cat:'Nature',color:'#3F8F4F'}, 'sahara-area':{cat:'Nature',color:'#C97A3A'}, 'mountain-area':{cat:'Nature',color:'#5A8F3F'}, 'coast-area':{cat:'Nature',color:'#3F8F8F'},
  food:{cat:'Culture',color:'#8E4585'}, tradition:{cat:'Culture',color:'#7A3B72'}, architecture:{cat:'Culture',color:'#A4569B'}, festival:{cat:'Culture',color:'#6E3667'}, language:{cat:'Culture',color:'#B86FAF'}, 'historical-period':{cat:'Culture',color:'#5C2E56'},
  theme:{cat:'Planning',color:'#3457A8'}, 'travel-style':{cat:'Planning',color:'#5878C8'}, season:{cat:'Planning',color:'#28407E'}, accommodation:{cat:'Planning',color:'#7892D8'}, transport:{cat:'Planning',color:'#4567B8'},
  country:{cat:'Root',color:'#222'},
};
const order = Object.keys(SUPER).filter(t => entitiesByType(t as any).length > 0 && t !== 'country');
const W=820,H=640,CX=410,CY=320,R=250;
const nodes = order.map((t,i) => {
  const ang = (i/order.length)*2*Math.PI - Math.PI/2;
  const count = entitiesByType(t as any).length;
  const r = Math.max(9, Math.min(34, 7 + Math.sqrt(count)*4));
  return { t, count, color:SUPER[t].color, cat:SUPER[t].cat,
    x: CX + Math.cos(ang)*R, y: CY + Math.sin(ang)*R,
    lx: CX + Math.cos(ang)*(R+r+8), ly: CY + Math.sin(ang)*(R+r+8),
    anchor: Math.cos(ang) > 0.2 ? 'start' : (Math.cos(ang) < -0.2 ? 'end' : 'middle') };
});
const cats = [...new Set(order.map(t=>SUPER[t].cat))].map(c => ({ c, color: nodes.find(n=>n.cat===c)!.color }));

const hubAudit = hubs.map(h => ({ title:h.title, entities: entitiesForTheme(h.theme, h.featureTypes).length }));
const emptyHubs = hubAudit.filter(h => h.entities === 0);
const dataset = {
  '@type':'Dataset', '@id':`${site}/knowledge/graph/#dataset`,
  name:'Algeria Compass Algeria Knowledge Graph',
  description:`A structured graph of ${stats.total} Algeria travel entities and their relationships.`,
  url:`${site}/knowledge/graph/`, creator:{'@id':`${site}/#organization`},
  distribution:{'@type':'DataDownload', encodingFormat:'application/json', contentUrl:`${site}/knowledge/graph.json`},
  about:{'@id':`${site}/#algeria`},
};
const schema=[dataset];
---
<BaseLayout title="Algeria Knowledge-Graph Map" description="A visualization of the Algeria Compass Algeria knowledge graph: entity categories, relationships, hubs and coverage." schema={schema}>
  <Hero title="Knowledge-Graph Map" eyebrow="Knowledge" text="How the Algeria knowledge graph fits together — every entity category, sized by coverage, linked to the country at its centre." image="/assets/img/sahara-dunes-tadrart.jpg" alt="Algeria knowledge graph" />

  <section class="section"><div class="wrap">
    <div class="legend">{cats.map(c => <span><i style={`background:${c.color}`}></i>{c.c}</span>)}</div>
    <div class="graph-wrap">
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Algeria knowledge graph map" class="kg">
        {nodes.map(n => <line x1={CX} y1={CY} x2={n.x} y2={n.y} stroke="var(--border)" stroke-width="1" />)}
        <circle cx={CX} cy={CY} r="46" fill="#222" />
        <text x={CX} y={CY-4} text-anchor="middle" fill="#fff" font-size="14" font-weight="700">Algeria</text>
        <text x={CX} y={CY+14} text-anchor="middle" fill="#fff" font-size="10">{stats.total} entities</text>
        {nodes.map(n => (
          <g>
            <circle cx={n.x} cy={n.y} r={Math.max(9, Math.min(34, 7 + Math.sqrt(n.count)*4))} fill={n.color} opacity="0.9" />
            <text x={n.x} y={n.y+4} text-anchor="middle" fill="#fff" font-size="11" font-weight="700">{n.count}</text>
            <text x={n.lx} y={n.ly} text-anchor={n.anchor} fill="var(--text-m)" font-size="10.5">{n.t.replace(/-/g,' ')}</text>
          </g>
        ))}
      </svg>
    </div>
  </div></section>

  <section class="section alt"><div class="wrap">
    <h2>Graph metrics</h2>
    <div class="metrics">
      <div><span>{stats.total}</span>entities</div>
      <div><span>{Object.keys(stats.byTypeCount).length}</span>entity types</div>
      <div><span>{stats.relationEdges}</span>relationship edges</div>
      <div><span>{stats.density}</span>edges / entity</div>
      <div><span>{stats.withCoords}</span>geo-located</div>
      <div><span>{stats.withContent}</span>linked to content</div>
    </div>
  </div></section>

  <section class="section"><div class="wrap">
    <h2>Coverage &amp; integrity</h2>
    <ul class="audit">
      <li><strong>Orphan entities:</strong> {stats.orphans.length === 0 ? 'none — every entity is connected ✓' : stats.orphans.map(o=>o.name).join(', ')}</li>
      <li><strong>Empty hubs:</strong> {emptyHubs.length === 0 ? 'none — every hub aggregates entities ✓' : emptyHubs.map(h=>h.title).join(', ')}</li>
      <li><strong>Provinces mapped to a full guide:</strong> {entitiesByType('province').filter(p=>p.contentSlug).length} / 58 (others are inventoried and ready to expand)</li>
    </ul>
    <h3 class="grp">Entities per hub</h3>
    <div class="hub-bars">
      {hubAudit.map(h => (
        <div class="bar-row"><span class="bar-label">{h.title}</span>
          <span class="bar"><span style={`width:${Math.min(100,h.entities*6)}%`}></span></span>
          <span class="bar-n">{h.entities}</span>
        </div>
      ))}
    </div>
    <p style="margin-top:1rem"><a class="btn btn-outline" href="/knowledge/graph.json">Download graph JSON →</a></p>
  </div></section>
</BaseLayout>
<style>
.legend{display:flex;gap:1.1rem;flex-wrap:wrap;font-size:.82rem;color:var(--text-m);margin-bottom:.6rem}
.legend i{display:inline-block;width:11px;height:11px;border-radius:3px;margin-right:.35rem;vertical-align:middle}
.graph-wrap{overflow-x:auto;background:var(--wash);border:1px solid var(--border);border-radius:14px;padding:.5rem}
.kg{width:100%;min-width:680px;height:auto;display:block}
.metrics{display:grid;gap:.8rem;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));margin-top:1rem}
.metrics div{display:flex;flex-direction:column;align-items:center;padding:1rem;border:1px solid var(--border);border-radius:10px;background:var(--bg);font-size:.82rem;color:var(--text-l);text-align:center}
.metrics span{font-size:1.6rem;font-weight:800;color:var(--text)}
.audit{list-style:none;padding:0;margin:1rem 0;display:flex;flex-direction:column;gap:.5rem}
.audit li{padding:.6rem .8rem;border-left:3px solid var(--brand);background:var(--wash);border-radius:0 8px 8px 0;font-size:.9rem}
.hub-bars{display:flex;flex-direction:column;gap:.4rem;margin-top:.8rem}
.bar-row{display:grid;grid-template-columns:180px 1fr 36px;align-items:center;gap:.6rem;font-size:.84rem}
.bar{background:var(--border);border-radius:6px;height:12px;overflow:hidden}
.bar span{display:block;height:100%;background:var(--brand)}
.bar-n{text-align:right;color:var(--text-m)}
.grp{margin-top:1.4rem;font-size:.8rem;text-transform:uppercase;letter-spacing:.06em;color:var(--text-l)}
</style>
