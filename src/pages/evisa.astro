---
import StampFeeTable from '../components/StampFeeTable.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaSection from '../components/CtaSection.astro';
import { CONTACT } from '../config';
import { alternatesFor } from '../i18n';
const site = (Astro.site?.toString() || 'https://algeriacompass.com').replace(/\/$/, '');
const alternates = alternatesFor(site, {
  en: '/evisa/',
  fr: '/fr/evisa-algerie/',
  it: '/it/evisa-algeria/',
  es: '/es/evisa-argelia/',
  de: '/de/evisa-algerien/',
});
const breadcrumb = { '@type':'BreadcrumbList', itemListElement:[
  {'@type':'ListItem',position:1,name:'Home',item:`${site}/`},
  {'@type':'ListItem',position:2,name:'e-Visa & Entry',item:`${site}/evisa/`}]};
const faqs = [
  { q: 'What is the Saharan e-Visa?', a: 'It is the visa-authorisation document we prepare for travellers on an organised Saharan program. As a licensed Algerian tour operator we issue an authorisation carrying a QR code that is verifiable on the Algerian Ministry of Interior’s portal. The visa itself is granted by the Algerian authorities — your sticker/stamp is issued on arrival; we handle every file in advance.' },
  { q: 'How much does the Saharan e-Visa cost?', a: 'The visa-authorisation document is $45. Preparing all of the required files is completely free on our side. A separate visa stamp fee is paid at Algiers airport on arrival, set by your length of stay — from 5,000 DA (€35) for 1–2 days to 20,000 DA (€140) for 8–10 days; the full table is below.' },
  { q: 'Can I get the visa on arrival for Djanet and the Tassili n’Ajjer?', a: 'Yes — Djanet is the gateway to the Tassili n’Ajjer National Park and the Tadrart Rouge, and it is one of the southern wilayas this route is designed for. The condition is that your organised program with a licensed Algerian operator includes a Sahara trip: we prepare the authorisation in advance and your sticker is issued on arrival at Algiers airport. Send us your nationality and we will confirm your eligibility before you book.' },
  { q: 'Where is the visa issued — do I have to fly into the south?', a: 'No. You fly into Algiers as normal and your visa is issued on arrival at Algiers airport. What qualifies you is a Sahara trip in your program, not the airport you land at. Inside Algeria we book the domestic flights to the desert — Djanet–Tiska (DJG) for the Tassili n’Ajjer and the Tadrart Rouge, Tamanrasset (TMR) for the Hoggar, Ghardaïa Noumérat (GHA) for the M’Zab Valley, Timimoun (TMX) for the Gourara — as part of your program.' },
  { q: 'Can I visit the north too, or only the desert?', a: 'Both. A single trip can combine Algiers, the coast and the Roman cities with the Sahara — what matters is that a Sahara trip is part of the program. We design the itinerary so it qualifies.' },
  { q: 'Is the authorisation document official and verifiable?', a: 'Yes. It carries a QR code that can be checked on the Algerian Ministry of Interior’s portal. Issuance follows the official channels — we are your documentation partner; the Algerian authorities issue the visa.' },
  { q: 'Do I need to book a full tour to get it?', a: 'Yes. The Saharan e-Visa authorisation is available when you book a complete program with us — it is part of arranging your organised trip, not a standalone service.' },
  { q: 'Does Algeria have an e-Visa for tourists?', a: 'There is no general online tourist e-Visa for ordinary travel to Algeria. The two practical routes are a tourist visa from your local Algerian consulate, or — for organised tours that include the Sahara — the Saharan visa-authorisation we prepare, with the sticker issued on arrival at Algiers airport. We handle the paperwork either way.' },
  { q: 'How do I actually enter Algeria?', a: 'Most visitors fly into Algiers (or another northern airport) on a consulate tourist visa, supported by our invitation letter. Travellers whose organised program includes the Sahara may instead use our visa-authorisation route, with the sticker issued on arrival at Algiers airport. We confirm which applies to you.' },
];
const faqSchema = { '@type':'FAQPage', '@id':`${site}/evisa/#faq`,
  mainEntity: faqs.map(f => ({ '@type':'Question', name:f.q, acceptedAnswer:{ '@type':'Answer', text:f.a } })) };
---
<BaseLayout speakable={['h1', '.speak']}
  title="Algeria e-Visa & Entry: How It Really Works | Algeria Compass"
  description="Straight facts on entering Algeria: there is no general tourist e-Visa. The routes are a consulate visa or visa on arrival for organised Sahara tours."
  image="/assets/img/algiers-great-mosque.jpg"
  keywords={["Algeria e-Visa","Algeria visa on arrival","entry to Algeria","Algeria tourist visa","Algeria visa online","Djanet visa on arrival","Tassili n'Ajjer visa","Tamanrasset visa","Algeria Sahara visa"]}
  alternates={alternates}
  schema={[breadcrumb, faqSchema]}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'e-Visa & Entry'}]} />
  <section class="section"><div class="wrap" style="max-width:780px">
    <div class="eyebrow">Entry to Algeria</div>
    <h1>e-Visa &amp; entry to Algeria</h1>
    <div class="prose" style="margin-top:1rem">
      <p>Travellers often search for an "Algeria e-Visa". Here's the honest picture, so you plan on facts rather than hope.</p>

      <h2>Is there an Algeria e-Visa?</h2>
      <p class="speak">For ordinary tourism, <strong>there is no general online e-Visa</strong> you can simply apply for and print. Algeria's tourist entry works through two established routes instead — and we handle the paperwork for both.</p>

      <h2>Route 1 — Consulate tourist visa (the north & most trips)</h2>
      <p>You apply for a tourist visa at the <strong>Algerian consulate</strong> covering your country, normally in person. Consulates require an <strong>invitation letter / tourist voucher</strong> from a licensed Algerian agency — which we issue you, along with your hotel and tour confirmation and a checklist for your nationality. Allow roughly <strong>two to four weeks</strong>.</p>

      <h2>Route 2 — The Saharan e-Visa (organised desert programs)</h2>
      <p class="speak">This is the closest thing to an "online" route. For an <strong>organised Saharan program</strong>, we prepare a <strong>visa-authorisation document</strong> in advance — no consulate visit needed — and your visa sticker is issued on arrival at <strong>Algiers airport</strong>. It is <strong>open to travellers of any nationality</strong>, provided your organised program includes a Sahara trip. <a href="#saharan-evisa">See exactly how the Saharan e-Visa works ↓</a></p>

      <h2>What counts as a Sahara trip</h2>
      <p>The route needs a Sahara trip in your program — it does not matter which airport you fly into, and the visa is issued at Algiers. The Saharan regions our programs actually use are <strong>Djanet</strong> — the gateway to the <strong>Tassili n'Ajjer</strong> National Park and the <strong>Tadrart Rouge</strong> — <strong>Tamanrasset</strong> in the Hoggar, <strong>Ghardaïa</strong> in the M'Zab Valley and <strong>Timimoun</strong> in the Gourara. Once you are in Algeria, we book the domestic flights to the airports that serve them: <strong>Djanet–Tiska (DJG)</strong>, <strong>Tamanrasset (TMR)</strong>, <strong>Ghardaïa Noumérat (GHA)</strong> and <strong>Timimoun (TMX)</strong>. If you are booking one of our <a href="/tours/">Saharan programs</a>, the itinerary is already built to qualify.</p>

      <h2>How our visa support fits in</h2>
      <p>Whichever route applies, we prepare the documentation consulates and authorities expect — see <a href="/visa-support/">Visa Support</a> for the full detail and required documents, and <a href="/algeria-visa-requirements/">Algeria visa requirements</a> for a side-by-side comparison of the two routes. We are your documentation partner; the consulate or government issues the visa.</p>

      <h2>Verify before you travel</h2>
      <p>Algerian entry rules <strong>vary by nationality and change over time</strong>. Always confirm the current requirements with your official Algerian consulate, and let us know your nationality so we can tell you exactly which route — consulate visa or visa on arrival — fits your trip.</p>

      <p style="color:var(--text-l);font-size:.9rem">Not sure which route is yours? <a href="/contact/">Ask us</a> or message <a href={`https://wa.me/${CONTACT.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a> — we'll confirm and send your checklist.</p>
      <!-- OWNER: if Algeria introduces an official tourist e-Visa portal, link it here and update Route framing. -->
    </div>
  </div></section>

  <!-- ===== Saharan e-Visa explainer (P7) ===== -->
  <section class="section sev" id="saharan-evisa" data-region="sahara"><div class="wrap">
    <div class="sev-head">
      <span class="eyebrow">For organised Saharan programs</span>
      <h2>The Saharan e-Visa — how it works</h2>
      <p class="sev-lede">As a <strong>licensed Algerian tour operator</strong>, we can prepare your visa-authorisation document for a trip that includes the Sahara. Issuance follows the official channels: we handle every file, and the Algerian authorities issue the visa. Here is exactly what that means — and what it costs.</p>
    </div>

    <ol class="sev-steps">
      <li>
        <span class="sev-n">1</span>
        <div><strong>Book a complete program</strong>
        <p>The Saharan e-Visa authorisation is available when you book a complete tour with us. What qualifies is a <strong>Sahara trip in your program</strong> — so you can combine the <strong>north and the south</strong> in one journey, and you land in Algiers as normal.</p></div>
      </li>
      <li>
        <span class="sev-n">2</span>
        <div><strong>We prepare all the files — free</strong>
        <p>Assembling every required document is <strong>completely free on our side</strong>. We tell you precisely what to send for your nationality and put the application together for you.</p></div>
      </li>
      <li>
        <span class="sev-n">3</span>
        <div><strong>We issue your authorisation — $45</strong>
        <p>You receive a <strong>visa-authorisation document carrying a QR code</strong> that is <strong>verifiable on the Algerian Ministry of Interior’s portal</strong>. The document costs <strong>$45</strong>.</p></div>
      </li>
      <li>
        <span class="sev-n">4</span>
        <div><strong>Pay the sticker tax on arrival</strong>
        <p>A <strong>visa sticker/stamp tax is payable on arrival</strong> to the Algerian authorities, who issue the visa. The fee is set by your length of stay — see the table below.</p></div>
      </li>
    </ol>

    <StampFeeTable lang="en" />

    <div class="sev-facts">
      <div class="sev-fact"><span class="sev-fig">$45</span><span class="sev-lab">Authorisation document</span></div>
      <div class="sev-fact"><span class="sev-fig">Free</span><span class="sev-lab">We prepare every file</span></div>
      <div class="sev-fact"><span class="sev-fig">QR-verified</span><span class="sev-lab">On the Ministry of Interior portal</span></div>
      <div class="sev-fact"><span class="sev-fig">North + South</span><span class="sev-lab">Any program with a Sahara trip</span></div>
    </div>

    <div class="sev-note">
      <p><strong>One honest note:</strong> the visa stamp fee at Algiers airport is a government charge, separate from our $45 document fee, and it is set by length of stay, not by passport. Tell us your nationality and dates and we’ll confirm your eligibility and the exact fee before you commit.</p>
    </div>

    <div class="sev-cta">
      <a class="btn btn-gold" href="/tours/">Browse Saharan tours →</a>
      <a class="btn btn-ghost" href={`https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent('Hello Algeria Compass, I have a question about the Saharan e-Visa.')}`} target="_blank" rel="noopener">💬 Ask about the Saharan e-Visa</a>
    </div>

    <div class="sev-faq">
      <h3>Saharan e-Visa — quick answers</h3>
      <div class="faq">
        {faqs.slice(0,7).map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </div>
  </div></section>

  <CtaSection heading="We handle the visa — you enjoy the trip" />
</BaseLayout>

<style>
  /* ===== Saharan e-Visa explainer (P7) ===== */
  .sev{
    background-color:#F3E7CF;
    background-image:url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'48'%20height%3D'48'%3E%3Cg%20fill%3D'none'%20stroke%3D'%23C2842B'%20stroke-width%3D'1'%20opacity%3D'.12'%3E%3Cpath%20d%3D'M24%203L45%2024L24%2045L3%2024Z'/%3E%3Ccircle%20cx%3D'24'%20cy%3D'24'%20r%3D'6'/%3E%3C/g%3E%3C/svg%3E"),
      linear-gradient(180deg,#FAF1DE,#F0E1C2);
    scroll-margin-top:80px;
  }
  .sev .eyebrow{color:#8A5314}
  .sev-head{max-width:780px}
  .sev h2{color:#7a4513;font-size:clamp(1.5rem,3vw,2.1rem);margin:.2rem 0 .5rem}
  .sev-lede{color:#574226;font-size:1.06rem;line-height:1.7;margin:0}
  .sev-steps{list-style:none;padding:0;margin:1.8rem 0 0;display:grid;grid-template-columns:1fr 1fr;gap:1rem}
  .sev-steps li{display:flex;gap:.85rem;background:#fffaf0;border:1px solid #e6cfa3;border-radius:14px;
    padding:1.05rem 1.15rem;box-shadow:0 6px 18px rgba(122,69,19,.07)}
  .sev-n{flex:0 0 auto;width:2rem;height:2rem;border-radius:50%;background:#8A5410;color:#fff;font-weight:800;
    display:flex;align-items:center;justify-content:center;font-size:.95rem}
  .sev-steps strong{display:block;color:#7a4513;font-size:1.04rem;margin-bottom:.2rem}
  .sev-steps p{margin:0;color:#534233;font-size:.9rem;line-height:1.55}
  .sev-facts{display:grid;grid-template-columns:repeat(4,1fr);gap:.9rem;margin:1.4rem 0 0}
  .sev-fact{background:#7a4513;color:#fff;border-radius:13px;padding:1rem .9rem;text-align:center}
  .sev-fig{display:block;font-family:var(--serif);font-size:1.5rem;font-weight:800;color:#F4D58A;line-height:1.1}
  .sev-lab{display:block;font-size:.78rem;color:rgba(255,255,255,.85);margin-top:.3rem;line-height:1.35}
  .sev-note{margin:1.3rem 0 0;background:#fff6e6;border:1px solid #e6cfa3;border-left:4px solid #8A5410;
    border-radius:10px;padding:.9rem 1.1rem}
  .sev-note p{margin:0;color:#534233;font-size:.92rem;line-height:1.6}
  .sev-cta{margin:1.5rem 0 0;display:flex;flex-wrap:wrap;gap:.7rem}
  .sev-cta .btn-gold{background:#8A5410;color:#fff}
  .sev-cta .btn-gold:hover{filter:brightness(1.08)}
  .sev-cta .btn-ghost{border-color:#8A5410;color:#7a4513}
  .sev-faq{margin:2rem 0 0;max-width:820px}
  .sev-faq h3{color:#7a4513;font-size:1.2rem;margin:0 0 .6rem}
  @media(max-width:760px){
    .sev-steps{grid-template-columns:1fr}
    .sev-facts{grid-template-columns:1fr 1fr}
  }
</style>
