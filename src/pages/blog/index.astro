---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Card from '../../components/Card.astro';
import CtaSection from '../../components/CtaSection.astro';
const items = await getCollection('article');
---
<BaseLayout title="The Algeria Journal — Travel Guides & Stories" description="Guides, history, food and field notes from across Algeria." image="/assets/img/sahara-camp-sunset.jpg" keywords={["Algeria travel blog","Algeria guides","Algeria travel articles","Algeria stories"]}>
  <Hero title="The Algeria Journal" eyebrow="Algeria" text="Guides, history, food and field notes from across Algeria." image="/assets/img/brand-algeria.jpg" alt="Algeria" />
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'The Algeria Journal'}]} />
  <section class="section"><div class="wrap">
    <div class="grid">
      {items.map(it => (
        <Card href={`/blog/${it.slug}/`}
          title={it.data.title}
          image={it.data.image ?? '/assets/img/brand-algeria.jpg'}
          alt={it.data.imageAlt ?? it.data.title}
          tag={it.data.category}
          text={it.data.excerpt} />
      ))}
    </div>
    <p style="margin-top:1.4rem">More ways to explore Algeria: <a href="/travel-guides/">our travel guides</a>, or <a href="/discover/">discover Algeria</a> region by region.</p>
  </div></section>
  <CtaSection />
</BaseLayout>
