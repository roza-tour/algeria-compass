---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import FaqSection from '../../components/FaqSection.astro';
import CtaSection from '../../components/CtaSection.astro';
import RelatedGrid from '../../components/RelatedGrid.astro';
import Byline from '../../components/Byline.astro';
import SourceList from '../../components/SourceList.astro';
import EditorialMeta from '../../components/EditorialMeta.astro';
import { related, toCard } from '../../lib/related';
import { resolveAuthor, resolveReviewer, authorNode, reviewerNode, citationNodes } from '../../lib/authorship';
import KeyTakeaways from '../../components/KeyTakeaways.astro';
import TravelStats from '../../components/TravelStats.astro';
import ClimateMatrix from '../../components/ClimateMatrix.astro';
import SeasonRecommendation from '../../components/SeasonRecommendation.astro';
import TravelCostTable from '../../components/TravelCostTable.astro';
import TravelerProfileMatch from '../../components/TravelerProfileMatch.astro';
import TravelRequirements from '../../components/TravelRequirements.astro';
import CommonMistakes from '../../components/CommonMistakes.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import PracticalInfoBox from '../../components/PracticalInfoBox.astro';
export async function getStaticPaths() {
  const items = await getCollection('article');
  return items.map(item => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props;
const d = item.data;
const { Content } = await item.render();
const site = (Astro.site?.toString() || 'https://algeriacompass.com').replace(/\/$/, '');
const moreArticles = await related('article', { region: d.region, exclude: item.slug, limit: 3 });
const dests = await related('destination', { region: d.region, limit: 3 });
const author = await resolveAuthor(d.author);
const reviewer = await resolveReviewer(d.reviewedBy);
const authorEntity = authorNode(site, author.entry);
const reviewerEntity = reviewerNode(site, reviewer.entry);
const cites = citationNodes(d.sources);
const post = {
  "@type": "BlogPosting",
  "@id": `${site}/blog/${item.slug}/#post`,
  "headline": d.title,
  "description": d.excerpt,
  "image": site + d.image,
  "datePublished": d.published.toISOString(),
  "dateModified": d.updated.toISOString(),
  "author": { "@id": (authorEntity as any)["@id"] },
  "reviewedBy": { "@id": (reviewerEntity as any)["@id"] },
  "publisher": { "@id": site + "/#organization" },
  "mainEntityOfPage": `${site}/blog/${item.slug}/`,
  "inLanguage": "en",
  ...(cites.length ? { citation: cites } : {})
};
post["@type"] = ["BlogPosting","Article"];
const breadcrumb = { "@type":"BreadcrumbList", "@id":`${site}/blog/${item.slug}/#breadcrumb`, itemListElement:[
  { "@type":"ListItem", position:1, name:"Home", item:`${site}/` },
  { "@type":"ListItem", position:2, name:"Blog", item:`${site}/blog/` },
  { "@type":"ListItem", position:3, name:d.title, item:`${site}/blog/${item.slug}/` } ] };
const webpage = { "@type":"WebPage", "@id":`${site}/blog/${item.slug}/#webpage`, url:`${site}/blog/${item.slug}/`,
  name:d.seo.title, isPartOf:{ "@id":`${site}/#website` }, primaryImageOfPage: site + d.image,
  breadcrumb:{ "@id":`${site}/blog/${item.slug}/#breadcrumb` }, inLanguage:"en" };
// FAQPage is emitted once by <FaqSection> below (the shared component all page
// types use). Do NOT also add a FAQPage node to the @graph here, or each blog
// post renders two FAQPage blocks (duplicate schema emission).
const schemaNodes = [post, authorEntity, reviewerEntity, breadcrumb, webpage].filter(Boolean);
---
<BaseLayout title={d.seo.title} description={d.seo.description} image={d.image} imageAlt={d.imageAlt} keywords={d.seo.keywords} type="article" region={d.region} schema={schemaNodes} sticky={true}>
  <Fragment slot="head">
    <meta property="article:published_time" content={d.published.toISOString()} />
    <meta property="article:modified_time" content={d.updated.toISOString()} />
    <meta property="article:author" content={author.name} />
    <meta property="article:section" content={d.category} />
  </Fragment>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Blog',href:'/blog/'},{name:d.category}]} />
  <article class="section"><div class="wrap" style="max-width:780px">
    <span class="eyebrow">{d.category}</span>
    <h1 style="font-size:clamp(1.7rem,4vw,2.5rem);margin:.4rem 0">{d.title}</h1>
    <p style="color:var(--text-l);font-size:.82rem">{d.published.toLocaleDateString('en-US',{year:'numeric',month:'long'})} · {d.readMinutes} min read</p>
    <Byline authorName={author.name} authorHref={author.href} reviewerName={reviewer.name} reviewerHref={reviewer.href} updated={d.updated} lastReviewed={d.lastReviewed} />
    <img src={d.image} alt={d.imageAlt} style="border-radius:16px;margin:1.4rem 0;width:100%;aspect-ratio:16/9;object-fit:cover" width="780" height="440" loading="eager" />
    <QuickAnswer text={d.quickAnswer} />
    {d.keyTakeaways.length > 0 && <KeyTakeaways items={d.keyTakeaways} />}
    <div class="prose"><Content /></div>
    {d.stats.length > 0 && <TravelStats stats={d.stats} />}
    {d.climate.length > 0 && <ClimateMatrix months={d.climate} place={d.climatePlace} />}
    {d.seasons.length > 0 && <SeasonRecommendation seasons={d.seasons} />}
    {d.costs.length > 0 && <TravelCostTable rows={d.costs} currency={d.costCurrency} note={d.costNote} />}
    {d.travelerProfiles.length > 0 && <TravelerProfileMatch profiles={d.travelerProfiles} />}
    {d.requirements.length > 0 && <TravelRequirements items={d.requirements} note={d.requirementsNote} />}
    {d.practical.length > 0 && <PracticalInfoBox rows={d.practical} title={d.practicalTitle} />}
    {d.commonMistakes.length > 0 && <CommonMistakes items={d.commonMistakes} />}
    {d.comparisons.map(c => <ComparisonTable columns={c.columns} rows={c.rows} caption={c.caption} />)}
    <KeyFacts facts={d.keyFacts} />
    <SourceList sources={d.sources} />
    <EditorialMeta sourceCount={d.sources.length} reviewerName={reviewer.name} reviewerHref={reviewer.href} lastReviewed={d.lastReviewed} />
  </div></article>
  <RelatedGrid heading="Keep reading" items={moreArticles.map(e => toCard(e,'/blog/'))} />
  <RelatedGrid heading="Where this takes you" items={dests.map(e => toCard(e,'/destinations/'))} />
  <FaqSection faqs={d.faqs} />
  <CtaSection />
</BaseLayout>
