---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatesStrip from '../components/StatesStrip.astro';
import CivilizationsExplorer from '../components/CivilizationsExplorer.astro';
import SweetsStrip from '../components/SweetsStrip.astro';
import TravellerSlider from '../components/TravellerSlider.astro';
import Reviews from '../components/Reviews.astro';
import HonestAnswers from '../components/HonestAnswers.astro';
import TourCard from '../components/TourCard.astro';
import data from '../data/tours.json';
const tours = ((data as any).tours || (data as any)) as any[];

// curated featured tours (fall back to first 6)
const featuredIds = ['djanet-sahara-safari','algiers-city-tour-casbah-bardo-martyrsmemorial','algeria-through-time-and-tradition','tour-bejaia-historic','ghardaia-guided-tour','oran-mostaganem-tlemcen'];
const featured = featuredIds.map(id => tours.find(t => t.id === id)).filter(Boolean);

// "Plan your Algeria trip" — vibrant, joyful entry points (real pages only)
const planCards = [
  { href:'/tours/',        emoji:'🧭', title:'Browse tours',     text:'20 private, guided itineraries — Sahara, coast and Roman north.', a:'#0B3D2E', b:'#11543D' },
  { href:'/destinations/', emoji:'🏛️', title:'Destinations',     text:"Casbah of Algiers, Tassili n'Ajjer, Constantine, Djémila and more.", a:'#8A3F2E', b:'#b4543b' },
  { href:'/provinces/',    emoji:'🗺️', title:'States',           text:"Region-by-region guides across Algeria's States.", a:'#1E8C8C', b:'#27a9a9' },
  { href:'/travel-guides/',emoji:'🛂', title:'Travel guides',    text:'Visa, safety, best time to visit, food and transport.', a:'#C19333', b:'#dba63c' },
  { href:'/culture/',      emoji:'🍵', title:'Culture & food',   text:'Cuisine, crafts, music and the civilisations that shaped Algeria.', a:'#7a3b16', b:'#9c5223' },
  { href:'/discover/',     emoji:'✨', title:'Discover Algeria', text:'Our in-depth, researched guide to the whole country.', a:'#4A2A6A', b:'#6b3f97' },
];

const waText = encodeURIComponent("Hello Algeria Compass, I'd like to plan an Algeria tour.");
---
<BaseLayout
  title="Algeria Compass — Private Algeria Tours, Sahara Safaris & Cultural Journeys"
  description="Algeria Compass is a licensed Algerian tour operator: private, guided journeys across Algeria — Sahara safaris, the UNESCO Casbah of Algiers, Roman cities, the M'Zab Valley and the Kabyle coast. Tours from €30."
  image="/assets/img/algiers-white-city-aerial.jpg"
  imageAlt="The white tiered city of Algiers above its Mediterranean bay"
  keywords={["Algeria","Algeria tours","Algeria travel","visit Algeria","Algeria tour operator","Sahara tours Algeria","Algeria holidays"]}
  sticky={true}>

  {/* Preload the above-the-fold LCP hero image (already the page's OG image) */}
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/img/algiers-white-city-aerial.sm.webp" type="image/webp" fetchpriority="high" />
  </Fragment>

  <section class="home-hero" aria-label="Algeria Revealed">
    <picture class="home-hero-bg" aria-hidden="true">
      <source srcset="/assets/img/algiers-white-city-aerial.sm.webp" type="image/webp" />
      <img src="/assets/img/algiers-white-city-aerial.jpg" alt="" width="1600" height="900" fetchpriority="high" decoding="async" />
    </picture>
    <span class="home-hero-pattern" aria-hidden="true"></span>
    <div class="wrap home-hero-in">
      <div class="eyebrow">Algeria Revealed · Licensed Algerian Tour Operator</div>
      <h1>Explore Algeria in Elite Luxury</h1>
      <p class="lead">Private, locally-guided journeys across Algeria — Sahara, the UNESCO Casbah, Roman cities, the M'Zab and the coast.</p>
      <p class="hero-cta">
        <a class="btn btn-gold" href="/tours/">Browse all tours →</a>
        <a class="btn btn-ghost-light" href={`https://wa.me/213784193176?text=${waText}`} target="_blank" rel="noopener">💬 WhatsApp us</a>
      </p>
    </div>
    <a class="home-hero-scroll" href="#featured" aria-label="Scroll to featured tours"><span class="hhs-dot" aria-hidden="true"></span>Scroll</a>
  </section>

  <StatesStrip />

  <section class="section feat-sec" id="featured" data-reveal><div class="wrap">
    <div class="sec-head">
      <div class="eyebrow">Private journeys</div>
      <h2>Featured tours</h2>
    </div>
    <div class="grid" style="margin-top:1.4rem">
      {featured.map((t: any, i: number) => <TourCard tour={t} priority={i < 2} />)}
    </div>
    <p style="margin-top:1.6rem"><a class="btn" href="/tours/">All 20 tours →</a></p>
  </div></section>

  <!-- L1 — Luxury 5-Star Collection banner -->
  <section class="lux-band" aria-label="Luxury 5-Star Collection" data-reveal>
    <a class="lux-band-in wrap" href="/luxury/">
      <div class="lux-band-txt">
        <span class="lux-band-eyebrow">★ The 5-Star Collection</span>
        <h2>Luxury Algeria, privately yours</h2>
        <p>Three signature, all-inclusive 8-day journeys — Roman ruins, UNESCO cities, the Sahara and the Andalusian west. Internal flights, 5-star hotels, private 4WD. From €1,615 / person.</p>
        <span class="lux-band-cta">Discover the journeys →</span>
      </div>
    </a>
  </section>

  <section class="section plan-sec" data-reveal><div class="wrap">
    <div class="sec-head">
      <div class="eyebrow">The country</div>
      <h2>Plan your Algeria trip</h2>
      <p class="plan-lead">Six ways into Algeria — pick a thread and pull.</p>
    </div>
    <div class="plan-grid">
      {planCards.map(c => (
        <a class="plan-card" href={c.href} style={`--a:${c.a};--b:${c.b}`}>
          <span class="plan-emoji" aria-hidden="true">{c.emoji}</span>
          <span class="plan-t">{c.title}</span>
          <span class="plan-x">{c.text}</span>
          <span class="plan-go" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div></section>

  <CivilizationsExplorer />

  <SweetsStrip />

  <TravellerSlider />

  <Reviews />

  <HonestAnswers />

  <section class="section final-cta" style="background:var(--wash)" data-reveal><div class="wrap" style="text-align:center">
    <div class="cta">
      <h2>Ready to see Algeria?</h2>
      <p style="margin-top:.5rem">Tell us your dates and interests — we'll craft a private itinerary.</p>
      <p style="margin-top:1rem">
        <a class="btn btn-gold" href="/contact/">Plan a trip</a>
        <a class="btn" href={`https://wa.me/213784193176?text=${waText}`} target="_blank" rel="noopener" style="background:#25D366;color:#06351f" aria-label="Plan your trip on WhatsApp">💬 WhatsApp</a>
      </p>
    </div>
  </div></section>

  <script is:inline>
    /* Homepage hero parallax — image drifts slower than the content on scroll.
       Scroll-reveal for [data-reveal] sections is handled globally in BaseLayout. */
    (function(){
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var bg = document.querySelector('.home-hero-bg');
      var inr = document.querySelector('.home-hero-in');
      if(!bg) return;
      var ticking = false;
      window.addEventListener('scroll', function(){
        if(ticking) return; ticking = true;
        requestAnimationFrame(function(){
          var y = window.pageYOffset || 0;
          if(y < 820){
            bg.style.transform = 'translateY(' + (y*0.18).toFixed(1) + 'px)';
            if(inr){ inr.style.transform = 'translateY(' + (y*0.30).toFixed(1) + 'px)'; inr.style.opacity = String(Math.max(0, 1 - y/560)); }
          }
          ticking = false;
        });
      }, { passive:true });
    })();
  </script>

</BaseLayout>

<style>
  /* L1 — luxury banner */
  .lux-band{background:#07261C}
  .lux-band-in{display:block;text-decoration:none;position:relative;overflow:hidden;
    padding:2.4rem 0;border-radius:0}
  .lux-band{position:relative;overflow:hidden}
  .lux-band::before{content:"";position:absolute;inset:0;background:
    radial-gradient(120% 100% at 90% -20%, rgba(201,162,75,.28), transparent 55%),
    radial-gradient(90% 90% at -10% 120%, rgba(30,111,92,.5), transparent 55%),
    linear-gradient(135deg,#0B3D2E,#07261C);pointer-events:none}
  .lux-band-txt{position:relative;max-width:760px}
  .lux-band-eyebrow{display:inline-block;color:#E0BE73;font-weight:800;font-size:.8rem;letter-spacing:.08em;
    text-transform:uppercase;margin-bottom:.5rem}
  .lux-band h2{font-family:'Cinzel',serif;color:#fff;font-size:clamp(1.5rem,3.4vw,2.3rem);margin:0 0 .5rem;line-height:1.1}
  .lux-band p{color:rgba(255,255,255,.9);line-height:1.6;margin:0 0 1rem;max-width:640px}
  .lux-band-cta{display:inline-block;background:#C9A24B;color:#07261C;font-weight:800;padding:.7rem 1.3rem;
    border-radius:10px;transition:transform .15s ease,filter .15s ease}
  .lux-band-in:hover .lux-band-cta{transform:translateY(-2px);filter:brightness(1.06)}
  /* P4 — "Plan your Algeria trip": vibrant, joyful entry cards */
  .plan-sec{background:linear-gradient(180deg,#fbf8f2,#f3ede0)}
  .plan-lead{color:var(--text-m);margin:.4rem 0 0}
  .plan-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1rem;margin-top:1.3rem}
  .plan-card{position:relative;overflow:hidden;display:flex;flex-direction:column;gap:.3rem;
    min-height:160px;padding:1.2rem 1.2rem 1.3rem;border-radius:18px;text-decoration:none;color:#fff;
    background:linear-gradient(140deg,var(--a),var(--b));box-shadow:0 8px 24px rgba(11,61,46,.14);
    transition:transform .18s ease,box-shadow .18s ease}
  .plan-card::after{content:"";position:absolute;right:-30px;top:-30px;width:120px;height:120px;border-radius:50%;
    background:rgba(255,255,255,.12);transition:transform .3s ease}
  .plan-card:hover{transform:translateY(-5px);box-shadow:0 18px 40px rgba(11,61,46,.22)}
  .plan-card:hover::after{transform:scale(1.5)}
  .plan-emoji{font-size:1.7rem;position:relative;z-index:1}
  .plan-t{font-family:'Cinzel',serif;font-weight:700;font-size:1.2rem;position:relative;z-index:1}
  .plan-x{font-size:.86rem;color:rgba(255,255,255,.92);line-height:1.45;flex:1;position:relative;z-index:1}
  .plan-go{font-size:1.3rem;font-weight:800;position:relative;z-index:1;transition:transform .18s ease}
  .plan-card:hover .plan-go{transform:translateX(5px)}

  /* ===== Phase 3 — homepage visual transform ===== */
  /* Hero: full-bleed photo + emerald protection scrim + gold compass-diamond field */
  .home-hero{position:relative;min-height:clamp(420px,72vh,720px);display:flex;align-items:flex-end;
    overflow:hidden;background:var(--green-d)}
  .home-hero-bg{position:absolute;inset:-6% 0 0;z-index:0;will-change:transform}
  .home-hero-bg img{width:100%;height:108%;object-fit:cover;display:block}
  .home-hero::after{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;
    background:linear-gradient(105deg,rgba(7,38,28,.92),rgba(7,38,28,.55) 48%,rgba(7,38,28,.22) 80%),
               linear-gradient(0deg,rgba(7,38,28,.72),transparent 40%)}
  .home-hero-pattern{position:absolute;inset:0;z-index:1;pointer-events:none;opacity:.55;
    background-image:url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'90'%20height%3D'90'%20viewBox%3D'0%200%2090%2090'%3E%20%3Cg%20fill%3D'none'%20stroke%3D'%23C8920A'%20stroke-width%3D'1'%20opacity%3D'0.4'%3E%20%3Cpath%20d%3D'M45%206%20L84%2045%20L45%2084%20L6%2045%20Z'%2F%3E%3Cpath%20d%3D'M45%2026%20L64%2045%20L45%2064%20L26%2045%20Z'%2F%3E%20%3Ccircle%20cx%3D'45'%20cy%3D'45'%20r%3D'3'%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E");
    background-repeat:repeat;background-size:90px 90px}
  .home-hero-in{position:relative;z-index:2;padding:3.4rem 0 3rem;will-change:transform}
  .home-hero .eyebrow{color:var(--gold-l)}
  .home-hero h1{color:#fff;font-size:var(--fs-display);max-width:15ch;margin:.55rem 0 0;
    text-shadow:0 2px 28px rgba(0,0,0,.38)}
  .home-hero .lead{color:rgba(255,255,255,.92);max-width:54ch;margin:.95rem 0 0;
    font-size:var(--fs-lead);font-weight:300;line-height:1.6}
  .home-hero .hero-cta{margin-top:1.6rem;display:flex;gap:.8rem;flex-wrap:wrap;align-items:center}
  .home-hero-scroll{position:absolute;left:50%;bottom:1.1rem;transform:translateX(-50%);z-index:2;
    display:flex;flex-direction:column;align-items:center;gap:.4rem;color:rgba(255,255,255,.82);
    font-size:.64rem;letter-spacing:.2em;text-transform:uppercase;text-decoration:none}
  .home-hero-scroll:hover{color:#fff;text-decoration:none}
  .hhs-dot{width:22px;height:34px;border:2px solid rgba(255,255,255,.6);border-radius:12px;position:relative}
  .hhs-dot::before{content:"";position:absolute;left:50%;top:6px;width:3px;height:7px;border-radius:2px;
    background:var(--gold-l);transform:translateX(-50%);animation:hhs 1.7s ease-in-out infinite}
  @keyframes hhs{0%{opacity:0;transform:translate(-50%,0)}40%{opacity:1}100%{opacity:0;transform:translate(-50%,12px)}}
  @media (max-width:640px){
    .home-hero{min-height:clamp(360px,58vh,520px)}
    .home-hero-in{padding:2.1rem 0 2.3rem}
    .home-hero h1{max-width:none}
    .home-hero-scroll{display:none}
  }
  /* Section rhythm + heading hierarchy */
  .home-hero ~ .section{padding-block:clamp(3rem,5.5vw,4.6rem)}
  .sec-head{margin-bottom:.5rem}
  .sec-head .eyebrow{display:inline-block}
  .sec-head .eyebrow::after{content:"";display:block;width:34px;height:3px;border-radius:2px;
    background:var(--gold);margin-top:.55rem;opacity:.92}
  .sec-head h2{font-size:var(--fs-h1);margin:.4rem 0 0;letter-spacing:.004em}
  .feat-sec .grid{gap:1.6rem}
  /* Reveal-on-scroll styles are global (in global.css). */
  @media (prefers-reduced-motion: reduce){
    .hhs-dot::before{animation:none}
  }
</style>
