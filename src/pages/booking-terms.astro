---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaSection from '../components/CtaSection.astro';
import { CONTACT } from '../config';
const site = (Astro.site?.toString() || 'https://algeriacompass.com').replace(/\/$/, '');
const breadcrumb = { '@type':'BreadcrumbList', itemListElement:[
  {'@type':'ListItem',position:1,name:'Home',item:`${site}/`},
  {'@type':'ListItem',position:2,name:'Booking & Cancellation Terms',item:`${site}/booking-terms/`}]};
const faqs = [
  { q: 'How do I pay, and is there a deposit?', a: 'Booking is by request. Once we confirm availability, permits and any flights, a deposit secures your dates and the balance is due before departure. Payment is by bank transfer or arranged on WhatsApp — we do not take card payments online yet.' },
  { q: 'What is your refund policy if I cancel?', a: 'You can cancel free of charge up to 5 days before your tour departure date and receive a full refund. Within 5 days of departure, costs already committed on your behalf — hotels, internal flights, guides, drivers and suppliers — may no longer be recoverable, and we refund whatever remains. Government visa fees, independently booked flights and travel insurance are never refundable, as they are paid to third parties.' },
  { q: 'Can I change my dates?', a: 'Yes — date changes are free, subject to availability. Tell us as early as you can so we can re-arrange guides, transport and any permits.' },
];
const faqSchema = { '@type':'FAQPage', '@id':`${site}/booking-terms/#faq`,
  mainEntity: faqs.map(f => ({ '@type':'Question', name:f.q, acceptedAnswer:{ '@type':'Answer', text:f.a } })) };
---
<BaseLayout
  title="Booking & Cancellation Terms | Algeria Compass"
  description="How booking, deposits, payment, refunds and date changes work with Algeria Compass — free cancellation up to 5 days before departure for a full refund, plus free date changes subject to availability."
  image="/assets/img/brand-algeria.jpg"
  keywords={["Algeria Compass booking terms","cancellation policy","refund policy","Algeria tour payment","Algeria tour deposit"]}
  schema={[breadcrumb, faqSchema]}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Booking & Cancellation Terms'}]} />
  <section class="section"><div class="wrap" style="max-width:780px">
    <div class="eyebrow">Good to know</div>
    <h1>Booking &amp; cancellation terms</h1>
    <div class="prose" style="margin-top:1rem">
      <p>We keep our terms short and fair. Here is exactly how booking, payment, refunds and changes work. Anything specific to your trip — particularly where domestic flights or desert permits are involved — is confirmed in writing before you pay.</p>

      <h2>How booking works</h2>
      <p>Booking with us is by <strong>request</strong>, not instant checkout. You send your dates and group through any tour's booking form or on WhatsApp; we check availability, permits and flights; then we confirm the details and the final price. A <strong>deposit</strong> secures your dates, and the <strong>balance is due before departure</strong>.</p>

      <h2>Payment</h2>
      <p>Payment is by <strong>bank transfer</strong> or arranged with us on <strong>WhatsApp</strong>. We do not currently accept card payments online; if that changes, it will be a secure, named gateway and we will say so clearly. We will never ask for card details by message or email.</p>

      <h2>Cancellations &amp; refunds</h2>
      <ul>
        <li><strong>Free cancellation up to 5 days before departure — full refund.</strong> Cancel any time up to five days before your tour departure date and we refund you in full. We keep nothing.</li>
        <li><strong>Within 5 days of departure.</strong> Costs already committed on your behalf — hotels, internal flights, guides, drivers and suppliers — may no longer be recoverable; we always refund whatever remains.</li>
      </ul>
      <p>Some costs are paid to third parties and are <strong>never refundable</strong> through us: visa fees paid to the Algerian government, international or domestic flights you booked independently, and travel-insurance premiums.</p>

      <h2>Changing your dates or itinerary</h2>
      <p><strong>Date changes are free, subject to availability.</strong> We will always try to accommodate a change of plan; the earlier you tell us, the easier it is to re-arrange guides, transport and any permits. Significant itinerary changes may affect the price, which we will confirm with you first.</p>

      <h2>If circumstances are beyond anyone's control</h2>
      <p>In genuinely exceptional situations — natural disasters, government travel bans or similar events outside everyone's control — we will work with you in good faith, normally offering a credit toward a future trip. Tell us as soon as you can and we will find the fairest way forward.</p>

      <h2>How to cancel or change a booking</h2>
      <p>Contact us with your booking reference by email at <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a> or on <a href={`https://wa.me/${CONTACT.whatsapp}`} target="_blank" rel="noopener">WhatsApp ({CONTACT.phoneDisplay})</a>. We confirm within a day and process any refund promptly to your original payment method.</p>

      <p style="color:var(--text-l);font-size:.9rem">These terms apply to private tours booked directly with Algeria Compass. The specific terms for your trip are confirmed in writing at the time of booking.</p>
      <!-- OWNER: published cancellation policy = FREE CANCELLATION UP TO 5 DAYS before the
           tour departure date (full refund). If you want a specific closer-in tier or fee
           (rather than handling it case by case), tell me the exact figures and I'll add them. -->
    </div>
  </div></section>
  <CtaSection heading="Questions about a booking?" />
</BaseLayout>
