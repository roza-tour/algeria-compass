const SUGGEST: Record<Lang, string[]> = {
  en: ['How much do your tours cost?', 'When is the best time to visit?', 'Do I need a visa?', 'Are your tours private?'],
  fr: ['Combien coûtent vos circuits ?', 'Quelle est la meilleure période ?', 'Ai-je besoin d’un visa ?', 'Vos circuits sont-ils privés ?'],
  de: ['Was kosten Ihre Reisen?', 'Wann ist die beste Reisezeit?', 'Brauche ich ein Visum?', 'Sind Ihre Reisen privat?'],
  es: ['¿Cuánto cuestan vuestros circuitos?', '¿Cuál es la mejor época?', '¿Necesito visado?', '¿Vuestros circuitos son privados?'],
  it: ['Quanto costano i vostri circuiti?', 'Qual è il periodo migliore?', 'Serve un visto?', 'I vostri circuiti sono privati?'],
};


// Trip planner — four taps instead of a blank box. Answers are matched against
// the same tour catalogue (theme, days, regions), and the visitor leaves with
// two real trips and a WhatsApp message that already says what they want.
const PLAN: Record<Lang, any> = {
  en: { start: '✨ Help me choose a trip', intro: 'Four quick questions and I will suggest two trips.',
        q: ['What draws you most?', 'How many days do you have?', 'When would you travel?', 'How many travellers?'],
        o: [['The Sahara & desert', 'Roman ruins & history', 'Cities & culture', 'A bit of everything'], ['Up to 5 days', '6 to 8 days', '9 days or more'], ['October – April', 'May – September', 'Not sure yet'], ['1 – 2', '3 – 6', '7 or more']],
        res: 'Here are the two trips that fit best:', summer: 'The deep Sahara is a winter trip (October to April), so for summer I have suggested the north.',
        wa: 'Send my answers on WhatsApp', req: 'Request these dates', again: 'Start again', none: 'Nothing on our list fits that exactly — our team will build it for you.' },
  fr: { start: '✨ Aidez-moi à choisir', intro: 'Quatre questions rapides et je vous propose deux circuits.',
        q: ['Qu’est-ce qui vous attire le plus ?', 'De combien de jours disposez-vous ?', 'Quand voyageriez-vous ?', 'Combien de voyageurs ?'],
        o: [['Le Sahara et le désert', 'Ruines romaines et histoire', 'Villes et culture', 'Un peu de tout'], ['Jusqu’à 5 jours', '6 à 8 jours', '9 jours ou plus'], ['Octobre – avril', 'Mai – septembre', 'Je ne sais pas encore'], ['1 – 2', '3 – 6', '7 ou plus']],
        res: 'Voici les deux circuits qui vous correspondent le mieux :', summer: 'Le grand Sahara se visite en hiver (octobre à avril) : pour l’été, je vous propose le nord.',
        wa: 'Envoyer mes réponses sur WhatsApp', req: 'Demander ces dates', again: 'Recommencer', none: 'Rien dans notre liste ne correspond exactement — notre équipe vous le construit sur mesure.' },
  it: { start: '✨ Aiutami a scegliere', intro: 'Quattro domande veloci e vi propongo due viaggi.',
        q: ['Cosa vi attira di più?', 'Quanti giorni avete?', 'Quando partireste?', 'Quanti viaggiatori?'],
        o: [['Il Sahara e il deserto', 'Rovine romane e storia', 'Città e cultura', 'Un po’ di tutto'], ['Fino a 5 giorni', 'Da 6 a 8 giorni', '9 giorni o più'], ['Ottobre – aprile', 'Maggio – settembre', 'Non so ancora'], ['1 – 2', '3 – 6', '7 o più']],
        res: 'Ecco i due viaggi più adatti:', summer: 'Il Sahara profondo è un viaggio invernale (da ottobre ad aprile): per l’estate vi propongo il nord.',
        wa: 'Invia le mie risposte su WhatsApp', req: 'Richiedi queste date', again: 'Ricomincia', none: 'Niente nella nostra lista corrisponde esattamente — il nostro team lo costruisce su misura.' },
  es: { start: '✨ Ayúdame a elegir', intro: 'Cuatro preguntas rápidas y le propongo dos viajes.',
        q: ['¿Qué le atrae más?', '¿Cuántos días tiene?', '¿Cuándo viajaría?', '¿Cuántos viajeros?'],
        o: [['El Sáhara y el desierto', 'Ruinas romanas e historia', 'Ciudades y cultura', 'Un poco de todo'], ['Hasta 5 días', 'De 6 a 8 días', '9 días o más'], ['Octubre – abril', 'Mayo – septiembre', 'Aún no lo sé'], ['1 – 2', '3 – 6', '7 o más']],
        res: 'Estos son los dos viajes que mejor encajan:', summer: 'El Sáhara profundo es un viaje de invierno (de octubre a abril): para el verano le propongo el norte.',
        wa: 'Enviar mis respuestas por WhatsApp', req: 'Solicitar estas fechas', again: 'Empezar de nuevo', none: 'Nada de nuestra lista encaja exactamente — nuestro equipo se lo diseña a medida.' },
  de: { start: '✨ Hilfe bei der Reisewahl', intro: 'Vier kurze Fragen, dann schlage ich Ihnen zwei Reisen vor.',
        q: ['Was reizt Sie am meisten?', 'Wie viele Tage haben Sie?', 'Wann würden Sie reisen?', 'Wie viele Reisende?'],
        o: [['Die Sahara & Wüste', 'Römische Ruinen & Geschichte', 'Städte & Kultur', 'Von allem etwas'], ['Bis zu 5 Tage', '6 bis 8 Tage', '9 Tage oder mehr'], ['Oktober – April', 'Mai – September', 'Noch offen'], ['1 – 2', '3 – 6', '7 oder mehr']],
        res: 'Diese zwei Reisen passen am besten:', summer: 'Die tiefe Sahara ist eine Winterreise (Oktober bis April) — für den Sommer schlage ich den Norden vor.',
        wa: 'Meine Antworten per WhatsApp senden', req: 'Diese Termine anfragen', again: 'Neu starten', none: 'Nichts auf unserer Liste passt genau — unser Team stellt es Ihnen individuell zusammen.' },
};

const t = T[lang];
const plan = PLAN[lang];
const waHref = `https://wa.me/${CONTACT.whatsapp}`;
const contactHref = ROUTES[lang].contact;
---

<button class="ask-launch" id="askLaunch" type="button" aria-expanded="false" aria-controls="askPanel">
  <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.6 8.6 0 0 1-3.8-.9L3 21l1.9-4.9A8.4 8.4 0 0 1 12 3.1a8.4 8.4 0 0 1 9 8.4z"/>
  </svg>
  <span>{t.launch}</span>
</button>

<div class="ask-panel" id="askPanel" role="dialog" aria-modal="false" aria-labelledby="askTitle" hidden
     data-lang={lang} data-src={`/answers-${lang}.json`}
     data-wa={waHref} data-contact={contactHref}
     data-none={t.none} data-more={t.more} data-walabel={t.wa} data-msg={t.msg}
     data-from={t.from} data-also={t.also} data-thinking={t.thinking} data-near={t.near}
     data-trips={t.trips} data-per={t.per} data-plan={JSON.stringify(plan)}>
  <div class="ask-head">
    <div>
      <h2 id="askTitle">{t.title}</h2>
      <p>{t.sub}</p>
    </div>
    <button class="ask-x" id="askClose" type="button" aria-label={t.close}>&times;</button>
  </div>

  <div class="ask-log" id="askLog" role="log" aria-live="polite">
    <ul class="ask-sugg" id="askSugg">
      <li><button type="button" class="ask-plan-start" data-plan-start="1">{plan.start}</button></li>
      {SUGGEST[lang].map(s => <li><button type="button" data-q={s}>{s}</button></li>)}
    </ul>
  </div>

  <form class="ask-form" id="askForm">
    <label class="ask-sr" for="askInput">{t.title}</label>
    <input id="askInput" name="q" type="text" autocomplete="off" placeholder={t.ph} maxlength="200" />
    <button type="submit">{t.send}</button>
  </form>
</div>

<!-- is:global is required, not laziness: the answer bubbles, the related list and
     the handoff buttons are created in JS, so they never receive Astro's scope
     attribute and scoped rules simply do not match them — the panel rendered as
     unstyled run-together text. Every selector here is namespaced .ask-*. -->
<style is:global>
  .ask-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

  /* The open/closed state is the `hidden` attribute, and the browser's own
     [hidden]{display:none} is the weakest rule there is — the `display:flex`
     and `display:inline-flex` below beat it on specificity, so without this
     line the panel is never actually closed: it sits open over the bottom-left
     of every page with the launcher buried underneath it. */
  .ask-launch[hidden], .ask-panel[hidden]{display:none !important}

  /* --ask-up is the height of the cookie banner while it is on screen (set in
     JS below), so the launcher and the panel ride above it instead of under
     it. It is 0 the rest of the time, which is every visit after the first. */
  .ask-launch{position:fixed;left:16px;bottom:calc(16px + var(--ask-up,0px));z-index:90;
    display:inline-flex;align-items:center;gap:.45rem;min-height:44px;
    padding:.7rem 1.05rem;border:0;border-radius:var(--radius-pill);cursor:pointer;
    background:var(--green-d);color:#fff;font:inherit;font-weight:800;font-size:.92rem;
    box-shadow:var(--shadow-pill);transition:background .18s}
  .ask-launch:hover{background:var(--brand-green)}
  .ask-launch:focus-visible{outline:3px solid var(--gold-l);outline-offset:2px}

  /* Above the cookie banner (z-index 200): the banner is centred and overlaps
     the right half of this panel, so at 95 the input and the send button sat
     underneath it and clicks landed on the banner instead. The launcher stays
     below the banner — the banner is answered once, then it is gone. */
  .ask-panel{position:fixed;left:16px;bottom:calc(16px + var(--ask-up,0px));z-index:210;
    width:min(400px,calc(100vw - 32px));
    max-height:min(620px,calc(100vh - 32px - var(--ask-up,0px)));
    display:flex;flex-direction:column;overflow:hidden;
    background:var(--card);border:1px solid var(--border);border-radius:16px;
    box-shadow:0 18px 50px rgba(7,38,28,.28)}

  .ask-head{display:flex;align-items:flex-start;gap:.6rem;padding:1rem 1.1rem .85rem;
    background:linear-gradient(160deg,var(--brand-green),var(--green-d));color:#fff}
  .ask-head h2{font-size:1.08rem;color:#fff;margin:0;font-family:var(--sans);font-weight:800}
  .ask-head p{margin:.25rem 0 0;font-size:.86rem;color:rgba(255,255,255,.88);line-height:1.5}
  .ask-x{margin-inline-start:auto;background:transparent;border:0;color:#fff;cursor:pointer;
    font-size:1.6rem;line-height:1;padding:0 .2rem;min-width:44px;min-height:44px}
  .ask-x:focus-visible{outline:2px solid var(--gold-l);outline-offset:2px;border-radius:6px}

  .ask-log{flex:1;overflow-y:auto;padding:1rem 1.1rem;display:flex;flex-direction:column;gap:.9rem;
    background:var(--paper)}

  .ask-sugg{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.45rem}
  .ask-sugg button{width:100%;text-align:start;font:inherit;font-size:.93rem;font-weight:600;
    color:var(--green-d);background:var(--card);border:1px solid var(--border);
    border-radius:10px;padding:.6rem .8rem;min-height:44px;cursor:pointer;transition:border-color .16s,background .16s}
  .ask-sugg button:hover{border-color:var(--green);background:#fff}
  .ask-sugg button:focus-visible{outline:2px solid var(--green);outline-offset:1px}

  .ask-q{align-self:flex-end;max-width:88%;background:var(--green-d);color:#fff;
    border-radius:12px 12px 3px 12px;padding:.55rem .8rem;font-size:.93rem;font-weight:600;line-height:1.5}
  .ask-a{background:var(--card);border:1px solid var(--border);border-radius:12px 12px 12px 3px;
    padding:.8rem .9rem;max-width:96%}
  .ask-a .chip{display:inline-block;font-size:.7rem;font-weight:800;letter-spacing:.05em;
    text-transform:uppercase;color:var(--accent-ink);margin-bottom:.35rem}
  .ask-a .qt{display:block;font-weight:700;color:var(--green-d);font-size:.95rem;margin-bottom:.25rem}
  .ask-a p{margin:0;color:var(--text-m);font-size:.95rem;line-height:1.6}
  .ask-a .src{display:inline-block;margin-top:.55rem;font-size:.88rem;font-weight:700;
    color:var(--green-d);text-decoration:underline;text-underline-offset:2px}
  .ask-a .foot{margin-top:.5rem;font-size:.76rem;color:var(--text-l)}
  .ask-a .near{margin:0 0 .55rem;padding:.45rem .6rem;border-radius:8px;
    background:var(--warn-wash,#FAF2E2);color:var(--gold-d);font-size:.86rem;font-weight:600;line-height:1.5}

  .ask-also{margin-top:.6rem;padding-top:.55rem;border-top:1px solid var(--border)}
  .ask-also b{display:block;font-size:.74rem;font-weight:800;letter-spacing:.05em;
    text-transform:uppercase;color:var(--text-l);margin-bottom:.3rem}
  .ask-also a{display:block;font-size:.9rem;font-weight:600;color:var(--green-d);
    padding:.2rem 0;text-decoration:underline;text-underline-offset:2px}

  /* Trip suggestions read as cards, not as another list of links: they are the
     one place in the panel where we are selling rather than answering, and the
     price is the fact the visitor is looking for. */
  .ask-trips{margin-top:.6rem;padding-top:.55rem;border-top:1px solid var(--border)}
  .ask-trips b{display:block;font-size:.74rem;font-weight:800;letter-spacing:.05em;
    text-transform:uppercase;color:var(--text-l);margin-bottom:.35rem}
  .ask-trips a{display:block;padding:.5rem .65rem;margin-bottom:.35rem;text-decoration:none;
    background:var(--paper);border:1px solid var(--border);border-radius:10px;
    transition:border-color .16s,background .16s}
  .ask-trips a:hover{border-color:var(--green);background:#fff}
  .ask-trips a:focus-visible{outline:2px solid var(--green);outline-offset:1px}
  .ask-trips .tt{display:block;font-size:.9rem;font-weight:700;color:var(--green-d);line-height:1.35}
  .ask-trips .tm{display:block;margin-top:.15rem;font-size:.8rem;font-weight:600;color:var(--text-m)}

  .ask-chips{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.5rem}
  .ask-chips button{font:inherit;font-size:.92rem;font-weight:600;min-height:40px;padding:.45rem .8rem;border-radius:999px;
    border:1px solid var(--border);background:#fff;color:var(--text);cursor:pointer}
  .ask-chips button:hover,.ask-chips button.on{border-color:var(--green);background:var(--green);color:#fff}
  .ask-chips[data-done] button:not(.on){opacity:.45;cursor:default}
  .ask-sugg .ask-plan-start,.ask-plan-start{background:var(--green);color:#fff;border-color:var(--green)}
  .ask-plan-start{font:inherit;font-weight:700;min-height:40px;padding:.45rem .9rem;border-radius:10px;border:1px solid var(--green);cursor:pointer}
  .ask-sugg .ask-plan-start:hover{background:#fff;color:var(--green)}
  .ask-hand{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:.6rem}
  .ask-hand a{display:inline-flex;align-items:center;min-height:40px;padding:.45rem .8rem;
    border-radius:var(--radius-pill);font-size:.87rem;font-weight:800;text-decoration:none}
  .ask-hand .wa{background:#1ebe5d;color:#06351f}
  .ask-hand .ct{background:var(--wash);color:var(--green-d);border:1px solid var(--border)}

  .ask-form{display:flex;gap:.5rem;padding:.75rem .8rem;border-top:1px solid var(--border);background:var(--card)}
  .ask-form input{flex:1;min-width:0;font:inherit;font-size:.95rem;padding:.6rem .75rem;
    border:1px solid var(--border);border-radius:10px;background:#fff;color:var(--ink);min-height:44px}
  .ask-form input:focus-visible{outline:2px solid var(--green);outline-offset:0;border-color:var(--green)}
  .ask-form button{font:inherit;font-weight:800;font-size:.92rem;padding:.6rem 1.05rem;min-height:44px;
    border:0;border-radius:10px;background:var(--gold);color:#1a1a1a;cursor:pointer}
  .ask-form button:hover{background:var(--gold-l)}
  .ask-form button:focus-visible{outline:3px solid var(--green);outline-offset:2px}

  /* On phones the launcher sits opposite the WhatsApp bar and loses its label;
     the panel goes full width so the answer text is not squeezed. */
  @media(max-width:520px){
    .ask-launch span{display:none}
    .ask-launch{padding:.6rem .75rem}
    .ask-panel{left:8px;right:8px;bottom:calc(8px + var(--ask-up,0px));width:auto;
      max-height:calc(100vh - 16px - var(--ask-up,0px))}
  }
  @media(prefers-reduced-motion:reduce){.ask-launch{transition:none}}
</style>

<script is:inline>
(function () {
  var panel = document.getElementById('askPanel');
  var launch = document.getElementById('askLaunch');
  if (!panel || !launch) return;

  var log = document.getElementById('askLog');
  var form = document.getElementById('askForm');
  var input = document.getElementById('askInput');
  var closeBtn = document.getElementById('askClose');
  var D = panel.dataset;

  var data = null, loading = null, idf = null;

  // ---- text handling -------------------------------------------------
  // Strip accents so "Ghardaia" matches "Ghardaïa" and "cout" matches "coût".
  function norm(s) {
    return String(s || '').toLowerCase()
      .normalize('NFD').replace(/[̀-ͯ]/g, '')
      .replace(/[^a-z0-9À-ɏ\s'’-]/g, ' ')
      .replace(/\s+/g, ' ').trim();
  }
  // Interrogatives are deliberately NOT stopped: the indexed questions contain
  // them too, so "when…" matching "When is…" is real signal, not noise.
  var STOP = ' a an the is are do does did can could would should i my me we our you your of in on at to for from with and or but it its this that these those there any some be been was were will shall les des une un le la de du et ou est sont pour avec dans sur je vous nous mon votre der die das ein eine und oder ist sind fur mit auf im den dem ich wir sie ihr el los las una y o es son para con en al mi su i gli lo delle della e per con nel sul mio vostro '
    // Conversational framing verbs. They carry no topic, but the site has
    // never published most of them, so they scored as maximally rare and
    // hijacked the "rarest word in the question" test — "tell me about the
    // Tadrart Rouge" was judged to be a question about `tell`.
    + 'tell show want wants wanted wish looking look plan planning see seeing know about please help thinking interested trip trips '
    + 'voir veux veut voudrais aimerais souhaite savoir dire aller montrer '
    + 'quiero quiere queria querria ver saber ir mostrar decir '
    + 'vorrei voglio vuole vedere sapere andare mostrare dire '
    + 'mochte mochten will wollen sehen wissen gehen zeigen sagen ';
  function toks(s) {
    var out = [];
    norm(s).split(' ').forEach(function (w) {
      if (w.length < 2 || STOP.indexOf(' ' + w + ' ') !== -1) return;
      out.push(w);
      // Someone typing quickly writes "mzab", not "M'Zab"; index both so the
      // apostrophe is not the reason a place fails to match.
      if (/['\u2019]/.test(w)) {
        var bare = w.replace(/['\u2019]/g, '');
        if (bare.length > 1 && bare !== w && STOP.indexOf(' ' + bare + ' ') === -1) out.push(bare);
        // French and Italian elision: the site writes "l'eau", "d'Alger",
        // "dell'Hamma", but a visitor types "eau", "Alger", "Hamma". Index the
        // noun on its own too \u2014 without this, "puis-je boire l eau du robinet"
        // matched nothing at all, because "eau" and "l'eau" were different
        // words. Only a short prefix counts as an article, so "aujourd'hui"
        // does not turn into "hui".
        var cut = w.split(/['\u2019]/);
        if (cut.length === 2 && cut[0].length <= 3 && cut[1].length > 1
            && STOP.indexOf(' ' + cut[1] + ' ') === -1) out.push(cut[1]);
      }
    });
    return out;
  }

  var IDF_MAX = 1;
  function buildIdf(items) {
    var df = Object.create(null), n = items.length;
    items.forEach(function (it) {
      var seen = Object.create(null);
      toks(it.q + ' ' + it.a).forEach(function (w) {
        if (!seen[w]) { seen[w] = 1; df[w] = (df[w] || 0) + 1; }
      });
    });
    var out = Object.create(null);
    for (var w in df) out[w] = Math.log(1 + n / df[w]);
    // A word the site has never published is maximally rare. Scoring it as
    // common would let "iguana" cost nothing and a stray match on one ordinary
    // word carry an unrelated answer through.
    IDF_MAX = Math.log(1 + n);
    return out;
  }
  function idfOf(w) { return idf[w] !== undefined ? idf[w] : IDF_MAX; }

  function load() {
    if (data) return Promise.resolve(data);
    if (loading) return loading;
    loading = fetch(D.src, { cache: 'force-cache' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (j) {
        data = j || { rules: [], items: [] };
        // Pre-tokenise once; scoring then runs over arrays, not strings.
        data.items.forEach(function (it) { it._q = toks(it.q); it._a = toks(it.a); });
        (data.tours || []).forEach(function (t) { t._w = toks(t.t + ' ' + t.w); });
        idf = buildIdf(data.items);
        return data;
      })
      .catch(function () { data = { rules: [], items: [] }; idf = Object.create(null); return data; });
    return loading;
  }

  // ---- retrieval -----------------------------------------------------
  function ruleFor(q) {
    var n = ' ' + norm(q) + ' ';
    for (var i = 0; i < (data.rules || []).length; i++) {
      var r = data.rules[i];
      for (var j = 0; j < r.p.length; j++) {
        var p = norm(r.p[j]);
        if (n.indexOf(' ' + p + ' ') !== -1 || n.indexOf(' ' + p) !== -1) return r;
      }
    }
    return null;
  }

  // Returns the ranking score plus how much of the question's meaning the item
  // actually covers, measured in IDF mass rather than word count so that
  // matching "algeria" (common here) counts for far less than "foggara".
  // A query word counts as present if the word itself OR the term our pages
  // actually use for it appears (data.syn) — "women travelling alone" scored
  // zero against "solo female travellers" before this.
  function has(list, w) {
    if (list.indexOf(w) !== -1) return true;
    var a = (data.syn || {})[w];
    return a ? list.indexOf(a) !== -1 : false;
  }
  function inQuery(qset, w) {
    if (qset[w]) return true;
    var a = (data.syn || {})[w];
    return a ? !!qset[a] : false;
  }

  function score(qt, qset, it) {
    var s = 0, mass = 0;
    for (var k = 0; k < qt.length; k++) {
      var w = qt[k], g = idfOf(w);
      if (has(it._q, w)) { s += g * 3; mass += g; }   // hit in the question line counts most
      else if (has(it._a, w)) { s += g; mass += g; }
    }
    // How much of the INDEXED question the visitor's words cover — the mirror
    // of the score above, which measures how much of the QUERY we matched.
    // Used only for confidence, not for ranking: as a ranking multiplier it
    // favoured short index entries (a four-word "Good to know" label beat the
    // full answer it belongs to) and measurably made results worse, so it
    // stays out of the sort.
    var iq = it._q, cov = 0;
    for (var j = 0; j < iq.length; j++) if (inQuery(qset, iq[j])) cov++;
    var qcov = iq.length ? cov / iq.length : 0;
    return { s: s, mass: mass, qcov: qcov };
  }

  function search(q) {
    var qt = toks(q);
    if (!qt.length) return [];
    var qMass = 0, i, qset = Object.create(null);
    for (i = 0; i < qt.length; i++) { qMass += idfOf(qt[i]); qset[qt[i]] = 1; }
    // An answer must carry most of what was asked, not one incidental word.
    // Without this gate "can I bring my pet iguana to the moon" matched a
    // packing list on the single word "bring" and answered it confidently.
    var need = qt.length === 1 ? 0.9 : 0.55;
    var out = [];
    for (i = 0; i < data.items.length; i++) {
      var r = score(qt, qset, data.items[i]);
      var ratio = r.mass / qMass;
      // Confidence is the better of the two readings. A visitor who types
      // "puis-je boire l'eau du robinet" has asked our published question
      // almost word for word, but `puis` is a word the site has never
      // published, so query-coverage alone dragged a perfect match below the
      // caveat line and we told them it was only the closest thing we had.
      if (r.s > 0 && ratio >= need) {
        out.push({ s: r.s, r: Math.max(ratio, r.qcov), it: data.items[i] });
      }
    }
    out.sort(function (a, b) { return b.s - a.s; });
    return out.slice(0, 4);
  }

  // ---- rendering -----------------------------------------------------
  function esc(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML; }

  // Everything the visitor asked goes into the WhatsApp message, so the team
  // starts the conversation already knowing what they want.
  var asked = [];
  function handoff(q) {
    var lines = ['Hello Algeria Compass! I asked your website assistant:'];
    asked.slice(-4).forEach(function (x) { lines.push('- ' + x); });
    lines.push('(page: ' + location.pathname + ')');
    var wa = D.wa + '?text=' + encodeURIComponent(asked.length ? lines.join('\n') : (q || ''));
    return '<div class="ask-hand">' +
      '<a class="wa" href="' + esc(wa) + '" target="_blank" rel="noopener">' + esc(D.walabel) + '</a>' +
      '<a class="ct" href="' + esc(D.contact) + '">' + esc(D.msg) + '</a></div>';
  }

  // ---- trip suggestions ------------------------------------------------
  // The assistant's job is to shorten the path to a booking, not just to
  // answer trivia. Once we know what someone asked about — the Sahara in
  // winter, Roman ruins, a week with children — the two trips that match are
  // more useful than the answer alone. Scored on the same rare-word principle
  // as the answers, and shown only when the match is real: a generic question
  // suggests nothing rather than padding every reply with the same two tours.
  function suggestTrips(q) {
    var list = (data && data.tours) || [];
    if (!list.length) return [];
    var qt = toks(q);
    if (!qt.length) return [];
    var total = 0, peak = 0;
    qt.forEach(function (w) { var v = idfOf(w); total += v; if (v > peak) peak = v; });
    if (!total) return [];
    var scored = [];
    for (var i = 0; i < list.length; i++) {
      var t = list[i], mass = 0, seen = Object.create(null), gotPeak = false;
      for (var j = 0; j < qt.length; j++) {
        var w = qt[j];
        if (seen[w]) continue;
        if (has(t._w, w)) {
          seen[w] = 1; mass += idfOf(w);
          if (idfOf(w) >= peak - 1e-9) gotPeak = true;
        }
      }
      // The rarest word in the question IS the question — "timgad" in "roman
      // ruins like timgad", "japan" in "capital of japan". A trip that matches
      // everything except that word has matched the filler, so "what is the
      // capital of japan" was scoring 0.45 on `what` and `capital` alone and
      // recommending a 14-day tour. If the rare word is one the site has never
      // published, no trip can carry it, and nothing is suggested.
      if (mass > 0 && gotPeak) scored.push({ t: t, r: mass / total });
    }
    scored.sort(function (a, b) { return b.r - a.r; });
    // A trip has to cover a real share of what was asked. Below this the
    // "match" is one common word and the suggestion is noise.
    return scored.filter(function (s) { return s.r >= 0.34; }).slice(0, 2);
  }

  function tripsHtml(q) {
    var picks = suggestTrips(q);
    if (!picks.length) return '';
    return '<div class="ask-trips"><b>' + esc(D.trips) + '</b>' +
      picks.map(function (p) {
        var t = p.t;
        return '<a href="' + esc(t.u) + '">' +
          '<span class="tt">' + esc(t.t) + '</span>' +
          '<span class="tm">' + esc(t.d) +
          (t.p ? ' · €' + esc(String(t.p)) + ' ' + esc(D.per) : '') +
          '</span></a>';
      }).join('') + '</div>';
  }

  function addQ(q) {
    var el = document.createElement('div');
    el.className = 'ask-q';
    el.textContent = q;
    log.appendChild(el);
  }

  function addA(html) {
    var el = document.createElement('div');
    el.className = 'ask-a';
    el.innerHTML = html;
    log.appendChild(el);
    log.scrollTop = log.scrollHeight;
  }

  function answer(q) {
    var sugg = document.getElementById('askSugg');
    if (sugg) sugg.remove();
    addQ(q);
    asked.push(q);

    var rule = ruleFor(q);
    if (rule) {
      addA('<p>' + esc(rule.a) + '</p>' +
           '<a class="src" href="' + esc(rule.u) + '">' + esc(D.more) + '</a>' +
           tripsHtml(q) + handoff(q));
      report(q, 1);
      return;
    }

    var hits = search(q);
    if (!hits.length) {
      addA('<p>' + esc(D.none) + '</p>' + tripsHtml(q) + handoff(q));
      report(q, 0);
      return;
    }

    var top = hits[0].it;
    // Good and near-miss matches overlap in score — measured on real queries,
    // legitimate ones bottom out around 0.53 and the worst false positive sat
    // at 0.63, so no threshold separates them. Rather than silently present a
    // weak match as an answer, say plainly that it is only the closest thing.
    var html = (hits[0].r < 0.75 ? '<p class="near">' + esc(D.near) + '</p>' : '') +
      '<span class="chip">' + esc(top.k) + '</span>' +
      '<span class="qt">' + esc(top.q) + '</span>' +
      '<p>' + esc(top.a) + '</p>' +
      '<a class="src" href="' + esc(top.u) + '">' + esc(D.more) + '</a>' +
      '<div class="foot">' + esc(D.from) + '</div>';

    var rest = hits.slice(1, 4);
    if (rest.length) {
      html += '<div class="ask-also"><b>' + esc(D.also) + '</b>' +
        rest.map(function (r) {
          return '<a href="' + esc(r.it.u) + '">' + esc(r.it.q) + '</a>';
        }).join('') + '</div>';
    }
    html += tripsHtml(q) + handoff(q);
    addA(html);
    report(q, hits.length);
  }


  // ---- trip planner ----------------------------------------------------
  var P = JSON.parse(D.plan || '{}'), pick = [];
  var THEMES = [['sahara', 'mzab'], ['roman', 'east'], ['city', 'culture', 'west', 'coast'], null];
  function planStep() {
    var i = pick.length;
    if (i < P.q.length) {
      addA('<p>' + (i === 0 ? esc(P.intro) + '<br>' : '') + '<b>' + esc(P.q[i]) + '</b></p>' +
        '<div class="ask-chips">' + P.o[i].map(function (o, k) {
          return '<button type="button" data-plan-opt="' + k + '">' + esc(o) + '</button>';
        }).join('') + '</div>');
      return;
    }
    planResult();
  }
  function planScore(t) {
    var interest = pick[0], days = pick[1], summer = pick[2] === 1;
    if (t.n <= 2) return -99;
    var s = 0, th = THEMES[interest];
    if (th) { if (th.indexOf(t.th) !== -1) s += 3; else if (interest === 1 && t.th === 'culture') s += 1; }
    else { if (t.r >= 3) s += 3; if (t.n >= 8) s += 1; }
    if (days === 0) s += t.n <= 5 ? 2 : (t.n <= 7 ? 0.5 : -1);
    if (days === 1) s += (t.n >= 6 && t.n <= 8) ? 2 : ((t.n === 5 || t.n === 10) ? 1 : 0);
    if (days === 2) s += t.n >= 9 ? 2 : (t.n >= 7 ? 1 : -1);
    if (summer && (t.sa || t.th === 'sahara' || t.th === 'mzab')) s -= 6;   // the deep south is not travelled in summer
    return s;
  }
  function planResult() {
    var list = (data.tours || []).map(function (t) { return { t: t, s: planScore(t) }; })
      .filter(function (x) { return x.s > 1; })
      .sort(function (a, b) { return b.s - a.s || a.t.p - b.t.p; }).slice(0, 2);
    var summerNote = pick[2] === 1 && pick[0] === 0 ? '<p class="near">' + esc(P.summer) + '</p>' : '';
    var lines = ['Hello Algeria Compass! I used the trip planner on your website.',
      'Interest: ' + ['Sahara & desert', 'Roman ruins & history', 'Cities & culture', 'A bit of everything'][pick[0]],
      'Days: ' + ['up to 5', '6-8', '9+'][pick[1]],
      'When: ' + ['October-April', 'May-September', 'not sure yet'][pick[2]],
      'Travellers: ' + ['1-2', '3-6', '7+'][pick[3]]];
    var cards = list.map(function (x) {
      var t = x.t; lines.push('I like: ' + t.t + ' — ' + location.origin + t.u);
      return '<a href="' + esc(t.u) + '"><span class="tt">' + esc(t.t) + '</span><span class="tm">' + esc(t.d) +
        (t.p ? ' · €' + esc(String(t.p)) + ' ' + esc(D.per) : '') + '</span></a>';
    }).join('');
    var id = list.length ? list[0].t.u.replace(/\/$/, '').split('/').pop() : '';
    var req = D.contact + '?' + (id ? 'tour=' + encodeURIComponent(id) + '&' : '') +
      'people=' + ['2', '4', '8'][pick[3]] + '&message=' + encodeURIComponent(lines.slice(1).join('\n'));
    var wa = D.wa + '?text=' + encodeURIComponent(lines.join('\n'));
    addA(summerNote + (list.length ? '<p><b>' + esc(P.res) + '</b></p><div class="ask-trips">' + cards + '</div>' : '<p>' + esc(P.none) + '</p>') +
      '<div class="ask-hand"><a class="wa" href="' + esc(wa) + '" target="_blank" rel="noopener" data-evt="planner_whatsapp">' + esc(P.wa) + '</a>' +
      '<a class="ct" href="' + esc(req) + '" data-evt="planner_request">' + esc(P.req) + '</a></div>' +
      '<p style="margin-top:.6rem"><button type="button" class="ask-plan-start" data-plan-start="1">' + esc(P.again) + '</button></p>');
    report('[planner] ' + lines.slice(1, 5).join(' | '), list.length);
  }
  function planStart() {
    var sugg = document.getElementById('askSugg');
    if (sugg) sugg.remove();
    pick = [];
    addQ(P.start.replace(/^\S+\s/, ''));
    planStep();
  }

  // ---- logging -------------------------------------------------------
  // Same beacon the site search already uses. n = 0 marks a question our pages
  // could not answer, which is the row the owner actually wants to read.
  function report(q, n) {
    try {
      var body = JSON.stringify({ t: 'ask', p: location.pathname, q: q.slice(0, 200), n: n });
      if (navigator.sendBeacon) navigator.sendBeacon('/hit.php', new Blob([body], { type: 'application/json' }));
      else fetch('/hit.php', { method: 'POST', body: body, keepalive: true });
    } catch (e) { /* analytics must never break the answer */ }
  }

  // ---- open / close --------------------------------------------------
  function open() {
    panel.hidden = false;
    launch.hidden = true;
    launch.setAttribute('aria-expanded', 'true');
    load().then(function () { input.focus(); });
  }
  function close() {
    panel.hidden = true;
    launch.hidden = false;
    launch.setAttribute('aria-expanded', 'false');
    launch.focus();
  }

  // ---- stay clear of the cookie banner --------------------------------
  // The banner is a fixed bar pinned to the same bottom edge at z-index 200,
  // and on narrow viewports it is wide enough to sit right on top of this
  // launcher — so on a visitor's very first page view the assistant button was
  // unclickable, which is exactly the visit where it is most wanted. Measure
  // the banner and lift the widget above it until the choice is made.
  // This script is is:inline, so it runs while the document is still parsing
  // and the banner's markup is not in the DOM yet — wait for it rather than
  // depending on the order the two components happen to be mounted in.
  function watchBanner() {
    var cc = document.getElementById('cookie-consent');
    if (!cc) return;
    var fit = function () {
      var up = cc.hidden ? 0 : Math.round(cc.getBoundingClientRect().height) + 12;
      document.documentElement.style.setProperty('--ask-up', up + 'px');
    };
    fit();
    new MutationObserver(fit).observe(cc, { attributes: true, attributeFilter: ['hidden'] });
    if (window.ResizeObserver) new ResizeObserver(fit).observe(cc);
    window.addEventListener('resize', fit);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', watchBanner);
  } else {
    watchBanner();
  }

  launch.addEventListener('click', open);
  closeBtn.addEventListener('click', close);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !panel.hidden) close();
  });

  log.addEventListener('click', function (e) {
    var ps = e.target.closest('button[data-plan-start]');
    if (ps) { load().then(planStart); return; }
    var po = e.target.closest('button[data-plan-opt]');
    if (po) {
      var box = po.parentNode;
      if (box.dataset.done) return;
      box.dataset.done = '1';
      po.classList.add('on');
      pick.push(+po.dataset.planOpt);
      addQ(po.textContent);
      load().then(planStep);
      return;
    }
    var b = e.target.closest('button[data-q]');
    if (!b) return;
    load().then(function () { answer(b.dataset.q); });
  });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var q = (input.value || '').trim();
    if (!q) return;
    input.value = '';
    load().then(function () { answer(q); });
  });
})();
</script>
