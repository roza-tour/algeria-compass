---
// Phase 1/3 — reusable inline-SVG cultural motifs. No external assets, no libs.
// Every motif draws in `currentColor`, so callers recolor it by setting CSS
// `color` (typically `color:var(--accent)` from a [data-region] palette) and
// control prominence with opacity. Use as section dividers, card corners and
// low-opacity background watermarks.
//
// names: zellige (8-point star), tifinagh (Amazigh yaz ⵣ), dune (curve divider),
//        mzab-arch, tuareg-cross (Agadez), roman-arch.
export interface Props { name: string; size?: number | string; class?: string; title?: string; }
const { name, size = 48, class: cls = '', title } = Astro.props;
const decorative = !title;
const common = {
  width: size, height: size, viewBox: '0 0 100 100',
  fill: 'none', xmlns: 'http://www.w3.org/2000/svg',
  class: `motif motif-${name} ${cls}`.trim(),
  ...(decorative ? { 'aria-hidden': 'true', focusable: 'false' } : { role: 'img' }),
};
---
{name === 'zellige' && (
  <svg {...common}>{title && <title>{title}</title>}
    <rect x="22" y="22" width="56" height="56" stroke="currentColor" stroke-width="4" />
    <rect x="22" y="22" width="56" height="56" stroke="currentColor" stroke-width="4" transform="rotate(45 50 50)" />
    <circle cx="50" cy="50" r="8" fill="currentColor" />
  </svg>
)}
{name === 'tifinagh' && (
  <svg {...common}>{title && <title>{title}</title>}
    <g stroke="currentColor" stroke-width="6" stroke-linecap="round">
      <circle cx="50" cy="20" r="9" fill="currentColor" stroke="none" />
      <line x1="50" y1="29" x2="50" y2="74" />
      <line x1="50" y1="40" x2="28" y2="26" />
      <line x1="50" y1="40" x2="72" y2="26" />
      <line x1="50" y1="74" x2="30" y2="88" />
      <line x1="50" y1="74" x2="70" y2="88" />
    </g>
  </svg>
)}
{name === 'dune' && (
  <svg {...common} viewBox="0 0 200 40" width={typeof size === 'number' ? size * 4 : size} height={size}>{title && <title>{title}</title>}
    <path d="M0 30 C 35 30, 45 8, 80 8 S 130 30, 165 30 200 14 200 14" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
  </svg>
)}
{name === 'mzab-arch' && (
  <svg {...common}>{title && <title>{title}</title>}
    <path d="M24 86 L24 46 Q24 22 50 14 Q76 22 76 46 L76 86" stroke="currentColor" stroke-width="5" stroke-linejoin="round" />
    <path d="M50 14 L50 86" stroke="currentColor" stroke-width="2" opacity="0.5" />
  </svg>
)}
{name === 'tuareg-cross' && (
  <svg {...common}>{title && <title>{title}</title>}
    <g stroke="currentColor" stroke-width="5" stroke-linejoin="round">
      <circle cx="50" cy="34" r="16" fill="none" />
      <path d="M50 50 L50 84" />
      <path d="M28 72 L50 84 L72 72" fill="none" />
      <path d="M34 34 L18 34 M66 34 L82 34" />
    </g>
  </svg>
)}
{name === 'roman-arch' && (
  <svg {...common}>{title && <title>{title}</title>}
    <path d="M22 86 L22 50 A28 28 0 0 1 78 50 L78 86" stroke="currentColor" stroke-width="5" stroke-linejoin="round" />
    <line x1="14" y1="86" x2="86" y2="86" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
  </svg>
)}
