---
// P6 — full "Algerian Sweets" subsection for the food page. Honey-toned
// background with a subtle geometric motif; styled dish cards from src/data/sweets.
import { SWEETS, SWEETS_HERO, SWEETS_HERO_ALT } from '../data/sweets.mjs';
---
<section class="section sw" id="sweets"><div class="wrap">
  <div class="sw-head">
    <div>
      <span class="eyebrow">Culture · Pastries</span>
      <h2>Algerian sweets &amp; pastries</h2>
      <p class="sw-lede">The other half of the Algerian table. After the savoury comes a world of honeyed, almond-rich pastries — Ottoman in technique, Andalusian in delicacy, and brought out by the trayful for Eid, weddings and Ramadan nights with glasses of mint tea or coffee.</p>
      <p style="margin:.7rem 0 0"><a class="btn btn-gold" href="/sweets/" style="background:#8A5410;color:#fff">Open the full sweets guide 🍯 →</a></p>
    </div>
    <figure class="sw-hero">
      <img src={SWEETS_HERO} alt={SWEETS_HERO_ALT} width="735" height="907" loading="lazy" decoding="async" />
    </figure>
  </div>

  <div class="sw-grid">
    {SWEETS.map(d => (
      <article class="sw-card">
        <div class="sw-img"><img src={d.img} alt={`${d.name} — Algerian pastry`} width="420" height="320" loading="lazy" decoding="async" /></div>
        <div class="sw-b">
          <h3>{d.name}</h3>
          <span class="sw-origin">{d.origin}</span>
          <p>{d.desc}</p>
        </div>
      </article>
    ))}
  </div>
</div></section>

<style>
  .sw{
    background-color:#F7EAD2;
    background-image:url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'52'%20height%3D'52'%3E%3Cg%20fill%3D'none'%20stroke%3D'%23B8860B'%20stroke-width%3D'1.1'%20opacity%3D'.12'%3E%3Cpath%20d%3D'M26%202L50%2026L26%2050L2%2026Z'/%3E%3Ccircle%20cx%3D'26'%20cy%3D'26'%20r%3D'7'/%3E%3C/g%3E%3C/svg%3E"),
      linear-gradient(180deg,#FBF1DC,#F3E2C2);
  }
  .sw .eyebrow{color:#8A5A0C}
  .sw-head{display:grid;grid-template-columns:1.3fr .7fr;gap:1.8rem;align-items:center}
  .sw h2{color:#7a4a12;font-size:clamp(1.5rem,3vw,2.1rem);margin:.1rem 0 .4rem}
  .sw-lede{color:#5e4828;font-size:1.05rem;line-height:1.7;max-width:640px;margin:0}
  .sw-hero{margin:0;border-radius:18px;overflow:hidden;box-shadow:0 16px 40px rgba(122,74,18,.28);border:3px solid rgba(184,134,11,.4)}
  .sw-hero img{width:100%;height:100%;max-height:320px;object-fit:cover;display:block}
  .sw-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:1.2rem;margin-top:1.6rem}
  .sw-card{background:#fffaf1;border:1px solid #e8d3a8;border-radius:14px;overflow:hidden;display:flex;flex-direction:column;
    box-shadow:0 6px 20px rgba(122,74,18,.08);transition:transform .18s ease,box-shadow .18s ease}
  .sw-card:hover{transform:translateY(-4px);box-shadow:0 14px 32px rgba(122,74,18,.18)}
  .sw-img{aspect-ratio:7/5;overflow:hidden;background:#f0ddb8}
  .sw-img img{width:100%;height:100%;object-fit:cover;transition:transform .4s ease}
  .sw-card:hover .sw-img img{transform:scale(1.06)}
  .sw-b{padding:.9rem 1.05rem 1.1rem;display:flex;flex-direction:column;flex:1}
  .sw-b h3{font-family:var(--serif);color:#8a3f12;font-size:1.12rem;margin:0}
  .sw-origin{font-size:.66rem;text-transform:uppercase;letter-spacing:.06em;color:#8A5A0C;font-weight:700;margin:.2rem 0 .45rem}
  .sw-b p{font-size:.86rem;color:#534233;line-height:1.55;margin:0}
  @media(max-width:760px){ .sw-head{grid-template-columns:1fr} .sw-hero{order:-1} }
</style>
