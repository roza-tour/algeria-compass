---
// Site-wide search, inline in the nav bar. Results drop below the field from
// /search-index.json — 319 pages across all five languages.
//
// This replaced an overlay: a full-screen dialog is a heavy answer to "let me
// look something up", and it hid the bar the reader was already using. Sitting
// in the bar, the field is visible on every page and costs one tab stop. The
// space came from collapsing the four language links into a dropdown.
//
// Results are filtered to the reader's own language first. If that finds
// nothing, the other languages are offered under their own heading rather than
// silently mixed in — a German reader searching "Sahara" should see the German
// pages, but should not be told there is nothing when an English page helps.
import { asLang, t as tr } from '../i18n';
interface Props { lang?: string }
const lang = asLang(Astro.props.lang);
const T = {
  label: tr(lang, 'searchLabel'),
  ph: tr(lang, 'searchPlaceholder'),
  aria: tr(lang, 'searchAria'),
  none: tr(lang, 'searchNone'),
  other: tr(lang, 'searchOther'),
  close: tr(lang, 'searchClose'),
};
---
<div class="ss" id="ss">
  <div class="ss-field">
    <svg class="ss-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
    </svg>
    <input id="ssInput" type="search" autocomplete="off" placeholder={T.ph} aria-label={T.aria}
           role="combobox" aria-controls="ssResults" aria-expanded="false" aria-autocomplete="list" />
    <button type="button" class="ss-clear" id="ssClear" aria-label={T.close} hidden>&#10005;</button>
  </div>
  <div class="ss-drop" id="ssDrop" hidden>
    <p class="ss-status" id="ssStatus" aria-live="polite"></p>
    <ul class="ss-results" id="ssResults" role="listbox" aria-label={T.aria}></ul>
  </div>
</div>

<script is:inline define:vars={{ lang, T }}>
  (function () {
    var root = document.getElementById('ss');
    var input = document.getElementById('ssInput');
    var drop = document.getElementById('ssDrop');
    var list = document.getElementById('ssResults');
    var status = document.getElementById('ssStatus');
    var clear = document.getElementById('ssClear');
    if (!root || !input) return;

    var data = null, loading = false, cursor = -1, lastSent = '', timer = null;

    function esc(s) {
      return String(s || '').replace(/[&<>"]/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
      });
    }

    // Fold accents so "wueste"/"wuste" reach "Wüste" and "argelia" reaches
    // "Argelia" — most people type without diacritics, and four of the five
    // languages here are full of them. German umlauts also expand the ue/oe/ae
    // way, which stripping alone would miss.
    function fold(s) {
      return String(s || '').toLowerCase()
        .replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/ß/g, 'ss')
        .normalize('NFD').replace(/[̀-ͯ]/g, '');
    }

    function load() {
      if (data || loading) return;
      loading = true;
      fetch('/search-index.json')
        .then(function (r) { return r.json(); })
        .then(function (j) { data = j; loading = false; if (input.value) run(); })
        .catch(function () { loading = false; });
    }

    function score(row, term) {
      if (row._t === undefined) {                    // fold once, then reuse
        row._t = fold(row.t);
        row._d = fold(row.d);
        row._u = fold(row.u.replace(/[-/]/g, ' '));  // the slug carries real words
        row._k = fold(row.k);
      }
      if (row._t === term) return 100;
      if (row._t.indexOf(term) === 0) return 80;     // title starts with the term
      if (row._t.indexOf(term) !== -1) return 60;    // title contains it
      // The URL is searchable too: /de/budget-algerien/ should answer "budget"
      // even though its German headline never uses the word.
      if (row._u.indexOf(term) !== -1) return 45;
      if (row._d.indexOf(term) !== -1) return 30;
      if (row._k.indexOf(term) !== -1) return 20;
      return 0;
    }

    function close() {
      drop.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      cursor = -1;
    }

    function run() {
      var q = input.value.trim();
      var term = fold(q);
      list.innerHTML = ''; cursor = -1;
      clear.hidden = !q;
      if (!term) { close(); status.textContent = ''; return; }
      if (!data) { load(); return; }

      var mine = [], others = [];
      for (var i = 0; i < data.length; i++) {
        var s = score(data[i], term);
        if (!s) continue;
        (data[i].l === lang ? mine : others).push({ r: data[i], s: s });
      }
      var by = function (a, b) { return b.s - a.s || a.r.t.length - b.r.t.length; };
      mine.sort(by); others.sort(by);

      // Own language first; only fall back to the rest when it found nothing.
      var show = mine.slice(0, 10);
      var extra = show.length ? [] : others.slice(0, 6);

      drop.hidden = false;
      if (!show.length && !extra.length) {
        status.textContent = T.none + ' “' + q + '”';
        input.setAttribute('aria-expanded', 'false');
        track(q, 0);
        return;
      }
      status.textContent = '';
      input.setAttribute('aria-expanded', 'true');

      show.concat(extra).forEach(function (h, i) {
        if (extra.length && i === show.length) {
          var sep = document.createElement('li');
          sep.className = 'ss-sep'; sep.textContent = T.other;
          list.appendChild(sep);
        }
        var li = document.createElement('li');
        li.className = 'ss-item'; li.setAttribute('role', 'option');
        li.innerHTML = '<a href="' + h.r.u + '"><span class="ss-kind">' + esc(h.r.k) + '</span>'
          + '<span class="ss-title">' + esc(h.r.t) + '</span>'
          + (h.r.d ? '<span class="ss-blurb">' + esc(h.r.d) + '</span>' : '') + '</a>';
        list.appendChild(li);
      });
      track(q, show.length + extra.length);
    }

    // Report the query once it settles, not on every keystroke — otherwise
    // "sahara" would be logged as s, sa, sah, saha, sahar, sahara.
    function track(q, n) {
      if (q.length < 3 || q === lastSent) return;
      lastSent = q;
      clearTimeout(timer);
      timer = setTimeout(function () {
        try {
          var body = JSON.stringify({ t: 'search', p: location.pathname, q: q, n: n });
          if (navigator.sendBeacon) navigator.sendBeacon('/hit.php', body);
          else fetch('/hit.php', { method: 'POST', body: body, keepalive: true });
        } catch (e) {}
      }, 900);
    }

    input.addEventListener('focus', load);
    input.addEventListener('input', run);
    clear.addEventListener('click', function () { input.value = ''; run(); input.focus(); });

    document.addEventListener('click', function (e) { if (!root.contains(e.target)) close(); });

    root.addEventListener('keydown', function (e) {
      var items = list.querySelectorAll('.ss-item a');
      if (e.key === 'Escape') { close(); input.blur(); }
      else if (e.key === 'ArrowDown' && items.length) { e.preventDefault(); cursor = Math.min(cursor + 1, items.length - 1); items[cursor].focus(); }
      else if (e.key === 'ArrowUp' && items.length) {
        e.preventDefault();
        if (cursor <= 0) { cursor = -1; input.focus(); }
        else { cursor--; items[cursor].focus(); }
      }
    });

    // "/" from anywhere jumps to the field, the way most search-first sites work.
    document.addEventListener('keydown', function (e) {
      if (e.key !== '/' || /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName)) return;
      e.preventDefault(); input.focus();
    });
  })();
</script>

<style>
  .ss { position: relative; }

  /* Sits ON the dark green bar, so the field is a translucent well rather than
     a white box that would fight the header. */
  .ss-field {
    display: flex; align-items: center; gap: .4rem;
    background: rgba(246, 239, 224, .10);
    border: 1px solid rgba(246, 239, 224, .18);
    border-radius: 999px; padding: 0 .35rem 0 .7rem;
    height: 36px; transition: background .2s ease, border-color .2s ease, width .2s ease;
  }
  .ss-field:focus-within {
    background: rgba(246, 239, 224, .16);
    border-color: var(--gold, #C9A24B);
  }
  .ss-ic { width: 15px; height: 15px; color: rgba(246, 239, 224, .6); flex: 0 0 auto; }
  #ssInput {
    width: 150px; border: 0; outline: none; background: transparent;
    font: inherit; font-size: .8rem; color: #F6EFE0; min-width: 0;
    padding: 0; height: 100%;
  }
  #ssInput::placeholder { color: rgba(246, 239, 224, .5); }
  #ssInput:focus { width: 200px; }
  #ssInput::-webkit-search-cancel-button { display: none; }
  .ss-clear {
    background: transparent; border: 0; color: rgba(246, 239, 224, .6);
    cursor: pointer; font-size: .8rem; line-height: 1;
    min-width: 26px; min-height: 26px; border-radius: 50%;
  }
  .ss-clear:hover { color: #F6EFE0; background: rgba(246, 239, 224, .12); }

  /* results panel — mirrors .sub-menu so the bar has one dropdown language */
  .ss-drop {
    position: absolute; top: calc(100% + .45rem); right: 0; z-index: 330;
    width: min(420px, calc(100vw - 2rem));
    background: var(--green-d, #07261C);
    border: 1px solid rgba(201, 162, 75, .28);
    border-radius: 12px; box-shadow: 0 14px 34px rgba(7, 38, 28, .45);
    max-height: min(70vh, 460px); overflow-y: auto; padding: .35rem;
  }
  .ss-status { margin: 0; padding: .6rem .7rem; color: rgba(246, 239, 224, .65); font-size: .82rem; }
  .ss-status:empty { display: none; }
  .ss-results { list-style: none; margin: 0; padding: 0; display: grid; gap: .15rem; }

  /* The rows below are built by JavaScript, so they never carry Astro's
     scoping attribute and a scoped rule would silently skip them — which is
     exactly what happened: the result titles fell through to the inherited
     dark green and sat at 1.32:1 on the dark panel. Declared global, but every
     selector is nested under .ss-drop so nothing escapes this component. */
  :global(.ss-drop .ss-sep) {
    font-size: .64rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em;
    color: rgba(246, 239, 224, .55); padding: .6rem .7rem .2rem;
  }
  :global(.ss-drop .ss-item a) {
    display: block; padding: .5rem .7rem; border-radius: 8px; text-decoration: none;
    border-left: 3px solid transparent;
  }
  :global(.ss-drop .ss-item a:hover),
  :global(.ss-drop .ss-item a:focus-visible) {
    background: rgba(246, 239, 224, .08); border-left-color: var(--gold, #C9A24B); outline: none;
  }
  :global(.ss-drop .ss-kind) {
    display: inline-block; font-size: .6rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .06em; color: #E4C87A;
    background: rgba(246, 239, 224, .08); border-radius: 999px;
    padding: .08rem .45rem; margin-bottom: .18rem;
  }
  :global(.ss-drop .ss-title) { display: block; font-weight: 700; color: #F6EFE0; font-size: .88rem; line-height: 1.35; }
  :global(.ss-drop .ss-blurb) { display: block; color: rgba(246, 239, 224, .68); font-size: .76rem; line-height: 1.45; margin-top: .1rem; }

  /* In the mobile menu the bar is a stacked panel: the field goes full width
     at the top of it and the results sit directly under, no floating. */
  @media (max-width: 980px) {
    .ss { width: 100%; }
    .ss-field { height: 42px; border-radius: 10px; }
    #ssInput, #ssInput:focus { width: 100%; flex: 1; font-size: .92rem; }
    .ss-drop { position: static; width: 100%; margin-top: .45rem; max-height: 46vh; box-shadow: none; }
  }
  @media (prefers-reduced-motion: reduce) { .ss-field, #ssInput { transition: none; } }
</style>
