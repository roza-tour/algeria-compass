---
// Unified site header — matches the rebrand homepage chrome (logo + nav).
// All links are real URLs so the same header works across every Astro route.
const nav = [
  { href: '/', label: 'Home' },
  { href: '/tours/', label: 'Tours' },
  { href: '/destinations/', label: 'Destinations' },
  { href: '/provinces/', label: 'Provinces' },
  { href: '/culture/', label: 'Culture' },
  { href: '/questions/', label: 'FAQ' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' }
];
const path = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---
<div class="id-band" aria-hidden="true"></div>
<nav class="nav" itemscope itemtype="https://schema.org/SiteNavigationElement">
  <div class="nav-inner">
    <a class="nav-logo-link" href="/" aria-label="Algeria Compass — Home">
      <img class="brand-mark" src="/assets/img/logo-emblem.png" width="70" height="40" alt="" />
      <span class="brand-name">Algeria <b>Compass</b></span>
    </a>

    <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="primary-nav" aria-label="Open menu">&#9776;</button>

    <ul class="nav-links" id="primary-nav" role="navigation" aria-label="Primary">
      {nav.map(n => (
        <li><a href={n.href} class={isActive(n.href) ? 'active' : undefined}>{n.label}</a></li>
      ))}
    </ul>

    <div class="nav-cta">
      <a href="https://wa.me/213784193176" target="_blank" rel="noopener" class="btn-wa">&#128172; WhatsApp</a>
      <a href="/contact/" class="btn-book">Plan a Trip</a>
    </div>
  </div>
</nav>
<script is:inline>
  (function(){
    var b=document.getElementById('navToggle'), n=document.getElementById('primary-nav');
    if(!b||!n) return;
    b.addEventListener('click',function(){
      var open=n.classList.toggle('mobile-open');
      b.setAttribute('aria-expanded', String(open));
      b.setAttribute('aria-label', open?'Close menu':'Open menu');
    });
  })();
</script>
