---
// Printable itinerary ("Save as PDF") for one tour, in the reader's language.
// Opened after the visitor leaves their email in ItineraryOffer; not indexed.
import fs from 'node:fs';
import { tourGallery } from '../data/tour-photos';
import { TOUR_VISUALS } from '../data/tour-visuals';
import { CONTACT, BOOKING } from '../config';
import { ROUTES, asLang } from '../i18n';

interface Props { t: any; loc?: any; lang?: string }
const { t } = Astro.props;
const lang = asLang(Astro.props.lang);
const L = Astro.props.loc || t;
const site = 'https://algeriacompass.com';
const pageUrl = lang === 'en' ? `${site}/tours/${t.id}/` : `${site}${ROUTES[lang].tours}${t.id}/`;
const hero = `/assets/img/tours/${(TOUR_VISUALS[t.id] || { hero: `${t.image_slugs[0]}-1.jpg` }).hero}`;
// Every other photo: neighbours in the ranking are often near-duplicates.
let photos: { file: string; alt?: string }[] = [];
try { photos = tourGallery(t.image_slugs, fs.readdirSync('public/assets/img/tours'), 8).filter((_, i) => i % 2 === 0).slice(0, 4); } catch {}
const price = Number(t.price_eur).toLocaleString(lang === 'en' ? 'en-GB' : 'de-DE');
const C = {
  en: { save: 'Save as PDF / Print', back: '← Back to the tour', eyebrow: 'Private tour itinerary', from: 'From', per: 'per person', days: 'Day by day', day: 'Day', inc: 'Included', exc: 'Not included', good: 'Good to know', book: 'How to book', b1: `Your dates are held free for ${BOOKING.holdHours} hours while we confirm.`, b2: `Free cancellation up to ${BOOKING.cancelDays} days before departure.`, b3: `${BOOKING.earlyPct}% off when you book ${BOOKING.earlyDays}+ days ahead.`, b4: 'Visa support included; full refund if your visa is refused.', note: 'Private trip on your own dates, with a licensed local guide.' },
  fr: { save: 'Enregistrer en PDF / Imprimer', back: '← Retour au circuit', eyebrow: 'Programme du circuit privé', from: 'Dès', per: 'par personne', days: 'Jour par jour', day: 'Jour', inc: 'Inclus', exc: 'Non inclus', good: 'Bon à savoir', book: 'Comment réserver', b1: `Vos dates sont bloquées gratuitement ${BOOKING.holdHours} heures, le temps de confirmer.`, b2: `Annulation gratuite jusqu'à ${BOOKING.cancelDays} jours avant le départ.`, b3: `${BOOKING.earlyPct} % de réduction en réservant ${BOOKING.earlyDays} jours ou plus à l'avance.`, b4: 'Assistance visa incluse ; remboursement intégral en cas de refus de visa.', note: 'Voyage privé à vos dates, avec un guide local agréé.' },
  it: { save: 'Salva in PDF / Stampa', back: '← Torna al viaggio', eyebrow: 'Programma del viaggio privato', from: 'Da', per: 'a persona', days: 'Giorno per giorno', day: 'Giorno', inc: 'Incluso', exc: 'Non incluso', good: 'Da sapere', book: 'Come prenotare', b1: `Le vostre date restano bloccate gratis per ${BOOKING.holdHours} ore mentre confermiamo.`, b2: `Cancellazione gratuita fino a ${BOOKING.cancelDays} giorni prima della partenza.`, b3: `Sconto del ${BOOKING.earlyPct}% prenotando almeno ${BOOKING.earlyDays} giorni prima.`, b4: 'Assistenza visto inclusa; rimborso totale se il visto viene rifiutato.', note: 'Viaggio privato nelle vostre date, con una guida locale autorizzata.' },
  es: { save: 'Guardar en PDF / Imprimir', back: '← Volver al viaje', eyebrow: 'Programa del viaje privado', from: 'Desde', per: 'por persona', days: 'Día a día', day: 'Día', inc: 'Incluido', exc: 'No incluido', good: 'Conviene saber', book: 'Cómo reservar', b1: `Sus fechas quedan reservadas gratis ${BOOKING.holdHours} horas mientras confirmamos.`, b2: `Cancelación gratuita hasta ${BOOKING.cancelDays} días antes de la salida.`, b3: `${BOOKING.earlyPct} % de descuento reservando con ${BOOKING.earlyDays} días o más de antelación.`, b4: 'Asistencia de visado incluida; reembolso total si le deniegan el visado.', note: 'Viaje privado en sus fechas, con un guía local autorizado.' },
  de: { save: 'Als PDF speichern / Drucken', back: '← Zurück zur Reise', eyebrow: 'Programm der Privatreise', from: 'Ab', per: 'pro Person', days: 'Tag für Tag', day: 'Tag', inc: 'Inklusive', exc: 'Nicht inklusive', good: 'Gut zu wissen', book: 'So buchen Sie', b1: `Ihre Termine bleiben ${BOOKING.holdHours} Stunden kostenlos reserviert, während wir bestätigen.`, b2: `Kostenlose Stornierung bis ${BOOKING.cancelDays} Tage vor Abreise.`, b3: `${BOOKING.earlyPct} % Rabatt bei Buchung ${BOOKING.earlyDays} Tage oder früher.`, b4: 'Visum-Unterstützung inklusive; volle Erstattung, wenn das Visum abgelehnt wird.', note: 'Privatreise zu Ihren Terminen, mit lizenziertem lokalem Guide.' },
}[lang];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{L.title} — Algeria Compass</title>
  <link rel="canonical" href={pageUrl} />
  <style>
    @page { size: A4; margin: 14mm 14mm 12mm; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: Georgia, 'DejaVu Serif', serif; color: #1d2b25; background: #fff; }
    .bar { position: sticky; top: 0; display: flex; gap: .6rem; justify-content: center; padding: .7rem; background: #0B3D2E; z-index: 2; }
    .bar a, .bar button { font: 600 .95rem system-ui, sans-serif; padding: .6rem 1.1rem; border-radius: 8px; border: 1px solid #E3C27A; cursor: pointer; text-decoration: none; }
    .bar button { background: #E3C27A; color: #0B3D2E; }
    .bar a { color: #fff; }
    .doc { max-width: 820px; margin: 0 auto; padding: 1.5rem 1.2rem 2.5rem; }
    .head { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #C9A24A; padding-bottom: .6rem; }
    .head img { height: 64px; }
    .head span { font: 600 .8rem system-ui, sans-serif; color: #7a6a3a; letter-spacing: .12em; text-transform: uppercase; }
    .hero { width: 100%; height: 260px; object-fit: cover; border-radius: 10px; margin: 1rem 0 .4rem; }
    h1 { color: #0B3D2E; font-size: 1.9rem; line-height: 1.15; margin: .6rem 0 .3rem; }
    .meta { font: 600 .95rem system-ui, sans-serif; color: #5a4a1c; }
    .meta b { color: #0B3D2E; font-size: 1.15rem; }
    .hook { font-size: 1.05rem; line-height: 1.6; }
    h2 { color: #0B3D2E; font-size: 1.25rem; border-bottom: 1px solid #e6d5a8; padding-bottom: .25rem; margin: 1.4rem 0 .6rem; }
    .day { break-inside: avoid; margin: 0 0 .9rem; }
    .day h3 { margin: 0 0 .2rem; font-size: 1.02rem; color: #0B3D2E; }
    .day h3 span { font: 700 .75rem system-ui, sans-serif; background: #0B3D2E; color: #E3C27A; padding: .15rem .45rem; border-radius: 4px; margin-right: .4rem; text-transform: uppercase; letter-spacing: .08em; }
    .day p, li { font-size: .95rem; line-height: 1.55; margin: .15rem 0; }
    .day ul { margin: .25rem 0 0; padding-left: 1.1rem; }
    .photos { display: grid; grid-template-columns: repeat(4, 1fr); gap: .4rem; margin: .4rem 0; }
    .photos img { width: 100%; height: 95px; object-fit: cover; border-radius: 6px; }
    .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .box { border: 1px solid #e6d5a8; border-radius: 10px; padding: .4rem 1rem .8rem; break-inside: avoid; }
    .foot { margin-top: 1.4rem; text-align: center; font: .9rem system-ui, sans-serif; color: #444; border-top: 1px solid #e6d5a8; padding-top: .8rem; }
    .foot b { color: #0B3D2E; }
    @media print { .bar { display: none; } .doc { padding: 0; max-width: none; } .hero { height: 220px; } }
    @media (max-width: 600px) { .cols { grid-template-columns: 1fr; } .photos { grid-template-columns: repeat(2, 1fr); } }
  </style>
</head>
<body>
  <div class="bar"><button type="button" onclick="window.print()">{C.save}</button><a href={pageUrl}>{C.back}</a></div>
  <main class="doc">
    <div class="head"><img src="/assets/img/logo-full.png" alt="Algeria Compass" /><span>{C.eyebrow}</span></div>
    <img class="hero" src={hero} alt={L.title} />
    <h1>{L.title}</h1>
    <p class="meta">{L.duration} · {C.from} <b>€{price}</b> {C.per}</p>
    <p class="hook">{L.hook || t.summary} {C.note}</p>
    {photos.length > 0 && <div class="photos">{photos.map(p => <img src={`/assets/img/thumbs/tours/${p.file}`} alt={p.alt || L.title} />)}</div>}

    <h2>{C.days}</h2>
    {(L.itinerary || t.itinerary || []).map((d: any) => (
      <div class="day">
        <h3><span>{C.day} {d.day}</span>{d.title}</h3>
        {d.body && <p>{d.body}</p>}
        {d.stops && d.stops.length > 0 && <ul>{d.stops.map((s: any) => <li><strong>{s.place}</strong> — {s.text}</li>)}</ul>}
      </div>
    ))}

    <div class="cols">
      {(L.includes || []).length > 0 && <div class="box"><h2>{C.inc}</h2><ul>{L.includes.map((x: string) => <li>{x}</li>)}</ul></div>}
      {(L.excludes || []).length > 0 && <div class="box"><h2>{C.exc}</h2><ul>{L.excludes.map((x: string) => <li>{x}</li>)}</ul></div>}
    </div>
    {(L.goodToKnow || []).length > 0 && <><h2>{C.good}</h2><ul>{L.goodToKnow.map((g: any) => <li><strong>{g.label}:</strong> {g.value}</li>)}</ul></>}

    <h2>{C.book}</h2>
    <ul><li>{C.b1}</li><li>{C.b2}</li><li>{C.b3}</li><li>{C.b4}</li></ul>
    <div class="foot"><b>Algeria Compass</b> · WhatsApp {CONTACT.phoneDisplay} · {CONTACT.email}<br />{pageUrl}</div>
  </main>
  <script is:inline>setTimeout(function(){try{if(!sessionStorage.getItem('ac-printed-'+location.pathname)){sessionStorage.setItem('ac-printed-'+location.pathname,'1');window.print();}}catch(e){window.print();}},900);</script>
</body>
</html>
