---
// Unified footer — rebrand dark styling, preserving every existing content link.
// Language-aware: pass lang="fr" for the French labels (same links/design).
import { CONTACT } from '../config';
import { asLang, ROUTES } from '../i18n';
interface Props { lang?: string }
const lang = asLang(Astro.props.lang);
const year = new Date().getFullYear();
// t(english, french, italian) — italian falls back to english while a string is untranslated.
const t = (en: string, fr: string, it?: string) => (lang === 'fr' ? fr : lang === 'it' ? (it ?? en) : en);
const R = ROUTES[lang];

const columns = [
  {
    h: t('Explore', 'Explorer', 'Esplora'),
    links: [
      { href: R.tours, label: t('Tours', 'Circuits', 'Viaggi') },
      { href: '/luxury/', label: t('Luxury 5-Star Collection', 'Collection de luxe 5 étoiles', 'Collezione lusso 5 stelle') },
      { href: R.destinations, label: 'Destinations' },
      { href: '/provinces/', label: t('States', 'Wilayas', 'Province') },
      { href: '/regions/', label: t('Regions — 8 worlds', 'Régions', 'Regioni') },
      { href: '/experiences/', label: t('Experiences', 'Expériences', 'Esperienze') },
      { href: '/blog/', label: t('Blog', 'Guides', 'Blog') },
      { href: '/discover/', label: t('Discover Algeria', "Découvrir l'Algérie", "Scopri l'Algeria") },
    ],
  },
  {
    h: t('Knowledge', 'À savoir', 'Da sapere'),
    links: [
      { href: '/questions/', label: t('Questions & Answers', 'Questions & réponses', 'Domande e risposte') },
      { href: '/culture/', label: 'Culture' },
      { href: '/history/', label: t('History', 'Histoire', 'Storia') },
      { href: '/food/', label: t('Food', 'Cuisine', 'Cucina') },
      { href: '/sweets/', label: t('Sweets & Pastries', 'Pâtisseries', 'Dolci e pasticceria') },
      { href: '/unesco/', label: t('UNESCO Sites', 'Sites UNESCO', 'Siti UNESCO') },
    ],
  },
  {
    h: t('Plan', 'Préparer', 'Organizza'),
    links: [
      { href: '/travel-guides/', label: t('Travel Guides', 'Guides pratiques', 'Guide pratiche') },
      { href: '/visa-support/', label: t('Visa Support', 'Aide au visa', 'Assistenza visto') },
      { href: '/evisa/', label: t('e-Visa & Entry', 'e-Visa & entrée', 'e-Visa e ingresso') },
      { href: '/booking-terms/', label: t('Booking & Cancellation Terms', "Conditions de réservation", 'Condizioni di prenotazione') },
      { href: '/about/', label: t('About', 'À propos', 'Chi siamo') },
      { href: '/contact/', label: t('Contact & Inquiry', 'Contact', 'Contatti') },
      { href: '/sitemap/', label: 'Sitemap' },
    ],
  },
  {
    h: t('Editorial', 'Rédaction', 'Redazione'),
    links: [
      { href: '/editorial/', label: t('Editorial standards', 'Charte éditoriale', 'Linee editoriali') },
      { href: '/team/', label: t('Editorial team', "L'équipe", 'La redazione') },
      { href: '/reviewers/', label: t('Review & fact-checking', 'Vérification des faits', 'Verifica dei fatti') },
      { href: '/editorial/corrections-policy/', label: t('Corrections', 'Corrections', 'Correzioni') },
      { href: '/editorial/ai-usage-policy/', label: t('AI usage', "Usage de l'IA", "Uso dell'IA") },
    ],
  },
];
---
<footer>
  <div class="footer-wrap footer-inner">
    <div class="footer-grid">
      <div class="f-brandblock">
        <picture>
          <source srcset="/assets/img/logo-full.webp" type="image/webp" />
          <img class="f-logo" src="/assets/img/logo-full.png" width="220" height="167" alt="Algeria Compass" loading="lazy" decoding="async" />
        </picture>
        <p class="f-tagline">{t('Explore Algeria in Elite Luxury', "L'Algérie dans un luxe d'exception", "L'Algeria in un lusso d'eccezione")}</p>
        <p class="f-desc">{t('Licensed Algerian tour operator — luxury private, guided tours across Algeria.', 'Voyagiste algérien agréé — circuits privés et guidés de luxe à travers l’Algérie.', 'Tour operator algerino autorizzato — viaggi privati e guidati di lusso in tutta l’Algeria.')}</p>
        <address class="f-nap">
          {CONTACT.address.full}<br/>
          <a href={`tel:${CONTACT.phoneE164}`}>{CONTACT.phoneDisplay}</a><br/>
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        </address>
        <div class="f-socials">
          <a href="https://wa.me/213784193176" target="_blank" rel="noopener" class="fs" aria-label="WhatsApp">WA</a>
          <a href="https://www.instagram.com/algeria_compass/" target="_blank" rel="noopener" class="fs" aria-label="Algeria Compass on Instagram">IG</a>
          <a href="https://www.facebook.com/profile.php?id=61590718167514" target="_blank" rel="noopener" class="fs" aria-label="Algeria Compass on Facebook">FB</a>
        </div>
      </div>
      {columns.map(col => (
        <div class="fcol">
          <h2>{col.h}</h2>
          <ul>
            {col.links.map(l => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <div class="footer-bottom">
      <p>&copy; {year} Algeria Compass. {t('All rights reserved.', 'Tous droits réservés.')} (Algeria)</p>
      <div class="fcerts">
        <span class="fcert">{t('Private Guided Tours', 'Circuits privés guidés')}</span>
        <span class="fcert">{t('Local Algerian Experts', 'Experts algériens locaux')}</span>
        <span class="fcert">{t('SSL Secured', 'Sécurisé SSL')}</span>
      </div>
    </div>
  </div>
</footer>
<style>
  .f-nap{font-style:normal;font-size:.76rem;line-height:1.7;color:rgba(255,255,255,.42);margin-bottom:1rem;text-align:center}
  .f-nap a{color:rgba(255,255,255,.55)}
  .f-nap a:hover{color:#fff;text-decoration:none}
</style>
