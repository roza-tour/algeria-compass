---
// Unified footer — rebrand dark styling, preserving every existing content link.
import { CONTACT } from '../config';
const year = new Date().getFullYear();
---
<footer>
  <div class="footer-wrap footer-inner">
    <div class="footer-grid">
      <div class="f-brandblock">
        <picture>
          <source srcset="/assets/img/logo-full.webp" type="image/webp" />
          <img class="f-logo" src="/assets/img/logo-full.png" width="220" height="167" alt="Algeria Compass" loading="lazy" decoding="async" />
        </picture>
        <p class="f-tagline">Explore Algeria in Elite Luxury</p>
        <p class="f-desc">Licensed Algerian tour operator — luxury private, guided tours across Algeria.</p>
        <address class="f-nap">
          &#128205; {CONTACT.address.full}<br/>
          &#128222; <a href={`tel:${CONTACT.phoneE164}`}>{CONTACT.phoneDisplay}</a><br/>
          &#9993; <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        </address>
        <div class="f-socials">
          <a href="https://wa.me/213784193176" target="_blank" rel="noopener" class="fs" aria-label="WhatsApp">WA</a>
          <a href="https://www.instagram.com/algeria_compass/" target="_blank" rel="noopener" class="fs" aria-label="Algeria Compass on Instagram">IG</a>
          <a href="https://www.facebook.com/profile.php?id=61590718167514" target="_blank" rel="noopener" class="fs" aria-label="Algeria Compass on Facebook">FB</a>
        </div>
      </div>
      <div class="fcol">
        <h2>Explore</h2>
        <ul>
          <li><a href="/tours/">Tours</a></li>
          <li><a href="/luxury/">Luxury 5-Star Collection</a></li>
          <li><a href="/destinations/">Destinations</a></li>
          <li><a href="/provinces/">States</a></li>
          <li><a href="/regions/">Regions — 8 worlds</a></li>
          <li><a href="/experiences/">Experiences</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/discover/">Discover Algeria</a></li>
        </ul>
      </div>
      <div class="fcol">
        <h2>Knowledge</h2>
        <ul>
          <li><a href="/questions/">Questions &amp; Answers</a></li>
          <li><a href="/culture/">Culture</a></li>
          <li><a href="/history/">History</a></li>
          <li><a href="/food/">Food</a></li>
          <li><a href="/sweets/">Sweets &amp; Pastries</a></li>
          <li><a href="/unesco/">UNESCO Sites</a></li>
        </ul>
      </div>
      <div class="fcol">
        <h2>Plan</h2>
        <ul>
          <li><a href="/travel-guides/">Travel Guides</a></li>
          <li><a href="/visa-support/">Visa Support</a></li>
          <li><a href="/evisa/">e-Visa &amp; Entry</a></li>
          <li><a href="/booking-terms/">Booking &amp; Cancellation Terms</a></li>
          <li><a href="/knowledge/">Knowledge graph</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact &amp; Inquiry</a></li>
          <li><a href="/sitemap/">Sitemap</a></li>
        </ul>
      </div>
      <div class="fcol">
        <h2>Editorial</h2>
        <ul>
          <li><a href="/editorial/">Editorial standards</a></li>
          <li><a href="/team/">Editorial team</a></li>
          <li><a href="/reviewers/">Review &amp; fact-checking</a></li>
          <li><a href="/editorial/corrections-policy/">Corrections</a></li>
          <li><a href="/editorial/ai-usage-policy/">AI usage</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {year} Algeria Compass. All rights reserved. (Algeria)</p>
      <div class="fcerts">
        <span class="fcert">&#129517; Private Guided Tours</span>
        <span class="fcert">&#127465;&#127487; Local Algerian Experts</span>
        <span class="fcert">&#128274; SSL Secured</span>
      </div>
    </div>
  </div>
</footer>
<style>
  .f-nap{font-style:normal;font-size:.76rem;line-height:1.7;color:rgba(255,255,255,.42);margin-bottom:1rem;text-align:center}
  .f-nap a{color:rgba(255,255,255,.55)}
  .f-nap a:hover{color:#fff;text-decoration:none}
</style>
