---
// Animated eclipse hero, drawn live on a canvas: a deep sky of twinkling
// stars and the odd shooting star; the Sun glowing; the Moon sliding across;
// the diamond ring flashing at contact; totality with a pearly, streaming
// corona, pink prominences at the limb and the stars brightening; then the
// Moon moves off and the cycle starts again. A gold eight-pointed star turns
// slowly behind it. With prefers-reduced-motion one still frame of totality
// is drawn. A live countdown runs to the moment totality begins.
export interface Props {
  eyebrow: string; title: string; text: string;
  target: string;          // ISO time when totality begins, e.g. 2027-08-02T09:51:00+01:00
  place: string;           // where the countdown counts to
  cta?: { href: string; label: string };
  cta2?: { href: string; label: string };
}
const { eyebrow, title, text, target, place, cta, cta2 } = Astro.props;
---
<section class="esky" aria-label={title}>
  <canvas class="esky-canvas" aria-hidden="true"></canvas>
  <div class="esky-in wrap">
    <div class="esky-copy">
      <span class="esky-eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      <p>{text}</p>
      <div class="esky-count" data-target={target} role="timer" aria-live="off">
        <span class="esky-count-l">Totality in {place} begins in</span>
        <span class="esky-count-n">
          <span><b data-u="d">–</b><small>days</small></span>
          <span><b data-u="h">–</b><small>hours</small></span>
          <span><b data-u="m">–</b><small>min</small></span>
          <span><b data-u="s">–</b><small>sec</small></span>
        </span>
      </div>
      {(cta || cta2) && (
        <p class="esky-cta">
          {cta && <a class="ec-btn" href={cta.href} data-evt="cta_plan">{cta.label}</a>}
          {cta2 && <a class="ec-btn ec-btn-ghost" href={cta2.href}>{cta2.label}</a>}
        </p>
      )}
    </div>
    <div class="esky-art" aria-hidden="true"></div>
  </div>
</section>
<script>
  // ---------- countdown ----------
  document.querySelectorAll<HTMLElement>('.esky-count').forEach((el) => {
    const t = Date.parse(el.dataset.target || '');
    const put = (u: string, v: number) => { const n = el.querySelector(`[data-u="${u}"]`); if (n) n.textContent = String(v).padStart(u === 'd' ? 1 : 2, '0'); };
    const tick = () => {
      const s = Math.floor(Math.max(0, t - Date.now()) / 1000);
      put('d', Math.floor(s / 86400)); put('h', Math.floor(s / 3600) % 24); put('m', Math.floor(s / 60) % 60); put('s', s % 60);
    };
    tick(); setInterval(tick, 1000);
  });

  // ---------- reveal on scroll ----------
  const rev = 'IntersectionObserver' in window ? new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); rev?.unobserve(e.target); } }), { threshold: 0.12 }) : null;
  document.querySelectorAll('.ec-reveal').forEach((n) => rev ? rev.observe(n) : n.classList.add('is-in'));

  // ---------- the eclipse ----------
  const CYCLE = 18000;               // ms for one full eclipse
  const IN_END = 0.36, OUT_START = 0.72;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('.esky').forEach((hero) => {
    const cv = hero.querySelector('canvas') as HTMLCanvasElement;
    const art = hero.querySelector('.esky-art') as HTMLElement;
    const ctx = cv.getContext('2d');
    if (!ctx) return;
    let W = 0, H = 0, DPR = 1, cx = 0, cy = 0, R = 60;
    let stars: { x: number; y: number; r: number; a: number; sp: number; ph: number; c: string }[] = [];
    let corona: HTMLCanvasElement | null = null;
    const shoot = { on: false, x: 0, y: 0, vx: 0, vy: 0, life: 0 };
    let nextShoot = 2500;

    // Pearly corona streamers, rendered once per size to an offscreen canvas.
    const makeCorona = () => {
      const S = Math.ceil(R * 9), c = document.createElement('canvas');
      c.width = c.height = S;
      const g = c.getContext('2d')!; const m = S / 2;
      g.globalCompositeOperation = 'lighter';
      const N = 220;
      for (let i = 0; i < N; i++) {
        const a = (i / N) * Math.PI * 2 + Math.random() * 0.03;
        // longer streamers in two broad lobes, like a real corona
        const lobe = Math.pow(Math.abs(Math.cos(a - 0.35)), 2.2);
        const len = R * (0.35 + Math.random() * 0.9 + lobe * (1.4 + Math.random() * 2.2));
        const w = R * (0.02 + Math.random() * 0.07);
        const x0 = m + Math.cos(a) * R * 0.96, y0 = m + Math.sin(a) * R * 0.96;
        const x1 = m + Math.cos(a + (Math.random() - 0.5) * 0.08) * (R + len);
        const y1 = m + Math.sin(a + (Math.random() - 0.5) * 0.08) * (R + len);
        const gr = g.createLinearGradient(x0, y0, x1, y1);
        const tint = Math.random() < 0.18 ? '190,210,255' : '255,246,226';
        gr.addColorStop(0, `rgba(${tint},${0.22 + Math.random() * 0.2})`);
        gr.addColorStop(0.35, `rgba(${tint},0.08)`);
        gr.addColorStop(1, `rgba(${tint},0)`);
        g.strokeStyle = gr; g.lineWidth = w; g.lineCap = 'round';
        g.beginPath(); g.moveTo(x0, y0);
        g.quadraticCurveTo(m + Math.cos(a + 0.04) * (R + len * 0.5), m + Math.sin(a + 0.04) * (R + len * 0.5), x1, y1);
        g.stroke();
      }
      // inner glow hugging the limb
      const ig = g.createRadialGradient(m, m, R * 0.98, m, m, R * 1.9);
      ig.addColorStop(0, 'rgba(255,250,235,0.95)');
      ig.addColorStop(0.08, 'rgba(255,240,210,0.55)');
      ig.addColorStop(0.35, 'rgba(200,215,255,0.16)');
      ig.addColorStop(1, 'rgba(160,180,255,0)');
      g.fillStyle = ig; g.beginPath(); g.arc(m, m, R * 1.9, 0, Math.PI * 2); g.fill();
      corona = c;
    };

    const resize = () => {
      const b = hero.getBoundingClientRect(); const ab = art.getBoundingClientRect();
      DPR = Math.min(2, window.devicePixelRatio || 1);
      W = b.width; H = b.height;
      cv.width = Math.round(W * DPR); cv.height = Math.round(H * DPR);
      cv.style.width = W + 'px'; cv.style.height = H + 'px';
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      cx = ab.left - b.left + ab.width / 2; cy = ab.top - b.top + ab.height / 2;
      R = Math.max(38, ab.width * 0.2);
      const n = Math.min(900, Math.round((W * H) / 1400));
      const cols = ['255,255,255', '255,244,220', '214,228,255', '255,236,200'];
      stars = Array.from({ length: n }, () => ({
        x: Math.random() * W, y: Math.random() * H,
        r: Math.random() < 0.06 ? 1.4 + Math.random() * 1.2 : 0.3 + Math.random() * 0.9,
        a: 0.25 + Math.random() * 0.6, sp: 0.6 + Math.random() * 2.4, ph: Math.random() * 6.28,
        c: cols[(Math.random() * cols.length) | 0],
      }));
      makeCorona();
    };

    const ease = (x: number) => x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2;
    const clamp = (x: number) => Math.max(0, Math.min(1, x));

    const star4 = (x: number, y: number, len: number, alpha: number) => {
      ctx.save(); ctx.globalCompositeOperation = 'lighter'; ctx.globalAlpha = alpha;
      for (const [dx, dy, l] of [[1, 0, 1], [0, 1, 1], [0.7, 0.7, 0.45], [0.7, -0.7, 0.45]] as const) {
        const g = ctx.createLinearGradient(x - dx * len * l, y - dy * len * l, x + dx * len * l, y + dy * len * l);
        g.addColorStop(0, 'rgba(255,255,255,0)'); g.addColorStop(0.5, 'rgba(255,255,255,1)'); g.addColorStop(1, 'rgba(255,255,255,0)');
        ctx.strokeStyle = g; ctx.lineWidth = 1.6;
        ctx.beginPath(); ctx.moveTo(x - dx * len * l, y - dy * len * l); ctx.lineTo(x + dx * len * l, y + dy * len * l); ctx.stroke();
      }
      const gl = ctx.createRadialGradient(x, y, 0, x, y, len * 0.35);
      gl.addColorStop(0, 'rgba(255,255,255,1)'); gl.addColorStop(0.3, 'rgba(255,245,215,.8)'); gl.addColorStop(1, 'rgba(255,230,180,0)');
      ctx.fillStyle = gl; ctx.beginPath(); ctx.arc(x, y, len * 0.35, 0, Math.PI * 2); ctx.fill();
      ctx.restore();
    };

    const frame = (time: number) => {
      const p = reduce ? 0.5 : (time % CYCLE) / CYCLE;
      // Moon position: slides in, holds over totality, slides out
      let off: number;
      if (p < IN_END) off = -(1 - ease(p / IN_END)) * R * 2.6;
      else if (p < OUT_START) off = 0;
      else off = ease((p - OUT_START) / (1 - OUT_START)) * R * 2.6;
      const cover = clamp(1 - Math.abs(off) / (R * 2));                  // how much of the Sun is hidden
      const k = reduce ? 1 : (p > IN_END - 0.01 && p < OUT_START + 0.01 ? clamp(Math.min((p - IN_END + 0.01) / 0.03, (OUT_START + 0.01 - p) / 0.03)) : 0);

      // sky: deep blue, darker as the Moon covers the Sun
      const sky = ctx.createRadialGradient(cx, cy, R, cx, cy, Math.max(W, H));
      sky.addColorStop(0, `rgb(${Math.round(34 - 22 * cover)},${Math.round(44 - 32 * cover)},${Math.round(104 - 72 * cover)})`);
      sky.addColorStop(0.55, `rgb(${Math.round(12 - 8 * cover)},${Math.round(16 - 11 * cover)},${Math.round(48 - 32 * cover)})`);
      sky.addColorStop(1, '#03040C');
      ctx.globalCompositeOperation = 'source-over';
      ctx.fillStyle = sky; ctx.fillRect(0, 0, W, H);

      // stars: twinkle always, blaze during totality
      const boost = 0.55 + 0.45 * cover + 0.6 * k;
      const ts = time / 1000;
      for (const s of stars) {
        const tw = reduce ? 0.8 : 0.55 + 0.45 * Math.sin(ts * s.sp + s.ph);
        const al = Math.min(1, s.a * tw * boost);
        ctx.fillStyle = `rgba(${s.c},${al})`;
        ctx.beginPath(); ctx.arc(s.x, s.y, s.r * (0.85 + 0.3 * k), 0, Math.PI * 2); ctx.fill();
        if (s.r > 1.5 && al > 0.6) { ctx.fillStyle = `rgba(${s.c},${al * 0.18})`; ctx.beginPath(); ctx.arc(s.x, s.y, s.r * 3.2, 0, Math.PI * 2); ctx.fill(); }
      }

      // shooting star now and then
      if (!reduce) {
        if (!shoot.on && time > nextShoot) {
          shoot.on = true; shoot.x = Math.random() * W * 0.6; shoot.y = Math.random() * H * 0.35;
          const sp = 7 + Math.random() * 5; shoot.vx = sp; shoot.vy = sp * (0.35 + Math.random() * 0.3); shoot.life = 1;
        }
        if (shoot.on) {
          const tx = shoot.x - shoot.vx * 12, ty = shoot.y - shoot.vy * 12;
          const g = ctx.createLinearGradient(tx, ty, shoot.x, shoot.y);
          g.addColorStop(0, 'rgba(255,255,255,0)'); g.addColorStop(1, `rgba(255,248,230,${shoot.life})`);
          ctx.strokeStyle = g; ctx.lineWidth = 1.8; ctx.beginPath(); ctx.moveTo(tx, ty); ctx.lineTo(shoot.x, shoot.y); ctx.stroke();
          shoot.x += shoot.vx; shoot.y += shoot.vy; shoot.life -= 0.018;
          if (shoot.life <= 0 || shoot.x > W || shoot.y > H) { shoot.on = false; nextShoot = time + 4000 + Math.random() * 6000; }
        }
      }

      // gold eight-pointed star turning slowly behind the eclipse
      ctx.save(); ctx.translate(cx, cy); ctx.rotate(reduce ? 0 : ts * 0.04);
      ctx.strokeStyle = `rgba(240,199,102,${0.16 + 0.1 * k})`; ctx.lineWidth = 1;
      for (const rr of [R * 2.9, R * 2.35]) {
        for (const rot of [0, Math.PI / 4]) { ctx.save(); ctx.rotate(rot); ctx.strokeRect(-rr / Math.SQRT2, -rr / Math.SQRT2, rr * Math.SQRT2, rr * Math.SQRT2); ctx.restore(); }
      }
      ctx.beginPath(); ctx.arc(0, 0, R * 3.05, 0, Math.PI * 2); ctx.stroke();
      ctx.restore();

      // the Sun with its glow (fades as it is covered)
      const sunGlow = 1 - cover * 0.92;
      if (sunGlow > 0.02) {
        const gl = ctx.createRadialGradient(cx, cy, R * 0.9, cx, cy, R * 4);
        gl.addColorStop(0, `rgba(255,214,120,${0.55 * sunGlow})`); gl.addColorStop(0.3, `rgba(255,170,70,${0.18 * sunGlow})`); gl.addColorStop(1, 'rgba(255,150,50,0)');
        ctx.fillStyle = gl; ctx.beginPath(); ctx.arc(cx, cy, R * 4, 0, Math.PI * 2); ctx.fill();
      }
      const sd = ctx.createRadialGradient(cx - R * 0.2, cy - R * 0.2, R * 0.1, cx, cy, R);
      sd.addColorStop(0, '#FFFDF2'); sd.addColorStop(0.6, '#FFE9A6'); sd.addColorStop(1, '#F6B544');
      ctx.fillStyle = sd; ctx.beginPath(); ctx.arc(cx, cy, R, 0, Math.PI * 2); ctx.fill();

      // corona, breathing and turning very slowly
      if (k > 0 && corona) {
        ctx.save(); ctx.globalCompositeOperation = 'lighter';
        ctx.globalAlpha = k * (0.88 + 0.12 * Math.sin(ts * 1.3));
        ctx.translate(cx, cy); ctx.rotate(reduce ? 0 : ts * 0.025);
        const sc = 1 + 0.025 * Math.sin(ts * 0.9);
        ctx.scale(sc, sc);
        ctx.drawImage(corona, -corona.width / 2, -corona.height / 2);
        ctx.restore();
      }

      // the Moon
      const mx = cx + off, my = cy - off * 0.12;
      // seen only where it covers the Sun, as in reality (clip to the solar disc)
      ctx.save(); ctx.beginPath(); ctx.arc(cx, cy, R * 1.03, 0, Math.PI * 2); ctx.clip();
      ctx.fillStyle = '#02030A'; ctx.beginPath(); ctx.arc(mx, my, R * 1.015, 0, Math.PI * 2); ctx.fill();
      ctx.restore();

      // pink prominences and chromosphere at the limb during totality
      if (k > 0.2) {
        ctx.save(); ctx.globalCompositeOperation = 'lighter';
        ctx.strokeStyle = `rgba(255,90,130,${0.55 * k})`; ctx.lineWidth = R * 0.03; ctx.shadowColor = 'rgba(255,80,120,.9)'; ctx.shadowBlur = R * 0.15;
        ctx.beginPath(); ctx.arc(mx, my, R * 1.02, 0, Math.PI * 2); ctx.stroke();
        ctx.fillStyle = `rgba(255,95,135,${0.75 * k})`;
        for (const [ang, h] of [[0.6, 0.09], [2.3, 0.06], [3.9, 0.11], [5.2, 0.07]] as const) {
          const hh = R * h * (0.85 + 0.15 * Math.sin(ts * 2 + ang));
          ctx.beginPath(); ctx.ellipse(mx + Math.cos(ang) * R * 1.03, my + Math.sin(ang) * R * 1.03, hh * 0.5, hh, ang + Math.PI / 2, 0, Math.PI * 2); ctx.fill();
        }
        ctx.restore();
      }

      // diamond ring at second and third contact
      if (!reduce) {
        const d1 = clamp(1 - Math.abs(p - (IN_END - 0.012)) / 0.02), d2 = clamp(1 - Math.abs(p - (OUT_START + 0.012)) / 0.02);
        const d = Math.max(d1, d2);
        if (d > 0) {
          const ang = d1 > d2 ? 0.15 : Math.PI + 0.15;
          star4(cx + Math.cos(ang) * R, cy + Math.sin(ang) * R, R * 1.6, d);
        }
      }
    };

    let raf = 0, visible = true;
    const loop = (t: number) => { frame(t); if (!reduce && visible) raf = requestAnimationFrame(loop); };
    resize();
    if (reduce) frame(0); else raf = requestAnimationFrame(loop);
    let rt = 0;
    addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(() => { resize(); if (reduce) frame(0); }, 150); });
    if ('IntersectionObserver' in window && !reduce) {
      new IntersectionObserver(([e]) => {
        const v = e.isIntersecting && !document.hidden;
        if (v && !visible) { visible = true; raf = requestAnimationFrame(loop); }
        if (!v) { visible = false; cancelAnimationFrame(raf); }
      }).observe(hero);
    }
  });
</script>
<style>
  .esky{position:relative;overflow:hidden;color:#EEE7D7;background:#05071A;min-height:min(88vh,760px);display:flex;align-items:center}
  .esky-canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
  .esky::after{content:"";position:absolute;inset:auto 0 0 0;height:30px;background:var(--ec-star,none) center/30px 30px repeat-x;opacity:.45;border-top:1px solid rgba(240,199,102,.28);z-index:1}
  .esky-in{position:relative;z-index:2;display:grid;grid-template-columns:1.1fr .9fr;gap:2rem;align-items:center;padding-top:3rem;padding-bottom:4.4rem;width:100%}
  .esky-eyebrow{display:inline-block;font:700 .76rem/1 var(--sans);letter-spacing:.22em;text-transform:uppercase;color:#F0C766;margin-bottom:1rem}
  .esky h1{font-family:var(--serif);color:#FBEFC9;font-size:clamp(2.4rem,5.6vw,4.4rem);line-height:1.02;margin:0 0 1rem;text-shadow:0 4px 30px rgba(0,0,0,.7)}
  .esky-copy>p{font-size:clamp(1.05rem,1.6vw,1.22rem);line-height:1.65;color:#EEE7D7;max-width:560px;margin:0 0 1.4rem;text-shadow:0 2px 14px rgba(0,0,0,.8)}
  .esky-count{display:inline-flex;flex-direction:column;gap:.5rem;padding:1rem 1.2rem;border:1px solid rgba(240,199,102,.4);border-radius:16px;background:rgba(5,7,26,.72);backdrop-filter:blur(6px)}
  .esky-count-l{font:700 .72rem/1.2 var(--sans);letter-spacing:.14em;text-transform:uppercase;color:#F0C766}
  .esky-count-n{display:flex;gap:1rem}
  .esky-count-n span{display:flex;flex-direction:column;align-items:center;min-width:3.2rem}
  .esky-count-n b{font:600 clamp(1.7rem,3.6vw,2.4rem)/1 var(--serif);color:#FBEFC9;font-variant-numeric:tabular-nums}
  .esky-count-n small{font:600 .7rem/1.4 var(--sans);letter-spacing:.1em;text-transform:uppercase;color:#CFC8B8}
  .esky-cta{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1.4rem!important}
  .esky-art{width:min(420px,80vw);aspect-ratio:1;justify-self:center}
  @media (max-width:820px){.esky-in{grid-template-columns:1fr}.esky-art{order:-1;width:min(300px,78vw)}.esky{min-height:auto}}
</style>
