---
// P2 — customer reviews: shows ONLY approved reviews (fetched at runtime from
// /reviews-approved.json so new approvals appear without a rebuild) + a submit
// form that POSTs to /reviews.php and is stored PENDING for manual moderation
// (reviews-admin.php). AggregateRating/Review JSON-LD is injected client-side
// ONLY from real approved reviews — never fabricated, never when empty.
import data from '../data/tours.json';
const tours = (((data as any).tours || data) as any[]).map(t => t.title).sort();
---
<section class="section rvx" id="reviews"><div class="wrap">
  <div class="eyebrow">In their words</div>
  <h2>Reviews from our travellers</h2>
  <p class="rvx-sub">Real, verified reviews from people who travelled with us. We publish each one only after we’ve confirmed it — so what you read here is genuine.</p>

  <!-- No aria-label: the link's own visible text already describes it, and an
       aria-label that does not contain the visible words breaks voice control
       (a user saying "click 5.0 on Google" would not match). -->
  <a class="rvx-google" href="https://share.google/rEAjf9e2qvCwefa2X" target="_blank" rel="noopener">
    <span class="rvx-google-score">5.0</span>
    <span class="rvx-google-stars" aria-hidden="true">★★★★★</span>
    <span class="rvx-google-txt"><strong>5.0 on Google</strong> — from 9 five-star reviews · read them on Google →</span>
  </a>

  <div class="rvx-grid">
    <div class="rvx-list" id="rvx-list" data-src="/reviews-approved.json" aria-live="polite">
      <p class="rvx-empty">Loading reviews…</p>
    </div>

    <form class="rvx-form" id="rvx-form" method="post" action="/reviews.php">
      <h3>Travelled with us? Leave a review</h3>
      <p class="rvx-note">Your review is checked by our team before it appears — usually within a day.</p>
      <label>Your name<span aria-hidden="true">*</span>
        <input type="text" name="name" required maxlength="80" autocomplete="name">
      </label>
      <label>Country
        <input type="text" name="country" maxlength="60" autocomplete="country-name" placeholder="e.g. Germany">
      </label>
      <label>Which tour / experience?
        <select name="tour">
          <option value="">Choose a tour (optional)</option>
          {tours.map(t => <option value={t}>{t}</option>)}
          <option value="Custom / private trip">Custom / private trip</option>
        </select>
      </label>
      <fieldset class="rvx-stars">
        <legend>Your rating<span aria-hidden="true">*</span></legend>
        {[5,4,3,2,1].map(n => (
          <>
            <input type="radio" id={`star${n}`} name="rating" value={n} required />
            <label for={`star${n}`} title={`${n} star${n>1?'s':''}`} aria-label={`${n} stars`}>★</label>
          </>
        ))}
      </fieldset>
      <label>Your review<span aria-hidden="true">*</span>
        <textarea name="comment" required maxlength="1500" rows="4" placeholder="What was your trip like?"></textarea>
      </label>
      <input type="text" name="website" class="rvx-hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <button type="submit" class="btn btn-gold">Submit review</button>
      <p class="rvx-msg" id="rvx-msg" role="status" hidden></p>
    </form>
  </div>
</div></section>

<style>
  .rvx-sub{color:var(--text-m);max-width:720px;margin:.4rem 0 0}
  .rvx-grid{display:grid;grid-template-columns:1.25fr .9fr;gap:1.6rem;margin-top:1.4rem;align-items:start}
  @media(max-width:820px){ .rvx-grid{grid-template-columns:1fr} }
  /* list */
  .rvx-list{display:flex;flex-direction:column;gap:.9rem;min-height:80px}
  .rvx-empty{color:var(--text-m);background:var(--wash);border:1px dashed var(--border);border-radius:12px;padding:1.4rem;text-align:center;margin:0}
  .rvx-card{background:#fff;border:1px solid var(--border);border-radius:14px;padding:1rem 1.15rem;box-shadow:var(--shadow-card)}
  .rvx-top{display:flex;justify-content:space-between;align-items:center;gap:.6rem;flex-wrap:wrap}
  .rvx-name{font-weight:800;color:var(--green-d)}
  .rvx-stars-out{color:var(--gold);letter-spacing:2px;font-size:1rem}
  .rvx-meta{color:var(--text-l);font-size:.8rem;margin:.1rem 0 .5rem}
  .rvx-body{margin:0;color:var(--text);line-height:1.6}
  .rvx-agg{display:flex;align-items:center;gap:.6rem;margin:0 0 1rem;font-weight:700;color:var(--green-d)}
  .rvx-agg b{font-size:1.5rem} .rvx-agg .rvx-stars-out{font-size:1.15rem}
  /* verified Google rating banner (server-rendered, links to the live profile) */
  .rvx-google{display:inline-flex;align-items:center;gap:.7rem;margin:1rem 0 0;padding:.65rem 1.05rem;
    border:1px solid var(--border);border-left:4px solid var(--gold);border-radius:12px;background:var(--wash);
    text-decoration:none;transition:box-shadow .2s,border-color .2s}
  .rvx-google:hover{box-shadow:0 8px 22px rgba(11,61,46,.12);border-color:var(--gold)}
  .rvx-google-score{font-family:'Cinzel',serif;font-weight:800;font-size:1.5rem;color:var(--green-d);line-height:1}
  .rvx-google-stars{color:var(--gold);letter-spacing:2px;font-size:1.05rem}
  .rvx-google-txt{color:var(--text-m);font-size:.92rem}
  .rvx-google-txt strong{color:var(--green-d)}
  /* form */
  .rvx-form{background:linear-gradient(160deg,#0B3D2E,#07261C);color:#fff;border-radius:16px;padding:1.3rem 1.3rem 1.5rem;
    box-shadow:0 10px 30px rgba(7,38,28,.25)}
  .rvx-form h3{color:#fff;font-size:1.15rem;margin:0 0 .2rem}
  .rvx-note{color:rgba(255,255,255,.8);font-size:.82rem;margin:0 0 .9rem}
  .rvx-form label{display:block;font-size:.82rem;font-weight:700;color:rgba(255,255,255,.92);margin:.7rem 0 .25rem}
  .rvx-form input[type=text],.rvx-form select,.rvx-form textarea{width:100%;font:inherit;font-size:.95rem;
    padding:.6rem .7rem;border:1px solid rgba(255,255,255,.25);border-radius:9px;background:rgba(255,255,255,.95);color:#13231d}
  .rvx-form textarea{resize:vertical;min-height:96px}
  .rvx-form .btn{margin-top:1rem;min-height:44px}
  .rvx-hp{position:absolute;left:-9999px;width:1px;height:1px;opacity:0}
  /* interactive star input (reversed so :hover highlights leftwards) */
  .rvx-stars{border:0;padding:0;margin:.7rem 0 0;display:flex;flex-direction:row-reverse;justify-content:flex-end;gap:.1rem}
  .rvx-stars legend{font-size:.82rem;font-weight:700;color:rgba(255,255,255,.92);margin-bottom:.25rem;float:left;width:100%}
  .rvx-stars input{position:absolute;opacity:0;width:0;height:0}
  .rvx-stars label{font-size:1.8rem;color:rgba(255,255,255,.3);cursor:pointer;transition:color .12s;margin:0}
  .rvx-stars label:hover,.rvx-stars label:hover ~ label,
  .rvx-stars input:checked ~ label{color:var(--gold-l)}
  .rvx-stars input:focus-visible + label{outline:2px solid var(--gold-l);outline-offset:2px;border-radius:4px}
  .rvx-msg{margin:.8rem 0 0;font-weight:700;font-size:.9rem}
  .rvx-msg.ok{color:#9be3b8} .rvx-msg.err{color:#ffc7bf}
</style>

<script is:inline>
  (function(){
    var sec = document.querySelector('.rvx'); if(!sec) return;
    var list = sec.querySelector('#rvx-list');
    var esc = function(s){ var d=document.createElement('div'); d.textContent=s==null?'':String(s); return d.innerHTML; };
    var starStr = function(n){ n=Math.round(n); return '★★★★★'.slice(0,n) + '☆☆☆☆☆'.slice(0,5-n); };

    // 1) render approved reviews (no file yet === no reviews yet)
    var emptyState = '<p class="rvx-empty">We’re publishing our travellers’ reviews here shortly — meanwhile, read our verified five-star reviews on Google above, or be the first to leave one here.</p>';
    fetch(list.getAttribute('data-src'), { cache:'no-store' })
      .then(function(r){ return r.ok ? r.json() : { reviews:[] }; })
      .then(function(d){
      var rs = (d && d.reviews) || [];
      if(!rs.length){ list.innerHTML = emptyState; return; }
      var avg = rs.reduce(function(a,x){ return a + (+x.rating||0); }, 0) / rs.length;
      var html = '<div class="rvx-agg"><b>'+avg.toFixed(1)+'</b><span class="rvx-stars-out" aria-hidden="true">'+starStr(avg)+'</span><span>from '+rs.length+' review'+(rs.length>1?'s':'')+'</span></div>';
      rs.slice().reverse().forEach(function(x){
        html += '<article class="rvx-card"><div class="rvx-top"><span class="rvx-name">'+esc(x.name)+'</span>'+
          '<span class="rvx-stars-out" aria-label="'+(+x.rating)+' out of 5">'+starStr(+x.rating)+'</span></div>'+
          '<div class="rvx-meta">'+[esc(x.country),esc(x.tour),esc(x.date)].filter(Boolean).join(' · ')+'</div>'+
          '<p class="rvx-body">'+esc(x.comment)+'</p></article>';
      });
      list.innerHTML = html;

      // 2) inject AggregateRating + Review JSON-LD — ONLY from real approved data.
      // Uses the SAME @id as the sitewide Organization so Google MERGES the rating
      // onto the one TravelAgency entity; the recommended LocalBusiness fields
      // (telephone, priceRange, address, image) are included so the node is also
      // complete if evaluated on its own (Rich Results: 0 warnings).
      var ld = {
        "@context":"https://schema.org", "@type":"TravelAgency",
        "@id":"https://algeriacompass.com/#organization",
        "name":"Algeria Compass", "url":"https://algeriacompass.com/",
        "image":"https://algeriacompass.com/assets/img/og-image.png",
        "telephone":"+213784193176",
        "priceRange":"€30–€2,290 per person",
        "address":{ "@type":"PostalAddress", "streetAddress":"Rue Larbi Ben M’Hidi",
          "addressLocality":"Alger-Centre", "addressRegion":"Algiers", "postalCode":"16000", "addressCountry":"DZ" },
        "aggregateRating":{ "@type":"AggregateRating", "ratingValue":avg.toFixed(1),
          "reviewCount":rs.length, "bestRating":5, "worstRating":1 },
        "review": rs.slice(-12).map(function(x){ return {
          "@type":"Review",
          "author":{ "@type":"Person", "name":x.name||"Traveller" },
          "datePublished":x.date,
          "reviewBody":x.comment,
          "reviewRating":{ "@type":"Rating", "ratingValue":+x.rating, "bestRating":5, "worstRating":1 }
        }; })
      };
      var s = document.createElement('script'); s.type='application/ld+json';
      s.textContent = JSON.stringify(ld); document.head.appendChild(s);
    }).catch(function(){ list.innerHTML = emptyState; });

    // 3) submit the form via fetch
    var form = sec.querySelector('#rvx-form'); var msg = sec.querySelector('#rvx-msg');
    form.addEventListener('submit', function(e){
      e.preventDefault();
      msg.hidden = false; msg.className='rvx-msg'; msg.textContent='Sending…';
      fetch(form.action, { method:'POST', headers:{ 'X-Requested-With':'fetch' }, body:new FormData(form) })
        .then(function(r){ return r.json(); })
        .then(function(j){
          if(j && j.ok){ form.reset(); msg.className='rvx-msg ok'; msg.textContent='Thank you! Your review will appear once our team has verified it.'; }
          else { msg.className='rvx-msg err'; msg.textContent=(j&&j.error)||'Something went wrong. Please try again.'; }
        })
        .catch(function(){ msg.className='rvx-msg err'; msg.textContent='Network error — please try again, or WhatsApp us.'; });
    });
  })();
</script>
