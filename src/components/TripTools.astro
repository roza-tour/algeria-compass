---
// Two small tools that work on every page:
//
//  1. Currency. Prices are booked in EUR; a visitor can read them in USD or
//     GBP instead. Any element with data-eur="828" is rewritten (≈ $923), and
//     any <select data-cur-select> switches the currency. The choice is
//     remembered. Rates are the ECB's, refreshed at each build (gen-fx.mjs).
//
//  2. Shortlist. The heart on a tour card ([data-fav]) saves the tour; a pill
//     shows how many are saved and opens a panel to remove them, send the
//     whole list on WhatsApp in one message, or compare them side by side.
//     Stored in the browser only (localStorage) -- nothing is sent anywhere
//     until the visitor presses Send.
import fx from '../data/fx.json';
import { CONTACT } from '../config';
export interface Props { lang?: string; }
const lang = Astro.props.lang || 'en';
const T: Record<string, Record<string, string>> = {
  en: { saved: 'Saved', title: 'Your shortlist', empty: 'Tap the heart on any tour to save it here.', send: 'Send my shortlist on WhatsApp', compare: 'Compare side by side', remove: 'Remove', close: 'Close', cur: 'Currency', note: 'Prices are booked in euros; other currencies are approximate.', msg: "Hello Algeria Compass, I'm interested in these tours:" },
  fr: { saved: 'Favoris', title: 'Vos favoris', empty: 'Touchez le cœur d’un circuit pour l’enregistrer ici.', send: 'Envoyer mes favoris sur WhatsApp', compare: 'Comparer', remove: 'Retirer', close: 'Fermer', cur: 'Devise', note: 'Les prix sont réservés en euros ; les autres devises sont indicatives.', msg: 'Bonjour Algeria Compass, ces circuits m’intéressent :' },
  it: { saved: 'Preferiti', title: 'I tuoi preferiti', empty: 'Tocca il cuore di un tour per salvarlo qui.', send: 'Invia i preferiti su WhatsApp', compare: 'Confronta', remove: 'Rimuovi', close: 'Chiudi', cur: 'Valuta', note: 'I prezzi si prenotano in euro; le altre valute sono indicative.', msg: 'Buongiorno Algeria Compass, mi interessano questi tour:' },
  es: { saved: 'Guardados', title: 'Tu selección', empty: 'Toca el corazón de un circuito para guardarlo aquí.', send: 'Enviar mi selección por WhatsApp', compare: 'Comparar', remove: 'Quitar', close: 'Cerrar', cur: 'Moneda', note: 'Los precios se reservan en euros; otras monedas son aproximadas.', msg: 'Hola Algeria Compass, me interesan estos circuitos:' },
  de: { saved: 'Merkliste', title: 'Ihre Merkliste', empty: 'Tippen Sie auf das Herz einer Reise, um sie hier zu speichern.', send: 'Merkliste per WhatsApp senden', compare: 'Vergleichen', remove: 'Entfernen', close: 'Schließen', cur: 'Währung', note: 'Gebucht wird in Euro; andere Währungen sind ungefähr.', msg: 'Hallo Algeria Compass, mich interessieren diese Reisen:' },
};
const t = T[lang] || T.en;
const cfg = { rates: fx.rates, wa: CONTACT.whatsapp, t };
---
<button type="button" class="sl-pill" id="sl-pill" hidden aria-haspopup="dialog">
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 20.3l-1.3-1.2C6 14.9 3 12.2 3 8.9 3 6.2 5.1 4.2 7.7 4.2c1.5 0 3 .7 3.9 1.9l.4.5.4-.5c.9-1.2 2.4-1.9 3.9-1.9 2.6 0 4.7 2 4.7 4.7 0 3.3-3 6-7.7 10.2z"/></svg>
  <span>{t.saved}</span> <b id="sl-count" aria-label={t.saved}>0</b>
</button>
<dialog class="sl-panel" id="sl-panel" aria-labelledby="sl-h">
  <div class="sl-head">
    <h2 id="sl-h">{t.title}</h2>
    <button type="button" class="sl-x" id="sl-close" aria-label={t.close}>×</button>
  </div>
  <ul class="sl-list" id="sl-list"></ul>
  <p class="sl-empty" id="sl-empty">{t.empty}</p>
  <div class="sl-actions" id="sl-actions">
    <a class="btn btn-wa" id="sl-wa" target="_blank" rel="noopener">{t.send}</a>
    <a class="btn btn-ghost" id="sl-compare" href="/compare/">{t.compare}</a>
  </div>
  <label class="sl-cur">{t.cur}
    <select data-cur-select>
      <option value="EUR">€ EUR</option><option value="USD">$ USD</option><option value="GBP">£ GBP</option>
    </select>
  </label>
  <p class="sl-note">{t.note}</p>
</dialog>

<style is:global>
  .sl-pill{position:fixed;left:16px;bottom:84px;z-index:60;display:inline-flex;align-items:center;gap:.4rem;border:0;cursor:pointer;
    padding:.6rem 1rem;border-radius:999px;background:#fff;color:#07261C;font-weight:700;font-size:.88rem;
    box-shadow:0 8px 24px rgba(7,38,28,.25);font-family:var(--font-body)}
  /* display rules above would otherwise override the hidden attribute */
  .sl-pill[hidden],.sl-actions[hidden],.sl-actions [hidden],.sl-empty[hidden]{display:none !important}
  .sl-pill svg{fill:#C92B34}
  .sl-pill b{background:#C92B34;color:#fff;border-radius:999px;min-width:1.5em;padding:0 .4em;text-align:center}
  .sl-pill.bump{animation:sl-bump .45s ease}
  @keyframes sl-bump{40%{transform:scale(1.12)}}
  .sl-panel{margin:auto;border:0;border-radius:16px;padding:0;width:min(460px,calc(100vw - 32px));max-height:min(82vh,720px);
    box-shadow:0 30px 80px rgba(0,0,0,.35);font-family:var(--font-body);color:var(--ink)}
  .sl-panel::backdrop{background:rgba(7,20,15,.55);backdrop-filter:blur(2px)}
  .sl-head{display:flex;align-items:center;justify-content:space-between;padding:1rem 1.2rem;border-bottom:1px solid var(--border);
    position:sticky;top:0;background:#fff;z-index:1}
  .sl-head h2{margin:0;font-size:1.4rem}
  .sl-x{border:0;background:none;font-size:1.8rem;line-height:1;cursor:pointer;color:var(--text-l);padding:.2rem .5rem}
  .sl-list{list-style:none;margin:0;padding:.6rem 1.2rem}
  .sl-list li{display:grid;grid-template-columns:64px 1fr auto;gap:.8rem;align-items:center;padding:.6rem 0;border-bottom:1px solid var(--border)}
  .sl-list img{width:64px;height:48px;object-fit:cover;border-radius:6px;display:block;background:var(--cream)}
  .sl-list a{color:var(--green-d);font-weight:600;text-decoration:none;line-height:1.25;font-size:.95rem}
  .sl-list a:hover{text-decoration:underline}
  .sl-list small{display:block;color:var(--text-l);font-size:.85rem;margin-top:.15rem}
  .sl-rm{border:1px solid var(--border);background:#fff;border-radius:4px;padding:.3rem .55rem;font-size:.8rem;cursor:pointer;color:var(--text-m)}
  .sl-empty{padding:0 1.2rem;color:var(--text-l)}
  .sl-actions{display:flex;flex-wrap:wrap;gap:.6rem;padding:.4rem 1.2rem 0}
  .sl-actions .btn{flex:1 1 auto;justify-content:center;text-align:center}
  .sl-cur{display:flex;align-items:center;gap:.6rem;padding:1rem 1.2rem 0;font-size:.9rem;font-weight:600;color:var(--text-m)}
  .sl-cur select{padding:.35rem .5rem;border:1px solid var(--border);border-radius:4px;font:inherit}
  .sl-note{padding:.4rem 1.2rem 1.2rem;margin:0;font-size:.8rem;color:var(--text-l)}
  @media (max-width:560px){ .sl-pill{bottom:142px;padding:.55rem .75rem} .sl-pill span{display:none} }
</style>

<script is:inline define:vars={{ cfg }}>
  (function () {
    var KEY = 'ac-shortlist', CUR = 'ac-cur', t = cfg.t;
    var store = {
      get: function (k, d) { try { var v = localStorage.getItem(k); return v ? JSON.parse(v) : d; } catch (e) { return d; } },
      set: function (k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }
    };
    var SYM = { EUR: '€', USD: '$', GBP: '£' };

    /* ---- currency ---- */
    function fmt(eur, cur) {
      if (cur === 'EUR' || !cfg.rates[cur]) return '€' + Math.round(eur).toLocaleString('en');
      return '≈ ' + SYM[cur] + Math.round(eur * cfg.rates[cur]).toLocaleString('en');
    }
    function applyCur() {
      var cur = store.get(CUR, 'EUR');
      document.querySelectorAll('[data-eur]').forEach(function (el) { el.textContent = fmt(+el.getAttribute('data-eur'), cur); });
      document.querySelectorAll('[data-cur-select]').forEach(function (s) { s.value = cur; });
      document.documentElement.setAttribute('data-cur', cur);
    }
    document.addEventListener('change', function (e) {
      if (e.target && e.target.matches && e.target.matches('[data-cur-select]')) { store.set(CUR, e.target.value); applyCur(); render(); }
    });
    window.__applyCur = applyCur;

    /* ---- shortlist ---- */
    var pill = document.getElementById('sl-pill'), panel = document.getElementById('sl-panel');
    function list() { return store.get(KEY, []); }
    function syncHearts() {
      var ids = list().map(function (x) { return x.id; });
      document.querySelectorAll('[data-fav]').forEach(function (b) { b.setAttribute('aria-pressed', ids.indexOf(b.getAttribute('data-fav')) > -1 ? 'true' : 'false'); });
    }
    function render() {
      var l = list(), cur = store.get(CUR, 'EUR');
      document.getElementById('sl-count').textContent = l.length;
      pill.hidden = l.length === 0;
      var ul = document.getElementById('sl-list'); ul.innerHTML = '';
      l.forEach(function (x) {
        var li = document.createElement('li');
        var img = document.createElement('img'); img.src = x.img || ''; img.alt = ''; img.loading = 'lazy'; img.width = 64; img.height = 48;
        var d = document.createElement('div');
        var a = document.createElement('a'); a.href = '/tours/' + x.id + '/'; a.textContent = x.title;
        var sm = document.createElement('small'); sm.textContent = fmt(x.price, cur);
        d.appendChild(a); d.appendChild(sm);
        var rm = document.createElement('button'); rm.type = 'button'; rm.className = 'sl-rm'; rm.textContent = t.remove;
        rm.addEventListener('click', function () { toggle({ id: x.id }); });
        li.appendChild(img); li.appendChild(d); li.appendChild(rm); ul.appendChild(li);
      });
      document.getElementById('sl-empty').hidden = l.length > 0;
      document.getElementById('sl-actions').hidden = l.length === 0;
      var msg = t.msg + '\n' + l.map(function (x) { return '• ' + x.title + ' (€' + x.price + ') ' + location.origin + '/tours/' + x.id + '/'; }).join('\n');
      document.getElementById('sl-wa').href = 'https://wa.me/' + cfg.wa + '?text=' + encodeURIComponent(msg);
      var cmp = document.getElementById('sl-compare');
      cmp.href = '/compare/?t=' + l.map(function (x) { return x.id; }).join(',');
      cmp.hidden = l.length < 2;
      syncHearts();
    }
    function toggle(item) {
      var l = list(), i = -1;
      l.forEach(function (x, k) { if (x.id === item.id) i = k; });
      if (i > -1) l.splice(i, 1); else if (item.title) l.push(item);
      store.set(KEY, l.slice(-12));
      render();
      if (i === -1) { pill.classList.remove('bump'); void pill.offsetWidth; pill.classList.add('bump'); }
      if (window.gtag && i === -1) window.gtag('event', 'shortlist_add', { tour: item.id });
    }
    document.addEventListener('click', function (e) {
      var b = e.target.closest && e.target.closest('[data-fav]');
      if (!b) return;
      e.preventDefault();
      toggle({ id: b.getAttribute('data-fav'), title: b.getAttribute('data-title'), price: +b.getAttribute('data-price'), img: b.getAttribute('data-img') });
      b.classList.remove('pop'); void b.offsetWidth; b.classList.add('pop');
    });
    pill.addEventListener('click', function () { if (panel.showModal) panel.showModal(); else panel.setAttribute('open', ''); });
    document.getElementById('sl-close').addEventListener('click', function () { panel.close ? panel.close() : panel.removeAttribute('open'); });
    panel.addEventListener('click', function (e) { if (e.target === panel) panel.close(); });

    function init() { applyCur(); render(); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  })();
</script>
