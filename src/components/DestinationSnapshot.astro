---
export interface Props { name: string; type?: string; province?: string; bestTime?: string; timeNeeded?: string; knownFor?: string[]; }
const { name, type, province, bestTime, timeNeeded, knownFor = [] } = Astro.props;
---
<aside class="ai-block snapshot" aria-label={`${name} snapshot`}>
  <h3>{name} at a glance</h3>
  <dl>
    {type && <><dt>Type</dt><dd>{type}</dd></>}
    {province && <><dt>State</dt><dd>{province}</dd></>}
    {bestTime && <><dt>Best time</dt><dd>{bestTime}</dd></>}
    {timeNeeded && <><dt>Time needed</dt><dd>{timeNeeded}</dd></>}
    {knownFor.length > 0 && <><dt>Known for</dt><dd>{knownFor.join(', ')}</dd></>}
  </dl>
</aside>
