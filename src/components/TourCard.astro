---
// P4 — conversion-focused tour card, shared by the homepage + /tours/ so they
// stay consistent. Sells: strong photo, name, duration, "from €X", a benefit
// line, real trust cues, and a clear primary CTA.
//
// Trust cues are all TRUE for every tour: every itinerary is private + guided,
// we are a licensed Algerian operator, and the booking terms give free
// cancellation up to 5 days before departure (/booking-terms/).
//
// "Best seller" is NEVER fabricated: it shows only when a tour has
// `"bestseller": true` in src/data/tours.json. OWNER: set that flag on the
// tours you actually sell most — until then no best-seller badges appear.
import { TOUR_VISUALS } from '../data/tour-visuals';
const { tour, priority = false } = Astro.props as { tour: any; priority?: boolean };
const t = tour;
const v = TOUR_VISUALS[t.id] || { hero: `${t.image_slugs[0]}-1.jpg`, accent: '#0B3D2E' };
const benefit = t.hook || t.summary;
---
<a class="tcard" href={`/tours/${t.id}/`} style={`--accent:${v.accent}`}>
  <div class="tcard-img">
    {v.hero
      ? <picture>
          <source srcset={`/assets/img/thumbs/tours/${v.hero.replace(/\.(jpe?g|png)$/i, '.webp')}`} type="image/webp" />
          <img src={`/assets/img/thumbs/tours/${v.hero}`} alt={t.title} width="400" height="250" loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding="async" />
        </picture>
      : <div class="tcard-grad"></div>}
    <div class="tcard-badges">
      <span class="tcard-badge private">Private</span>
      {t.bestseller && <span class="tcard-badge best">★ Best seller</span>}
    </div>
    <span class="tcard-dur">{t.duration}</span>
  </div>
  <div class="tcard-body">
    <h3 class="tcard-title">{t.title}</h3>
    <p class="tcard-benefit">{benefit}</p>
    <ul class="tcard-trust" aria-label="Why book this tour">
      <li>Licensed Algerian operator</li>
      <li>Free cancellation up to 5 days before</li>
    </ul>
    <div class="tcard-foot">
      <span class="tcard-price">
        {t.price_from && <em>from</em>}
        <b>€{t.price_eur}</b>
        <small>/ {t.per}</small>
      </span>
      <span class="tcard-cta">View &amp; book <span aria-hidden="true">→</span></span>
    </div>
  </div>
</a>

<style>
  .tcard{display:flex;flex-direction:column;background:#fff;border:1px solid var(--border);
    border-radius:16px;overflow:hidden;text-decoration:none;color:inherit;
    box-shadow:0 4px 18px rgba(11,61,46,.07);transition:transform .18s ease,box-shadow .18s ease}
  .tcard:hover{transform:translateY(-5px);box-shadow:0 18px 40px rgba(11,61,46,.16)}
  /* image */
  .tcard-img{position:relative;aspect-ratio:16/10;overflow:hidden;background:var(--accent)}
  .tcard-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .45s ease}
  .tcard:hover .tcard-img img{transform:scale(1.06)}
  .tcard-grad{width:100%;height:100%;background:linear-gradient(135deg,var(--accent,#0B3D2E),#07261C)}
  .tcard-badges{position:absolute;top:.6rem;left:.6rem;display:flex;gap:.35rem;flex-wrap:wrap}
  .tcard-badge{font-size:.66rem;font-weight:800;letter-spacing:.04em;padding:.28rem .6rem;border-radius:999px;
    backdrop-filter:blur(3px);text-transform:uppercase}
  .tcard-badge.private{background:rgba(7,38,28,.78);color:#fff}
  .tcard-badge.best{background:var(--brand-gold);color:#07261C}
  .tcard-dur{position:absolute;bottom:.6rem;right:.6rem;font-size:.72rem;font-weight:700;color:#fff;
    background:rgba(7,38,28,.72);backdrop-filter:blur(3px);padding:.3rem .65rem;border-radius:8px}
  /* body */
  .tcard-body{display:flex;flex-direction:column;flex:1;padding:.95rem 1.05rem 1.1rem}
  .tcard-title{font-size:1.06rem;line-height:1.25;margin:0 0 .35rem}
  .tcard-benefit{font-size:.86rem;color:var(--text-m);line-height:1.5;margin:0 0 .7rem;
    display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  .tcard-trust{list-style:none;margin:0 0 .85rem;padding:0;display:flex;flex-direction:column;gap:.28rem;
    border-top:1px solid var(--border);padding-top:.7rem}
  .tcard-trust li{font-size:.76rem;color:var(--green-l);font-weight:600;display:flex;align-items:center;gap:.4rem;line-height:1.3}
  .tcard-trust li::before{content:"✓";color:var(--brand-gold);font-weight:900;flex:0 0 auto}
  .tcard-foot{margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:.6rem}
  .tcard-price{display:flex;align-items:baseline;gap:.25rem;color:var(--green-d)}
  .tcard-price em{font-style:normal;font-size:.7rem;color:var(--text-l);text-transform:uppercase;letter-spacing:.04em}
  .tcard-price b{font-family:'Cinzel',serif;font-size:1.35rem;line-height:1}
  .tcard-price small{font-size:.72rem;color:var(--text-l)}
  .tcard-cta{flex:0 0 auto;background:var(--brand-green);color:#fff;font-weight:800;font-size:.8rem;
    padding:.55rem .9rem;border-radius:9px;white-space:nowrap;transition:background .15s}
  .tcard:hover .tcard-cta{background:var(--brand-gold);color:#07261C}
</style>
