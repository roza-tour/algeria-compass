---
// A LIVE illustrated scene for an occasion — not a pattern swatch.
// Ramadan: night sky, twinkling stars, a glowing crescent, swaying fanous
// lanterns over a mosque skyline. Christmas: falling snow over an evergreen
// treeline under a gold star. Winter: heavier snow over a snow-capped range.
// Sahara: a setting sun over layered dunes with a slow caravan and rising stars.
//
// Everything is CSS transform/opacity (GPU-friendly), decorative (aria-hidden),
// and completely still under prefers-reduced-motion.
export interface Props {
  occasion: 'ramadan' | 'christmas' | 'winter' | 'sahara';
  eyebrow?: string;
  title?: string;
  note?: string;
}
const { occasion, eyebrow, title, note } = Astro.props;

// Deterministic particle positions (no RNG, so builds stay reproducible).
const STARS = [
  [6, 22], [13, 12], [21, 30], [28, 16], [35, 8], [42, 26], [49, 14],
  [57, 22], [64, 10], [71, 28], [78, 18], [85, 12], [92, 25], [17, 42],
  [33, 46], [52, 40], [68, 44], [88, 40], [45, 33], [76, 35],
];
const SNOW = [
  [4, 0, 11], [12, 2, 9], [19, 4, 13], [27, 1, 10], [34, 3, 12], [41, 5, 8],
  [48, 0, 14], [55, 2, 10], [62, 4, 9], [69, 1, 13], [76, 3, 11], [83, 5, 9],
  [90, 0, 12], [96, 2, 10], [8, 6, 15], [23, 7, 12], [44, 6, 14], [59, 8, 11],
  [73, 7, 13], [87, 6, 15],
];
---
<aside class:list={['occ-scene', `occ-scene--${occasion}`]} aria-label={title || `${occasion} scene`}>
  <div class="occ-art" aria-hidden="true">
    {occasion === 'ramadan' && (
      <>
        <span class="occ-sky occ-sky--night"></span>
        {STARS.map(([l, t], i) => (
          <span class="occ-star" style={`left:${l}%;top:${t}%;animation-delay:${(i % 7) * 0.6}s`}></span>
        ))}
        <svg class="occ-moon" viewBox="0 0 60 60" fill="none">
          <path d="M42 6a24 24 0 1 0 9 32A19 19 0 1 1 42 6Z" fill="currentColor"/>
        </svg>
        <span class="occ-lantern occ-lantern--1">
          <svg viewBox="0 0 24 40" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
            <path d="M12 0v7M8 7h8l2 6a6 6 0 0 1-12 0Z"/><path d="M9 26h6M12 21v5M10 30h4"/>
            <path d="M8.5 13h7" opacity=".6"/>
          </svg>
        </span>
        <span class="occ-lantern occ-lantern--2">
          <svg viewBox="0 0 24 40" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
            <path d="M12 0v5M8 5h8l2 6a6 6 0 0 1-12 0Z"/><path d="M9 22h6M12 17v5"/>
          </svg>
        </span>
        <svg class="occ-skyline" viewBox="0 0 400 80" preserveAspectRatio="none" fill="currentColor">
          <path d="M0 80V64h18v-8a10 10 0 0 1 20 0v8h14V44h6V32h4v12h6v20h22V52a14 14 0 0 1 28 0v12h16V40h5V26h4v14h5v24h30V58a12 12 0 0 1 24 0v6h20V46h6V34h4v12h6v18h26V56a16 16 0 0 1 32 0v8h20v-8a9 9 0 0 1 18 0v8h26v16Z"/>
        </svg>
      </>
    )}

    {occasion === 'christmas' && (
      <>
        <span class="occ-sky occ-sky--pine"></span>
        {STARS.slice(0, 12).map(([l, t], i) => (
          <span class="occ-star" style={`left:${l}%;top:${t * 0.7}%;animation-delay:${(i % 5) * 0.7}s`}></span>
        ))}
        <svg class="occ-topstar" viewBox="0 0 40 40" fill="currentColor">
          <path d="M20 2l4.6 10.6L36 17l-9.4 5.2L20 34l-6.6-11.8L4 17l11.4-4.4z"/>
        </svg>
        {SNOW.map(([l, d, dur], i) => (
          <span class="occ-flake" style={`left:${l}%;animation-delay:${d}s;animation-duration:${dur}s;--sz:${i % 3 === 0 ? 5 : 3}px`}></span>
        ))}
        <svg class="occ-treeline" viewBox="0 0 400 90" preserveAspectRatio="none" fill="currentColor">
          <path d="M0 90V70l14-22 8 12 10-26 12 20 8-12 14 24 10-16 12 22 10-18 14 26 10-14 12 20 10-24 14 26 10-16 12 22 10-20 14 24 10-14 12 20 10-22 14 24 10-16 12 22 10-18 14 24 10-12 12 18 10-20 14 22 10-14 12 20 10-18 14 24 8 10v14Z"/>
        </svg>
      </>
    )}

    {occasion === 'winter' && (
      <>
        <span class="occ-sky occ-sky--frost"></span>
        {SNOW.map(([l, d, dur], i) => (
          <span class="occ-flake" style={`left:${l}%;animation-delay:${d * 0.6}s;animation-duration:${dur * 0.8}s;--sz:${i % 4 === 0 ? 6 : 4}px`}></span>
        ))}
        {SNOW.slice(0, 10).map(([l, d, dur], i) => (
          <span class="occ-flake occ-flake--far" style={`left:${(l + 5) % 100}%;animation-delay:${d}s;animation-duration:${dur * 1.5}s;--sz:2px`}></span>
        ))}
        <svg class="occ-range" viewBox="0 0 400 110" preserveAspectRatio="none">
          <path d="M0 110V72l52-44 30 26 24-18 44 40 34-30 46 40 28-22 52 44 42-30 48 44v-4V110Z" fill="currentColor" opacity=".28"/>
          <path d="M0 110V86l60-40 34 30 30-22 50 44 36-28 52 42 40-26 54 44 44-32v42Z" fill="currentColor"/>
          <path d="M60 46l14 12-10 4-8-6zM210 60l12 10-9 3-7-5z" fill="#fff" opacity=".85"/>
        </svg>
      </>
    )}

    {occasion === 'sahara' && (
      <>
        <span class="occ-sky occ-sky--dusk"></span>
        {STARS.slice(0, 10).map(([l, t], i) => (
          <span class="occ-star" style={`left:${l}%;top:${t * 0.5}%;animation-delay:${(i % 5) * 0.8}s`}></span>
        ))}
        <span class="occ-sun"></span>
        <svg class="occ-dune occ-dune--back" viewBox="0 0 400 60" preserveAspectRatio="none" fill="currentColor">
          <path d="M0 60V34c60-26 118 12 182-6 64-18 118-22 218 6v26Z"/>
        </svg>
        <span class="occ-caravan" aria-hidden="true">
          <svg viewBox="0 0 120 30" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
            <path d="M6 24v-6a4 4 0 0 1 4-4c2.5 0 2.5 2.5 5 2.5s2.5-2.5 5-2.5a4 4 0 0 1 4 4v6M10 24v4M24 24v4M25 14V8"/>
            <path d="M46 25v-5a3 3 0 0 1 3-3c2 0 2 2 4 2s2-2 4-2a3 3 0 0 1 3 3v5M49 25v3M60 25v3M61 17v-5"/>
            <path d="M78 26v-4a2.5 2.5 0 0 1 2.5-2.5c1.6 0 1.6 1.6 3.2 1.6s1.6-1.6 3.2-1.6A2.5 2.5 0 0 1 89 22v4M80 26v2.5M88 26v2.5M89 19.5V16"/>
          </svg>
        </span>
        <svg class="occ-dune occ-dune--front" viewBox="0 0 400 70" preserveAspectRatio="none" fill="currentColor">
          <path d="M0 70V46c70-30 130 16 200-2 70-18 130-14 200 12v14Z"/>
        </svg>
      </>
    )}
  </div>

  <div class="occ-copy">
    {eyebrow && <span class="occ-eyebrow">{eyebrow}</span>}
    {title && <p class="occ-title">{title}</p>}
    {note && <p class="occ-note">{note}</p>}
  </div>
</aside>

<style>
  .occ-scene {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    margin: 1.6rem 0;
    min-height: 300px;
    display: flex;
    align-items: flex-end;
    isolation: isolate;
  }
  .occ-art { position: absolute; inset: 0; z-index: 0; }
  .occ-copy {
    position: relative;
    z-index: 2;
    padding: 1.5rem 1.4rem 1.4rem;
    width: 100%;
    background: linear-gradient(to top, rgba(0, 0, 0, .62), rgba(0, 0, 0, .28) 55%, transparent);
    color: #fff;
  }
  .occ-eyebrow {
    display: inline-block;
    font-family: var(--sans);
    font-size: .66rem; letter-spacing: .2em; text-transform: uppercase; font-weight: 800;
    color: var(--scene-accent, #E8C56A);
  }
  .occ-title {
    font-family: var(--scene-display, var(--font-display));
    font-size: clamp(1.35rem, 3vw, 2rem);
    line-height: 1.2; margin: .45rem 0 .3rem; color: #fff;
    text-shadow: 0 2px 14px rgba(0, 0, 0, .45);
  }
  .occ-note { margin: 0; max-width: 60ch; color: rgba(255, 255, 255, .9); font-size: .95rem; line-height: 1.6; }

  /* ---------- skies ---------- */
  .occ-sky { position: absolute; inset: 0; }
  .occ-sky--night { background: linear-gradient(180deg, #071E17 0%, #0B3D2E 55%, #14523C 100%); }
  .occ-sky--pine  { background: linear-gradient(180deg, #061B14 0%, #0E3A2A 60%, #174B36 100%); }
  .occ-sky--frost { background: linear-gradient(180deg, #16323F 0%, #2E6F8E 55%, #9FC6D8 100%); }
  .occ-sky--dusk  { background: linear-gradient(180deg, #2B1A3D 0%, #8A3F2E 45%, #D98C3C 78%, #E8B96A 100%); }

  /* ---------- stars ---------- */
  .occ-star {
    position: absolute; width: 3px; height: 3px; border-radius: 50%;
    background: #FFF7DF; opacity: .25;
    box-shadow: 0 0 6px rgba(255, 247, 223, .9);
  }

  /* ---------- ramadan ---------- */
  .occ-scene--ramadan { --scene-accent: #E8C56A; --scene-display: 'Amiri', var(--font-display); }
  .occ-moon {
    position: absolute; right: 8%; top: 12%; width: clamp(54px, 9vw, 82px); height: auto;
    color: #F0D384; filter: drop-shadow(0 0 18px rgba(240, 211, 132, .55));
  }
  .occ-lantern { position: absolute; display: block; color: #E8C56A; transform-origin: 50% 0; }
  .occ-lantern::before { content:''; position:absolute; left:50%; top:-14px; width:1px; height:16px; background:rgba(232,197,106,.5); }
  .occ-lantern svg { width: 100%; height: auto; filter: drop-shadow(0 0 10px rgba(232, 197, 106, .45)); }
  .occ-lantern--1 { left: 11%; top: 6px; width: 34px; }
  .occ-lantern--2 { left: 23%; top: 4px; width: 26px; opacity: .85; }
  .occ-skyline { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 42%; color: #041710; opacity: .85; }

  /* ---------- christmas ---------- */
  .occ-scene--christmas { --scene-accent: #E9C46A; --scene-display: 'Cormorant Garamond', var(--font-display); }
  .occ-topstar {
    position: absolute; right: 10%; top: 8%; width: clamp(34px, 6vw, 52px); height: auto;
    color: #E9C46A; filter: drop-shadow(0 0 14px rgba(233, 196, 106, .6));
  }
  .occ-treeline { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 46%; color: #05261B; }

  /* ---------- winter ---------- */
  .occ-scene--winter { --scene-accent: #DDEEF7; }
  .occ-range { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 52%; color: #1D4457; }

  /* ---------- snow ---------- */
  .occ-flake {
    position: absolute; top: -8%;
    width: var(--sz, 4px); height: var(--sz, 4px);
    border-radius: 50%; background: #fff; opacity: .85;
    animation-name: occ-fall; animation-timing-function: linear; animation-iteration-count: infinite;
  }
  .occ-flake--far { opacity: .45; }

  /* ---------- sahara ---------- */
  .occ-scene--sahara { --scene-accent: #FFDFA8; }
  .occ-sun {
    position: absolute; display: block; right: 14%; top: 30%;
    width: clamp(56px, 10vw, 92px); aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle, #FFE7B0 0%, #FFC978 45%, rgba(255, 176, 92, 0) 72%);
  }
  .occ-dune { position: absolute; left: 0; right: 0; width: 100%; }
  .occ-dune--back { bottom: 22%; height: 30%; color: #A85A28; opacity: .75; }
  .occ-dune--front { bottom: 0; height: 34%; color: #6E3417; }
  .occ-caravan { position: absolute; display: block; bottom: 41%; left: -20%; width: 132px; color: #4A2410; opacity: .85; }
  .occ-caravan svg { width: 100%; height: auto; }

  /* ---------- motion (only when the visitor allows it) ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .occ-star { animation: occ-twinkle 3.4s ease-in-out infinite; }
    .occ-moon { animation: occ-float 9s ease-in-out infinite; }
    .occ-topstar { animation: occ-pulse 4.5s ease-in-out infinite; }
    .occ-lantern--1 { animation: occ-sway 6s ease-in-out infinite; }
    .occ-lantern--2 { animation: occ-sway 7.5s ease-in-out infinite reverse; }
    .occ-sun { animation: occ-glow 7s ease-in-out infinite; }
    .occ-caravan { animation: occ-walk 46s linear infinite; }
  }
  /* snow only falls when motion is allowed; otherwise the flakes stay hidden */
  @media (prefers-reduced-motion: reduce) {
    .occ-flake { display: none; }
  }

  @keyframes occ-twinkle {
    0%, 100% { opacity: .2; transform: scale(.8); }
    50%      { opacity: 1;  transform: scale(1.25); }
  }
  @keyframes occ-float {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-8px); }
  }
  @keyframes occ-pulse {
    0%, 100% { opacity: .82; transform: scale(1); }
    50%      { opacity: 1;   transform: scale(1.08); }
  }
  @keyframes occ-sway {
    0%, 100% { transform: rotate(-5deg); }
    50%      { transform: rotate(5deg); }
  }
  @keyframes occ-glow {
    0%, 100% { transform: scale(1); opacity: .92; }
    50%      { transform: scale(1.06); opacity: 1; }
  }
  @keyframes occ-walk {
    from { transform: translateX(0); }
    to   { transform: translateX(760px); }
  }
  @keyframes occ-fall {
    from { transform: translateY(0) translateX(0); opacity: 0; }
    10%  { opacity: .9; }
    90%  { opacity: .9; }
    to   { transform: translateY(340px) translateX(26px); opacity: 0; }
  }

  @media (max-width: 640px) {
    .occ-scene { min-height: 240px; }
    .occ-lantern--2 { display: none; }
  }
  @media print {
    .occ-scene { min-height: 0; }
    .occ-art { display: none; }
    .occ-copy { background: none; color: inherit; }
    .occ-title { color: inherit; text-shadow: none; }
    .occ-note { color: inherit; }
  }
</style>
