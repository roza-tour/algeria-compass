---
export interface Props { faqs: { q: string; a: string }[]; }
const { faqs } = Astro.props;
const ld = {
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question", "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---
{faqs.length > 0 && (
  <section class="section" data-reveal>
    <div class="wrap">
      <h2 class="sec-h">Frequently asked questions</h2>
      <div class="faq">
        {faqs.map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} is:inline />
  </section>
)}
