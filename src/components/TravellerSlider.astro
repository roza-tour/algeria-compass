---
// L2 — "Real journeys, real travellers" AUTO-MARQUEE.
// Two rows of curated client photos scroll continuously in opposite directions
// and loop seamlessly (each row's set is duplicated), so the number of photos
// is never obvious. No arrows, no dots. Pauses on hover/focus; visitors who
// prefer reduced motion get a static, tidy grid instead. Photos are curated for
// quality + variety (incl. desert/Sahara) by scripts/curate-traveller-photos.mjs.
import slider from '../data/traveller-slider.json';
// Show 48 curated tiles (24 per row × 2 rows). The marquee duplicates each row
// for the seamless loop, so this renders 96 lazy tiles across two strips.
const photos = ((slider as any).slider as { src: string; w: number; h: number }[]).slice(0, 48);
const mid = Math.ceil(photos.length / 2);
const rowA = photos.slice(0, mid);
const rowB = photos.slice(mid);
// duplicate each row for a seamless -50% loop; duplicates are hidden from AT
const loopA = [...rowA, ...rowA];
const loopB = [...rowB, ...rowB];
---
<section class="tmq" aria-label="Photos from Algeria Compass travellers">
  <div class="wrap tmq-head">
    <div class="eyebrow">Moments from our trips</div>
    <h2>Real journeys, real travellers</h2>
    <p class="tmq-sub">Unscripted photographs from recent Algeria Compass guests — coast, cities and the deep Sahara. Every face here travelled with us.</p>
  </div>

  <div class="tmq-rows">
    <ul class="tmq-row tmq-left" role="list">
      {loopA.map((p, i) => (
        <li class="tmq-tile" aria-hidden={i >= rowA.length ? 'true' : undefined}>
          <picture>
            <source srcset={p.src.replace(/\.(jpe?g|png)$/i, '.sm.webp')} type="image/webp" />
            <img src={p.src} alt={i >= rowA.length ? '' : 'An Algeria Compass traveller on tour in Algeria'}
                 width={p.w} height={p.h} loading="lazy" decoding="async" />
          </picture>
        </li>
      ))}
    </ul>
    <ul class="tmq-row tmq-right" role="list">
      {loopB.map((p, i) => (
        <li class="tmq-tile" aria-hidden={i >= rowB.length ? 'true' : undefined}>
          <picture>
            <source srcset={p.src.replace(/\.(jpe?g|png)$/i, '.sm.webp')} type="image/webp" />
            <img src={p.src} alt={i >= rowB.length ? '' : 'Algeria Compass guests exploring Algeria'}
                 width={p.w} height={p.h} loading="lazy" decoding="async" />
          </picture>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .tmq{padding:2.4rem 0 2.8rem;background:#07261C;overflow:hidden;content-visibility:auto;contain-intrinsic-size:auto 520px}
  .tmq-head{text-align:center}
  .tmq .eyebrow{color:#E0BE73}
  .tmq h2{font-family:'Cinzel',serif;color:#fff;font-size:clamp(1.5rem,3vw,2.1rem);margin:.1rem 0 .4rem}
  .tmq-sub{color:rgba(255,255,255,.82);max-width:620px;margin:0 auto;line-height:1.6}
  .tmq-rows{margin-top:1.6rem;display:flex;flex-direction:column;gap:1rem;
    -webkit-mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent);
    mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent)}
  .tmq-row{list-style:none;display:flex;gap:1rem;width:max-content;margin:0;padding:0;will-change:transform}
  .tmq-left{animation:tmq-scroll-l 64s linear infinite}
  .tmq-right{animation:tmq-scroll-r 72s linear infinite}
  /* pause the whole marquee when a visitor hovers or tabs into it */
  .tmq:hover .tmq-row,.tmq:focus-within .tmq-row{animation-play-state:paused}
  /* film-strip: every tile is a fixed HEIGHT, native width — no cropping, so
     portrait and landscape phone shots both show in full */
  .tmq-tile{flex:0 0 auto;height:clamp(172px,24vw,224px);border-radius:14px;overflow:hidden;
    border:1px solid rgba(201,162,75,.28);box-shadow:0 8px 22px rgba(0,0,0,.3);background:#0c2c22}
  .tmq-tile img{height:100%;width:auto;display:block;transition:transform .4s ease}
  .tmq-tile:hover img{transform:scale(1.05)}
  @keyframes tmq-scroll-l{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  @keyframes tmq-scroll-r{from{transform:translateX(-50%)}to{transform:translateX(0)}}

  /* reduced motion: no scrolling — a tidy static grid of the real (non-dup) tiles */
  @media (prefers-reduced-motion: reduce){
    .tmq-rows{mask-image:none;-webkit-mask-image:none;gap:.8rem}
    .tmq-row{animation:none;width:auto;flex-wrap:wrap;justify-content:center}
    .tmq-row [aria-hidden="true"]{display:none}
    .tmq-tile{height:clamp(150px,32vw,188px)}
  }
</style>
