---
// L3/perf — Google Analytics 4 with Consent Mode v2 (GDPR), loaded LAZILY.
// The consent defaults + config are queued immediately (tiny inline JS), but the
// heavy gtag.js download is deferred until the first user interaction or browser
// idle — eliminating the render-blocking request, unused JS, and long tasks
// Lighthouse flagged. Analytics consent defaults to DENIED until the visitor
// accepts via <CookieConsent/>.
import { ANALYTICS } from '../config';
const { plausibleDomain, ga4 } = ANALYTICS;
---
{plausibleDomain && (
  <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.tagged-events.js" is:inline></script>
)}
{ga4 && (
  <script is:inline define:vars={{ ga4 }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    window.gtag = gtag;
    var __granted = false;
    try { __granted = localStorage.getItem('ac-consent') === 'granted'; } catch (e) {}
    gtag('consent', 'default', {
      ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
      analytics_storage: __granted ? 'granted' : 'denied',
      functionality_storage: 'granted', security_storage: 'granted', wait_for_update: 500
    });
    gtag('js', new Date());
    gtag('config', ga4, { anonymize_ip: true });

    // Defer the gtag.js download until the page is interactive/idle.
    var __ga_loaded = false;
    function __loadGA(){
      if (__ga_loaded) return; __ga_loaded = true;
      var s = document.createElement('script');
      s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4;
      document.head.appendChild(s);
    }
    // Load only on the FIRST real user interaction — keeps gtag.js (~65 KiB)
    // out of the initial/critical path entirely (and out of an idle Lighthouse run).
    ['scroll','click','keydown','pointerdown','touchstart'].forEach(function(ev){
      window.addEventListener(ev, __loadGA, { once: true, passive: true });
    });
  </script>
)}
{(plausibleDomain || ga4) && (
  <script is:inline>
    document.addEventListener('click',function(e){
      var t=e.target.closest('[data-evt]'); if(!t) return; var name=t.getAttribute('data-evt');
      if(window.plausible) window.plausible(name);
      if(window.gtag) window.gtag('event',name);
    });
    window.trackEvent=function(name){ if(window.plausible)window.plausible(name); if(window.gtag)window.gtag('event',name); };
  </script>
)}

<!-- First-party, cookieless behaviour tracker → /hit.php (feeds the private
     stats.php dashboard). No cookies, no IP, no persistent identifier: the
     session id lives in sessionStorage only, so it dies when the tab closes
     and can never follow anyone across sites or days. That is why this needs
     no consent and runs independently of the Google/consent block above.

     Three beacons per page at most — view, engaged (15s), exit (with dwell +
     scroll depth) — which keeps the log small while still answering "did they
     actually read it?" rather than just "did it load?". -->
<script is:inline>
  (function(){
    var SS = null;
    try { SS = window.sessionStorage; } catch(e){}
    var g = function(k){ try { return SS && SS.getItem(k); } catch(e){ return null; } };
    var s = function(k,v){ try { SS && SS.setItem(k,v); } catch(e){} };

    // Ephemeral, per-tab session id — never persisted, never sent anywhere else.
    var sid = g('ac_s');
    if (!sid) { sid = Math.random().toString(36).slice(2,10); s('ac_s', sid); }
    // First page of this session? (drives entry pages + bounce rate)
    var entry = g('ac_e') !== '1';
    if (entry) s('ac_e','1');

    var start = Date.now(), maxScroll = 0, closed = false;

    function ping(t, extra){
      try{
        var d = { t: t, p: location.pathname, s: sid };
        if (extra) for (var k in extra) d[k] = extra[k];
        var body = JSON.stringify(d);
        if (navigator.sendBeacon) navigator.sendBeacon('/hit.php', body);
        else fetch('/hit.php', { method:'POST', body: body, keepalive:true });
      }catch(e){}
    }

    // --- page view, with the context that makes it interpretable ---
    var w = window.innerWidth || 1024;
    var vw = w < 640 ? 'sm' : (w < 1024 ? 'md' : 'lg');
    var utm = '';
    try {
      var q = new URLSearchParams(location.search);
      utm = (q.get('utm_source') || q.get('utm_campaign') || q.get('ref') || '').slice(0,40);
    } catch(e){}
    ping(window.__AC_NF ? 'notfound' : 'view', { en: entry ? 1 : 0, vw: vw, utm: utm });

    // --- scroll depth (kept in memory, reported once on exit) ---
    window.addEventListener('scroll', function(){
      var doc = document.documentElement;
      var h = (doc.scrollHeight || 0) - (window.innerHeight || 0);
      if (h <= 0) return;
      var pc = Math.round((window.scrollY || doc.scrollTop || 0) / h * 100);
      if (pc > maxScroll) maxScroll = Math.min(100, pc);
    }, { passive: true });

    // --- engaged: still here after 15s and the tab is visible ---
    setTimeout(function(){ if (!document.hidden) ping('engaged'); }, 15000);

    // --- exit: how long they stayed and how far they read ---
    function bye(){
      if (closed) return; closed = true;
      var secs = Math.round((Date.now() - start) / 1000);
      if (secs > 0 && secs < 3600) ping('exit', { dw: secs, sd: maxScroll });
    }
    window.addEventListener('pagehide', bye);
    document.addEventListener('visibilitychange', function(){ if (document.hidden) bye(); });

    // --- clicks: tracked CTAs, plus which tour cards pull people in ---
    document.addEventListener('click', function(e){
      var el = e.target.closest('[data-evt]');
      if (el) ping(el.getAttribute('data-evt'));
      var a = e.target.closest('a[href]');
      if (a) {
        var href = a.getAttribute('href') || '';
        if (/^\/(tours|fr\/circuits|it\/circuiti|es\/circuitos|de\/reisen)\/[^/]+\/$/.test(href)) {
          ping('tour_click', { tp: href });
        }
      }
    });
  })();
</script>
