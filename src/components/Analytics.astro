---
// L3 — Google Analytics 4 with Google Consent Mode v2 (GDPR).
// Lives in <head>. Consent for analytics/ads defaults to DENIED, so GA loads in
// privacy-preserving consent mode (no analytics cookies) until the visitor
// accepts via the cookie banner (<CookieConsent/>, which calls consent 'update').
import { ANALYTICS } from '../config';
const { plausibleDomain, ga4 } = ANALYTICS;
---
{plausibleDomain && (
  <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.tagged-events.js" is:inline></script>
)}
{ga4 && (
  <>
    <!-- Consent Mode v2 defaults — must run BEFORE gtag config -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      window.gtag = gtag;
      var __ac = null;
      try { __ac = localStorage.getItem('ac-consent'); } catch (e) {}
      var __granted = __ac === 'granted';
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: __granted ? 'granted' : 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500
      });
      gtag('js', new Date());
    </script>
    <!-- Google tag (gtag.js) -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`} is:inline></script>
    <script is:inline define:vars={{ ga4 }}>
      gtag('config', ga4, { anonymize_ip: true });
    </script>
  </>
)}
{(plausibleDomain || ga4) && (
  <script is:inline>
    // Track tagged CTA/WhatsApp clicks + inquiry submissions in either provider.
    document.addEventListener('click',function(e){
      var t=e.target.closest('[data-evt]'); if(!t) return; var name=t.getAttribute('data-evt');
      if(window.plausible) window.plausible(name);
      if(window.gtag) window.gtag('event',name);
    });
    window.trackEvent=function(name){ if(window.plausible)window.plausible(name); if(window.gtag)window.gtag('event',name); };
  </script>
)}
