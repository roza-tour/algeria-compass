---
// Site-wide seasonal ambience — a single layer that sits BEHIND the page
// (position:fixed, z-index:0, pointer-events:none), so it can never touch
// layout, clicks, readability, or drift across a photograph.
//
// There used to be a second layer above the content so the particles were
// always visible. What that actually produced was plain glowing dots crossing
// every image on the site. It is gone. The ambience now lives only in the
// background, where transparent sections let it breathe, and the art is
// specific to the season rather than the same dot in a different colour:
//
// summer    — Mediterranean noon: a breathing sun, soft shafts of light, slow swells.
//             No particles — scattered dots read as noise, not as light.
// spring    — petals drifting on a breeze
// autumn    — leaves turning as they fall
// winter    — snow, small and soft
// christmas — snow plus warm gold star-sparkle
// ramadan   — a night sky: stars twinkling at their own pace, one crescent glow
// eid       — the same night, warmer and more festive
// yennayer  — Amazigh teal shimmer
//
// The season is decided at build time (src/lib/season.ts) and re-checked in the
// browser, so a page cached across a season boundary still corrects itself.
// Everything freezes under prefers-reduced-motion.
import { seasonForDate, upcomingWindows } from '../lib/season';

const now = new Date();
// SEASON_PREVIEW=winter npm run build  — forces a season so you can see any
// occasion without waiting for the calendar. Unset = real date (normal builds).
const preview = (import.meta.env.SEASON_PREVIEW as string) || '';
const season = preview || seasonForDate(now);
// ~18 months of upcoming windows, so a cached page can re-resolve itself.
const schedule = upcomingWindows(now, 18).map(w => [w.from, w.to, w.season]);

// Deterministic tables (no RNG — builds stay byte-stable).
// FALLING: [left %, duration s, delay s, scale]
const FALLING = [
  [4, 19, 0, 1], [11, 15, 3, .8], [18, 22, 6, 1.1], [25, 17, 1, .7], [32, 20, 4, 1],
  [39, 16, 8, .9], [46, 23, 2, 1.2], [53, 18, 5, .75], [60, 15, 9, 1], [67, 21, 0, .85],
  [74, 17, 6, 1.1], [81, 19, 3, .7], [88, 16, 7, 1], [95, 20, 1, .9],
  [8, 24, 5, .8], [22, 18, 10, 1], [43, 22, 7, .75], [58, 17, 12, 1.05],
  [72, 20, 4, .9], [86, 23, 9, .8],
];
// STARS: [left %, top %, delay s, period s, size px]
const STARS = [
  [7, 12, 0, 4.4, 2], [16, 6, 1.6, 5.2, 3], [24, 19, 3.1, 4, 2], [33, 9, .7, 6, 2.5],
  [41, 16, 2.4, 4.8, 2], [52, 5, 4, 5.6, 3], [61, 21, 1.2, 4.2, 2],
  [69, 11, 3.6, 6.4, 2.5], [78, 24, 2, 4.6, 2], [87, 8, 4.4, 5, 3], [94, 17, 1, 5.8, 2],
  [12, 28, 2.8, 4.4, 2], [46, 30, 3.9, 6.2, 2.5], [83, 32, 1.9, 5.4, 2],
  [29, 38, 4.6, 5, 2], [58, 41, 2.2, 6, 2], [74, 36, 3.3, 4.8, 2.5], [95, 44, 1.5, 5.6, 2],
];

const isNight = season === 'ramadan' || season === 'eid' || season === 'mawlid'
             || season === 'yennayer' || season === 'national';
---
<div class="amb" data-season={season} data-preview={preview || undefined} aria-hidden="true">
  {(season === 'winter' || season === 'christmas') && (
    <div class="amb-layer">
      {FALLING.map(([l, dur, dl, sc]) => (
        <span class="amb-flake" style={`left:${l}%;animation-duration:${dur}s;animation-delay:${dl}s;--sc:${sc}`}></span>
      ))}
    </div>
  )}

  {season === 'christmas' && (
    <div class="amb-layer">
      {STARS.slice(0, 10).map(([l, t, dl, per, sz]) => (
        <span class="amb-spark" style={`left:${l}%;top:${t}%;animation-delay:${dl}s;animation-duration:${per}s;width:${sz + 1}px;height:${sz + 1}px`}></span>
      ))}
    </div>
  )}

  {season === 'summer' && (
    <>
      <span class="amb-shaft amb-shaft--1"></span>
      <span class="amb-shaft amb-shaft--2"></span>
      <span class="amb-shaft amb-shaft--3"></span>
      <span class="amb-sun"></span>
      <div class="amb-layer amb-sea">
        <span class="amb-swell amb-swell--1"></span>
        <span class="amb-swell amb-swell--2"></span>
        <span class="amb-swell amb-swell--3"></span>
        <span class="amb-shimmer"></span>
      </div>
    </>
  )}

  {season === 'spring' && (
    <div class="amb-layer">
      {FALLING.map(([l, dur, dl, sc]) => (
        <span class="amb-petal" style={`left:${l}%;animation-duration:${dur + 6}s;animation-delay:${dl}s;--sc:${sc}`}></span>
      ))}
    </div>
  )}

  {season === 'autumn' && (
    <div class="amb-layer">
      {FALLING.map(([l, dur, dl, sc]) => (
        <span class="amb-leaf" style={`left:${l}%;animation-duration:${dur + 4}s;animation-delay:${dl}s;--sc:${sc}`}></span>
      ))}
    </div>
  )}

  {isNight && (
    <>
      <div class="amb-layer">
        {STARS.map(([l, t, dl, per, sz]) => (
          <span class="amb-star" style={`left:${l}%;top:${t}%;animation-delay:${dl}s;animation-duration:${per}s;width:${sz}px;height:${sz}px`}></span>
        ))}
      </div>
      <span class="amb-glow"></span>
    </>
  )}
</div>

<script is:inline define:vars={{ windows: schedule }}>
  /* A page can be cached for weeks. Re-resolve the season client-side and, if it
     no longer matches what was baked in, correct the attribute so the ambience
     is never out of step with the calendar. The art for the new season only
     appears on the next build, but the wash/colour follows immediately. */
  (function () {
    var el = document.querySelector('.amb');
    if (!el) return;
    if (el.dataset.preview) return;   // a forced preview build: leave it alone
    var d = new Date(), iso = d.toISOString().slice(0, 10), s = null;
    for (var i = 0; i < windows.length; i++) {
      if (iso >= windows[i][0] && iso < windows[i][1]) { s = windows[i][2]; break; }
    }
    if (!s) {
      var m = d.getMonth();
      s = (m >= 2 && m <= 4) ? 'spring' : (m >= 5 && m <= 7) ? 'summer' : (m >= 8 && m <= 10) ? 'autumn' : 'winter';
    }
    if (el.getAttribute('data-season') !== s) el.setAttribute('data-season', s);
    if (document.documentElement.getAttribute('data-season') !== s)
      document.documentElement.setAttribute('data-season', s);
  })();
</script>

<style is:global>
  /* Lift the page above the fixed ambience layer. Sections that set their own
     background stay opaque (the ambience simply does not show through them);
     transparent sections let it breathe behind the text. */
  main, footer { position: relative; z-index: 1; }
</style>

<style>
  /* One layer, behind the page, inert. Nothing here is ever drawn over content. */
  .amb {
    position: fixed; inset: 0;
    z-index: 0;
    pointer-events: none; overflow: hidden; contain: strict;
  }
  .amb-layer { position: absolute; inset: 0; }

  /* A very light seasonal wash over the page background. Kept low enough that
     body-text contrast is untouched. */
  .amb[data-season='spring'] { background: linear-gradient(180deg, rgba(122,168,109,.14), rgba(122,168,109,.05) 45%, rgba(122,168,109,.07)); }
  /* Summer reads warm, not blue: golden light from above, sand through the
     middle, and only the last stretch before the swells hints at the sea. */
  .amb[data-season='summer'] { background: linear-gradient(180deg, rgba(255,202,104,.20), rgba(246,208,140,.07) 46%, rgba(238,196,120,.05) 72%, rgba(46,158,152,.09)); }
  .amb[data-season='autumn'] { background: linear-gradient(180deg, rgba(198,124,48,.16), rgba(198,124,48,.05) 45%, rgba(160,96,36,.08)); }
  .amb[data-season='winter'] { background: linear-gradient(180deg, rgba(120,166,196,.16), rgba(120,166,196,.05) 45%, rgba(96,146,182,.09)); }
  .amb[data-season='christmas'] { background: linear-gradient(180deg, rgba(160,132,58,.16), rgba(140,120,60,.05) 45%, rgba(120,40,36,.07)); }
  .amb[data-season='ramadan'] { background: radial-gradient(90% 55% at 78% 6%, rgba(201,162,39,.20), transparent 62%), linear-gradient(180deg, rgba(8,44,34,.10), rgba(8,44,34,.06)); }
  .amb[data-season='eid'] { background: radial-gradient(90% 55% at 78% 6%, rgba(232,197,106,.24), transparent 64%), linear-gradient(180deg, rgba(8,44,34,.09), rgba(8,44,34,.05)); }
  .amb[data-season='mawlid'] { background: radial-gradient(90% 55% at 78% 6%, rgba(160,190,150,.18), transparent 62%), linear-gradient(180deg, rgba(8,44,34,.09), rgba(8,44,34,.05)); }
  .amb[data-season='yennayer'] { background: radial-gradient(90% 55% at 78% 6%, rgba(30,140,140,.20), transparent 62%), linear-gradient(180deg, rgba(16,92,92,.10), rgba(16,92,92,.06)); }
  .amb[data-season='national'] { background: linear-gradient(180deg, rgba(11,61,46,.14), rgba(11,61,46,.06) 45%, rgba(11,61,46,.08)); }

  /* ---------- snow: small, soft, no hard glow ---------- */
  .amb-flake {
    position: absolute; top: -8vh; width: 7px; height: 7px; border-radius: 50%;
    background: rgba(255, 255, 255, .95);
    box-shadow: 0 0 7px rgba(190, 222, 240, .85);
    animation-name: amb-fall; animation-timing-function: linear; animation-iteration-count: infinite;
  }
  .amb[data-season='christmas'] .amb-flake { background: rgba(255, 250, 238, .9); }

  /* ---------- summer: Mediterranean noon ----------
     One warm sun that slowly breathes, three soft shafts of light leaning the
     way afternoon light falls through a window, and the sea kept to the foot
     of the page. Light is continuous — nothing is scattered, nothing travels. */
  .amb-sun {
    position: absolute; right: 4%; top: 3%;
    width: clamp(200px, 30vw, 420px); aspect-ratio: 1; border-radius: 50%;
    background:
      radial-gradient(circle, rgba(255, 236, 178, .5) 0%, rgba(255, 210, 118, .26) 30%, rgba(255, 190, 92, .10) 55%, transparent 72%);
    animation: amb-breathe 14s ease-in-out infinite;
  }
  .amb-shaft {
    position: absolute; top: -12%; height: 120%; width: clamp(60px, 9vw, 130px);
    background: linear-gradient(180deg, rgba(255, 220, 140, .16), rgba(255, 210, 120, .05) 55%, transparent 82%);
    transform: rotate(14deg); transform-origin: top center;
    filter: blur(14px);
    animation: amb-shaft 17s ease-in-out infinite;
  }
  .amb-shaft--1 { right: 12%; }
  .amb-shaft--2 { right: 26%; width: clamp(40px, 6vw, 90px); opacity: .8; animation-duration: 23s; animation-delay: -6s; }
  .amb-shaft--3 { right: 40%; width: clamp(28px, 4vw, 60px); opacity: .55; animation-duration: 29s; animation-delay: -12s; }
  .amb-sea { top: auto; bottom: 0; height: 30vh; }
  .amb-swell {
    position: absolute; left: -20%; right: -20%; height: 120px; border-radius: 50%;
    background: radial-gradient(60% 100% at 50% 100%, rgba(30, 140, 140, .16), transparent 70%);
  }
  .amb-swell--1 { bottom: -60px; animation: amb-swell 15s ease-in-out infinite; }
  .amb-swell--2 { bottom: -34px; opacity: .75; animation: amb-swell 21s ease-in-out infinite reverse; }
  .amb-swell--3 { bottom: -10px; opacity: .5;  animation: amb-swell 27s ease-in-out infinite; }
  /* One warm band where sun meets water — a single reflection, not confetti. */
  .amb-shimmer {
    position: absolute; left: 8%; right: 8%; bottom: 7vh; height: 3px; border-radius: 3px;
    background: linear-gradient(90deg, transparent, rgba(255, 216, 140, .35) 30%, rgba(255, 228, 160, .5) 50%, rgba(255, 216, 140, .35) 70%, transparent);
    filter: blur(1px);
    animation: amb-shimmer 9s ease-in-out infinite;
  }

  /* ---------- spring petals ---------- */
  .amb-petal {
    position: absolute; top: -8vh; width: 9px; height: 7px;
    border-radius: 60% 40% 55% 45%;
    background: rgba(226, 150, 168, .62);
    animation-name: amb-drift-fall; animation-timing-function: linear; animation-iteration-count: infinite;
  }

  /* ---------- autumn leaves ---------- */
  .amb-leaf {
    position: absolute; top: -8vh; width: 10px; height: 8px;
    border-radius: 70% 30% 65% 35%;
    background: rgba(184, 100, 34, .58);
    animation-name: amb-drift-fall; animation-timing-function: linear; animation-iteration-count: infinite;
  }

  /* ---------- night sky ----------
     Each star twinkles on its own period so the field never pulses in unison. */
  .amb-star, .amb-spark {
    position: absolute; border-radius: 50%;
    background: #F4E3AE; opacity: .25;
    box-shadow: 0 0 7px rgba(244, 227, 174, .85), 0 0 2px rgba(255, 255, 255, .9);
    animation-name: amb-twinkle; animation-timing-function: ease-in-out; animation-iteration-count: infinite;
  }
  .amb[data-season='eid'] .amb-star      { background: #FFF0C4; }
  .amb[data-season='yennayer'] .amb-star { background: #BFEDE6; box-shadow: 0 0 7px rgba(140, 226, 216, .8); }
  .amb[data-season='mawlid'] .amb-star   { background: #E4F0DC; }
  .amb[data-season='national'] .amb-star { background: #EAF6EE; }
  .amb-spark { background: #FFE9B8; box-shadow: 0 0 9px rgba(255, 214, 130, .9); }

  .amb-glow {
    position: absolute; right: 7%; top: 4%;
    width: clamp(90px, 13vw, 190px); aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle, rgba(240, 211, 132, .22) 0%, transparent 68%);
    animation: amb-breathe 11s ease-in-out infinite;
  }
  .amb[data-season='yennayer'] .amb-glow { background: radial-gradient(circle, rgba(30,140,140,.22) 0%, transparent 68%); }
  .amb[data-season='mawlid'] .amb-glow   { background: radial-gradient(circle, rgba(190,214,178,.2) 0%, transparent 68%); }
  .amb[data-season='national'] .amb-glow { background: radial-gradient(circle, rgba(255,255,255,.16) 0%, transparent 68%); }

  /* --sc carries the per-particle scale so it composes with the animation's
     own transform instead of being overwritten by it. */
  @keyframes amb-fall {
    from { transform: translateY(0) translateX(0) scale(var(--sc, 1)); opacity: 0; }
    10%  { opacity: .7; }
    90%  { opacity: .7; }
    to   { transform: translateY(114vh) translateX(36px) scale(var(--sc, 1)); opacity: 0; }
  }
  @keyframes amb-drift-fall {
    from { transform: translateY(0) translateX(0) rotate(0deg) scale(var(--sc, 1)); opacity: 0; }
    10%  { opacity: .78; }
    90%  { opacity: .78; }
    to   { transform: translateY(114vh) translateX(90px) rotate(320deg) scale(var(--sc, 1)); opacity: 0; }
  }
  @keyframes amb-shaft {
    0%, 100% { opacity: .55; transform: rotate(14deg); }
    50%      { opacity: 1;   transform: rotate(12.5deg); }
  }
  @keyframes amb-shimmer {
    0%, 100% { opacity: .35; transform: scaleX(.96); }
    50%      { opacity: .8;  transform: scaleX(1); }
  }
  @keyframes amb-swell {
    0%, 100% { transform: translateY(0) scaleX(1); }
    50%      { transform: translateY(-14px) scaleX(1.06); }
  }
  @keyframes amb-twinkle {
    0%, 100% { opacity: .3; }
    50%      { opacity: 1; }
  }
  @keyframes amb-breathe {
    0%, 100% { opacity: .75; transform: scale(1); }
    50%      { opacity: 1;   transform: scale(1.08); }
  }

  /* Phones: thin the field to roughly half; drop the sea and the narrow
     shafts (small screens keep the sun and the widest shaft only). */
  @media (max-width: 640px) {
    .amb-flake:nth-child(odd), .amb-petal:nth-child(odd),
    .amb-leaf:nth-child(odd),
    .amb-star:nth-child(3n) { display: none; }
    .amb-sea { display: none; }
    .amb-shaft--2, .amb-shaft--3 { display: none; }
  }

  /* Motion is decoration: if the visitor asks for less, the layer holds still. */
  @media (prefers-reduced-motion: reduce) {
    .amb * { animation: none !important; }
    .amb-star, .amb-spark { opacity: .35; }
    .amb-shaft { opacity: .7; }
  }

  @media print { .amb { display: none !important; } }
</style>
