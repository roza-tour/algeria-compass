---
// Linked JSON-LD graph. Country is a real @id entity; WebSite carries a sitelinks
// SearchAction wired to the real /search/ endpoint (P8).
import { CONTACT } from '../config';
export interface Props { nodes?: any[]; }
const { nodes = [] } = Astro.props;
const site = (Astro.site?.toString() || 'https://algeriacompass.com').replace(/\/$/, '');
const A = CONTACT.address;
// Organization `sameAs` — the brand's real, owner-confirmed social profiles.
const SAMEAS: string[] = [
  "https://www.instagram.com/algeria_compass/",
  "https://www.facebook.com/profile.php?id=61590718167514",
];
const org: any = {
  "@type": "TravelAgency",
  "@id": site + "/#organization",
  "name": "Algeria Compass",
  "description": "Algeria Compass is a licensed Algerian tour operator specialising in luxury private, guided tours across Algeria — Sahara safaris, the UNESCO Casbah of Algiers, Roman cities, the M'Zab Valley and the Kabyle coast.",
  "slogan": "Luxury private guided tours across Algeria.",
  "url": site + "/",
  "logo": site + "/assets/img/logo-full.png",
  "image": site + "/assets/img/og-image.png",
  "email": CONTACT.email,
  "telephone": CONTACT.phoneE164,
  "priceRange": "€30–€2,290 per person",
  "currenciesAccepted": "EUR",
  "address": { "@type": "PostalAddress", "streetAddress": A.street, "addressLocality": A.locality, "addressRegion": A.region, "postalCode": A.postalCode, "addressCountry": A.countryCode },
  "geo": { "@type": "GeoCoordinates", "latitude": CONTACT.geo.lat, "longitude": CONTACT.geo.lng },
  "hasMap": CONTACT.mapShort,
  "areaServed": [{ "@id": site + "/#algeria" }],
  "audience": { "@type": "Audience", "audienceType": "International leisure travellers" },
  "knowsLanguage": ["en","fr","ar"],
  "knowsAbout": ["Algeria travel","Sahara desert","UNESCO World Heritage Algeria","Roman Algeria","Amazigh culture","M'Zab Valley"],
  "publishingPrinciples": site + "/editorial/editorial-policy/",
  "actionableFeedbackPolicy": site + "/editorial/corrections-policy/",
  "ethicsPolicy": site + "/editorial/transparency-policy/",
  "subOrganization": [{ "@id": site + "/#editorial-team" }, { "@id": site + "/#editorial-review" }],
  "contactPoint": { "@type": "ContactPoint", "telephone": CONTACT.phoneE164, "email": CONTACT.email, "contactType": "customer service", "availableLanguage": ["English","French","Arabic"], "areaServed": "Worldwide" }
};
if (SAMEAS.length) org.sameAs = SAMEAS;
const country = {
  "@type": "Country",
  "@id": site + "/#algeria",
  "name": "Algeria",
  "alternateName": "People's Democratic Republic of Algeria",
  "sameAs": ["https://en.wikipedia.org/wiki/Algeria","https://www.wikidata.org/wiki/Q262"]
};
const website = {
  "@type": "WebSite",
  "@id": site + "/#website",
  "url": site + "/",
  "name": "Algeria Compass",
  "alternateName": "Luxury private guided tours across Algeria",
  "description": "Luxury private guided tours across Algeria.",
  "publisher": { "@id": site + "/#organization" },
  "inLanguage": "en",
  "potentialAction": {
    "@type": "SearchAction",
    "target": { "@type": "EntryPoint", "urlTemplate": site + "/search/?q={search_term_string}" },
    "query-input": "required name=search_term_string"
  }
};
const graph = { "@context": "https://schema.org", "@graph": [org, country, website, ...nodes] };
---
<script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />
