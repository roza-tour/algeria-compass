---
export interface Stat { value: string; label: string; }
export interface Props { stats: Stat[]; }
const { stats } = Astro.props;
---
{stats.length > 0 && (
  <div class="ai-block stat-row">{stats.map(s => (
    <div class="stat"><span class="stat-v">{s.value}</span><span class="stat-l">{s.label}</span></div>
  ))}</div>
)}
