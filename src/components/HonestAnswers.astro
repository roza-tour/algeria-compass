---
// Phase E — "Honest Answers" homepage trust section.
// Disarms a hesitant traveller: real trust badges (no invented ratings/years —
// those are clearly-marked owner placeholders) + a categorised objection
// accordion condensed from the full FAQ, linking to /questions/.

const badges = [
  { icon: '🛡', label: 'Licensed Algerian operator' },
  { icon: '🛂', label: 'Visa support included' },
  { icon: '🧭', label: 'Local Algerian guides' },
  { icon: '💬', label: 'Arabic · Tamazight · French · English' },
];

// OWNER PLACEHOLDERS — do NOT publish invented numbers. Fill these in and they
// become live badges; until then they render as obvious "to add" chips.
const placeholders = [
  { label: 'Independent rating', hint: 'add platform + score' },
  { label: 'Years in operation', hint: 'add founding year' },
  { label: 'Travellers hosted', hint: 'add a real figure' },
];

const cats = [
  { title: 'Safety & welcome', items: [
    { q: 'Is Algeria actually safe to visit?', a: 'Yes. The north — Algiers, the coast, the Roman cities, Kabylie — is calm, and Algerians are famously hospitable to the few foreigners who come. You take the ordinary precautions of any new country. The deep south and borders are restricted, and we only travel them with permits and licensed guides.' },
    { q: 'Will I actually be welcome as a foreign tourist?', a: 'More than welcome. Algeria sees a tiny fraction of its neighbours’ visitors, so you arrive as a guest, not a number — expect curiosity, invitations to tea, and very little hassle.' },
    { q: 'Is it safe for solo and women travellers?', a: 'Generally yes, with modest dress and normal awareness; serious harassment is uncommon. Travelling privately with a local guide removes most of the friction women tell us they worry about.' },
  ]},
  { title: 'Visa & entry', items: [
    { q: 'Do I need a visa, and is it hard?', a: 'Most nationalities need a tourist visa from an Algerian consulate before travel — and consulates require an invitation letter from a licensed Algerian agency. That is exactly the part we handle for you, free, with every booking.' },
    { q: 'Is there an e-visa or visa on arrival?', a: 'Not for ordinary tourism. The main exception is organised Sahara tourism entered via the south, where a simplified group entry can be arranged. We tell you honestly which route applies — and never promise what the rules don’t allow.' },
  ]},
  { title: 'Why Algeria feels “hard” — and how we remove it', items: [
    { q: 'Why does planning Algeria feel so difficult?', a: 'Because information is thin, English is patchy, the desert needs permits, and you can’t just book everything online. That gap is the whole reason we exist: one licensed operator handling visa paperwork, permits, flights, guides and logistics so you don’t stitch it together yourself.' },
    { q: 'Can’t I just do it independently?', a: 'In the north, with patience, yes — and we’ll say so. The Sahara, no: protected zones legally require a licensed operator, a 4x4 and permits. We’re upfront about where you need us and where you don’t.' },
    { q: 'What if something goes wrong on the ground?', a: 'You have a named local team and guide for the whole trip, reachable on WhatsApp. Nothing is “confirmed” until availability, transport and permits are actually checked — so what we promise is real.' },
  ]},
  { title: 'Money, language & daily life', items: [
    { q: 'Can I pay by card, or is it cash?', a: 'Algeria runs on cash. Cards work in a few city hotels and foreign-card ATMs are unreliable, so bring euros or dollars to exchange on arrival. We’ll tell you roughly how much to carry.' },
    { q: 'What languages will I get by in?', a: 'Arabic and Tamazight are everyday, French is widely spoken, English less so outside tourism. Our guides bridge the gap in all four.' },
    { q: 'What’s daily life like for a visitor?', a: 'Relaxed, social and a little improvised. SIM cards are cheap, cities have wifi, the desert is gloriously off-grid — and you should stick to bottled water.' },
  ]},
  { title: 'What to see & how long', items: [
    { q: 'How long do I really need?', a: 'A long weekend covers Algiers and the Roman coast. A week adds the M’Zab Valley or a Sahara leg. Ten days lets you cross from the Mediterranean to the dunes. Every tour page lists exactly what’s included.' },
    { q: 'First trip — where should I go?', a: 'Most first-timers love the mix of the UNESCO Casbah of Algiers, the Roman cities (Tipaza, Djémila, Timgad) and a few nights of Sahara at Djanet or Timimoun. We tailor it to your dates and pace.' },
    { q: 'When should I come?', a: 'Spring and autumn for the north; November to February for the Sahara. We plan around the seasons and Ramadan so the trip actually works.' },
  ]},
  { title: 'Why we’re legitimate', items: [
    { q: 'Who are Algeria Compass, exactly?', a: 'A licensed Algerian tour operator, run by locals, specialising only in Algeria — not a reseller bolting Algeria onto a global catalogue. The visa paperwork we issue is the kind consulates accept.' },
    { q: 'Why trust you over a random online listing?', a: 'Because we put our licence, our local guides and our real itineraries and prices in front of you, we confirm every trip by hand, and we’d rather tell you a hard truth than oversell. Independent ratings and traveller numbers will appear in the badges above once verified.' },
  ]},
];
---
<section class="section ha"><div class="wrap">
  <div class="ha-intro">
    <div class="eyebrow">Honest Answers</div>
    <h2>Curious about Algeria — but not sure who to trust?</h2>
    <p class="ha-sub">Fair. Here are straight answers to the questions that actually keep people from booking — no spin, no invented reviews.</p>
  </div>

  <div class="ha-badges" aria-label="What we can honestly promise">
    {badges.map(b => <span class="ha-badge"><span class="ha-ic" aria-hidden="true">{b.icon}</span>{b.label}</span>)}
    {/* OWNER: fill these in (see component) — they are placeholders, not claims */}
    {placeholders.map(p => <span class="ha-badge is-ph" title="Placeholder for the owner to confirm"><span class="ha-ic" aria-hidden="true">＋</span>{p.label}<em>{p.hint}</em></span>)}
  </div>

  <div class="ha-cats">
    {cats.map(c => (
      <div class="ha-cat">
        <h3>{c.title}</h3>
        <div class="faq">
          {c.items.map(i => <details><summary>{i.q}</summary><p>{i.a}</p></details>)}
        </div>
      </div>
    ))}
  </div>

  <p class="ha-foot">
    <a class="btn" href="/questions/">All travel questions &rarr;</a>
    <a class="btn btn-ghost" href="/contact/">Ask us anything &rarr;</a>
  </p>
</div></section>

<style>
  .ha{background:linear-gradient(180deg,#0B3D2E,#07261C);color:#fff}
  .ha .eyebrow{color:var(--gold-l)}
  .ha-intro{max-width:760px}
  .ha h2{color:#fff;font-size:clamp(1.5rem,3.2vw,2.2rem)}
  .ha-sub{color:rgba(255,255,255,.82);margin-top:.5rem;font-size:1.05rem}
  .ha-badges{display:flex;flex-wrap:wrap;gap:.6rem;margin:1.4rem 0 .4rem}
  .ha-badge{display:inline-flex;align-items:center;gap:.45rem;padding:.5rem .9rem;border-radius:999px;
    background:rgba(255,255,255,.08);border:1px solid rgba(201,162,75,.35);font-size:.85rem;font-weight:700;color:#fff}
  .ha-ic{font-size:.95rem}
  .ha-badge.is-ph{background:transparent;border:1px dashed rgba(255,255,255,.35);color:rgba(255,255,255,.6);font-weight:600}
  .ha-badge.is-ph em{font-style:normal;font-size:.7rem;opacity:.7;font-weight:500;margin-left:.1rem}
  .ha-cats{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1.2rem 2rem;margin-top:1.6rem}
  .ha-cat h3{font-size:.78rem;text-transform:uppercase;letter-spacing:.1em;color:var(--gold-l);
    border-bottom:1px solid rgba(201,162,75,.3);padding-bottom:.5rem;margin-bottom:.3rem}
  .ha .faq details{border-bottom:1px solid rgba(255,255,255,.12);padding:.7rem 0}
  .ha .faq summary{font-weight:700;color:#fff;cursor:pointer;list-style:none;position:relative;padding-right:1.4rem}
  .ha .faq summary::-webkit-details-marker{display:none}
  .ha .faq summary::after{content:"+";position:absolute;right:0;top:-.05rem;color:var(--gold-l);font-weight:700;font-size:1.1rem}
  .ha .faq details[open] summary::after{content:"–"}
  .ha .faq p{color:rgba(255,255,255,.8);margin-top:.5rem;font-size:.92rem}
  .ha-foot{margin-top:1.8rem;display:flex;gap:.7rem;flex-wrap:wrap}
  .ha-foot .btn-ghost{color:#fff;border-color:rgba(255,255,255,.4)}
</style>
