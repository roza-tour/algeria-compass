---
export interface Props { title: string; eyebrow?: string; text?: string; image: string; alt: string; }
const { title, eyebrow, text, image, alt } = Astro.props;
---
<section class="hero">
  <img src={image} alt={alt} fetchpriority="high" width="1200" height="630" />
  <div class="hero-in wrap">
    {eyebrow && <div class="eyebrow">{eyebrow}</div>}
    <h1>{title}</h1>
    {text && <p>{text}</p>}
    <slot />
  </div>
</section>
