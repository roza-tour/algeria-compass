---
// Interactive map of Algeria: every place our tours visit, sized by how many
// trips go there. Tap a place → the trips that visit it, in the reader's
// language, with price and a link. Pure SVG + a few lines of JS (no map
// library, no tiles, nothing third-party). Border: Natural Earth 1:50m
// (public domain), src/data/algeria-outline.json.
import outline from '../data/algeria-outline.json';
import data from '../data/tours.json';
import { TOURS_FR } from '../data/tours-fr';
import { TOURS_IT } from '../data/tours-it';
import { TOURS_ES } from '../data/tours-es';
import { TOURS_DE } from '../data/tours-de';
import { ROUTES, asLang } from '../i18n';

interface Props { lang?: string }
const lang = asLang(Astro.props.lang);
const LOCAL: Record<string, any> = { fr: TOURS_FR, it: TOURS_IT, es: TOURS_ES, de: TOURS_DE };

// Projection: plain equirectangular, x squeezed by cos(28°) so the country
// keeps its real proportions at Algeria's mid latitude.
const K = 20, COS = Math.cos(28 * Math.PI / 180), MINLON = -9, MAXLAT = 37.6;
const px = (lon: number) => +((lon - MINLON) * COS * K).toFixed(1);
const py = (lat: number) => +((MAXLAT - lat) * K).toFixed(1);
const ring = (outline as any).coordinates[0] as [number, number][];
const d = 'M' + ring.map(([lo, la]) => `${px(lo)},${py(la)}`).join('L') + 'Z';
const W = px(12.2), H = py(18.8);

// Places, and which tour regions (tours.json `wilayas`) belong to each.
const NAMES: Record<string, Record<string, string>> = {
  algiers: { en: 'Algiers', fr: 'Alger', it: 'Algeri', es: 'Argel', de: 'Algier' },
  constantine: { en: 'Constantine', fr: 'Constantine', it: 'Costantina', es: 'Constantina', de: 'Constantine' },
  timgad: { en: 'Timgad & the Aurès', fr: 'Timgad et les Aurès', it: 'Timgad e l\'Aurès', es: 'Timgad y el Aurés', de: 'Timgad & Aurès' },
  djemila: { en: 'Djémila & Sétif', fr: 'Djémila et Sétif', it: 'Djémila e Sétif', es: 'Djémila y Sétif', de: 'Djémila & Sétif' },
  djanet: { en: 'Djanet & the Tassili', fr: 'Djanet et le Tassili', it: 'Djanet e il Tassili', es: 'Djanet y el Tassili', de: 'Djanet & Tassili' },
  ghardaia: { en: "Ghardaïa & the M'Zab", fr: "Ghardaïa et le M'Zab", it: "Ghardaïa e il M'Zab", es: "Ghardaïa y el M'Zab", de: "Ghardaïa & M'Zab" },
};
const PLACES: { id: string; name: string; lat: number; lon: number; w: string[]; img: string }[] = [
  { id: 'algiers', lat: 36.75, lon: 3.06, w: ['algiers'], img: 'algiers-18.jpg' },
  { id: 'tipaza', lat: 36.59, lon: 2.3, w: ['tipaza'], img: 'tipaza-7.jpg' },
  { id: 'bejaia', lat: 36.75, lon: 5.08, w: ['bejaia'], img: 'bejaia-1.jpg' },
  { id: 'djemila', lat: 36.32, lon: 5.74, w: ['setif', 'djemila'], img: 'djemila-3.jpg' },
  { id: 'constantine', lat: 36.36, lon: 6.61, w: ['constantine'], img: 'constantine-14.jpg' },
  { id: 'annaba', lat: 36.9, lon: 7.77, w: ['annaba'], img: '' },
  { id: 'timgad', lat: 35.49, lon: 6.47, w: ['batna-timgad', 'batna'], img: 'batna-timgad-14.jpg' },
  { id: 'bousaada', lat: 35.21, lon: 4.18, w: ['bousaada'], img: 'bousaada-4.jpg' },
  { id: 'oran', lat: 35.7, lon: -0.63, w: ['oran'], img: 'oran-1.jpg' },
  { id: 'mostaganem', lat: 35.93, lon: 0.09, w: ['mostaganem'], img: 'mostaganem-1.jpg' },
  { id: 'tlemcen', lat: 34.88, lon: -1.32, w: ['tlemcen'], img: 'tlemcen-6.jpg' },
  { id: 'ghardaia', lat: 32.49, lon: 3.67, w: ['ghardaia'], img: 'ghardaia-6.jpg' },
  { id: 'timimoun', lat: 29.26, lon: 0.23, w: ['timimoun'], img: 'timimoun-2.jpg' },
  { id: 'djanet', lat: 24.55, lon: 9.48, w: ['djanet', 'illizi'], img: 'djanet-21.jpg' },
].map(p => ({ ...p, name: NAMES[p.id]?.[lang] ?? ({ tipaza: 'Tipaza', bejaia: 'Béjaïa', annaba: 'Annaba', bousaada: 'Bou Saâda', oran: lang === 'it' ? 'Orano' : lang === 'es' ? 'Orán' : 'Oran', mostaganem: 'Mostaganem', tlemcen: 'Tlemcen', timimoun: 'Timimoun' } as any)[p.id] }));

const tours = (((data as any).tours || data) as any[]).map(t => {
  const loc = lang === 'en' ? null : LOCAL[lang]?.[t.id];
  const tr = !!loc?.full;
  return { id: t.id, w: t.wilayas || [], href: tr ? `${ROUTES[lang].tours}${t.id}/` : `/tours/${t.id}/`,
    t: tr ? loc.title : t.title, d: tr ? loc.duration : t.duration, p: Number(t.price_eur) };
});
// The north is crowded (eleven places in a strip 2° high), so it is drawn a
// second time, enlarged, in a band under the country; the country map shows
// the northern places as small dots inside a dashed box.
const Z = { lon0: -2.3, lon1: 8.6, lat0: 34.5, lat1: 37.4 };
const ZS = W / (px(Z.lon1) - px(Z.lon0));
const ZY = H + 14;                                   // top of the enlarged band
const zx = (lon: number) => +((px(lon) - px(Z.lon0)) * ZS).toFixed(1);
const zy = (lat: number) => +(ZY + (py(lat) - py(Z.lat1)) * ZS).toFixed(1);
const ZH = +((py(Z.lat0) - py(Z.lat1)) * ZS).toFixed(1);
// Label placement: [dx, dy, text-anchor].
const LBL: Record<string, [number, number, string]> = {
  algiers: [0, -11, 'middle'], tipaza: [-9, 4, 'end'], bejaia: [0, -11, 'middle'], djemila: [0, 18, 'middle'],
  constantine: [9, 4, 'start'], annaba: [0, -11, 'middle'], timgad: [0, 18, 'middle'], bousaada: [0, 18, 'middle'],
  oran: [-9, 4, 'end'], mostaganem: [0, -11, 'middle'], tlemcen: [9, 4, 'start'],
  ghardaia: [10, 4, 'start'], timimoun: [10, 4, 'start'], djanet: [-11, 4, 'end'],
};
const pins = PLACES.map(p => {
  const list = tours.filter(t => t.w.some((w: string) => p.w.includes(w))).sort((a, b) => a.p - b.p);
  const north = p.lat > Z.lat0;
  const [dx, dy, anchor] = LBL[p.id] || [9, 4, 'start'];
  return { id: p.id, name: p.name, north, x: px(p.lon), y: py(p.lat), zx: zx(p.lon), zy: zy(p.lat), dx, dy, anchor,
    r: 4.5 + Math.min(list.length, 8) * 0.55,
    img: p.img ? `/assets/img/thumbs/tours/${p.img}` : '',
    trips: list.map(t => ({ t: t.t, d: t.d, p: t.p, u: t.href })) };
}).filter(p => p.trips.length);


const C = {
  en: { north: 'North', h: 'Explore Algeria on the map', sub: 'Tap a place to see the trips that go there.', trips: 'trips', trip: 'trip', from: 'from', per: 'per person', sahara: 'Sahara', med: 'Mediterranean Sea', pick: 'Choose a place on the map' },
  fr: { north: 'Nord', h: "Explorez l'Algérie sur la carte", sub: 'Touchez un lieu pour voir les circuits qui y passent.', trips: 'circuits', trip: 'circuit', from: 'dès', per: 'par personne', sahara: 'Sahara', med: 'Mer Méditerranée', pick: 'Choisissez un lieu sur la carte' },
  it: { north: 'Nord', h: "Esplorate l'Algeria sulla mappa", sub: 'Toccate un luogo per vedere i viaggi che ci passano.', trips: 'viaggi', trip: 'viaggio', from: 'da', per: 'a persona', sahara: 'Sahara', med: 'Mar Mediterraneo', pick: 'Scegliete un luogo sulla mappa' },
  es: { north: 'Norte', h: 'Explore Argelia en el mapa', sub: 'Toque un lugar para ver los viajes que pasan por allí.', trips: 'viajes', trip: 'viaje', from: 'desde', per: 'por persona', sahara: 'Sáhara', med: 'Mar Mediterráneo', pick: 'Elija un lugar en el mapa' },
  de: { north: 'Norden', h: 'Algerien auf der Karte entdecken', sub: 'Tippen Sie auf einen Ort, um die Reisen dorthin zu sehen.', trips: 'Reisen', trip: 'Reise', from: 'ab', per: 'pro Person', sahara: 'Sahara', med: 'Mittelmeer', pick: 'Wählen Sie einen Ort auf der Karte' },
}[lang];
const fmtLocale = lang === 'en' ? 'en-GB' : 'de-DE';
---
<section class="section amap-sec"><div class="wrap">
  <h2 class="amap-h">{C.h}</h2>
  <p class="amap-sub">{C.sub}</p>
  <div class="amap" data-amap data-from={C.from} data-per={C.per} data-trips={C.trips} data-trip={C.trip} data-locale={fmtLocale}>
    <svg viewBox={`0 0 ${W} ${ZY + ZH + 6}`} role="group" aria-label={C.h}>
      <defs><clipPath id="amap-zclip"><rect x="0" y={ZY} width={W} height={ZH} rx="10" /></clipPath></defs>
      <path d={d} class="amap-land" />
      <text x={px(-1.5)} y={py(37.05) - 1} class="amap-sea">{C.med}</text>
      <text x={px(2.2)} y={py(25.5)} class="amap-sahara">{C.sahara}</text>
      <rect x={px(Z.lon0)} y={py(Z.lat1)} width={px(Z.lon1) - px(Z.lon0)} height={py(Z.lat0) - py(Z.lat1)} class="amap-zbox" />
      {pins.filter(p => p.north).map(p => <circle cx={p.x} cy={p.y} r="2.6" class="amap-mini" />)}
      {pins.map((p, i) => !p.north && (
        <g class="amap-pin" data-i={i} tabindex="0" role="button" aria-label={`${p.name} — ${p.trips.length} ${p.trips.length === 1 ? C.trip : C.trips}`}>
          <circle cx={p.x} cy={p.y} r={p.r} class="amap-dot" />
          <text x={p.x + p.dx} y={p.y + p.dy} text-anchor={p.anchor} class="amap-lbl">{p.name}</text>
        </g>
      ))}
      <g clip-path="url(#amap-zclip)">
        <rect x="0" y={ZY} width={W} height={ZH} class="amap-zbg" />
        <path d={d} class="amap-land" transform={`translate(${-px(Z.lon0) * ZS} ${ZY - py(Z.lat1) * ZS}) scale(${ZS})`} style={`stroke-width:${(1.2 / ZS).toFixed(2)}`} />
      </g>
      <rect x="0.5" y={ZY} width={W - 1} height={ZH} rx="10" class="amap-zframe" />
      <g transform={`translate(9 ${ZY + 6.5}) scale(.42)`} class="amap-zico"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></g>
      <text x="22" y={ZY + 15} class="amap-ztitle">{C.north}</text>
      {pins.map((p, i) => p.north && (
        <g class="amap-pin" data-i={i} tabindex="0" role="button" aria-label={`${p.name} — ${p.trips.length} ${p.trips.length === 1 ? C.trip : C.trips}`}>
          <circle cx={p.zx} cy={p.zy} r={p.r} class="amap-dot" />
          <text x={p.zx + p.dx} y={p.zy + p.dy} text-anchor={p.anchor} class="amap-lbl">{p.name}</text>
        </g>
      ))}
    </svg>

    <div class="amap-panel" aria-live="polite">
      <p class="amap-pick">{C.pick}</p>
    </div>
  </div>
  <script type="application/json" class="amap-data" set:html={JSON.stringify(pins)} />
</div></section>

<style is:global>
  .amap-sec{padding-top:2rem}
  .amap-h{margin:0}
  .amap-sub{color:var(--text-l);margin:.3rem 0 1rem}
  .amap{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:1.2rem;align-items:start}
  .amap svg{width:100%;height:auto;border-radius:16px;border:1px solid var(--border);background:var(--bg,#fff)}
  .amap-zbox{fill:none;stroke:#0B3D2E;stroke-width:1;stroke-dasharray:3 3;opacity:.6}
  .amap-mini{fill:#0B3D2E;opacity:.7}
  .amap-zbg{fill:#dcebf2}
  .amap-zframe{fill:none;stroke:#b8955a;stroke-width:1}
  .amap-zico{fill:none;stroke:#5b7f91;stroke-width:2.4;stroke-linecap:round}
  .amap-ztitle{font:700 9px system-ui,sans-serif;fill:#5b7f91;letter-spacing:.08em;text-transform:uppercase}
  .amap-land{fill:#efe2c6;stroke:#b8955a;stroke-width:1.2}
  .amap-sea{font:600 9px system-ui,sans-serif;fill:#5b7f91;letter-spacing:.12em;text-transform:uppercase}
  .amap-sahara{font:700 20px Georgia,serif;fill:#c9a24a;opacity:.45;letter-spacing:.35em;text-transform:uppercase}
  .amap-pin{cursor:pointer;outline:none}
  .amap-dot{fill:#0B3D2E;stroke:#fff;stroke-width:2;transition:fill .2s}
  .amap-lbl{font:700 10px system-ui,sans-serif;fill:#1d2b25;paint-order:stroke;stroke:#fff;stroke-width:3px}
  .amap-pin:hover .amap-dot,.amap-pin:focus .amap-dot,.amap-pin.on .amap-dot{fill:#C9A24A}
  /* Sticky beside the map on desktop: the map is about three times the
     panel's height, so a static panel left a long empty column beside it. */
  .amap-panel{border:1px solid var(--border);border-radius:16px;padding:1rem;background:var(--wash);min-height:220px;
    position:sticky;top:96px;max-height:calc(100vh - 120px);overflow:auto}
  .amap-pick{color:var(--text-l);margin:3rem 0;text-align:center}
  .amap-panel h3{margin:.2rem 0 .6rem}
  .amap-panel img{width:100%;height:150px;object-fit:cover;border-radius:10px;margin-bottom:.6rem}
  .amap-panel a{display:block;padding:.55rem .7rem;margin:.4rem 0;border:1px solid var(--border);border-radius:10px;background:var(--bg,#fff);text-decoration:none;color:inherit}
  .amap-panel a:hover{border-color:var(--gold,#C9A24A)}
  .amap-panel a b{display:block;line-height:1.3}
  .amap-panel a span{font-size:.9rem;color:var(--text-m)}
  @media (max-width:820px){.amap{grid-template-columns:1fr}.amap-pick{margin:1rem 0}.amap-panel{position:static;max-height:none}}
</style>
<script is:inline>
(function(){
  document.querySelectorAll('[data-amap]').forEach(function(box){
    if (box.dataset.bound) return; box.dataset.bound = '1';
    var pins = JSON.parse(box.parentNode.querySelector('.amap-data').textContent);
    var panel = box.querySelector('.amap-panel'), D = box.dataset;
    function esc(s){var e=document.createElement('div');e.textContent=s==null?'':String(s);return e.innerHTML;}
    function show(i, initial){
      var p = pins[i];
      box.querySelectorAll('.amap-pin').forEach(function(g){g.classList.toggle('on', +g.dataset.i === i);});
      panel.innerHTML = (p.img ? '<img src="'+esc(p.img)+'" alt="" loading="lazy">' : '') +
        '<h3>'+esc(p.name)+' · '+p.trips.length+' '+esc(p.trips.length===1?D.trip:D.trips)+'</h3>' +
        p.trips.map(function(t){return '<a href="'+esc(t.u)+'" data-evt="map_tour_click"><b>'+esc(t.t)+'</b><span>'+esc(t.d)+' · '+esc(D.from)+' €'+Number(t.p).toLocaleString(D.locale)+' '+esc(D.per)+'</span></a>';}).join('');
      if (!initial && window.innerWidth < 820) panel.scrollIntoView({behavior:'smooth', block:'nearest'});
    }
    /* Open on the place with the most trips rather than an empty "choose a
       place" box, so the panel shows real tours before anyone clicks. The
       instruction is kept in the static HTML for no-JS readers. */
    if (pins.length) {
      var top = pins.reduce(function(best, p, i){ return p.trips.length > pins[best].trips.length ? i : best; }, 0);
      show(top, true);
    }
    box.querySelectorAll('.amap-pin').forEach(function(g){
      g.addEventListener('click', function(){ show(+g.dataset.i); });
      g.addEventListener('keydown', function(e){ if (e.key==='Enter'||e.key===' ') { e.preventDefault(); show(+g.dataset.i); } });
    });
  });
})();
</script>
