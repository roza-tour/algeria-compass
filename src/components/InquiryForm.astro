---
import { CONTACT } from '../config';
export interface Props { defaultInterest?: string; context?: string; compact?: boolean; }
const { defaultInterest = '', context = '' } = Astro.props;
const interests = ['Sahara','Roman ruins','Andalusian heritage','Kabylie & coast','Food','Culture','Photography','Family','Luxury'];
---
<form class="inq" id="inqForm" method="POST" action="/contact.php"
      data-wa={CONTACT.whatsapp} data-email={CONTACT.email}>
  <!-- spam honeypot: real users never fill this -->
  <input type="text" name="website" id="f-website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
  <input type="hidden" name="context" id="f-context" value={context} />

  <div class="row">
    <div><label for="f-name">Your name <span class="req">*</span></label><input id="f-name" name="name" type="text" autocomplete="name" required /></div>
    <div><label for="f-email">Email <span class="req">*</span></label><input id="f-email" name="email" type="email" autocomplete="email" required /></div>
  </div>
  <div class="row" style="margin-top:.8rem">
    <div><label for="f-country">Country</label><input id="f-country" name="country" type="text" autocomplete="country-name" placeholder="Where you're travelling from" /></div>
    <div><label for="f-people">Travellers</label><input id="f-people" name="people" type="number" min="1" inputmode="numeric" placeholder="2" /></div>
  </div>
  <div class="row" style="margin-top:.8rem">
    <div><label for="f-when">Travel dates</label><input id="f-when" name="when" type="text" placeholder="e.g. October, or flexible" /></div>
    <div><label for="f-days">How many days?</label><input id="f-days" name="days" type="text" placeholder="e.g. 10" /></div>
  </div>

  <div style="margin-top:1rem">
    <label>Interests</label>
    <div class="chips" id="chips">
      {interests.map(i => <button type="button" class="chip" data-chip={i} aria-pressed={i===defaultInterest ? 'true' : 'false'}>{i}</button>)}
    </div>
    <input type="hidden" name="interests" id="f-interests" value={defaultInterest} />
  </div>

  <div style="margin-top:1rem"><label for="f-msg">Your message <span class="req">*</span></label><textarea id="f-msg" name="message" rows="4" required placeholder="Tell us what you'd like to see and any questions."></textarea></div>

  <div id="inqError" class="inq-error" role="alert" hidden></div>

  <div class="nav-row" style="margin-top:1.1rem">
    <button type="submit" class="btn btn-gold" id="inqSubmit" data-evt="inquiry_submit">Send my request</button>
    <a class="btn btn-wa-2" id="waBtn" href={`https://wa.me/${CONTACT.whatsapp}`} target="_blank" rel="noopener">💬 Or send via WhatsApp</a>
  </div>
  <p class="form-note">We reply within a few hours to {CONTACT.phoneDisplay} · <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>. WhatsApp is optional — the form works on its own.</p>
</form>

<div id="inqSuccess" class="inq-success" hidden role="status">
  <h3>Thank you — your request is on its way.</h3>
  <p>We've emailed your details to our team and will reply within a few hours. Prefer to chat now? <a id="waBtn2" href={`https://wa.me/${CONTACT.whatsapp}`} target="_blank" rel="noopener">Message us on WhatsApp</a>.</p>
</div>

<script is:inline>
(function(){
  var f=document.getElementById('inqForm'); if(!f) return;
  var chips=[].slice.call(f.querySelectorAll('.chip')), hidden=document.getElementById('f-interests');
  function sync(){hidden.value=chips.filter(function(c){return c.getAttribute('aria-pressed')==='true';}).map(function(c){return c.getAttribute('data-chip');}).join(', ');}
  chips.forEach(function(c){c.addEventListener('click',function(){c.setAttribute('aria-pressed',c.getAttribute('aria-pressed')==='true'?'false':'true');sync();updateWa();});});
  sync();
  // pre-fill interest from ?i=
  try{var q=new URLSearchParams(location.search).get('i');
    if(q){document.getElementById('f-context').value=q;chips.forEach(function(c){if(c.getAttribute('data-chip').toLowerCase()===q.toLowerCase())c.setAttribute('aria-pressed','true');});sync();}}catch(e){}
  function val(id){var el=document.getElementById(id);return el?el.value.trim():'';}
  function buildMessage(){
    var ctx=document.getElementById('f-context').value||'';
    var l=['Hello Algeria Compass, I would like to plan a trip to Algeria.'];
    if(ctx)l.push('Tour/Interest: '+ctx);
    if(val('f-name'))l.push('Name: '+val('f-name'));
    if(val('f-email'))l.push('Email: '+val('f-email'));
    if(val('f-country'))l.push('From: '+val('f-country'));
    if(val('f-people'))l.push('Travellers: '+val('f-people'));
    if(val('f-when'))l.push('When: '+val('f-when'));
    if(val('f-days'))l.push('Duration: '+val('f-days')+' days');
    if(hidden.value)l.push('Interests: '+hidden.value);
    if(val('f-msg'))l.push('Notes: '+val('f-msg'));
    return l.join('\n');
  }
  var waBtn=document.getElementById('waBtn');
  function updateWa(){var u='https://wa.me/'+f.getAttribute('data-wa')+'?text='+encodeURIComponent(buildMessage());if(waBtn)waBtn.setAttribute('href',u);}
  f.addEventListener('input',updateWa); updateWa();
  var err=document.getElementById('inqError');
  function showErr(m){err.textContent=m;err.hidden=false;}
  try{if(new URLSearchParams(location.search).get('error')==='1')showErr('Sorry — that didn’t send. Please try again, or WhatsApp / email us directly.');}catch(e){}
  f.addEventListener('submit',function(e){
    err.hidden=true;
    var name=val('f-name'),email=val('f-email'),msg=val('f-msg');
    if(!name||!email||!msg){e.preventDefault();showErr('Please add your name, a valid email and a message.');return;}
    if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)){e.preventDefault();showErr('Please enter a valid email address.');return;}
    // progressive enhancement: submit via fetch; fall back to native POST if fetch unsupported
    if(!window.fetch)return; // native POST -> contact.php -> /thank-you/
    e.preventDefault();
    var btn=document.getElementById('inqSubmit');var old=btn.textContent;btn.textContent='Sending…';btn.disabled=true;
    if(window.trackEvent)window.trackEvent('inquiry_submit');
    fetch(f.getAttribute('action'),{method:'POST',headers:{'X-Requested-With':'fetch'},body:new FormData(f)})
      .then(function(r){return r.json().catch(function(){return {ok:r.ok};});})
      .then(function(d){
        if(d&&d.ok){f.hidden=true;var s=document.getElementById('inqSuccess');if(s)s.hidden=false;var w2=document.getElementById('waBtn2');if(w2)w2.setAttribute('href',waBtn.getAttribute('href'));window.scrollTo({top:f.getBoundingClientRect().top+window.scrollY-120,behavior:'smooth'});}
        else{showErr((d&&d.error)||'Sorry — something went wrong. Please WhatsApp or email us directly.');btn.textContent=old;btn.disabled=false;}
      })
      .catch(function(){showErr('Network error. Please try again, or WhatsApp / email us directly.');btn.textContent=old;btn.disabled=false;});
  });
})();
</script>
