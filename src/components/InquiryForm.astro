---
// The enquiry form is the last step before a booking, so it follows the
// language the visitor has been reading. Chip *values* stay English in every
// language (see INTEREST_VALUES) so the owner's inbox and the WhatsApp handoff
// remain in one language whatever the visitor sees.
import { CONTACT } from '../config';
import { FORM, INTEREST_VALUES, asLang } from '../i18n';
export interface Props { defaultInterest?: string; context?: string; compact?: boolean; lang?: string; }
const { defaultInterest = '', context = '', lang: langProp } = Astro.props;
const lang = asLang(langProp);
const f = FORM[lang];
const interests = INTEREST_VALUES.map((value, i) => ({ value, label: f.interestLabels[i] ?? value }));
---
<form class="inq" id="inqForm" method="POST" action="/contact.php"
      data-wa={CONTACT.whatsapp} data-email={CONTACT.email}
      data-sending={f.sending} data-err-required={f.errRequired} data-err-email={f.errEmail}
      data-err-send={f.errSend} data-err-network={f.errNetwork} data-err-retry={f.errRetry}>
  <!-- spam honeypot: real users never fill this -->
  <input type="text" name="website" id="f-website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
  <input type="hidden" name="context" id="f-context" value={context} />

  <div class="row">
    <div><label for="f-name">{f.name} <span class="req">*</span></label><input id="f-name" name="name" type="text" autocomplete="name" required /></div>
    <div><label for="f-email">{f.email} <span class="req">*</span></label><input id="f-email" name="email" type="email" autocomplete="email" required /></div>
  </div>
  <div class="row" style="margin-top:.8rem">
    <div><label for="f-country">{f.country}</label><input id="f-country" name="country" type="text" autocomplete="country-name" placeholder={f.countryPh} /></div>
    <div><label for="f-people">{f.travellers}</label><input id="f-people" name="people" type="number" min="1" inputmode="numeric" placeholder="2" /></div>
  </div>
  <div class="row" style="margin-top:.8rem">
    <div><label for="f-when">{f.dates}</label><input id="f-when" name="when" type="text" placeholder={f.datesPh} /></div>
    <div><label for="f-days">{f.days}</label><input id="f-days" name="days" type="text" placeholder={f.daysPh} /></div>
  </div>

  <fieldset style="margin-top:1rem">
    <legend>{f.interests}</legend>
    <div class="chips" id="chips">
      {interests.map(i => <button type="button" class="chip" data-chip={i.value} aria-pressed={i.value===defaultInterest ? 'true' : 'false'}>{i.label}</button>)}
    </div>
    <input type="hidden" name="interests" id="f-interests" value={defaultInterest} />
  </fieldset>

  <div style="margin-top:1rem"><label for="f-msg">{f.message} <span class="req">*</span></label><textarea id="f-msg" name="message" rows="4" required placeholder={f.messagePh}></textarea></div>

  <div id="inqError" class="inq-error" role="alert" hidden></div>

  <div class="nav-row" style="margin-top:1.1rem">
    <button type="submit" class="btn btn-gold" id="inqSubmit" data-evt="inquiry_submit">{f.submit}</button>
    <a class="btn btn-wa-2" id="waBtn" href={`https://wa.me/${CONTACT.whatsapp}`} target="_blank" rel="noopener"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="vertical-align:-3px;margin-right:.4em"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.67c2.2 0 4.27.86 5.82 2.42a8.19 8.19 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.24 8.23-1.48 0-2.93-.4-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24Z"/></svg>{f.viaWa}</a>
  </div>
  <p class="form-note">{f.note} {CONTACT.phoneDisplay} · <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>. {f.noteTail}</p>
</form>

<div id="inqSuccess" class="inq-success" hidden role="status">
  <h3>{f.successH}</h3>
  <p>{f.successP} <a id="waBtn2" href={`https://wa.me/${CONTACT.whatsapp}`} target="_blank" rel="noopener">{f.successWa}</a>.</p>
</div>

<script is:inline>
(function(){
  var f=document.getElementById('inqForm'); if(!f) return;
  var chips=[].slice.call(f.querySelectorAll('.chip')), hidden=document.getElementById('f-interests');
  function sync(){hidden.value=chips.filter(function(c){return c.getAttribute('aria-pressed')==='true';}).map(function(c){return c.getAttribute('data-chip');}).join(', ');}
  chips.forEach(function(c){c.addEventListener('click',function(){c.setAttribute('aria-pressed',c.getAttribute('aria-pressed')==='true'?'false':'true');sync();updateWa();});});
  sync();
  // pre-fill interest from ?i=
  try{var q=new URLSearchParams(location.search).get('i');
    if(q){document.getElementById('f-context').value=q;chips.forEach(function(c){if(c.getAttribute('data-chip').toLowerCase()===q.toLowerCase())c.setAttribute('aria-pressed','true');});sync();}}catch(e){}
  function val(id){var el=document.getElementById(id);return el?el.value.trim():'';}
  function buildMessage(){
    var ctx=document.getElementById('f-context').value||'';
    var l=['Hello Algeria Compass, I would like to plan a trip to Algeria.'];
    if(ctx)l.push('Tour/Interest: '+ctx);
    if(val('f-name'))l.push('Name: '+val('f-name'));
    if(val('f-email'))l.push('Email: '+val('f-email'));
    if(val('f-country'))l.push('From: '+val('f-country'));
    if(val('f-people'))l.push('Travellers: '+val('f-people'));
    if(val('f-when'))l.push('When: '+val('f-when'));
    if(val('f-days'))l.push('Duration: '+val('f-days')+' days');
    if(hidden.value)l.push('Interests: '+hidden.value);
    if(val('f-msg'))l.push('Notes: '+val('f-msg'));
    return l.join('\n');
  }
  var waBtn=document.getElementById('waBtn');
  function updateWa(){var u='https://wa.me/'+f.getAttribute('data-wa')+'?text='+encodeURIComponent(buildMessage());if(waBtn)waBtn.setAttribute('href',u);}
  f.addEventListener('input',updateWa); updateWa();
  var err=document.getElementById('inqError');
  // Messages come from data-* so the script stays language-agnostic.
  function s(k,fallback){return f.getAttribute('data-'+k)||fallback;}
  function showErr(m){err.textContent=m;err.hidden=false;}
  try{if(new URLSearchParams(location.search).get('error')==='1')showErr(s('err-retry','Sorry — that didn’t send. Please try again, or WhatsApp / email us directly.'));}catch(e){}
  f.addEventListener('submit',function(e){
    err.hidden=true;
    var name=val('f-name'),email=val('f-email'),msg=val('f-msg');
    if(!name||!email||!msg){e.preventDefault();showErr(s('err-required','Please add your name, a valid email and a message.'));return;}
    if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)){e.preventDefault();showErr(s('err-email','Please enter a valid email address.'));return;}
    // progressive enhancement: submit via fetch; fall back to native POST if fetch unsupported
    if(!window.fetch)return; // native POST -> contact.php -> /thank-you/
    e.preventDefault();
    var btn=document.getElementById('inqSubmit');var old=btn.textContent;btn.textContent=s('sending','Sending…');btn.disabled=true;
    if(window.trackEvent)window.trackEvent('inquiry_submit');
    fetch(f.getAttribute('action'),{method:'POST',headers:{'X-Requested-With':'fetch'},body:new FormData(f)})
      .then(function(r){return r.json().catch(function(){return {ok:r.ok};});})
      .then(function(d){
        if(d&&d.ok){f.hidden=true;var s=document.getElementById('inqSuccess');if(s)s.hidden=false;var w2=document.getElementById('waBtn2');if(w2)w2.setAttribute('href',waBtn.getAttribute('href'));window.scrollTo({top:f.getBoundingClientRect().top+window.scrollY-120,behavior:'smooth'});}
        else{showErr((d&&d.error)||s('err-send','Sorry — something went wrong. Please WhatsApp or email us directly.'));btn.textContent=old;btn.disabled=false;}
      })
      .catch(function(){showErr(s('err-network','Network error. Please try again, or WhatsApp / email us directly.'));btn.textContent=old;btn.disabled=false;});
  });
})();
</script>
