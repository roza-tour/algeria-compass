    faqs: [['Ist eine Reise nach Algerien sicher?', "Der Norden, das M'Zab-Tal und die organisierten Sahara-Routen sind ruhig und sehr gastfreundlich. In die tiefe Wüste reisen wir nur mit Genehmigungen und lizenzierten Guides."], ['Brauche ich ein Visum?', 'Für die meisten Nationalitäten ja. Das Einladungsschreiben erstellen wir bei jeder Buchung kostenlos; bei organisierten Sahara-Reisen kann das Visum mit unserer Genehmigung (40 €) bei der Ankunft erteilt werden. Und wird Ihr Visum abgelehnt, erstatten wir alles, was Sie uns gezahlt haben.'], ['Muss ich zahlen, um den Termin zu reservieren?', `Nein. Ihr Termin ist ${H} Stunden kostenlos reserviert, während wir Verfügbarkeit, Genehmigungen und Flüge bestätigen. Eine Anzahlung — per Überweisung, Karte oder PayPal — sichert die Reise erst, wenn Sie zufrieden sind.`], ['Sind die Reisen privat?', `Ja, jede Reise ist privat, zu Ihren Terminen, mit einem lizenzierten örtlichen Guide. Unsere Guides sprechen ${['Englisch', 'Französisch', 'Spanisch', 'Italienisch', 'Arabisch', 'Deutsch'].join(', ')}.`], ['Kann sich der Preis nach der Buchung ändern?', 'Nein. Der schriftlich bestätigte Preis ist fest — er steigt weder durch Saison, Nachfrage noch Wechselkurs.']],
    exitEyebrow: 'Bevor Sie gehen', exitH: `−${E} % bei Frühbuchung`, exitP: `Buchen Sie mindestens ${D} Tage vor Abreise, und ${E} % werden von jeder Reise abgezogen. Hinterlassen Sie Ihre E-Mail — wir senden Ihnen die passende Reise mit Rabatt.`, wa: 'WhatsApp (optional)', exitBtn: 'Mein Angebot senden', exitMsg: 'Bitte senden Sie mir einen Reisevorschlag mit Frühbucherrabatt.', close: 'Schließen',
    js: { locale: 'de-DE', best: 'Beste Wahl', also: 'Auch ideal', from: 'Ab', pp: 'pro Person', trav1: 'Reisender', travN: 'Reisende', onreq: 'Preis auf Anfrage für diese Gruppengröße', hold: 'Termin reservieren', early: (m: string) => `Eine Reise im ${m} erhält den Frühbucherrabatt: −${E} %, unten bereits abgezogen.`, soon: 'Sie reisen bald? Jetzt reservieren ist der beste Weg, Guides und Flüge zu sichern.', luxT: 'Die 5-Sterne-Kollektion — 8 Tage all-inclusive', luxH: 'Inlandsflüge, Fünf-Sterne-Hotels, alle Mahlzeiten, private 4x4-Flotte, Guides und Eintritte.', luxD: '8 Tage', wants: { sahara: 'Sahara', history: 'Römisch & Geschichte', both: 'Sahara + Geschichte', city: 'Algier & Küste' }, styles: { comfort: 'komfortabel', luxury: 'Luxus' }, holdMsg: 'Ich möchte einen Termin reservieren für:', waMsg: 'Hallo! Ich möchte buchen:', travS: 'Reisende(r)' },
  },
};
const C = COPY[lang] ?? COPY.en;
// Functions cannot cross into the inline script, so the two message templates
// are pre-split around a placeholder.
const J = { ...C.js, early: C.js.early('%M%') };

const DESERT = ['djanet', 'ghardaia', 'timimoun', 'bousaada'];
const TR: Record<string, any> = { fr: TOURS_FR, es: TOURS_ES, de: TOURS_DE };
const R = ROUTES[lang];
const tours = (toursData as any).tours.map((t: any) => {
  const tr = TR[lang]?.[t.id];
  const ok = lang === 'en' || tr?.full;
  return {
    id: t.id, title: ok && tr ? tr.title : t.title, hook: ok && tr ? tr.hook : t.hook, price: t.price_eur, theme: t.theme,
    days: parseInt(t.duration, 10) || 1, dur: (ok && tr ? tr.duration : t.duration).split(' · ')[0],
    desert: t.theme === 'sahara' || t.theme === 'mzab' || (t.wilayas || []).some((w: string) => DESERT.includes(w)),
    north: !(t.theme === 'sahara' || t.theme === 'mzab') || (t.wilayas || []).some((w: string) => !DESERT.includes(w) && w !== 'illizi'),
    img: `/assets/img/thumbs/tours/${(t.image_slugs || ['algiers'])[0]}-1.jpg`,
    url: (ok ? R.tours : '/tours/') + t.id + '/',
  };
});
const lux = { tiers: [[2, 9, LUX_PRICING.highValue], [10, 15, 1870], [16, 22, 1700], [23, 999, LUX_PRICING.fromValue]], url: R.luxury };
const cfg = { hold: H, earlyDays: D, earlyPct: E, wa: CONTACT.whatsapp };

const moments = ['client-641', 'client-223', 'client-547', 'client-189', 'client-4', 'client-500'];
const faqs = C.faqs.map(([q, a]: [string, string]) => ({ q, a }));
const self = PLAN_PATHS[lang] ?? PLAN_PATHS.en!;
const alternates = alternatesFor(site, PLAN_PATHS);
const schema = [{
  '@type': 'FAQPage', '@id': `${site}${self}#faq`, inLanguage: lang,
  mainEntity: faqs.map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}];
const hero = '/assets/img/tours/djanet-13.jpg';
const heroAlt = lang === 'fr' ? "Une arche de grès naturelle au-dessus du sable orange près de Djanet"
  : lang === 'es' ? 'Un arco natural de arenisca sobre la arena naranja cerca de Djanet'
  : lang === 'de' ? 'Ein natürlicher Sandsteinbogen über orangefarbenem Sand bei Djanet'
  : 'A natural sandstone arch rising above smooth orange sand in the desert around Djanet';
---
<BaseLayout title={C.title} description={C.desc} image={hero} imageAlt={heroAlt} keywords={C.kw} schema={schema} region="sahara" lang={lang} alternates={alternates}>

  <section class="lp-hero" style={`background-image:linear-gradient(180deg,rgba(10,20,15,.35),rgba(10,20,15,.78)),url(${hero})`}>
    <div class="wrap">
      <p class="eyebrow" style="color:var(--gold-l)">{C.eyebrow}</p>
      <h1>{C.h1}</h1>
      <p class="lp-sub">{C.sub}</p>
      <a class="btn btn-gold lp-go" href="#planner" data-evt="lp_start">{C.go}</a>
      <ul class="lp-chips">{C.chips.map((c: string) => <li>{c}</li>)}</ul>
    </div>
  </section>

  <section class="section" id="planner"><div class="wrap" style="max-width:860px">
    <div class="lp-card">
      <div class="lp-prog" aria-hidden="true"><span id="lpBar"></span></div>
      <form id="lpQuiz" novalidate>
        <fieldset class="lp-step" data-step="0">
          <legend>{C.q1}</legend>
          <div class="lp-opts">
            {['sahara', 'history', 'both', 'city'].map((v, i) => <button type="button" data-k="want" data-v={v}>{C.o1[i]}</button>)}
          </div>
        </fieldset>
        <fieldset class="lp-step" data-step="1" hidden>
          <legend>{C.q2}</legend>
          <div class="lp-opts">
            {['2', '5', '8', '12'].map((v, i) => <button type="button" data-k="days" data-v={v}>{C.o2[i]}</button>)}
          </div>
        </fieldset>
        <fieldset class="lp-step" data-step="2" hidden>
          <legend>{C.q3}</legend>
          <div class="lp-num">
            <button type="button" id="lpMinus" aria-label={C.fewer}>−</button>
            <output id="lpPax" aria-live="polite">2</output>
            <button type="button" id="lpPlus" aria-label={C.more}>+</button>
          </div>
          <button type="button" class="btn btn-gold lp-next" data-next>{C.next}</button>
        </fieldset>
        <fieldset class="lp-step" data-step="3" hidden>
          <legend>{C.q4}</legend>
          <div class="lp-opts lp-months" id="lpMonths"></div>
          <p class="lp-hint">{C.hint}</p>
        </fieldset>
        <fieldset class="lp-step" data-step="4" hidden>
          <legend>{C.q5}</legend>
          <div class="lp-opts">
            {['comfort', 'luxury'].map((v, i) => <button type="button" data-k="style" data-v={v}>{C.o5[i]}</button>)}
          </div>
        </fieldset>
      </form>

      <div id="lpResult" hidden>
        <h2>{C.resH}</h2>
        <p id="lpEarly" class="lp-early" hidden></p>
        <div id="lpList" class="lp-list"></div>

        <div class="lp-hold" id="hold">
          <h3>{C.holdH}</h3>
          <p>{C.holdP}</p>
          <form method="POST" action="/contact.php" id="lpHoldForm">
            <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
            <input type="hidden" name="context" id="lpCtx" value={`Plan-your-trip (${lang}): hold dates`} />
            <input type="hidden" name="interests" id="lpInt" value="" />
            <input type="hidden" name="people" id="lpPeople" value="" />
            <input type="hidden" name="when" id="lpWhen" value="" />
            <input type="hidden" name="days" id="lpDays" value="" />
            <div class="lp-row">
              <label>{C.name}<input name="name" required maxlength="80" autocomplete="name" /></label>
              <label>{C.email}<input name="email" type="email" required maxlength="120" autocomplete="email" /></label>
            </div>
            <label>{C.note}<textarea name="message" id="lpMsg" rows="3" maxlength="4000"></textarea></label>
            <div class="lp-actions">
              <button type="submit" class="btn btn-gold" data-evt="lp_hold">{C.holdBtn}</button>
              <a class="btn btn-wa-2" id="lpWa" href={`https://wa.me/${CONTACT.whatsapp}`} target="_blank" rel="noopener" data-evt="lp_whatsapp">{C.waBtn}</a>
            </div>
            <p class="lp-fine">{C.fine} <a href="/booking-terms/#guarantees">{C.terms}</a></p>
          </form>
        </div>
        <button type="button" class="lp-restart" id="lpRestart">{C.restart}</button>
      </div>
      <noscript><p>{C.noscript} <a href={R.contact}>{C.noscriptLink}</a> · WhatsApp {CONTACT.phoneDisplay}.</p></noscript>
    </div>
  </div></section>

  <section class="section" style="background:var(--wash)"><div class="wrap">
    <p class="eyebrow">{C.guarEyebrow}</p>
    <h2>{C.guarH}</h2>
    <div class="lp-guar">{C.guar.map(([b, s]: [string, string]) => <div><b>{b}</b><span>{s}</span></div>)}</div>
  </div></section>

  <section class="section"><div class="wrap">
    <div class="lp-proof">
      {C.proof.map(([b, s]: [string, string], i: number) => <div><b>{b}</b><span>{i === 0 ? <a href={CONTACT.googleProfile} target="_blank" rel="noopener">{s}</a> : s}</span></div>)}
    </div>
    <h2 style="margin-top:2rem">{C.momentsH}</h2>
    <div class="lp-moments">
      {moments.map((m) => (<img src={`/assets/img/clients/${m}.jpg`} alt={C.momentsAlt} loading="lazy" width="300" height="300" />))}
    </div>
    <p><a href="/moments/">{C.momentsLink}</a></p>
  </div></section>

  <section class="section" style="background:var(--wash)"><div class="wrap" style="max-width:820px">
    <h2>{C.timingH}</h2>
    <p set:html={C.timing} />
    <h2 style="margin-top:2rem">{C.faqH}</h2>
    {faqs.map((f: any, i: number) => (<details class="lp-faq"><summary>{f.q}</summary><p>{f.a}{i === 0 && <> <a href={C.safety}>→</a></>}</p></details>))}
  </div></section>

  <div class="lp-exit" id="lpExit" role="dialog" aria-modal="true" aria-labelledby="lpExitH" hidden>
    <div class="lp-exit-box">
      <button type="button" class="lp-x" id="lpExitX" aria-label={C.close}>×</button>
      <p class="eyebrow">{C.exitEyebrow}</p>
      <h2 id="lpExitH">{C.exitH}</h2>
      <p>{C.exitP}</p>
      <form method="POST" action="/contact.php">
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
        <input type="hidden" name="context" value={`Plan-your-trip (${lang}): early-booking offer (exit)`} />
        <input type="hidden" name="interests" value={`Early booking -${E}%`} />
        <label>{C.name}<input name="name" required maxlength="80" autocomplete="name" /></label>
        <label>{C.email}<input name="email" type="email" required maxlength="120" autocomplete="email" /></label>
        <label>{C.wa}<input name="whatsapp" maxlength="30" inputmode="tel" autocomplete="tel" placeholder="+…" /></label>
        <input type="hidden" name="message" value={C.exitMsg} />
        <button type="submit" class="btn btn-gold" data-evt="lp_exit_offer">{C.exitBtn}</button>
      </form>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ tours, lux, cfg, J }}>
(function(){
  var st={want:null,days:null,pax:2,month:null,monthDate:null,style:null}, step=0, steps=document.querySelectorAll('.lp-step');
  var bar=document.getElementById('lpBar');
  var ev=function(n){ try{ window.trackEvent && window.trackEvent(n) }catch(e){} };
  var esc=function(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;'); };
  function show(i){ step=i; steps.forEach(function(s,j){ s.hidden = j!==i; }); bar.style.width=(i/steps.length*100)+'%'; }
  var mWrap=document.getElementById('lpMonths'), now=new Date();
  for(var i=0;i<12;i++){ var d=new Date(now.getFullYear(), now.getMonth()+i, 1);
    var b=document.createElement('button'); b.type='button'; b.dataset.k='month'; b.dataset.v=d.getTime();
    b.textContent=d.toLocaleDateString(J.locale,{month:'short',year:'numeric'}); mWrap.appendChild(b); }
  document.getElementById('lpQuiz').addEventListener('click',function(e){
    var b=e.target.closest('button[data-k]'); if(b){
      var k=b.dataset.k, v=b.dataset.v;
      if(k==='month'){ var md=new Date(+v); st.monthDate=md; st.month=md.toLocaleDateString(J.locale,{month:'long',year:'numeric'}); } else st[k]=v;
      if(step===0) ev('lp_q1');
      if(step<steps.length-1) show(step+1); else result();
      return; }
    if(e.target.closest('[data-next]')) show(step+1);
  });
  var paxEl=document.getElementById('lpPax');
  document.getElementById('lpMinus').onclick=function(){ st.pax=Math.max(1,st.pax-1); paxEl.textContent=st.pax; };
  document.getElementById('lpPlus').onclick=function(){ st.pax=Math.min(40,st.pax+1); paxEl.textContent=st.pax; };
  function eur(n){ return '€'+Math.round(n).toLocaleString(J.locale); }
  function score(t){
    var s=0, want=st.want, d=+st.days;
    if(want==='sahara') s+= t.desert ? (t.north?6:10) : -20;
    if(want==='history') s+= t.north ? (t.desert?6:10) : -20;
    if(want==='both') s+= (t.desert && t.north) ? 10 : 2;
    if(want==='city') s+= (t.theme==='city'||t.theme==='coast'||t.theme==='roman') ? 10 : (t.north?2:-20);
    return s - Math.abs(t.days-d)*1.6;
  }
  function luxPrice(n){ for(var i=0;i<lux.tiers.length;i++){ var r=lux.tiers[i]; if(n>=r[0]&&n<=r[1]) return r[2]; } return null; }
  function result(){
    ev('lp_result');
    document.getElementById('lpQuiz').hidden=true; bar.style.width='100%';
    var R=document.getElementById('lpResult'); R.hidden=false;
    var early = Math.round((st.monthDate - new Date())/864e5) >= cfg.earlyDays;
    var earlyEl=document.getElementById('lpEarly'); earlyEl.hidden=false;
    earlyEl.textContent = early ? J.early.replace('%M%', st.month) : J.soon;
    var list=document.getElementById('lpList'); list.innerHTML='';
    var picks=[];
    if(st.style==='luxury') picks.push({title:J.luxT,hook:J.luxH,dur:J.luxD,price:luxPrice(st.pax),url:lux.url,img:'/assets/img/tours/djemila-2.jpg'});
    tours.slice().sort(function(a,b){return score(b)-score(a)}).slice(0, st.style==='luxury'?2:3).forEach(function(t){ picks.push(t); });
    picks.forEach(function(p,i){
      var per=p.price, tot=per? per*st.pax : null, disc= early&&tot ? tot*cfg.earlyPct/100 : 0;
      var el=document.createElement('div'); el.className='lp-pick'+(i===0?' lp-top':'');
      el.innerHTML='<img src="'+p.img+'" alt="" width="120" height="120" loading="lazy">'+
        '<div><span class="lp-badge">'+esc(i===0?J.best:J.also)+' · '+esc(p.dur)+'</span>'+
        '<h3><a href="'+p.url+'" target="_blank" rel="noopener">'+esc(p.title)+'</a></h3>'+
        '<p>'+esc(p.hook)+'</p>'+
        (per ? '<p class="lp-price">'+esc(J.from)+' <b>'+eur(per)+'</b> '+esc(J.pp)+' · '+st.pax+' '+esc(st.pax>1?J.travN:J.trav1)+': <b>'+eur(tot-disc)+'</b>'+(disc?' <s>'+eur(tot)+'</s> <em>−'+cfg.earlyPct+'%</em>':'')+'</p>'
             : '<p class="lp-price">'+esc(J.onreq)+'</p>')+
        '<button type="button" class="btn btn-gold lp-pickbtn" data-title="'+esc(p.title)+'">'+esc(J.hold)+'</button></div>';
      list.appendChild(el);
    });
    fill(picks[0].title);
    list.querySelectorAll('.lp-pickbtn').forEach(function(b){ b.onclick=function(){ fill(b.dataset.title); document.getElementById('hold').scrollIntoView({behavior:'smooth'}); }; });
    R.scrollIntoView({behavior:'smooth'});
  }
  function fill(title){
    var label=J.wants[st.want], style=J.styles[st.style];
    document.getElementById('lpCtx').value=document.getElementById('lpCtx').value.split(': ')[0]+': hold dates — '+title;
    document.getElementById('lpInt').value=label+' · '+style;
    document.getElementById('lpPeople').value=st.pax;
    document.getElementById('lpWhen').value=st.month;
    document.getElementById('lpDays').value={2:'1–3',5:'4–6',8:'7–9',12:'10+'}[st.days];
    var msg=document.getElementById('lpMsg'); if(!msg.dataset.touched) msg.value=J.holdMsg+' '+title+'.';
    var wa=J.waMsg+' '+title+' — '+st.pax+' '+J.travS+', '+st.month+', '+label+' ('+style+').';
    document.getElementById('lpWa').href='https://wa.me/'+cfg.wa+'?text='+encodeURIComponent(wa);
  }
  document.getElementById('lpMsg').addEventListener('input',function(){ this.dataset.touched='1'; });
  document.getElementById('lpRestart').onclick=function(){ document.getElementById('lpResult').hidden=true; document.getElementById('lpQuiz').hidden=false; show(0); };
  show(0);

  // Exit offer: once per session; desktop on exit intent, mobile after 45 s.
  var X=document.getElementById('lpExit'), shown=false;
  function seen(){ try{ return sessionStorage.getItem('lpExit') }catch(e){ return null } }
  function open(){ if(shown||seen()) return; if(!document.getElementById('lpResult').hidden) return; shown=true; try{sessionStorage.setItem('lpExit','1')}catch(e){} X.hidden=false; ev('lp_exit_shown'); X.querySelector('input[name=name]').focus(); }
  function close(){ X.hidden=true; }
  document.getElementById('lpExitX').onclick=close;
  X.addEventListener('click',function(e){ if(e.target===X) close(); });
  document.addEventListener('keydown',function(e){ if(e.key==='Escape') close(); });
  if(matchMedia('(pointer:fine)').matches) document.addEventListener('mouseout',function(e){ if(!e.relatedTarget && e.clientY<10) open(); });
  else setTimeout(open,45000);
})();
</script>

<style is:global>
  .lp-hero{background-size:cover;background-position:center;color:#fff;padding:5.5rem 0 4rem}
  .lp-hero h1{color:#fff;font-size:clamp(2rem,5vw,3.2rem);max-width:16ch;margin:.3rem 0 .8rem}
  .lp-sub{font-size:1.15rem;max-width:44ch;color:rgba(255,255,255,.92)}
  .lp-go{margin-top:1.2rem;font-size:1.1rem;padding:.9rem 1.8rem}
  .lp-chips{list-style:none;display:flex;flex-wrap:wrap;gap:.5rem;padding:0;margin:1.4rem 0 0}
  .lp-chips li{background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.25);padding:.35rem .75rem;border-radius:999px;font-size:.9rem}
  .lp-card{background:var(--card,#fff);border-radius:18px;box-shadow:0 10px 40px rgba(0,0,0,.08);padding:1.6rem;position:relative;overflow:hidden}
  .lp-prog{height:5px;background:rgba(0,0,0,.06);border-radius:5px;margin-bottom:1.2rem}
  .lp-prog span{display:block;height:100%;width:0;background:var(--gold,#b8862e);border-radius:5px;transition:width .3s}
  .lp-step{border:0;padding:0;margin:0}
  .lp-step legend{font-size:1.45rem;font-weight:800;margin-bottom:1rem;font-family:inherit}
  .lp-opts{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:.7rem}
  .lp-opts button{font:inherit;font-size:1.02rem;text-align:left;padding:1rem 1.1rem;border-radius:12px;border:1.5px solid rgba(0,0,0,.14);background:#fff;cursor:pointer;min-height:56px}
  .lp-opts button:hover,.lp-opts button:focus-visible{border-color:var(--gold,#b8862e);background:#fffaf0}
  .lp-months{grid-template-columns:repeat(auto-fit,minmax(110px,1fr))}
  .lp-months button{text-align:center}
  .lp-hint{color:var(--text-m);font-size:.92rem;margin-top:.8rem}
  .lp-num{display:flex;align-items:center;gap:1.2rem;margin:.4rem 0 1.2rem}
  .lp-num button{width:52px;height:52px;border-radius:50%;border:1.5px solid rgba(0,0,0,.2);background:#fff;font-size:1.6rem;cursor:pointer}
  .lp-num output{font-size:2rem;font-weight:800;min-width:2ch;text-align:center}
  .lp-early{background:#fff6e0;border-left:4px solid var(--gold,#b8862e);padding:.7rem .9rem;border-radius:8px}
  .lp-list{display:grid;gap:.9rem;margin:1rem 0 1.6rem}
  .lp-pick{display:grid;grid-template-columns:120px 1fr;gap:1rem;border:1px solid rgba(0,0,0,.1);border-radius:14px;padding:.9rem}
  .lp-pick.lp-top{border:2px solid var(--gold,#b8862e)}
  .lp-pick img{width:120px;height:120px;object-fit:cover;border-radius:10px}
  .lp-pick h3{margin:.2rem 0 .3rem;font-size:1.1rem} .lp-pick p{margin:.2rem 0;color:var(--text-m)}
  .lp-badge{font-size:.78rem;text-transform:uppercase;letter-spacing:.05em;color:var(--gold-d,#8a6420);font-weight:800}
  .lp-price{color:inherit!important} .lp-price s{color:var(--text-m)} .lp-price em{color:#1c7c3c;font-style:normal;font-weight:800}
  .lp-pickbtn{margin-top:.5rem;padding:.55rem 1rem}
