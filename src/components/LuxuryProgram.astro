---
// The 5-Star Collection — each programme rendered as a cinematic magazine
// "chapter": full-bleed header with an oversized gold numeral, a calm centred
// intro, a gold route ribbon, a vertical day-by-day timeline, a cream
// accommodation/inclusions panel for rhythm, and a premium dark pricing card.
import { LUX_PRICING } from '../data/luxury.mjs';
import { CONTACT } from '../config';
export interface Props { prog: any; }
const { prog } = Astro.props as { prog: any };
const wa = `https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent(`Hello Algeria Compass, I'd like to reserve the 5-Star journey “${prog.name}” (Programme ${prog.num}).`)}`;
---
<section class="lp" id={prog.id}>
  <!-- ===== cinematic chapter header ===== -->
  <header class="lp-chapter">
    <div class="lp-chapter-media">
      <img class="lp-chapter-img lux-graded" src={prog.hero} alt={`${prog.name} — luxury Algeria tour`} width="1600" height="900" loading="lazy" decoding="async" />
      <div class="lp-grade" aria-hidden="true"></div>
      <div class="lp-chapter-veil" aria-hidden="true"></div>
    </div>
    <div class="lp-chapter-in lp-reveal">
      <span class="lp-chapter-num" aria-hidden="true">{prog.num}</span>
      <span class="lp-eyebrow">Programme {prog.num} · {prog.subtitle}</span>
      <h2 class="lp-chapter-title">{prog.name}</h2>
      <span class="lp-flourish" aria-hidden="true"></span>
      <p class="lp-chapter-tagline">{prog.tagline}</p>
      <ul class="lp-badges">
        {prog.badges.map((b: string) => <li>{b}</li>)}
      </ul>
    </div>
  </header>

  <div class="lp-body">
    <!-- calm centred intro -->
    <div class="lp-intro lp-reveal">
      <p class="lp-lead">{prog.heroLine}</p>
      <p class="lp-overview">{prog.overview}</p>
    </div>

    <!-- gold route ribbon -->
    <div class="lp-route lp-reveal" aria-label="Route">
      {prog.route.map((r: any, i: number) => (
        <>
          <span class="lp-stop"><span class="lp-stop-place">{r.place}</span><span class="lp-stop-note">{r.note}</span></span>
          {i < prog.route.length - 1 && <span class="lp-arrow" aria-hidden="true"></span>}
        </>
      ))}
    </div>

    <!-- vertical day-by-day timeline -->
    <p class="lp-eyebrow lp-eyebrow-c lp-reveal">The Itinerary</p>
    <h3 class="lp-section-h lp-reveal">Day by Day</h3>
    <ol class="lp-timeline">
      {prog.days.map((d: any) => (
        <li class="lp-tl lp-reveal">
          <span class="lp-tl-node" aria-hidden="true"></span>
          <div class="lp-tl-row">
            <figure class="lp-tl-media">
              <img class="lux-graded" src={d.img} alt={d.title} width="800" height="560" loading="lazy" decoding="async" />
              <div class="lp-grade" aria-hidden="true"></div>
            </figure>
            <div class="lp-tl-text">
              <span class="lp-tl-day">{d.label}</span>
              <h4 class="lp-tl-title">{d.title}</h4>
              <ol class="lp-exp">
                {d.stops.map((s: any) => (
                  <li><span class="lp-exp-t">{s.t}</span><span class="lp-exp-d">{s.d}</span></li>
                ))}
              </ol>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>

  <!-- ===== cream panel: accommodation + inclusions ===== -->
  <div class="lp-cream">
    <div class="lp-cream-in">
      <div class="lp-panel-col lp-reveal">
        <p class="lp-eyebrow lp-eyebrow-dark">Accommodation</p>
        <ul class="lp-stay">
          {prog.stay.map((s: any) => (
            <li class="lp-stay-row">
              <span class="lp-stay-city">{s.city}</span>
              <span class="lp-stay-hotels">{s.hotels}</span>
              <span class="lp-stay-nights">{s.nights}</span>
            </li>
          ))}
        </ul>
        <p class="lp-stay-note">Specific properties are confirmed in writing with your booking, subject to availability.</p>
      </div>
      <div class="lp-panel-col lp-reveal">
        <p class="lp-eyebrow lp-eyebrow-dark">All-Inclusive</p>
        <ul class="lp-incl">
          {prog.includes.map((i: string) => <li>{i}</li>)}
        </ul>
        <p class="lp-cancel">Free cancellation up to 5 days before departure</p>
      </div>
    </div>
  </div>

  <!-- ===== premium pricing card ===== -->
  <div class="lp-body">
    <div class="lp-pricing lp-reveal">
      <p class="lp-eyebrow lp-eyebrow-c">Pricing · Per Person · EUR</p>
      <h3 class="lp-section-h">Private, all-inclusive</h3>
      <p class="lp-price-sub">The more you travel together, the lower the per-person rate — every tier private and request-to-book.</p>
      <div class="lp-tiers">
        {LUX_PRICING.tiers.map((t: any) => (
          <div class={`lp-tier${t.pax === '22+ pax' ? ' is-rec' : ''}`}>
            {t.pax === '22+ pax' && <span class="lp-tier-flag">Best value</span>}
            <span class="lp-tier-pax">{t.pax}</span>
            <span class="lp-tier-price">{t.price}</span>
            <span class="lp-tier-note">{t.note}</span>
          </div>
        ))}
      </div>
      <div class="lp-cta">
        <div class="lp-from">From <strong>{LUX_PRICING.fromLabel}</strong> <span>per person</span></div>
        <div class="lp-cta-btns">
          <a class="lp-btn-gold" href="#reserve">Reserve this journey</a>
          <a class="lp-btn-ghost" href={wa} target="_blank" rel="noopener">Speak to a specialist</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .lp{position:relative;z-index:2;color:var(--lux-cream);font-family:var(--lux-sans)}
  .lp-reveal{opacity:0;transform:translateY(34px);transition:opacity 1.1s cubic-bezier(.22,.61,.36,1),transform 1.1s cubic-bezier(.22,.61,.36,1)}
  .lp-reveal.in{opacity:1;transform:none}
  @media(prefers-reduced-motion:reduce){.lp-reveal{opacity:1;transform:none;transition:none}.lp-chapter-img{animation:none}}

  /* shared cinematic colour grade — unifies every photo on the page */
  .lux-graded{filter:saturate(1.08) contrast(1.05) brightness(.94)}
  .lp-grade{position:absolute;inset:0;pointer-events:none;
    background:
      linear-gradient(155deg,rgba(193,147,51,.16),transparent 42%),
      linear-gradient(0deg,rgba(7,38,28,.42),transparent 55%);
    mix-blend-mode:soft-light}

  /* shared gold eyebrow */
  .lp-eyebrow{display:inline-flex;align-items:center;gap:.7rem;font-family:var(--lux-label);font-weight:600;
    font-size:.7rem;letter-spacing:.32em;text-transform:uppercase;color:var(--lux-gold)}
  .lp-eyebrow-c{display:flex;justify-content:center;text-align:center;width:100%}
  .lp-eyebrow-dark{color:var(--lux-gold-deep)}
  .lp-section-h{font-family:var(--lux-display);font-weight:600;text-align:center;color:var(--lux-cream);
    font-size:clamp(1.9rem,4.2vw,3rem);letter-spacing:.06em;line-height:1.1;margin:.6rem 0 0}

  /* ============================ CHAPTER HEADER ============================ */
  .lp-chapter{position:relative;min-height:clamp(440px,80vh,760px);display:flex;align-items:flex-end;justify-content:center;overflow:hidden}
  .lp-chapter-media{position:absolute;inset:0;z-index:0}
  .lp-chapter-img{width:100%;height:100%;object-fit:cover;
    animation:lp-kenburns 30s ease-in-out infinite alternate;will-change:transform}
  @keyframes lp-kenburns{from{transform:scale(1)}to{transform:scale(1.09)}}
  .lp-chapter-veil{position:absolute;inset:0;background:
    radial-gradient(120% 80% at 50% 30%,transparent 30%,rgba(7,15,11,.55) 80%),
    linear-gradient(180deg,rgba(7,15,11,.5) 0%,transparent 26%,rgba(7,15,11,.35) 58%,var(--lux-black) 100%)}
  .lp-chapter-in{position:relative;z-index:2;text-align:center;padding:0 1.4rem 4rem;max-width:880px}
  .lp-chapter-num{display:block;font-family:var(--lux-display);font-weight:700;
    font-size:clamp(4.5rem,16vw,11rem);line-height:.8;letter-spacing:.02em;
    color:transparent;-webkit-text-stroke:1.4px rgba(193,147,51,.85);
    text-shadow:0 0 70px rgba(193,147,51,.18);margin-bottom:.6rem}
  .lp-chapter-title{font-family:var(--lux-display);font-weight:700;color:var(--lux-cream);letter-spacing:.07em;
    font-size:clamp(2.4rem,6.4vw,4.6rem);line-height:1.02;margin:.8rem 0 0;text-shadow:0 4px 40px rgba(0,0,0,.6)}
  .lp-flourish{display:block;width:120px;height:14px;margin:1.3rem auto;position:relative}
  .lp-flourish::before{content:"";position:absolute;top:50%;left:0;right:0;height:1px;
    background:linear-gradient(90deg,transparent,var(--lux-gold) 35%,var(--lux-gold) 65%,transparent)}
  .lp-flourish::after{content:"";position:absolute;top:50%;left:50%;width:8px;height:8px;
    transform:translate(-50%,-50%) rotate(45deg);background:var(--lux-gold);box-shadow:0 0 14px rgba(193,147,51,.7)}
  .lp-chapter-tagline{font-family:var(--lux-serif);font-style:italic;font-weight:400;color:var(--lux-cream-dim);
    font-size:clamp(1.15rem,2.4vw,1.5rem);line-height:1.55;max-width:660px;margin:0 auto 1.6rem}
  .lp-badges{list-style:none;display:flex;flex-wrap:wrap;justify-content:center;gap:.55rem;padding:0;margin:0}
  .lp-badges li{font-family:var(--lux-label);font-size:.62rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;
    color:var(--lux-cream);border:1px solid rgba(193,147,51,.5);border-radius:999px;padding:.45rem 1rem;
    background:rgba(7,38,28,.35);backdrop-filter:blur(4px)}

  /* ============================ BODY ============================ */
  .lp-body{max-width:1080px;margin:0 auto;padding:clamp(3rem,7vw,5.5rem) clamp(1.2rem,4vw,2.6rem) 0}
  .lp-intro{max-width:760px;margin:0 auto;text-align:center}
  .lp-lead{font-family:var(--lux-serif);font-style:italic;font-weight:400;font-size:clamp(1.5rem,3.1vw,2.15rem);
    line-height:1.4;color:var(--lux-gold-bright);margin:0 0 1.2rem}
  .lp-overview{color:var(--lux-cream-dim);font-size:1.08rem;line-height:1.85;font-weight:300;margin:0}

  /* gold route ribbon */
  .lp-route{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.55rem 1rem;margin:clamp(2.6rem,6vw,4rem) auto 0;max-width:900px}
  .lp-stop{display:inline-flex;flex-direction:column;align-items:center}
  .lp-stop-place{font-family:var(--lux-display);font-weight:500;font-size:clamp(1rem,2vw,1.25rem);color:var(--lux-cream);letter-spacing:.04em}
  .lp-stop-note{font-family:var(--lux-label);font-size:.56rem;text-transform:uppercase;letter-spacing:.2em;color:var(--lux-gold);margin-top:.25rem}
  .lp-arrow{width:30px;height:1px;background:linear-gradient(90deg,transparent,var(--lux-gold),transparent);position:relative;top:-7px}

  /* ============================ TIMELINE ============================ */
  .lp-timeline{list-style:none;margin:clamp(2.4rem,5vw,3.6rem) 0 0;padding:0;position:relative}
  .lp-timeline::before{content:"";position:absolute;left:7px;top:10px;bottom:10px;width:1px;
    background:linear-gradient(180deg,transparent,rgba(193,147,51,.55) 8%,rgba(193,147,51,.55) 92%,transparent)}
  .lp-tl{position:relative;padding:0 0 clamp(2.2rem,5vw,3.4rem) clamp(2rem,4vw,2.8rem)}
  .lp-tl:last-child{padding-bottom:0}
  .lp-tl-node{position:absolute;left:0;top:.35rem;width:15px;height:15px;border-radius:50%;
    border:1px solid var(--lux-gold);background:var(--lux-black);box-shadow:0 0 0 4px rgba(10,14,12,1)}
  .lp-tl-node::after{content:"";position:absolute;inset:4px;border-radius:50%;background:var(--lux-gold);box-shadow:0 0 12px rgba(193,147,51,.7)}
  .lp-tl-row{display:grid;grid-template-columns:minmax(0,4.4fr) minmax(0,7fr);gap:clamp(1.2rem,3vw,2.2rem);align-items:start}
  .lp-tl-media{position:relative;margin:0;border-radius:4px;overflow:hidden;aspect-ratio:4/3;
    border:1px solid rgba(193,147,51,.25)}
  .lp-tl-media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform 1.1s cubic-bezier(.22,.61,.36,1)}
  .lp-tl:hover .lp-tl-media img{transform:scale(1.06)}
  .lp-tl-day{font-family:var(--lux-label);font-weight:600;font-size:.64rem;letter-spacing:.24em;text-transform:uppercase;color:var(--lux-gold)}
  .lp-tl-title{font-family:var(--lux-display);font-weight:600;font-size:clamp(1.4rem,2.7vw,1.95rem);color:var(--lux-cream);
    letter-spacing:.04em;line-height:1.12;margin:.5rem 0 1.1rem}
  .lp-exp{list-style:none;counter-reset:exp;padding:0;margin:0;display:grid;gap:1.05rem}
  .lp-exp li{counter-increment:exp;position:relative;padding-left:2.5rem}
  .lp-exp li::before{content:counter(exp,decimal-leading-zero);position:absolute;left:0;top:.05rem;
    font-family:var(--lux-display);font-weight:600;font-size:.95rem;color:var(--lux-gold);
    border-bottom:1px solid rgba(193,147,51,.45);padding-bottom:.1rem}
  .lp-exp-t{display:block;font-family:var(--lux-serif);font-size:1.2rem;color:var(--lux-cream);margin-bottom:.2rem;letter-spacing:.01em}
  .lp-exp-d{display:block;color:var(--lux-cream-dim);font-size:.95rem;line-height:1.7;font-weight:300}

  /* ============================ CREAM PANEL ============================ */
  .lp-cream{position:relative;z-index:2;margin-top:clamp(3rem,7vw,5.5rem);
    background:linear-gradient(180deg,var(--lux-paper),var(--lux-paper-2));
    border-top:1px solid rgba(193,147,51,.4);border-bottom:1px solid rgba(193,147,51,.4)}
  .lp-cream-in{max-width:1080px;margin:0 auto;padding:clamp(2.8rem,6vw,4.6rem) clamp(1.2rem,4vw,2.6rem);
    display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,5vw,4rem)}
  .lp-panel-col{position:relative}
  .lp-panel-col + .lp-panel-col{padding-left:clamp(0px,3vw,2.4rem);border-left:1px solid rgba(193,147,51,.28)}
  .lp-stay{list-style:none;padding:0;margin:1.4rem 0 0;border-top:1px solid rgba(193,147,51,.3)}
  .lp-stay-row{display:grid;grid-template-columns:auto 1fr auto;gap:.4rem 1.3rem;align-items:center;
    padding:1.05rem .2rem;border-bottom:1px solid rgba(193,147,51,.3)}
  .lp-stay-city{font-family:var(--lux-display);font-weight:600;font-size:1.2rem;color:var(--lux-ink);letter-spacing:.03em}
  .lp-stay-hotels{color:var(--lux-ink-dim);font-size:.94rem;font-weight:400}
  .lp-stay-nights{font-family:var(--lux-label);font-size:.6rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;
    color:var(--lux-gold-deep);border:1px solid rgba(193,147,51,.6);border-radius:999px;padding:.32rem .8rem;white-space:nowrap}
  .lp-stay-note{color:var(--lux-ink-faint);font-size:.84rem;font-weight:400;margin:1.1rem 0 0;font-style:italic}
  .lp-incl{list-style:none;padding:0;margin:1.4rem 0 0;display:grid;grid-template-columns:1fr 1fr;gap:.85rem 1.4rem}
  .lp-incl li{position:relative;padding-left:1.7rem;color:var(--lux-ink-dim);font-size:.98rem;line-height:1.5;font-weight:400}
  .lp-incl li::before{content:"";position:absolute;left:0;top:.5em;width:8px;height:8px;transform:rotate(45deg);
    background:var(--lux-gold);box-shadow:0 0 0 3px rgba(193,147,51,.16)}
  .lp-cancel{margin:1.5rem 0 0;font-family:var(--lux-label);font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--lux-gold-deep);font-weight:600}

  /* ============================ PRICING CARD ============================ */
  .lp-pricing{margin-top:clamp(3rem,7vw,5.5rem);
    background:radial-gradient(130% 100% at 50% 0%,rgba(11,61,46,.55),var(--lux-emerald-deep) 70%);
    border:1px solid rgba(193,147,51,.34);border-radius:8px;
    padding:clamp(2.2rem,5vw,3.6rem) clamp(1.3rem,4vw,3rem);text-align:center}
  .lp-price-sub{color:var(--lux-cream-dim);font-weight:300;max-width:600px;margin:1rem auto 2rem;font-size:1rem;line-height:1.65}
  .lp-tiers{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border:1px solid rgba(193,147,51,.28);border-radius:6px;overflow:hidden}
  .lp-tier{position:relative;background:rgba(7,15,11,.35);padding:2rem 1rem 1.7rem;text-align:center;
    border-right:1px solid rgba(193,147,51,.22);transition:background .4s ease,transform .4s ease}
  .lp-tier:last-child{border-right:0}
  .lp-tier:hover{background:rgba(7,15,11,.6)}
  .lp-tier.is-rec{background:linear-gradient(180deg,var(--lux-gold-bright),var(--lux-gold));box-shadow:0 0 40px rgba(193,147,51,.25)}
  .lp-tier-flag{position:absolute;top:-1px;left:50%;transform:translate(-50%,-50%);background:var(--lux-emerald-deep);color:var(--lux-gold);
    font-family:var(--lux-label);font-size:.54rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;
    padding:.3rem .8rem;border:1px solid var(--lux-gold);border-radius:999px;white-space:nowrap}
  .lp-tier-pax{display:block;font-family:var(--lux-label);font-size:.62rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--lux-cream-faint)}
  .lp-tier-price{display:block;font-family:var(--lux-display);font-weight:600;font-size:clamp(1.6rem,2.6vw,2.1rem);color:var(--lux-gold);margin:.5rem 0 .3rem;line-height:1}
  .lp-tier-note{display:block;font-size:.76rem;color:var(--lux-cream-faint);font-weight:300}
  .lp-tier.is-rec .lp-tier-pax,.lp-tier.is-rec .lp-tier-note{color:rgba(7,38,28,.72)}
  .lp-tier.is-rec .lp-tier-price{color:var(--lux-emerald-deep)}
  .lp-cta{margin-top:2.4rem;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:1.4rem 2rem}
  .lp-from{color:var(--lux-cream-dim);font-weight:300;font-size:1rem}
  .lp-from strong{font-family:var(--lux-display);font-weight:700;font-size:clamp(2rem,3vw,2.6rem);color:var(--lux-gold);margin:0 .3rem;letter-spacing:.02em}
  .lp-cta-btns{display:flex;flex-wrap:wrap;gap:.9rem;justify-content:center}
  .lp-btn-gold,.lp-btn-ghost{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 1.9rem;border-radius:3px;
    font-family:var(--lux-label);font-weight:600;font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;text-decoration:none;
    transition:background .35s ease,color .35s ease,box-shadow .35s ease}
  .lp-btn-gold{position:relative;overflow:hidden;background:var(--lux-gold);color:var(--lux-emerald-deep)}
  .lp-btn-gold::after{content:"";position:absolute;top:0;left:-60%;width:40%;height:100%;
    background:linear-gradient(100deg,transparent,rgba(255,255,255,.55),transparent);transform:skewX(-20deg);
    animation:lp-shimmer 5s ease-in-out infinite}
  @keyframes lp-shimmer{0%,72%{left:-60%}88%{left:130%}100%{left:130%}}
  .lp-btn-gold:hover{background:var(--lux-gold-bright);box-shadow:0 14px 34px rgba(193,147,51,.35)}
  .lp-btn-ghost{border:1px solid var(--lux-gold);color:var(--lux-gold)}
  .lp-btn-ghost:hover{background:var(--lux-gold);color:var(--lux-emerald-deep)}
  @media(prefers-reduced-motion:reduce){.lp-btn-gold::after{animation:none;display:none}}

  /* ============================ RESPONSIVE ============================ */
  @media(max-width:820px){
    .lp-tl-row{grid-template-columns:1fr;gap:1rem}
    .lp-tl-media{aspect-ratio:16/10}
    .lp-tiers{grid-template-columns:1fr 1fr}
    .lp-tier:nth-child(2n){border-right:0}
    .lp-tier:nth-child(-n+2){border-bottom:1px solid rgba(193,147,51,.22)}
    .lp-cream-in{grid-template-columns:1fr;gap:2.4rem}
    .lp-panel-col + .lp-panel-col{padding-left:0;border-left:0;border-top:1px solid rgba(193,147,51,.28);padding-top:2.4rem}
    .lp-incl{grid-template-columns:1fr}
  }
  @media(max-width:520px){
    .lp-stay-row{grid-template-columns:1fr auto;row-gap:.2rem}
    .lp-stay-hotels{grid-column:1/-1}
    .lp-cta{flex-direction:column;gap:1.2rem}
  }
</style>
