---
// The 5-Star Collection — one programme, redesigned for the obsidian/champagne
// luxury page (Black → Charcoal → Gold → Ivory). Full-bleed cinematic hero,
// editorial overview, day cards, horizontal accommodation rows, premium pricing.
import { LUX_PRICING } from '../data/luxury.mjs';
import { CONTACT } from '../config';
export interface Props { prog: any; }
const { prog } = Astro.props as { prog: any };
const wa = `https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent(`Hello Algeria Compass, I'd like to reserve the 5-Star journey “${prog.name}” (Programme ${prog.num}).`)}`;
---
<section class="lp" id={prog.id}>
  <!-- ===== full-bleed programme hero ===== -->
  <div class="lp-hero">
    <img class="lp-hero-img" src={prog.hero} alt={`${prog.name} — luxury Algeria tour`} width="1600" height="900" loading="lazy" decoding="async" />
    <div class="lp-hero-veil" aria-hidden="true"></div>
    <div class="lp-hero-in lp-reveal">
      <span class="lp-num" aria-hidden="true">{prog.num}</span>
      <span class="lp-over">Programme {prog.num} · {prog.subtitle}</span>
      <h2 class="lp-title">{prog.name}</h2>
      <p class="lp-tagline">{prog.tagline}</p>
      <ul class="lp-badges">
        {prog.badges.map((b: string) => <li>{b}</li>)}
      </ul>
    </div>
  </div>

  <div class="lp-body">
    <!-- overview -->
    <div class="lp-over-block lp-reveal">
      <p class="lp-lead">{prog.heroLine}</p>
      <p class="lp-overview">{prog.overview}</p>
    </div>

    <!-- route -->
    <div class="lp-route lp-reveal" aria-label="Route">
      {prog.route.map((r: any, i: number) => (
        <>
          <span class="lp-stop"><span class="lp-stop-place">{r.place}</span><span class="lp-stop-note">{r.note}</span></span>
          {i < prog.route.length - 1 && <span class="lp-arrow" aria-hidden="true">—</span>}
        </>
      ))}
    </div>

    <p class="lp-section-over lp-reveal">Day by Day</p>
    <ol class="lp-days">
      {prog.days.map((d: any) => (
        <li class="lp-day lp-reveal">
          <figure class="lp-day-img">
            <img src={d.img} alt={d.title} width="800" height="560" loading="lazy" decoding="async" />
            <figcaption class="lp-day-tag">{d.label}</figcaption>
          </figure>
          <div class="lp-day-b">
            <h3>{d.title}</h3>
            <ol class="lp-exp">
              {d.stops.map((s: any) => (
                <li><span class="lp-exp-t">{s.t}</span><span class="lp-exp-d">{s.d}</span></li>
              ))}
            </ol>
          </div>
        </li>
      ))}
    </ol>

    <!-- accommodation -->
    <p class="lp-section-over lp-reveal">Accommodation</p>
    <ul class="lp-stay lp-reveal">
      {prog.stay.map((s: any) => (
        <li class="lp-stay-row">
          <span class="lp-stay-city">{s.city}</span>
          <span class="lp-stay-hotels">{s.hotels}</span>
          <span class="lp-stay-nights">{s.nights}</span>
        </li>
      ))}
    </ul>
    <p class="lp-stay-note lp-reveal">Specific properties are confirmed in writing with your booking, subject to availability.</p>

    <!-- all-inclusive -->
    <p class="lp-section-over lp-reveal">All-Inclusive</p>
    <ul class="lp-incl lp-reveal">
      {prog.includes.map((i: string) => <li>{i}</li>)}
    </ul>
    <p class="lp-cancel lp-reveal">Free cancellation up to five days before departure</p>

    <!-- pricing -->
    <p class="lp-section-over lp-reveal">Pricing · Per Person · EUR</p>
    <p class="lp-price-sub lp-reveal">Private group, all-inclusive. The more you travel together, the lower the per-person rate.</p>
    <div class="lp-tiers lp-reveal">
      {LUX_PRICING.tiers.map((t: any) => (
        <div class={`lp-tier${t.pax === '22+ pax' ? ' is-rec' : ''}`}>
          {t.pax === '22+ pax' && <span class="lp-tier-flag">Best value</span>}
          <span class="lp-tier-pax">{t.pax}</span>
          <span class="lp-tier-price">{t.price}</span>
          <span class="lp-tier-note">{t.note}</span>
        </div>
      ))}
    </div>

    <div class="lp-cta lp-reveal">
      <div class="lp-from">From <strong>{LUX_PRICING.fromLabel}</strong> <span>per person</span></div>
      <div class="lp-cta-btns">
        <a class="lp-btn-gold" href="#reserve">Reserve this journey</a>
        <a class="lp-btn-ghost" href={wa} target="_blank" rel="noopener">Speak to a specialist</a>
      </div>
    </div>
  </div>
</section>

<style>
  .lp{position:relative;z-index:2;color:var(--lux-ivory);font-family:var(--lux-sans)}
  .lp-reveal{opacity:0;transform:translateY(30px);transition:opacity 1s cubic-bezier(.22,.61,.36,1),transform 1s cubic-bezier(.22,.61,.36,1)}
  .lp-reveal.in{opacity:1;transform:none}
  @media(prefers-reduced-motion:reduce){.lp-reveal{opacity:1;transform:none;transition:none}.lp-hero-img{animation:none}}

  /* ===== full-bleed hero ===== */
  .lp-hero{position:relative;min-height:clamp(420px,72vh,680px);display:flex;align-items:flex-end;justify-content:center;overflow:hidden}
  .lp-hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;
    animation:lp-kenburns 26s ease-in-out infinite alternate;will-change:transform}
  @keyframes lp-kenburns{from{transform:scale(1)}to{transform:scale(1.08)}}
  .lp-hero-veil{position:absolute;inset:0;background:
    linear-gradient(180deg,rgba(10,10,10,.4) 0%,transparent 30%,rgba(10,10,10,.55) 62%,#0A0A0A 100%)}
  .lp-hero-in{position:relative;z-index:2;text-align:center;padding:0 1.4rem 3rem;max-width:820px}
  .lp-num{display:block;font-family:var(--lux-serif);font-weight:300;font-size:clamp(2.6rem,7vw,4.4rem);line-height:1;
    color:transparent;-webkit-text-stroke:1px rgba(201,168,76,.7);margin-bottom:.4rem}
  .lp-over{display:inline-flex;align-items:center;gap:.8rem;font-family:var(--lux-label);font-weight:600;font-size:.68rem;
    letter-spacing:.26em;text-transform:uppercase;color:var(--lux-gold)}
  .lp-over::before,.lp-over::after{content:"";width:30px;height:1px;background:linear-gradient(90deg,transparent,var(--lux-gold))}
  .lp-over::after{background:linear-gradient(90deg,var(--lux-gold),transparent)}
  .lp-title{font-family:var(--lux-serif);font-weight:300;color:var(--lux-ivory);letter-spacing:.01em;
    font-size:clamp(2.2rem,6vw,3.6rem);line-height:1.04;margin:.7rem 0 .5rem;text-shadow:0 3px 30px rgba(0,0,0,.5)}
  .lp-tagline{color:var(--lux-ivory-dim);font-size:1.06rem;line-height:1.6;font-weight:300;max-width:640px;margin:0 auto 1.2rem}
  .lp-badges{list-style:none;display:flex;flex-wrap:wrap;justify-content:center;gap:.5rem;padding:0;margin:0}
  .lp-badges li{font-family:var(--lux-label);font-size:.64rem;font-weight:500;letter-spacing:.12em;text-transform:uppercase;
    color:var(--lux-ivory);border:1px solid rgba(201,168,76,.45);border-radius:999px;padding:.4rem .9rem}

  /* ===== body ===== */
  .lp-body{max-width:1040px;margin:0 auto;padding:clamp(2.6rem,6vw,4.4rem) clamp(1.2rem,4vw,2.4rem) clamp(3rem,7vw,5rem)}
  .lp-over-block{max-width:720px;margin:0 auto;text-align:center}
  .lp-lead{font-family:var(--lux-serif);font-style:italic;font-weight:300;font-size:clamp(1.3rem,2.8vw,1.85rem);
    line-height:1.4;color:var(--lux-gold-bright);margin:0 0 1.1rem}
  .lp-overview{color:var(--lux-ivory-dim);font-size:1.04rem;line-height:1.75;font-weight:300;margin:0}

  /* ===== shared section overline ===== */
  .lp-section-over{display:flex;align-items:center;justify-content:center;gap:1rem;margin:clamp(2.6rem,6vw,4rem) 0 1.6rem;
    font-family:var(--lux-label);font-weight:600;font-size:.7rem;letter-spacing:.28em;text-transform:uppercase;color:var(--lux-gold)}
  .lp-section-over::before,.lp-section-over::after{content:"";width:clamp(28px,7vw,60px);height:1px;background:linear-gradient(90deg,transparent,var(--lux-gold))}
  .lp-section-over::after{background:linear-gradient(90deg,var(--lux-gold),transparent)}

  /* ===== route ===== */
  .lp-route{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.5rem .7rem;margin:2.4rem auto 0;max-width:820px}
  .lp-stop{display:inline-flex;flex-direction:column;align-items:center}
  .lp-stop-place{font-family:var(--lux-serif);font-size:1.15rem;color:var(--lux-ivory)}
  .lp-stop-note{font-family:var(--lux-label);font-size:.58rem;text-transform:uppercase;letter-spacing:.14em;color:var(--lux-gold);margin-top:.1rem}
  .lp-arrow{color:var(--lux-gold);opacity:.55}

  /* ===== day cards ===== */
  .lp-days{list-style:none;padding:0;margin:0;display:grid;gap:1.4rem}
  .lp-day{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);align-items:stretch;overflow:hidden;
    background:var(--lux-char);border:1px solid var(--lux-line);border-radius:5px}
  .lp-day:nth-child(even){grid-template-columns:minmax(0,6fr) minmax(0,5fr)}
  .lp-day:nth-child(even) .lp-day-img{order:2}
  .lp-day-img{position:relative;margin:0;min-height:260px;overflow:hidden}
  .lp-day-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .7s ease}
  .lp-day:hover .lp-day-img img{transform:scale(1.05)}
  .lp-day-img::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent 70%,rgba(18,17,16,.5))}
  .lp-day:nth-child(even) .lp-day-img::after{background:linear-gradient(270deg,transparent 70%,rgba(18,17,16,.5))}
  .lp-day-tag{position:absolute;left:0;bottom:0;z-index:2;font-family:var(--lux-label);font-size:.62rem;font-weight:600;
    letter-spacing:.12em;text-transform:uppercase;color:#0A0A0A;background:var(--lux-gold);padding:.4rem .8rem}
  .lp-day-b{padding:clamp(1.4rem,3vw,2.1rem)}
  .lp-day-b h3{font-family:var(--lux-serif);font-weight:500;font-size:clamp(1.4rem,2.6vw,1.9rem);color:var(--lux-ivory);margin:0 0 1rem;letter-spacing:.01em}
  .lp-exp{list-style:none;counter-reset:exp;padding:0;margin:0;display:grid;gap:1rem}
  .lp-exp li{counter-increment:exp;position:relative;padding-left:2.3rem}
  .lp-exp li::before{content:counter(exp,decimal-leading-zero);position:absolute;left:0;top:.05rem;
    font-family:var(--lux-serif);font-size:.95rem;color:var(--lux-gold);border-bottom:1px solid rgba(201,168,76,.4);padding-bottom:.05rem}
  .lp-exp-t{display:block;font-family:var(--lux-serif);font-size:1.12rem;color:var(--lux-ivory);margin-bottom:.15rem}
  .lp-exp-d{display:block;color:var(--lux-ivory-dim);font-size:.92rem;line-height:1.6;font-weight:300}

  /* ===== accommodation ===== */
  .lp-stay{list-style:none;padding:0;margin:0;border-top:1px solid var(--lux-line)}
  .lp-stay-row{display:grid;grid-template-columns:auto 1fr auto;gap:.4rem 1.4rem;align-items:center;
    padding:1.1rem .4rem;border-bottom:1px solid var(--lux-line)}
  .lp-stay-city{font-family:var(--lux-serif);font-size:1.5rem;color:var(--lux-gold);font-weight:400}
  .lp-stay-hotels{color:var(--lux-ivory-dim);font-size:.96rem;font-weight:300}
  .lp-stay-nights{font-family:var(--lux-label);font-size:.62rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;
    color:var(--lux-gold);border:1px solid rgba(201,168,76,.45);border-radius:999px;padding:.35rem .8rem;white-space:nowrap}
  .lp-stay-note{color:var(--lux-ivory-faint);font-size:.82rem;font-weight:300;margin:1rem 0 0;text-align:center}

  /* ===== all-inclusive ===== */
  .lp-incl{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(2,1fr);gap:.7rem 1.6rem;max-width:760px;margin:0 auto}
  .lp-incl li{position:relative;padding-left:1.5rem;color:var(--lux-ivory-dim);font-size:.98rem;line-height:1.5;font-weight:300}
  .lp-incl li::before{content:"";position:absolute;left:0;top:.5em;width:7px;height:7px;transform:rotate(45deg);background:var(--lux-gold)}
  .lp-cancel{text-align:center;margin:1.6rem auto 0;font-family:var(--lux-label);font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--lux-gold)}

  /* ===== pricing ===== */
  .lp-price-sub{text-align:center;color:var(--lux-ivory-dim);font-weight:300;max-width:560px;margin:0 auto 1.8rem;font-size:.96rem}
  .lp-tiers{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}
  .lp-tier{position:relative;background:var(--lux-char);border:1px solid var(--lux-line);border-radius:5px;
    padding:1.8rem 1rem 1.5rem;text-align:center;transition:transform .3s ease,border-color .3s ease}
  .lp-tier:hover{transform:translateY(-4px);border-color:rgba(201,168,76,.6)}
  .lp-tier.is-rec{background:linear-gradient(180deg,var(--lux-gold-bright),var(--lux-gold));border-color:var(--lux-gold)}
  .lp-tier-flag{position:absolute;top:-1px;left:50%;transform:translate(-50%,-50%);background:#0A0A0A;color:var(--lux-gold);
    font-family:var(--lux-label);font-size:.56rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;
    padding:.25rem .7rem;border:1px solid var(--lux-gold);border-radius:999px}
  .lp-tier-pax{display:block;font-family:var(--lux-label);font-size:.64rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--lux-ivory-faint)}
  .lp-tier-price{display:block;font-family:var(--lux-serif);font-weight:400;font-size:2rem;color:var(--lux-gold);margin:.4rem 0 .25rem;line-height:1}
  .lp-tier-note{display:block;font-size:.78rem;color:var(--lux-ivory-faint);font-weight:300}
  .lp-tier.is-rec .lp-tier-pax,.lp-tier.is-rec .lp-tier-note{color:rgba(10,10,10,.7)}
  .lp-tier.is-rec .lp-tier-price{color:#0A0A0A}

  /* ===== cta ===== */
  .lp-cta{margin-top:2.4rem;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1.2rem;
    padding:1.8rem clamp(1.2rem,3vw,2.2rem);border:1px solid var(--lux-line);border-radius:5px;
    background:radial-gradient(120% 140% at 0% 0%, rgba(201,168,76,.08), transparent 55%), var(--lux-char)}
  .lp-from{color:var(--lux-ivory-dim);font-weight:300;font-size:1rem}
  .lp-from strong{font-family:var(--lux-serif);font-weight:400;font-size:1.9rem;color:var(--lux-gold);margin:0 .15rem}
  .lp-cta-btns{display:flex;flex-wrap:wrap;gap:.8rem}
  .lp-btn-gold,.lp-btn-ghost{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 1.7rem;border-radius:3px;
    font-family:var(--lux-label);font-weight:600;font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;text-decoration:none;
    transition:background .3s ease,color .3s ease,box-shadow .3s ease}
  .lp-btn-gold{position:relative;overflow:hidden;background:var(--lux-gold);color:#0A0A0A}
  .lp-btn-gold::after{content:"";position:absolute;top:0;left:-60%;width:40%;height:100%;
    background:linear-gradient(100deg,transparent,rgba(255,255,255,.5),transparent);transform:skewX(-20deg);
    animation:lp-shimmer 4.5s ease-in-out infinite}
  @keyframes lp-shimmer{0%,72%{left:-60%}88%{left:130%}100%{left:130%}}
  .lp-btn-gold:hover{background:var(--lux-gold-bright);box-shadow:0 12px 30px rgba(201,168,76,.3)}
  .lp-btn-ghost{border:1px solid var(--lux-gold);color:var(--lux-gold)}
  .lp-btn-ghost:hover{background:var(--lux-gold);color:#0A0A0A}
  @media(prefers-reduced-motion:reduce){.lp-btn-gold::after{animation:none;display:none}}

  @media(max-width:820px){
    .lp-day,.lp-day:nth-child(even){grid-template-columns:1fr}
    .lp-day:nth-child(even) .lp-day-img{order:0}
    .lp-day-img{min-height:220px;aspect-ratio:16/10}
    .lp-tiers{grid-template-columns:1fr 1fr}
  }
  @media(max-width:560px){
    .lp-incl{grid-template-columns:1fr}
    .lp-stay-row{grid-template-columns:1fr auto;row-gap:.2rem}
    .lp-stay-hotels{grid-column:1/-1}
  }
</style>
