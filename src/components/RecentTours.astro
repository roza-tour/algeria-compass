---
// "You recently viewed": the tours this visitor opened (recorded by
// TripTools.astro in this browser only). Renders nothing for a first visit.
export interface Props { lang?: string; inline?: boolean; }
const lang = Astro.props.lang || 'en';
const inline = !!Astro.props.inline;  // inside an existing .wrap: no second wrapper
const H: Record<string, string> = { en: 'You recently viewed', fr: 'Vus récemment', it: 'Visti di recente', es: 'Vistos recientemente', de: 'Zuletzt angesehen' };
const CLEAR: Record<string, string> = { en: 'Clear', fr: 'Effacer', it: 'Cancella', es: 'Borrar', de: 'Löschen' };
---
<section class={inline ? 'rv rv--inline' : 'rv'} id="rv" hidden aria-labelledby="rv-h"><div class={inline ? '' : 'wrap'}>
  <div class="rv-head"><h2 id="rv-h">{H[lang] || H.en}</h2><button type="button" class="rv-clear" id="rv-clear">{CLEAR[lang] || CLEAR.en}</button></div>
  <ul class="rv-list" id="rv-list"></ul>
</div></section>
<style is:global>
  .rv{padding:1.6rem 0 .4rem}
  .rv[hidden]{display:none}
  .rv--inline{padding:0 0 1.4rem}
  .rv-head{display:flex;align-items:baseline;justify-content:space-between;gap:1rem}
  .rv-head h2{font-size:1.4rem;margin:0}
  .rv-clear{border:0;background:none;color:var(--text-l);text-decoration:underline;cursor:pointer;font:inherit;font-size:.85rem}
  .rv-list{list-style:none;margin:.9rem 0 0;padding:0 0 .4rem;display:grid;grid-auto-flow:column;grid-auto-columns:minmax(220px,260px);gap:.9rem;overflow-x:auto;scroll-snap-type:x mandatory}
  .rv-list li{scroll-snap-align:start}
  .rv-list a{display:grid;grid-template-columns:76px 1fr;gap:.7rem;align-items:center;padding:.5rem;border:1px solid var(--border);border-radius:var(--radius-m);background:#fff;text-decoration:none;color:var(--green-d);transition:box-shadow .2s}
  .rv-list a:hover{box-shadow:0 8px 20px rgba(11,61,46,.12)}
  .rv-list img{width:76px;height:56px;object-fit:cover;border-radius:6px;display:block;background:var(--cream)}
  .rv-list b{display:block;font-size:.88rem;font-weight:600;line-height:1.25}
  .rv-list small{display:block;margin-top:.2rem;color:var(--text-l);font-size:.8rem}
</style>
<script is:inline>
  (function () {
    var sec = document.getElementById('rv'); if (!sec) return;
    var r = []; try { r = JSON.parse(localStorage.getItem('ac-recent') || '[]'); } catch (e) {}
    r = r.filter(function (x) { return x && x.id && x.href !== location.pathname; }).slice(0, 6);
    if (!r.length) return;
    var ul = document.getElementById('rv-list');
    r.forEach(function (x) {
      var li = document.createElement('li'), a = document.createElement('a'); a.href = x.href;
      var img = document.createElement('img'); img.src = x.img || ''; img.alt = ''; img.loading = 'lazy'; img.width = 76; img.height = 56;
      var d = document.createElement('div'), b = document.createElement('b'); b.textContent = x.title;
      var sm = document.createElement('small'); sm.setAttribute('data-eur', x.price); sm.textContent = '€' + x.price;
      d.appendChild(b); d.appendChild(sm); a.appendChild(img); a.appendChild(d); li.appendChild(a); ul.appendChild(li);
    });
    sec.hidden = false;
    if (window.__applyCur) window.__applyCur();
    document.getElementById('rv-clear').addEventListener('click', function () { try { localStorage.removeItem('ac-recent'); } catch (e) {} sec.hidden = true; });
  })();
</script>
