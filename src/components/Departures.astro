---
// Upcoming group departures (src/data/departures.ts). With a `tour` prop it
// lists that tour's dates (tour page); without, every tour's (/tours/).
// Renders nothing when there is no future date.
import data from '../data/tours.json';
import { upcoming } from '../data/departures';
export interface Props { tour?: string; compact?: boolean; }
const { tour, compact = false } = Astro.props;
const tours = ((data as any).tours || data) as any[];
const byId = Object.fromEntries(tours.map((t: any) => [t.id, t]));
const list = upcoming(tour).filter(d => byId[d.tour]);
const fmt = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
{list.length > 0 && (
  <section class={compact ? 'dep dep--compact' : 'section dep'} id="departures">
    <div class={compact ? '' : 'wrap'}>
      <span class="eyebrow">Join a small group</span>
      <h2>{compact ? 'Group departures' : 'Upcoming group departures'}</h2>
      <p class="dep-lead">Travelling alone or as two? Join one of these scheduled departures. Every tour can also be booked privately, on any date.</p>
      <ul class="dep-list">
        {list.map(d => {
          const t = byId[d.tour];
          const full = !(d.left > 0);
          const href = `/contact/?i=${encodeURIComponent(t.title)}&when=${d.date}&group=1`;
          return (
            <li class={full ? 'dep-item is-full' : 'dep-item'}>
              <div class="dep-date"><b>{fmt(d.date)}</b>{!compact && <a href={`/tours/${t.id}/`}>{t.title}</a>}</div>
              <div class="dep-seats">{full ? 'Full' : <><b>{d.left}</b> of {d.seats} places left</>}</div>
              <div class="dep-price">from <b data-eur={d.price ?? t.price_eur}>€{d.price ?? t.price_eur}</b></div>
              {full ? <span class="dep-cta is-off">Full</span> : <a class="btn btn-gold dep-cta" href={href}>Join this departure</a>}
            </li>
          );
        })}
      </ul>
    </div>
  </section>
)}
<style>
  .dep-lead{color:var(--text-m);max-width:62ch}
  .dep-list{list-style:none;margin:1.2rem 0 0;padding:0;display:grid;gap:.7rem}
  .dep-item{display:grid;grid-template-columns:1.6fr 1fr .8fr auto;gap:1rem;align-items:center;padding:.9rem 1.1rem;
    border:1px solid var(--border);border-left:4px solid var(--accent,var(--brand-green));border-radius:var(--radius-m);background:#fff}
  .dep-date{display:flex;flex-direction:column;gap:.15rem}
  .dep-date a{color:var(--green-d);font-size:.9rem}
  .dep-seats{font-size:.92rem;color:var(--text-m)}
  .dep-seats b{color:#C92B34;font-size:1.05rem}
  .dep-price{font-size:.85rem;color:var(--text-l)}
  .dep-price b{font-family:var(--font-display);font-size:1.3rem;color:var(--green-d)}
  .dep-cta{white-space:nowrap}
  .dep-cta.is-off{color:var(--text-l);font-weight:600}
  .is-full{opacity:.6}
  .dep--compact .dep-item{grid-template-columns:1fr auto;}
  .dep--compact .dep-price{display:none}
  @media (max-width:720px){ .dep-item{grid-template-columns:1fr 1fr} .dep-cta{grid-column:1/-1;justify-content:center} }
</style>
