---
import { CONTACT } from '../config';
interface Props { lang?: 'en' | 'fr' }
const { lang = 'en' } = Astro.props;
const isFr = lang === 'fr';
const msg = isFr
  ? "Bonjour Algeria Compass — j'aimerais organiser un voyage en Algérie."
  : "Hi Algeria Compass — I'd like help planning a trip to Algeria.";
const wa = `https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent(msg)}`;
const t = isFr
  ? { waAria: 'Discuter sur WhatsApp', plan: 'Planifier', planAria: 'Planifier votre voyage' }
  : { waAria: 'Chat on WhatsApp', plan: 'Plan trip', planAria: 'Plan your trip' };
---
<div class="sticky-contact">
  <a class="wa" href={wa} data-evt="whatsapp_click" aria-label={t.waAria}><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.67c2.2 0 4.27.86 5.82 2.42a8.19 8.19 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.24 8.23-1.48 0-2.93-.4-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24Z"/></svg> <span>WhatsApp</span></a>
  <a class="pl" href="/contact/" data-evt="plan_click" aria-label={t.planAria}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg> <span>{t.plan}</span></a>
</div>
