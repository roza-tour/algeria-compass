---
export interface Props {
  title: string; description: string; canonical?: string;
  image?: string; imageAlt?: string; type?: string; keywords?: string | string[]; noindex?: boolean; lang?: string;
}
import { asLang, LANG_META } from '../i18n';
const { title, description, image = '/assets/img/og-image.png', imageAlt, type = 'website', keywords, noindex = false, lang = 'en' } = Astro.props;
const ogLocale = LANG_META[asLang(lang)].ogLocale;
const BRAND = 'Algeria Compass';
// Google truncates SERP titles at roughly 60-65 characters. Only append the brand
// suffix when the result still fits — otherwise the authored (keyword-first) title
// would be cut mid-phrase and the brand never shows anyway. Titles that already
// carry the brand are left untouched.
const TITLE_MAX = 65;
const withBrand = `${title} | ${BRAND}`;
const fullTitle = title.includes(BRAND)
  ? title
  : (withBrand.length <= TITLE_MAX ? withBrand : title);
const site = Astro.site?.toString().replace(/\/$/, '') || 'https://algeriacompass.com';
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = image.startsWith('http') ? image : site + image;
const kw = Array.isArray(keywords) ? keywords.join(', ') : keywords;
// fullTitle already ends in "| Algeria Compass" — don't append the brand again (avoids
// the duplicated "<Title> | Algeria Compass — Algeria Compass" alt). Brand appears once.
const altText = imageAlt || fullTitle;
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
{kw && <meta name="keywords" content={kw} />}
<meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={altText} />
<meta property="og:site_name" content="Algeria Compass" />
<meta property="og:locale" content={ogLocale} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={altText} />
