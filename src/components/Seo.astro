---
export interface Props {
  title: string; description: string; canonical?: string;
  image?: string; imageAlt?: string; type?: string; keywords?: string | string[]; noindex?: boolean;
}
const { title, description, image = '/assets/img/og-image.png', imageAlt, type = 'website', keywords, noindex = false } = Astro.props;
const BRAND = 'Algeria Compass';
const fullTitle = title.includes(BRAND) ? title : `${title} | ${BRAND}`;
const site = Astro.site?.toString().replace(/\/$/, '') || 'https://algeriacompass.com';
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = image.startsWith('http') ? image : site + image;
const kw = Array.isArray(keywords) ? keywords.join(', ') : keywords;
// fullTitle already ends in "| Algeria Compass" — don't append the brand again (avoids
// the duplicated "<Title> | Algeria Compass — Algeria Compass" alt). Brand appears once.
const altText = imageAlt || fullTitle;
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
{kw && <meta name="keywords" content={kw} />}
{noindex && <meta name="robots" content="noindex,follow" />}
<link rel="canonical" href={canonical} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={altText} />
<meta property="og:site_name" content="Algeria Compass" />
<meta property="og:locale" content="en_US" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={altText} />
