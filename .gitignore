node_modules
.astro

# dist/ is the intermediate build output. The PRODUCTION files are staged
# into the repo ROOT (the cPanel docroot) by `npm run deploy`, so dist/
# itself is not committed.
dist

# Build artifacts / backups (not source)
*.zip
*.bak

# Phase A temp image extraction
.tmp-images

# screenshot scratch (Phase B QA)
.shots

# QA verification artifacts & loose dev screenshots (not source, not linked)
_verify
astro_home.png
astro_setif.png
astro_article.png
new-logo.png

# headless-chrome verification profiles
.chrome-verify-*

# astro preview server log (local QA)
.preview.log

# Reviews: mutable, owner-moderated ON THE SERVER. Must stay UNTRACKED so the
# deploy's `git reset --hard` never wipes approved/pending reviews. Created by
# reviews.php / reviews-admin.php on first use. (data/.htaccess IS tracked.)
/reviews-approved.json
/data/*.jsonl
# Runtime security state written by the PHP endpoints — must stay untracked
# (regenerated on the server; wiped safely by the deploy's git reset).
/data/rl-*
/data/.login-*
/data/.admin_hash
# Self-hosted stats: anonymous hit log written by hit.php, read by stats.php.
# Server-side runtime data — stays untracked so the deploy's git reset never
# wipes the counts (git reset --hard leaves untracked files alone).
/data/hits-*.jsonl
shots/
